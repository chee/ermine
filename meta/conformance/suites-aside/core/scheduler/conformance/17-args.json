{
	"title": "arguments are no special thing: a read inside the process, pending until written",
	"steps": [
		{
			"op": "start",
			"address": [],
			"name": "p",
			"program": {
				"compute": [
					{
						"do": "content",
						"address": [
							"p",
							"n"
						],
						"var": "n"
					},
					{
						"do": "if",
						"test": {
							"$eq": [
								{
									"$len": {
										"$var": "n"
									}
								},
								0
							]
						},
						"then": [
							{
								"do": "pending"
							}
						]
					},
					{
						"do": "return",
						"value": {
							"$add": [
								{
									"$get": [
										{
											"$var": "n"
										},
										0,
										"versions",
										0,
										"content"
									]
								},
								1
							]
						}
					}
				]
			},
			"expect": {
				"ok": "@1"
			}
		},
		{
			"op": "content",
			"address": [
				"p"
			],
			"expect": {
				"ok": [
					{
						"id": "@1",
						"versions": [
							{
								"content": {
									"pending": 2
								},
								"time": 3,
								"status": true
							},
							{
								"content": null,
								"time": 1
							}
						]
					}
				]
			}
		},
		{
			"op": "create",
			"value": 5,
			"id": "n",
			"expect": {
				"ok": "n"
			}
		},
		{
			"op": "insert",
			"id": "@1",
			"name": "n",
			"child": "n",
			"expect": {
				"ok": 7
			}
		},
		{
			"op": "content",
			"address": [
				"p"
			],
			"expect": {
				"ok": [
					{
						"id": "@1",
						"versions": [
							{
								"content": 6,
								"time": 8
							}
						]
					}
				]
			}
		},
		{
			"op": "write",
			"address": [
				"p",
				"n"
			],
			"patches": [
				{
					"path": [],
					"value": 7
				}
			],
			"expect": {
				"ok": 11
			}
		},
		{
			"op": "content",
			"address": [
				"p"
			],
			"expect": {
				"ok": [
					{
						"id": "@1",
						"versions": [
							{
								"content": 8,
								"time": 12
							}
						]
					}
				]
			}
		}
	]
}
