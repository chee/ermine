{
	"title": "a backspace run that starts past what was typed: pushed one at a time on what was squished, the same as all at once",
	"steps": [
		{
			"op": "squish",
			"patches": [
				{ "path": ["t"], "range": [2, 2], "value": "abc" },
				{ "path": ["t"], "range": [6, 7] },
				{ "path": ["t"], "range": [5, 6] },
				{ "path": ["t"], "range": [4, 5] },
				{ "path": ["t"], "range": [3, 4] }
			],
			"expect": { "patches": [{ "path": ["t"], "range": [2, 4], "value": "a" }] }
		},
		{
			"op": "squish",
			"patches": [
				{ "path": ["t"], "range": [2, 2], "value": "abc" },
				{ "path": ["t"], "range": [6, 7] },
				{ "path": ["t"], "range": [5, 6] }
			],
			"expect": { "patches": [{ "path": ["t"], "range": [2, 4], "value": "abc" }] }
		},
		{
			"op": "squish",
			"patches": [
				{ "path": ["t"], "range": [2, 4], "value": "abc" },
				{ "path": ["t"], "range": [4, 5] },
				{ "path": ["t"], "range": [3, 4] }
			],
			"expect": { "patches": [{ "path": ["t"], "range": [2, 4], "value": "a" }] }
		}
	]
}
