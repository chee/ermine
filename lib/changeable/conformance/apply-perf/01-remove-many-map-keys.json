{
	"title": "one call removes n keys from a map of n keys",
	"sizes": [6250, 25000, 100000],
	"bound": "n log n",
	"template": [
		{
			"op": "apply",
			"value": { "map": { "for": "i", "to": "n", "key": "key{i}", "value": { "=": "i" } } },
			"patches": [{ "for": "i", "to": "n", "do": [{ "path": ["key{i}"] }] }]
		}
	]
}
