{
  "tasks": {
    "test": "deno test --allow-read --allow-write test",
    "check": "deno check src deno harness test build.ts demo",
    "conformance": "cd ../conformance && ERMINE_HARNESS=\"deno run --quiet ../ts/harness/main.ts\" deno task test",
    "build": "deno run --allow-read --allow-write --allow-run build.ts",
    "demo": "deno run --allow-read --allow-write --allow-run --allow-net --allow-env demo/core/dev.ts",
    "demo:build": "deno run --allow-read --allow-write --allow-run --allow-env demo/core/build.ts"
  },
  "imports": {
    "@std/assert": "jsr:@std/assert@^1",
    "fake-indexeddb": "npm:fake-indexeddb@^6",
    "preact": "npm:preact@^10.29.0",
    "preact/": "npm:/preact@^10.29.0/",
    "@preact/signals": "npm:@preact/signals@^2",
    "codemirror": "npm:codemirror@^6",
    "@codemirror/lang-javascript": "npm:@codemirror/lang-javascript@^6",
    "@codemirror/lang-json": "npm:@codemirror/lang-json@^6",
    "@codemirror/view": "npm:@codemirror/view@^6",
    "@codemirror/state": "npm:@codemirror/state@^6",
    "@codemirror/language": "npm:@codemirror/language@^6",
    "@codemirror/commands": "npm:@codemirror/commands@^6",
    "@lezer/highlight": "npm:@lezer/highlight@^1"
  },
  "lint": {
    "exclude": [
      "dist",
      "demo/core/dist"
    ]
  },
  "fmt": {
    "lineWidth": 100,
    "exclude": [
      "dist",
      "demo/core/dist"
    ]
  },
  "exclude": [
    "dist",
    "demo/core/dist"
  ],
  "compilerOptions": {
    "jsx": "react-jsx",
    "jsxImportSource": "preact"
  }
}
