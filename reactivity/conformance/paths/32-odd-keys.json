		{"op":"mark","source":"v","id":"n","patches":[{"path":["a"],"value":1}],"expect":{"spots":[["a"]]}},
		{"op":"mark","source":"v","id":"n","patches":[{"path":["\ud800"]}],"expect":{"spots":[["\ud800"]]}},
		{"op":"mark","source":"v","id":"n","patches":[{"path":["𐀀"],"value":1}],"expect":{"spots":[["𐀀"]]}},
		{"op":"mark","source":"v","id":"n","patches":[{"path":[""],"value":1}],"expect":{"spots":[[""]]}},
		{"op":"mark","source":"v","id":"n","patches":[{"path":["__proto__"]}],"expect":{"spots":[["__proto__"]]}},
		{"op":"event","source":"v","id":"n","expect":{"spots":[[0,"x"],["a\u0000b"],["a\u0000c"],["a"],["\ud800"],["\udc00"],["𐀀"],[""],["__proto__"]]}},
		{"op":"spot","source":"s\u0000x","id":"n","path":[],"expect":{}},
