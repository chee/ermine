		{"op":"event","source":"\ud800","id":"\udc00","expect":{"spots":[[]]}},
		{"op":"spot","source":"","id":"","path":["k"],"expect":{}},
		{"op":"event","source":"","id":"","expect":{"spots":[["k"]]}},
		{"op":"held","expect":{"keys":4,"spots":12,"steps":15}}
	]
}
