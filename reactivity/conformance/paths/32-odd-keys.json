{
	"title": "odd keys: -0 is index 0, a NUL or a lone surrogate in a key or a source is part of it, the empty string and __proto__ are keys like any other",
	"steps": [
		{"op":"spot","source":"v","id":"n","path":[0,"x"],"expect":{}},
		{"op":"spot","source":"v","id":"n","path":["a\u0000b"],"expect":{}},
		{"op":"spot","source":"v","id":"n","path":["a\u0000c"],"expect":{}},
		{"op":"spot","source":"v","id":"n","path":["a"],"expect":{}},
