{
	"title": "neither path a prefix of the other: never; a number key and a string key differ",
	"steps": [
		{ "op": "spot", "source": "v", "id": "n", "path": ["a", "c"], "expect": {} },
		{ "op": "spot", "source": "v", "id": "n", "path": ["a", "bb"], "expect": {} },
		{ "op": "spot", "source": "v", "id": "n", "path": ["b"], "expect": {} },
		{ "op": "spot", "source": "v", "id": "n", "path": ["l", "0"], "expect": {} },
		{ "op": "spot", "source": "v", "id": "n", "path": ["l", 0], "expect": {} },
		{
			"op": "mark",
			"source": "v",
			"id": "n",
			"patches": [{ "path": ["a", "b"], "value": 1 }],
			"expect": { "spots": [] }
		},
		{
			"op": "mark",
			"source": "v",
			"id": "n",
			"patches": [{ "path": ["l", 0], "value": 1 }],
			"expect": { "spots": [["l", 0]] }
		},
		{
			"op": "mark",
			"source": "v",
			"id": "n",
			"patches": [{ "path": ["l", "0"], "value": 1 }],
			"expect": { "spots": [["l", "0"]] }
		}
	]
}
