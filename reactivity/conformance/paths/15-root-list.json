{
	"title": "a list at []: its index reads follow the same rows",
	"steps": [
		{ "op": "spot", "source": "v", "id": "n", "path": [], "expect": {} },
		{ "op": "spot", "source": "v", "id": "n", "path": [0], "expect": {} },
		{ "op": "spot", "source": "v", "id": "n", "path": [1, "x"], "expect": {} },
		{ "op": "spot", "source": "v", "id": "n", "path": [2], "expect": {} },
		{
			"op": "mark",
			"source": "v",
			"id": "n",
			"patches": [{ "path": [], "range": [1, 2], "value": [5] }],
			"expect": { "spots": [[], [1, "x"]] }
		},
		{
			"op": "mark",
			"source": "v",
			"id": "n",
			"patches": [{ "path": [1] }],
			"expect": { "spots": [[], [2], [1, "x"]] }
		},
		{
			"op": "mark",
			"source": "v",
			"id": "n",
			"patches": [{ "path": [], "value": [] }],
			"expect": { "spots": [[], [0], [1, "x"], [2]] }
		}
	]
}
