		{ "op": "begin", "from": "p", "expect": {} },
		{ "op": "track", "from": "p", "to": "a", "expect": {} },
		{ "op": "begin", "from": "p", "fails": true },
		{ "op": "track", "from": "p", "to": "b", "expect": {} },
		{ "op": "reads", "of": "p", "expect": { "names": ["a", "b"] } },
		{ "op": "readers", "of": "a", "expect": { "names": ["p"] } },
		{ "op": "end", "from": "p", "expect": {} },
		{ "op": "begin", "from": "p", "expect": {} },
		{ "op": "end", "from": "p", "expect": {} },
		{ "op": "reads", "of": "p", "expect": { "names": [] } },
		{ "op": "readers", "of": "a", "expect": { "names": [] } },
		{ "op": "readers", "of": "b", "expect": { "names": [] } }
	]
}
