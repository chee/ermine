{
	"title": "a send from inside a memo or an effect is a send like any: its record holds the reads and writes made in the call (not the run's own), and why of what the handler wrote names the call, while the handler's latest record holds it",
	"steps": [
		{
			"op": "ermine",
			"expect": {}
		},
		{
			"op": "host",
			"call": [
				"ensureNode",
				"/data",
				{
					"n": 0
				}
			]
		},
		{
			"op": "code",
			"at": "/code/svc",
			"program": [
				{
					"do": [
						"createAction",
						"/svc/bump",
						[
							{
								"do": [
									"read",
									"/data",
									[
										"n"
									]
								],
								"as": "n"
							},
							{
								"do": [
									"patch",
									"/data",
									[
										{
											"path": [
												"n"
											],
											"value": 1
										}
									]
								]
							}
						],
						"$n"
					]
				}
			],
			"expect": {}
		},
		{
			"op": "start",
			"name": "svc",
			"at": "/code/svc",
			"expect": {
				"id": "proc:svc"
			}
		},
		{
			"op": "id",
			"path": [
				"data"
			],
			"expect": {
				"id": "n2"
			}
		},
		{
			"op": "id",
			"path": [
				"svc",
				"bump"
			],
			"expect": {
				"id": "n5"
			}
		},
		{
			"op": "code",
			"at": "/code/cl",
			"program": [
				{
					"do": [
						"createMemo",
						"m",
						{},
						[
							"executeAction",
							"/svc/bump"
						]
					]
				}
			],
			"expect": {}
		},
		{
			"op": "start",
			"name": "cl",
			"at": "/code/cl",
			"expect": {
				"id": "proc:cl"
			}
		},
		{
			"op": "id",
			"path": [
				"code",
				"cl",
				"m"
			],
			"expect": {
				"id": "n8"
			}
		},
		{
			"op": "record",
			"kind": "call",
			"id": "n5",
			"expect": {
				"record": {
					"n": 1,
					"caller": "proc:cl",
					"handler": "n5",
					"args": [],
					"end": "done",
					"returned": 0,
					"reads": [
						[
							"value",
							"n2"
						]
					],
					"writes": [
						[
							"value",
							"n2"
						]
					]
				}
			}
		},
		{
			"op": "host",
			"call": [
				"explain",
				"/data"
			],
			"expect": {
				"value": {
					"writer": "method",
					"path": [
						"svc",
						"bump"
					],
					"n": 1
				}
			}
		},
		{
			"op": "host",
			"call": [
				"patch",
				"/data",
				[
					{
						"path": [
							"n"
						],
						"value": 5
					}
				]
			]
		},
		{
			"op": "code",
			"at": "/code/ef",
			"program": [
				{
					"do": [
						"createEffect",
						"e",
						[
							"executeAction",
							"/svc/bump"
						],
						"acted"
					]
				}
			],
			"expect": {}
		},
		{
			"op": "start",
			"name": "ef",
			"at": "/code/ef",
			"expect": {
				"id": "proc:ef"
			}
		},
		{
			"op": "log",
			"name": "acted",
			"expect": {
				"values": [
					5
				]
			}
		},
		{
			"op": "record",
			"kind": "call",
			"id": "n5",
			"expect": {
				"record": {
					"n": 2,
					"caller": "proc:ef",
					"handler": "n5",
					"args": [],
					"end": "done",
					"returned": 5,
					"reads": [
						[
							"value",
							"n2"
						]
					],
					"writes": [
						[
							"value",
							"n2"
						]
					]
				}
			}
		},
		{
			"op": "host",
			"call": [
				"explain",
				"/data"
			],
			"expect": {
				"value": {
					"writer": "method",
					"path": [
						"svc",
						"bump"
					],
					"n": 2
				}
			}
		}
	]
}
