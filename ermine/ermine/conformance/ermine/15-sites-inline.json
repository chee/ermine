{
	"title": "sites skip only the files a feature lists: a feature written in the same file as the programs, listing none, leaves their lines their sites (a write's the program's line, a memo's the line that made it)",
	"steps": [
		{
			"op": "ermine",
			"features": [
				"inline"
			],
			"expect": {}
		},
		{
			"op": "code",
			"at": "/code/p",
			"program": [
				{
					"do": [
						"ensureNode",
						"./doc",
						{
							"n": 1
						}
					],
					"as": "doc"
				},
				{
					"do": [
						"createMemo",
						"m",
						{},
						[
							"read",
							"$doc",
							[
								"n"
							]
						]
					]
				}
			],
			"expect": {}
		},
		{
			"op": "start",
			"name": "p",
			"at": "/code/p",
			"expect": {
				"id": "proc:p"
			}
		},
		{
			"op": "id",
			"path": [
				"code",
				"doc"
			],
			"expect": {
				"id": "n4"
			}
		},
		{
			"op": "id",
			"path": [
				"code",
				"p",
				"m"
			],
			"expect": {
				"id": "n5"
			}
		},
		{
			"op": "site",
			"part": "value",
			"id": "n4",
			"expect": {
				"site": "program"
			}
		},
		{
			"op": "site",
			"part": "value",
			"id": "n5",
			"expect": {
				"site": "computer"
			}
		},
		{
			"op": "host",
			"call": [
				"ensureNode",
				"/x",
				1
