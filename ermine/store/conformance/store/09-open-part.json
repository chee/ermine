{
	"title": "any name is a part: run, beside value, added, replaced, taken out, evented and dropped like it; children knows nothing of it",
	"steps": [
		{ "op": "add", "source": "stored", "part": "run", "id": "x", "node": "r", "expect": {} },
		{ "op": "add", "source": "stored", "part": "value", "id": "x", "node": "v", "expect": {} },
		{ "op": "get", "source": "stored", "part": "run", "id": "x", "expect": { "node": "r" } },
		{ "op": "get", "source": "stored", "part": "value", "id": "x", "expect": { "node": "v" } },
		{ "op": "get", "source": "drag", "part": "run", "id": "x", "expect": {} },
		{ "op": "children", "source": "stored", "id": "x", "expect": {} },
		{
			"op": "add",
			"source": "stored",
			"part": "run",
			"id": "x",
			"node": "s",
			"expect": { "error": "already-there" }
		},
		{ "op": "sub", "source": "stored", "part": "run", "id": "x", "node": "s", "expect": {} },
		{ "op": "who", "source": "stored", "node": "s", "expect": { "keys": [["run", "x"]] } },
		{ "op": "who", "source": "stored", "node": "r", "expect": { "keys": [] } },
		{ "op": "add", "source": "stored", "part": "run", "id": "y", "node": "v", "expect": {} },
		{
			"op": "who",
			"source": "stored",
			"node": "v",
			"expect": { "keys": [["value", "x"], ["run", "y"]] }
		},
		{ "op": "del", "source": "stored", "part": "run", "id": "x", "expect": {} },
		{ "op": "get", "source": "stored", "part": "run", "id": "x", "expect": {} },
		{
			"op": "del",
			"source": "stored",
			"part": "run",
			"id": "x",
			"expect": { "error": "nothing-there" }
		},
		{
			"op": "events",
			"expect": {
				"events": [
					["stored", "run", "x", "r"],
					["stored", "value", "x", "v"],
					["stored", "run", "x", "s"],
					["stored", "run", "y", "v"],
					["stored", "run", "x", null]
				]
			}
		},
		{ "op": "drop", "source": "stored", "expect": {} },
		{
			"op": "events",
			"expect": { "events": [["stored", "value", "x", null], ["stored", "run", "y", null]] }
		}
	]
}
