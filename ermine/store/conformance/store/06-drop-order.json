{
	"title": "drop's order: an id deleted and held again goes last; a part replaced goes last among its id's parts",
	"steps": [
		{ "op": "add", "source": "s", "part": "value", "id": "p", "node": "a", "expect": {} },
		{ "op": "add", "source": "s", "part": "value", "id": "q", "node": "b", "expect": {} },
		{ "op": "add", "source": "s", "part": "value", "id": "r", "node": "c", "expect": {} },
		{ "op": "add", "source": "s", "part": "children", "id": "r", "node": "d", "expect": {} },
		{ "op": "del", "source": "s", "part": "value", "id": "p", "expect": {} },
		{ "op": "add", "source": "s", "part": "value", "id": "p", "node": "e", "expect": {} },
		{ "op": "sub", "source": "s", "part": "value", "id": "r", "node": "f", "expect": {} },
		{
			"op": "events",
			"expect": {
				"events": [
					["s", "value", "p", "a"],
					["s", "value", "q", "b"],
					["s", "value", "r", "c"],
