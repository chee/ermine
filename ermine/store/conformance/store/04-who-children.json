{
	"title": "who gives every key of a node in its source only; children is places' hole",
	"steps": [
		{ "op": "add", "source": "stored", "part": "children", "id": "x", "node": "k", "expect": {} },
		{ "op": "add", "source": "stored", "part": "children", "id": "y", "node": "k", "expect": {} },
		{ "op": "add", "source": "drag", "part": "children", "id": "z", "node": "k", "expect": {} },
		{ "op": "add", "source": "stored", "part": "value", "id": "x", "node": "k", "expect": {} },
		{
			"op": "who",
			"source": "stored",
			"node": "k",
			"expect": { "keys": [["children", "x"], ["children", "y"], ["value", "x"]] }
		},
		{ "op": "who", "source": "drag", "node": "k", "expect": { "keys": [["children", "z"]] } },
		{ "op": "who", "source": "pending", "node": "k", "expect": { "keys": [] } },
		{ "op": "who", "source": "stored", "node": "other", "expect": { "keys": [] } },
		{ "op": "children", "source": "stored", "id": "y", "expect": { "node": "k" } },
		{ "op": "children", "source": "stored", "id": "w", "expect": {} },
		{ "op": "children", "source": "pending", "id": "y", "expect": {} },
		{ "op": "del", "source": "stored", "part": "children", "id": "x", "expect": {} },
		{
			"op": "who",
			"source": "stored",
			"node": "k",
			"expect": { "keys": [["children", "y"], ["value", "x"]] }
		}
	]
}
