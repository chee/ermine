{
	"title": "a call's record holds no handles [the dormouse's finding 2]: the host hands an action a handle to /secret; a process explaining what the action wrote is shown the call's args and what it returned with each handle as the path it reaches from the root (nothing reaching it: null), never the handle, so no reader gets the host's power through a record",
	"steps": [
		{ "op": "ermine", "expect": {} },
		{ "op": "host", "call": ["ensureNode", "/secret", { "s": 1 }] },
		{ "op": "host", "call": ["ensureNode", "/shared/log", { "n": 0 }] },
		{
			"op": "code",
			"at": "/system/s",
			"program": [
				{
					"do": [
						"createAction",
						"on/log",
						[{ "do": ["patch", "/shared/log", [{ "path": ["n"], "value": 1 }]] }],
						"$0"
					]
				}
			],
			"expect": {}
		},
		{ "op": "start", "name": "s", "at": "/system/s", "expect": { "id": "proc:s" } },
		{
			"op": "host",
			"call": ["executeAction", "/system/s/on/log", { "path": ["secret"], "part": "value" }],
			"expect": { "value": { "path": ["secret"], "part": "value" } }
		},
		{ "op": "code", "at": "/code/q", "program": [], "expect": {} },
		{ "op": "start", "name": "q", "at": "/code/q", "expect": { "id": "proc:q" } },
		{
			"op": "do",
			"process": "q",
			"call": ["explainargs", "/shared/log"],
			"expect": { "value": { "args": [["secret"]], "returned": ["secret"] } }
		},
		{
			"op": "host",
			"call": ["explainargs", "/shared/log"],
			"expect": { "value": { "args": [["secret"]], "returned": ["secret"] } }
		},
		{ "op": "host", "call": ["unplace", "/secret"] },
		{
			"op": "do",
			"process": "q",
			"call": ["explainargs", "/shared/log"],
			"expect": { "value": { "args": [null], "returned": null } }
		}
	]
}
