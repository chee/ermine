{
	"title": "through a handle another process made: s, given q's folder, names its own ./note into it (a path in a patch: resolved as s, the one acting, not as q the caller); s explains q's node and is told its path from the root; r executing an action through s's handle is the caller, not s (the dormouse's finding 1)",
	"steps": [
		{
			"op": "ermine",
			"expect": {}
		},
		{
			"op": "code",
			"at": "/system/s",
			"program": [
				{
					"do": [
						"ensureNode",
						"./note",
						{
							"from": "s"
						}
					]
				},
				{
					"do": [
						"createAction",
						"on/file",
						[
							{
								"do": [
									"patchChildren",
									"$0",
									[
										{
											"path": [
												"note"
											],
											"value": "./note"
										}
									]
								]
							}
						],
						"filed"
					]
				},
				{
					"do": [
						"createAction",
						"on/why",
						[],
						[
							"explain",
							"$0"
						]
					]
				},
				{
					"do": [
						"createAction",
						"on/who",
						[],
						[
							"getCaller"
						]
					]
				},
				{
					"do": [
						"createAction",
						"on/give",
						[],
						[
							"getNode",
							"on/who"
						]
					]
				}
			],
			"expect": {}
		},
		{
			"op": "start",
			"name": "s",
			"at": "/system/s",
			"expect": {
				"id": "proc:s"
			}
		},
		{
			"op": "host",
			"call": [
				"ensureNode",
				"/code/note",
				{
					"from": "q"
				}
			]
		},
		{
			"op": "code",
			"at": "/code/q",
			"program": [
				{
					"do": [
						"ensureNode",
						"./shelf",
						{}
					],
					"as": "shelf"
				},
				{
					"do": [
						"ensureNode",
						"./doc",
						{
							"n": 0
						}
					],
					"as": "doc"
				},
				{
					"do": [
						"createAction",
						"on/touch",
						[
							{
								"do": [
									"patch",
									"$doc",
									[
										{
											"path": [
												"n"
											],
											"value": 1
										}
									]
								]
							}
						],
						"touched"
					]
				}
			],
			"expect": {}
		},
		{
			"op": "start",
			"name": "q",
			"at": "/code/q",
			"expect": {
				"id": "proc:q"
			}
		},
		{
			"op": "do",
			"process": "q",
			"call": [
				"executeAction",
				"/system/s/on/file",
				"$shelf"
			],
			"expect": {
				"value": "filed"
			}
		},
		{
			"op": "host",
			"call": [
				"read",
				"/code/shelf/note"
			],
			"expect": {
				"value": {
					"from": "s"
				}
			}
		},
		{
			"op": "do",
			"process": "q",
			"call": [
				"executeAction",
				"/code/q/on/touch"
			],
			"expect": {
				"value": "touched"
			}
		},
		{
			"op": "do",
			"process": "q",
			"call": [
				"executeAction",
				"/system/s/on/why",
				"$doc"
			],
			"expect": {
				"value": {
					"writer": "method",
					"path": [
						"code",
						"q",
						"on",
						"touch"
					],
					"n": 2
				}
			}
		},
		{
			"op": "do",
			"process": "q",
			"call": [
				"explain",
				"$doc"
			],
			"expect": {
				"value": {
					"writer": "method",
					"path": [
						"code",
						"q",
						"on",
						"touch"
					],
					"n": 2
				}
			}
		},
		{
			"op": "code",
			"at": "/code/r",
			"program": [],
			"expect": {}
		},
		{
			"op": "start",
			"name": "r",
			"at": "/code/r",
			"expect": {
				"id": "proc:r"
			}
		},
		{
			"op": "do",
			"process": "r",
			"call": [
				"executeAction",
				"/system/s/on/give"
			],
			"as": "who",
			"expect": {
				"value": {
					"path": [
						"system",
						"s",
						"on",
						"who"
					],
					"part": "value"
				}
			}
		},
		{
			"op": "do",
			"process": "r",
			"call": [
				"executeAction",
				"$who"
			],
			"expect": {
				"value": {
					"actor": "test",
					"process": [
						"code",
						"r"
					]
				}
			}
		}
	]
}
