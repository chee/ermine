{
	"title": "createWriter(), in an action: the writer's writes carry the call's mark (call, handler, caller in their metadata), so explain says which action wrote and getCaller() says who called it, even though the call returned long ago; what withWriter(f) makes belongs to the scope that placed the action",
	"steps": [
		{
			"op": "ermine",
			"expect": {}
		},
		{
			"op": "code",
			"at": "/code/p",
			"program": [
				{
					"do": [
						"ensureNode",
						"/k",
						0
					],
					"as": "k"
				},
				{
					"do": [
						"createAction",
						"on/start",
						[],
						[
							"createWriter"
						]
					]
				}
			],
			"expect": {}
		},
		{
			"op": "code",
			"at": "/code/q",
			"program": [],
			"expect": {}
		},
		{
			"op": "start",
			"name": "p",
			"at": "/code/p",
			"expect": {
				"id": "proc:p"
			}
		},
		{
			"op": "start",
			"name": "q",
			"at": "/code/q",
			"expect": {
				"id": "proc:q"
			}
		},
		{
			"op": "do",
			"process": "q",
			"call": [
				"executeAction",
				"./p/on/start"
			],
			"as": "runner",
			"expect": {
				"value": "function"
			}
		},
		{
			"op": "withWriter",
			"process": "q",
			"name": "runner",
			"steps": [
				{
					"do": [
						"patch",
						"/k",
						[
							{
								"path": [],
								"value": 7
							}
						]
					]
				},
				{
					"do": [
						"createMemo",
						"m",
						{},
						[
							"read",
							"/k"
						]
					]
				}
			],
			"back": [
				"getCaller"
			],
			"expect": {
				"value": {
					"actor": "test",
					"process": [
						"code",
						"q"
					]
				}
			}
		},
		{
			"op": "id",
			"path": [
				"k"
			],
			"expect": {
				"id": "n5"
			}
		},
		{
			"op": "metadata",
			"part": "value",
			"id": "n5",
			"expect": {
				"keys": [
					"call",
					"caller",
					"handler",
					"node",
					"process"
				],
				"call": 1,
				"handler": "n6",
				"caller": "proc:q",
				"node": "proc:p"
			}
		},
		{
			"op": "host",
			"call": [
				"read",
				"/code/p/m"
			],
			"expect": {
				"value": 7
			}
		}
	]
}
