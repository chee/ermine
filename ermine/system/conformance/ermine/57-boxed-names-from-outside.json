{
	"title": "list and readChildren from outside a box name a process started in it, as a walk to its node reaches it (scenario 48's rule, for listing): a folder a walk reaches under a box's folder lists that box's rows beneath it after its own names; the box's own view lists its rows alone; a process stopped goes from both",
	"steps": [
		{ "op": "ermine", "expect": {} },
		{ "op": "box", "name": "b", "at": "/boxes/b", "expect": {} },
		{
			"op": "code",
			"at": "/progs/q",
			"program": [{ "do": ["createMemo", "m", {}, 7] }],
			"expect": {}
		},
		{
			"op": "start",
			"name": "q",
			"at": "/code/q",
			"program": "/progs/q",
			"box": "b",
			"expect": { "id": "proc:q" }
		},
		{ "op": "code", "at": "/progs/z", "program": [], "expect": {} },
		{
			"op": "start",
			"name": "z",
			"at": "/boxes/b/code/z",
			"program": "/progs/z",
			"expect": { "id": "proc:z" }
		},
		{ "op": "code", "at": "/progs/o", "program": [], "expect": {} },
		{
			"op": "start",
			"name": "o",
			"at": "/code/o",
			"program": "/progs/o",
			"expect": { "id": "proc:o" }
		},
		{ "op": "pulse", "expect": {} },
		{ "op": "host", "call": ["hasNode", "/boxes/b/code/q"], "expect": { "value": true } },
		{ "op": "host", "call": ["list", "/boxes/b/code"], "expect": { "value": ["z", "q"] } },
		{
			"op": "host",
			"call": ["readChildren", "/boxes/b/code"],
			"expect": {
				"value": {
					"z": { "id": "proc:z", "part": "value" },
					"q": { "id": "proc:q", "part": "value" }
				}
			}
		},
		{ "op": "host", "call": ["list", "/boxes/b/code/q"], "expect": { "value": ["m"] } },
		{
			"op": "do",
			"process": "o",
			"call": ["list", "/boxes/b/code"],
			"expect": { "value": ["z", "q"] }
		},
		{ "op": "do", "process": "q", "call": ["list", "/code"], "expect": { "value": ["q"] } },
		{ "op": "stop", "name": "q", "expect": {} },
		{ "op": "host", "call": ["list", "/boxes/b/code"], "expect": { "value": ["z"] } },
		{
			"op": "host",
			"call": ["readChildren", "/boxes/b/code"],
			"expect": { "value": { "z": { "id": "proc:z", "part": "value" } } }
		}
	]
}
