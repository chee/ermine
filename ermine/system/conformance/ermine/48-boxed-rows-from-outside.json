{
	"title": "a process started in a box is reached from outside its box by path, its own nodes too [the dormouse's finding 11, fixed for 1.3]: a walk reaching a box's folder reads that box's rows beneath it, as the box's own view does",
	"steps": [
		{ "op": "ermine", "expect": {} },
		{ "op": "box", "name": "b", "at": "/boxes/b", "expect": {} },
		{
			"op": "code",
			"at": "/boxes/b/code/q",
			"program": [
				{ "do": ["createMemo", "m", {}, 7] },
				{ "do": ["createAction", "on/hi", [], "hi"] }
			],
			"back": "q value",
			"expect": {}
		},
		{ "op": "start", "name": "q", "at": "/code/q", "box": "b", "expect": { "id": "proc:q" } },
		{ "op": "pulse", "expect": {} },
		{ "op": "host", "call": ["read", "/boxes/b/code/q"], "expect": { "value": "q value" } },
		{ "op": "host", "call": ["read", "/boxes/b/code/q/m"], "expect": { "value": 7 } },
		{
			"op": "host",
			"call": ["executeAction", "/boxes/b/code/q/on/hi"],
			"expect": { "value": "hi" }
		},
		{ "op": "do", "process": "q", "call": ["read", "/code/q/m"], "expect": { "value": 7 } }
	]
}
