			}
		},
		{
			"op": "host",
			"call": [
				"unplace",
				"/pinned/n"
			]
		},
		{
			"op": "host",
			"call": [
				"explainargs",
				"/log"
			],
			"expect": {
				"value": {
					"args": [
						[
							"papers",
							"note"
						]
					],
					"returned": "logged"
