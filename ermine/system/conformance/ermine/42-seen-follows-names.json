				"/log"
			],
			"expect": {
				"value": {
					"args": [
						[
							"docs",
							"note"
						]
					],
					"returned": "logged"
				}
			}
		},
		{
			"op": "host",
			"call": [
				"rename",
				"/docs",
				"/papers"
			]
		},
		{
			"op": "host",
			"call": [
				"explainargs",
				"/log"
			],
			"expect": {
				"value": {
					"args": [
						[
							"papers",
							"note"
						]
					],
					"returned": "logged"
				}
			}
		},
		{
			"op": "host",
			"call": [
				"ensureNode",
				"/pinned",
				{}
			]
		},
		{
			"op": "host",
			"call": [
				"place",
				"/pinned/n",
				"/papers/note"
			]
		},
		{
			"op": "host",
			"call": [
				"explainargs",
				"/log"
			],
			"expect": {
				"value": {
					"args": [
						[
							"pinned",
							"n"
