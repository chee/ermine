{
	"title": "a change made through a writer while the page is user-activated (navigator.userActivation.isActive: a person just interacted with it) says so: userActivated: true on the ChangeView explain gives [chee 10-27]. no activation: absent. a write made directly is never marked. what it promises is that a person had just interacted with the page when this was written, no more. the activation is read through the getter and object kept when the module loaded, so a program replacing them gains nothing (tested in marks_test.ts); here the harness stands in for them before the module loads",
	"steps": [
		{
			"op": "ermine",
			"expect": {}
		},
		{
			"op": "code",
			"at": "/code/p",
			"program": [
				{
					"do": [
						"ensureNode",
						"/k",
						0
					],
					"as": "k"
				},
				{
					"do": [
						"ensureNode",
						"/j",
						0
					],
					"as": "j"
				},
				{
					"do": [
						"createWriter"
					],
					"as": "runner"
				}
			],
			"expect": {}
		},
		{
			"op": "start",
			"name": "p",
			"at": "/code/p",
			"expect": {
				"id": "proc:p"
			}
		},
		{
			"op": "activation",
			"active": true,
			"expect": {}
		},
		{
			"op": "withWriter",
			"process": "p",
			"name": "runner",
			"steps": [
				{
					"do": [
						"patch",
						"$k",
						[
							{
								"path": [],
								"value": 1
							}
						]
					]
				}
			],
			"expect": {}
		},
		{
			"op": "do",
			"process": "p",
			"call": [
				"explain",
				"$k"
			],
			"expect": {
				"value": {
					"writer": "outside",
					"site": "setup",
					"userActivated": true
				}
			}
		},
		{
			"op": "activation",
			"active": false,
			"expect": {}
		},
		{
			"op": "withWriter",
			"process": "p",
			"name": "runner",
			"steps": [
				{
					"do": [
						"patch",
						"$k",
						[
							{
								"path": [],
								"value": 2
							}
						]
					]
				}
			],
			"expect": {}
		},
		{
			"op": "do",
			"process": "p",
			"call": [
				"explain",
				"$k"
			],
			"expect": {
				"value": {
					"writer": "outside",
					"site": "setup"
				}
			}
		},
		{
			"op": "activation",
			"active": true,
			"expect": {}
		},
		{
			"op": "do",
			"process": "p",
			"call": [
				"patch",
				"$j",
				[
					{
						"path": [],
						"value": 1
					}
				]
			],
			"expect": {}
		},
		{
			"op": "do",
			"process": "p",
			"call": [
				"explain",
				"$j"
			],
			"expect": {
				"value": {
					"writer": "outside",
					"site": "program"
				}
			}
		},
		{
			"op": "activation",
			"active": false,
			"expect": {}
		},
		{
			"op": "withWriter",
			"process": "p",
			"name": "runner",
			"steps": [
				{
					"do": [
						"patch",
						"$k",
						[
							{
								"path": [],
								"value": 3
							}
						]
					]
				}
			],
			"expect": {}
		},
		{
			"op": "do",
			"process": "p",
			"call": [
				"explain",
				"$k"
			],
			"expect": {
				"value": {
					"writer": "outside",
					"site": "setup"
				}
			}
		}
	]
}
