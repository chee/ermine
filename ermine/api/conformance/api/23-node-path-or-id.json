{
	"title": "a node is its path or its id, never both: one with both is nothing-there, asked of no policy and reaching neither (a policy asks by the path, the write and read reach the id: a path let through must not carry another node's id); a path alone and an id alone as before",
	"steps": [
		{
			"op": "world",
			"deny": [{ "op": "edit", "path": "w/secret" }, { "op": "read", "path": "w/hidden" }],
			"expect": {}
		},
		{ "op": "kids", "id": "R", "value": { "w": "W" }, "expect": {} },
		{
			"op": "start",
			"name": "p",
			"at": ["w", "p"],
			"program": [
				{ "do": ["open", "./secret", 1] },
				{ "do": ["open", "./hidden", 2] },
				{ "do": ["open", "./open", 3] }
			],
			"expect": { "id": "proc:p" }
		},
		{ "op": "id", "path": ["w", "secret"], "expect": { "id": "n1" } },
		{ "op": "id", "path": ["w", "hidden"], "expect": { "id": "n2" } },
		{
			"op": "do",
			"process": "p",
			"call": [
				"edit",
				{ "path": ["w", "open"], "id": "n1", "part": "value" },
				[{ "path": [], "value": 9 }]
			],
			"fails": true,
			"expect": { "error": "nothing-there" }
		},
		{ "op": "saved", "part": "value", "id": "n1", "expect": { "value": 1 } },
		{
			"op": "do",
			"process": "p",
			"call": [
				"edit",
				{ "path": ["w", "secret"], "part": "value" },
				[{ "path": [], "value": 9 }]
			],
			"fails": true,
			"expect": { "error": "refused" }
		},
		{
			"op": "do",
			"process": "p",
			"call": ["read", { "path": ["w", "open"], "id": "n2", "part": "value" }],
			"fails": true,
			"expect": { "error": "nothing-there" }
		},
		{
			"op": "do",
			"process": "p",
			"call": ["read", { "path": ["w", "hidden"], "part": "value" }],
			"fails": true,
			"expect": { "error": "refused" }
		},
		{
			"op": "do",
			"process": "p",
			"call": ["entries", { "path": ["w", "open"], "id": "n2", "part": "value" }],
			"fails": true,
			"expect": { "error": "nothing-there" }
		},
		{
			"op": "do",
			"process": "p",
			"call": ["list", { "path": ["w", "open"], "id": "n2", "part": "value" }],
			"fails": true,
			"expect": { "error": "nothing-there" }
		},
		{
			"op": "do",
			"process": "p",
			"call": ["remove", { "path": ["w", "open"], "id": "n1", "part": "value" }],
			"fails": true,
			"expect": { "error": "nothing-there" }
		},
		{ "op": "id", "path": ["w", "secret"], "expect": { "id": "n1" } },
		{ "op": "id", "path": ["w", "open"], "expect": { "id": "n3" } },
		{
			"op": "do",
			"process": "p",
			"call": ["read", { "path": ["w", "open"], "part": "value" }],
			"expect": { "value": 3 }
		},
		{
			"op": "do",
			"process": "p",
			"call": ["read", { "id": "n3", "part": "value" }],
			"expect": { "value": 3 }
		}
	]
}
