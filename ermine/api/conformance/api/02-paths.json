{
	"title": "paths: a bare name is inside the process's own node (gone at its stop), ./ its working folder (cwd, by default the folder it is in), ../ above that, / the root",
	"steps": [
		{
			"op": "kids",
			"id": "R",
			"value": {
				"w": "W"
			},
			"expect": {}
		},
		{
			"op": "start",
			"name": "p",
			"at": [
				"w",
				"p"
			],
			"program": [
				{
					"do": [
						"open",
						"scratch",
						{
							"x": 1
						}
					]
				},
				{
					"do": [
						"open",
						"./here",
						1
					]
				},
				{
					"do": [
						"open",
						"../top",
						2
					]
				},
				{
					"do": [
						"open",
						"/root",
						3
					]
				}
			],
			"expect": {
				"id": "proc:p"
			}
		},
		{
			"op": "id",
			"path": [
				"w",
				"p",
				"scratch"
			],
			"expect": {
				"id": "n1"
			}
		},
		{
			"op": "id",
			"path": [
				"w",
				"here"
			],
			"expect": {
				"id": "n2"
			}
		},
		{
			"op": "id",
			"path": [
				"top"
			],
			"expect": {
				"id": "n3"
			}
		},
		{
			"op": "id",
			"path": [
				"root"
			],
			"expect": {
				"id": "n4"
			}
		},
		{
			"op": "start",
			"name": "q",
			"at": [
				"w",
				"q"
			],
			"program": [
				{
					"do": [
						"open",
						"./mine",
						4
					]
				}
			],
			"cwd": [
				"w",
				"docs"
			],
			"expect": {
				"id": "proc:q"
			}
		},
		{
			"op": "id",
			"path": [
				"w",
				"docs",
				"mine"
			],
			"expect": {
				"id": "n5"
			}
		},
		{
			"op": "id",
			"path": [
				"w",
				"mine"
			],
			"expect": {}
		},
		{
			"op": "stop",
			"name": "p",
			"expect": {}
		},
		{
			"op": "id",
			"path": [
				"w",
				"p",
				"scratch"
			],
			"expect": {}
		},
		{
			"op": "id",
			"path": [
				"w",
				"here"
			],
			"expect": {
				"id": "n2"
			}
		}
	]
}
