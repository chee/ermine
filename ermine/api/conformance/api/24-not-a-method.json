{
	"title": "send: a stand-in whose method is not a whole number from 0 below the count of methods made (-1, NaN, infinite, huge, a fraction, one past the last) is not-a-method; it calls none",
	"steps": [
		{ "op": "kids", "id": "R", "value": { "w": "W" }, "expect": {} },
		{
			"op": "kids",
			"id": "W",
			"value": {
				"less": "L",
				"nan": "N",
				"inf": "I",
				"huge": "H",
				"edge": "E",
				"half": "F",
				"past": "P"
			},
			"expect": {}
		},
		{
			"op": "put",
			"part": "value",
			"id": "L",
			"value": { "/": { "live": { "name": "Function", "method": -1 } } },
			"expect": {}
		},
		{
			"op": "put",
			"part": "value",
			"id": "N",
			"value": {
				"/": { "live": { "name": "Function", "method": { "/": { "number": "NaN" } } } }
			},
			"expect": {}
		},
		{
			"op": "put",
			"part": "value",
			"id": "I",
			"value": {
				"/": { "live": { "name": "Function", "method": { "/": { "number": "Infinity" } } } }
			},
			"expect": {}
		},
		{
			"op": "put",
			"part": "value",
			"id": "H",
			"value": { "/": { "live": { "name": "Function", "method": 1e300 } } },
			"expect": {}
		},
		{
			"op": "put",
			"part": "value",
			"id": "E",
			"value": { "/": { "live": { "name": "Function", "method": 1.8446744073709552e19 } } },
			"expect": {}
		},
		{
			"op": "put",
			"part": "value",
			"id": "F",
			"value": { "/": { "live": { "name": "Function", "method": 0.5 } } },
			"expect": {}
		},
		{
			"op": "put",
			"part": "value",
			"id": "P",
			"value": { "/": { "live": { "name": "Function", "method": 1 } } },
			"expect": {}
		},
		{
			"op": "start",
			"name": "p",
			"at": ["w", "p"],
			"program": [{ "do": ["method", "./real", [{ "do": ["log", "called", "$0"] }]] }],
			"expect": { "id": "proc:p" }
		},
		{ "op": "do", "process": "p", "call": ["send", "./real", "yes"], "expect": {} },
		{
			"op": "do",
			"process": "p",
			"call": ["send", "./less", "less"],
			"fails": true,
			"expect": { "error": "not-a-method" }
		},
		{
			"op": "do",
			"process": "p",
			"call": ["send", "./nan", "nan"],
			"fails": true,
			"expect": { "error": "not-a-method" }
		},
		{
			"op": "do",
			"process": "p",
			"call": ["send", "./inf", "inf"],
			"fails": true,
			"expect": { "error": "not-a-method" }
		},
		{
			"op": "do",
			"process": "p",
			"call": ["send", "./huge", "huge"],
			"fails": true,
			"expect": { "error": "not-a-method" }
		},
		{
			"op": "do",
			"process": "p",
			"call": ["send", "./edge", "edge"],
			"fails": true,
			"expect": { "error": "not-a-method" }
		},
		{
			"op": "do",
			"process": "p",
			"call": ["send", "./half", "half"],
			"fails": true,
			"expect": { "error": "not-a-method" }
		},
		{
			"op": "do",
			"process": "p",
			"call": ["send", "./past", "past"],
			"fails": true,
			"expect": { "error": "not-a-method" }
		},
		{ "op": "log", "name": "called", "expect": { "values": ["yes"] } }
	]
}
