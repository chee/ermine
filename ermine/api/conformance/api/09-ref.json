{
	"title": "ref: the node at a name, its value made only when nothing is there",
	"steps": [
		{
			"op": "kids",
			"id": "R",
			"value": {
				"w": "W"
			},
			"expect": {}
		},
		{
			"op": "start",
			"name": "p",
			"at": [
				"w",
				"p"
			],
			"program": [
				{
					"do": [
						"ref",
						"audio",
						{
							"live": 1
						}
					],
					"as": "r"
				},
				{
					"do": [
						"ref",
						"audio",
						{
							"live": 2
						}
					],
					"as": "again"
				}
			],
			"expect": {
				"id": "proc:p"
			}
		},
		{
			"op": "do",
			"process": "p",
			"call": [
				"read",
				"$r"
			],
			"expect": {
				"value": {
					"live": 1
				}
			}
		},
		{
			"op": "do",
			"process": "p",
			"call": [
				"read",
				"$again"
			],
			"expect": {
				"value": {
					"live": 1
				}
			}
		},
		{
			"op": "id",
			"path": [
				"w",
				"p",
				"audio"
			],
			"expect": {
				"id": "n1"
			}
		}
	]
}
