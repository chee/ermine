{
	"title": "method and send: a method is a node holding a function; send calls it in a scope under the one it was made in, the caller's id a pair on its writes, its return given back; a node holding no function: not-a-method",
	"steps": [
		{
			"op": "kids",
			"id": "R",
			"value": {
				"w": "W"
			},
			"expect": {}
		},
		{
			"op": "start",
			"name": "g",
			"at": [
				"w",
				"g"
			],
			"program": [
				{
					"do": [
						"open",
						"./last",
						"nobody"
					],
					"as": "last"
				},
				{
					"do": [
						"method",
						"on/greet",
						[
							{
								"do": [
									"edit",
									"$last",
									[
										{
											"path": [],
											"value": "$0"
										}
									]
								]
							}
						],
						[
							"read",
							"$last"
						]
					]
				}
			],
			"expect": {
				"id": "proc:g"
			}
		},
		{
			"op": "start",
			"name": "c",
			"at": [
				"w",
				"c"
			],
			"program": [],
			"expect": {
				"id": "proc:c"
			}
		},
		{
			"op": "do",
			"process": "c",
			"call": [
				"send",
				"./g/on/greet",
				"frog"
			],
			"expect": {
				"value": "frog"
			}
		},
		{
			"op": "do",
			"process": "c",
			"call": [
				"read",
				"./last"
			],
			"expect": {
				"value": "frog"
			}
		},
		{
			"op": "change",
			"part": "value",
			"id": "n1",
			"expect": {
				"actor": "test",
				"process": [
					"w",
					"g"
				],
				"caller": "proc:c"
			}
		},
		{
			"op": "do",
			"process": "c",
			"call": [
				"send",
				"./last"
			],
			"fails": true,
			"expect": {
				"error": "not-a-method"
			}
		},
		{
			"op": "do",
			"process": "c",
			"call": [
				"send",
				"./nobody/on/greet"
			],
			"fails": true,
			"expect": {
				"error": "not-a-method"
			}
		}
	]
}
