{
	"title": "records read in a loop end looping, as the scheduler sees any loop (a record's writer is its computer): one reading its own, two reading each other's; a reader of another's record is no loop, and reruns as that record changes",
	"steps": [
		{ "op": "runs", "expect": {} },
		{ "op": "value", "id": "a", "value": { "x": 0 }, "expect": {} },
		{ "op": "root", "name": "o", "info": { "actor": "o" }, "expect": {} },
		{
			"op": "watch",
			"name": "self",
			"scope": "o",
			"f": { "do": [{ "read": ["value", "a", ["x"]] }, { "run": ["S", "n"] }] },
			"expect": {}
		},
		{
			"op": "watch",
			"name": "p",
			"scope": "o",
			"f": { "do": [{ "read": ["value", "a", ["x"]] }, { "run": ["Q", "n"] }] },
			"expect": {}
		},
		{ "op": "watch", "name": "q", "scope": "o", "f": { "run": ["P", "n"] }, "expect": {} },
		{
			"op": "watch",
			"name": "plain",
			"scope": "o",
			"f": { "read": ["value", "a", ["x"]] },
			"expect": {}
		},
		{ "op": "watch", "name": "looker", "scope": "o", "f": { "run": ["L", "n"] }, "expect": {} },
		{ "op": "giveRun", "name": "self", "id": "S", "expect": {} },
		{ "op": "giveRun", "name": "p", "id": "P", "expect": {} },
		{ "op": "giveRun", "name": "q", "id": "Q", "expect": {} },
		{ "op": "giveRun", "name": "plain", "id": "L", "expect": {} },
		{ "op": "pulse", "expect": {} },
		{
			"op": "runOf",
			"id": "S",
			"expect": {
				"run": {
					"n": 2,
					"end": "looping",
					"error": "looping",
					"timed": true,
					"reads": [{ "part": "value", "id": "a", "path": ["x"], "actor": "test" }, null],
					"writes": []
				}
			}
		},
		{
			"op": "runOf",
			"id": "L",
			"expect": {
				"run": {
					"n": 1,
					"end": "done",
					"timed": true,
					"reads": [{ "part": "value", "id": "a", "path": ["x"], "actor": "test" }],
					"writes": []
				}
			}
		},
		{ "op": "state", "name": "looker", "expect": { "runs": 1, "value": 1 } },
		{
			"op": "edit",
			"part": "value",
			"id": "a",
			"patches": [{ "path": ["x"], "value": 1 }],
			"expect": {}
		},
		{ "op": "pulse", "expect": {} },
		{ "op": "state", "name": "looker", "expect": { "runs": 2, "value": 2 } },
		{ "op": "state", "name": "plain", "expect": { "runs": 2, "value": 1 } }
	]
}
