{
	"title": "a commit carries any value: as actor, in metadata, in a patch",
	"steps": [
		{
			"op": "encode",
			"commit": {
				"table": "value",
				"actor": { "name": "juno", "n": [1, -1, 1.5, -0] },
				"time": 1760000000,
				"signer": "1111111111111111111111111111111111111111111111111111111111111111",
				"nonce": 1,
				"parents": ["2222222222222222222222222222222222222222222222222222222222222222"],
				"lamport": 2,
				"patches": [
					{ "path": ["n"], "value": { "/": { "number": "Infinity" } } },
					{ "path": ["x"], "value": null },
					{ "path": ["y"], "value": true }
				],
				"metadata": [
					["bytes", { "/": { "bytes": "AQID" } }],
					["typed", { "/": { "float32": [1.5, "NaN"] } }],
					["live", { "/": { "live": "socket" } }]
				]
			},
			"expect": {
				"bytes": "",
				"name": "792e8f7a5827245620a031defcfd5d636c47ab3cea74ebb6bb45ab10616cdb7e"
			}
		},
		{
			"op": "encode",
			"commit": {
				"table": "value",
				"actor": null,
				"time": 1760000000,
				"signer": "1111111111111111111111111111111111111111111111111111111111111111",
				"nonce": 1,
				"parents": ["2222222222222222222222222222222222222222222222222222222222222222"],
				"lamport": 2,
				"patches": [{ "path": ["title"], "value": "hi" }]
			},
			"expect": {
				"bytes": "",
				"name": "4a5a9d4992d010deca60d27730c4db2f56d6588022075ef21b8fbc042b29cff1"
			}
		},
		{
			"op": "encode",
			"commit": {
				"table": "value",
				"actor": ["a", 1],
				"time": 1760000000,
				"signer": "1111111111111111111111111111111111111111111111111111111111111111",
				"nonce": 1,
				"parents": ["2222222222222222222222222222222222222222222222222222222222222222"],
				"lamport": 2,
				"patches": [{ "path": ["title"], "value": "hi" }]
			},
			"expect": {
				"bytes": "",
				"name": "63c531ba9968349826ed7eeac162b4bef228833351ec2cd7e76c36fc69763c41"
			}
		},
		{
			"op": "encode",
			"commit": {
				"table": "value",
				"actor": { "/": { "bytes": "q83v" } },
				"time": 1760000000,
				"signer": "1111111111111111111111111111111111111111111111111111111111111111",
				"nonce": 1,
				"parents": ["2222222222222222222222222222222222222222222222222222222222222222"],
				"lamport": 2,
				"patches": [{ "path": ["title"], "value": "hi" }]
			},
			"expect": {
				"bytes": "",
				"name": "2802fa0d4c53b6a19cb27a5b5c1d972022864db556898646e1d1e455489ceb6a"
			}
		}
	]
}
