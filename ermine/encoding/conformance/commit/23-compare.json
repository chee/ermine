{
	"title": "names compare bytewise, unsigned; a name before one it begins",
	"steps": [
		{
			"op": "compare",
			"a": "2222222222222222222222222222222222222222222222222222222222222222",
			"b": "2222222222222222222222222222222222222222222222222222222222222222",
			"expect": { "order": 0 }
		},
		{
			"op": "compare",
			"a": "2222222222222222222222222222222222222222222222222222222222222222",
			"b": "3333333333333333333333333333333333333333333333333333333333333333",
			"expect": { "order": -1 }
		},
		{
			"op": "compare",
			"a": "3333333333333333333333333333333333333333333333333333333333333333",
			"b": "2222222222222222222222222222222222222222222222222222222222222222",
			"expect": { "order": 1 }
		},
		{ "op": "compare", "a": "7f", "b": "80", "expect": { "order": -1 } },
		{ "op": "compare", "a": "ff00", "b": "0fff", "expect": { "order": 1 } },
		{ "op": "compare", "a": "2222", "b": "222200", "expect": { "order": -1 } },
		{ "op": "compare", "a": "", "b": "00", "expect": { "order": -1 } },
		{ "op": "compare", "a": "", "b": "", "expect": { "order": 0 } }
	]
}
