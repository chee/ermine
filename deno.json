{
	"workspace": [
		"./changeable",
		"./crow",
		"./graph",
		"./protect",
		"./reactivity",
		"./places",
		"./encoding",
		"./ids",
		"./processes",
		"./system",
		"./bundling",
		"./experiments/tippet"
	],
	"tasks": {
		"test": "deno test --allow-run --allow-read --allow-env --allow-write --allow-net && deno task conformance",
		"conformance": "deno test --quiet --allow-run --allow-read --allow-env conformance/run.ts --",
		"perf": "deno run --quiet --allow-run --allow-read --allow-env conformance/perf.ts",
		"differ": "deno run --quiet --allow-run --allow-read --allow-write --allow-env conformance/differ.ts",
		"plants": "deno run --quiet --allow-run --allow-read --allow-write --allow-env conformance/plants/plants_run.ts",
		"check": "deno check .",
		"bench": "deno bench"
	},
	"imports": {
		"@std/assert": "jsr:@std/assert@^1",
		"@yowasp/clang": "npm:@yowasp/clang@22.0.0-git20542-10",
		"cbor-x": "npm:cbor-x@^1.6.6",
		"cbor-x/": "npm:/cbor-x@^1.6.6/"
	},
	"fmt": {
		"lineWidth": 100,
		"semiColons": false,
		"useTabs": true
	},
	"exclude": [
		"dist",
		"**/dist",
		"**/c",
		"**/target",
		".graveyard",
		"conformance/suites-aside",
		".claude",
		".agent-shell"
	]
}
