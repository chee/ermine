{
	"workspace": [
		"./core",
		"./filesystem/places",
		"./filesystem/protect",
		"./ermine/encoding",
		"./playground/encoding",
		"./ermine/processes",
		"./ermine/boxes",
		"./playground/compilers",
		"./ermine/types",
		"./ermine/ermine",
		"./ermine/system",
		"./playground/realms",
		"./playground/together",
		"./ermine/sites",
		"./ermine/ids",
		"./filesystem/clingy",
		"./playground/programs",
		"./extensions/patchy",
		"./playground/demo-world",
		"./playground/demos",
		"./playground/libraries/pack-indexeddb",
		"./extensions/pully",
		"./playground/tools/files",
		"./playground/installs",
		"./playground/sessions",
		"./playground/trust",
		"./experiments/software",
		"./experiments/tippet",
		"./experiments/sources"
	],
	"tasks": {
		"test": "deno test --allow-run --allow-read --allow-env && deno task conformance",
		"conformance": "deno test --quiet --allow-run --allow-read --allow-env conformance/run.ts --",
		"perf": "deno run --quiet --allow-run --allow-read --allow-env conformance/perf.ts",
		"differ": "deno run --quiet --allow-run --allow-read --allow-write --allow-env conformance/differ.ts",
		"plants": "deno run --quiet --allow-run --allow-read --allow-write --allow-env conformance/plants/plants_run.ts",
		"demo": "cd playground/demos && deno task dev",
		"check": "deno check .",
		"bench": "deno bench"
	},
	"imports": {
		"@std/assert": "jsr:@std/assert@^1",
		"@yowasp/clang": "npm:@yowasp/clang@22.0.0-git20542-10",
		"cbor-x": "npm:cbor-x@^1.6.6",
		"cbor-x/": "npm:/cbor-x@^1.6.6/"
	},
	"fmt": {
		"lineWidth": 100,
		"semiColons": false,
		"useTabs": true
	},
	"exclude": [
		"dist",
		"**/dist",
		"**/c",
		"**/target",
		".graveyard",
		"conformance/suites-aside",
		".claude",
		".agent-shell"
	],
	"test": {
		"exclude": [
			"experiments/software",
			"playground/demo-world",
			"playground/demos",
			"playground/devtools",
			"playground/programs",
			"playground/realms"
		]
	}
}
