{
	"workspace": [
		"./core/op",
		"./core/node",
		"./core/places",
		"./core/util",
		"./core/graph",
		"./core/scheduler",
		"./core/protect",
		"./ermine/encoding",
		"./ermine/programs",
		"./extensions/subduction",
		"./playground/files",
		"./playground/solid",
		"./playground/demos/console",
		"./playground/places-fresh"
	],
	"tasks": {
		"test": "deno test --allow-run --allow-read --allow-env",
		"check": "deno check .",
		"bench": "deno bench",
		"bundle": "deno run --allow-read --allow-write --allow-run playground/bundle/bundle.ts"
	},
	"imports": {
		"@std/assert": "jsr:@std/assert@^1",
		"cbor-x": "npm:cbor-x@^1.6.6",
		"cbor-x/": "npm:/cbor-x@^1.6.6/"
	},
	"fmt": {
		"lineWidth": 100,
		"semiColons": false,
		"useTabs": true
	},
	"exclude": [
		"dist",
		"**/dist",
		"**/c",
		"**/target",
		".graveyard",
		"playground/experimental_os",
		"conformance/suites-aside",
		".claude",
		".agent-shell"
	]
}
