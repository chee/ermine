{
	"workspace": [
		"./core/op",
		"./core/node",
		"./filesystem/places",
		"./core/util",
		"./core/table",
		"./core/unread",
		"./core/blake3",
		"./core/scheduler",
		"./filesystem/protect",
		"./ermine/encoding",
		"./ermine/processes",
		"./ermine/boxes",
		"./ermine/programs",
		"./ermine/types",
		"./ermine/api",
		"./ermine/realms",
		"./ermine/sites",
		"./ermine/clingy",
		"./extensions/subduction",
		"./extensions/sync",
		"./extensions/programs",
		"./extensions/presence",
		"./extensions/patch-nodes",
		"./playground/demo-world",
		"./playground/demos",
		"./playground/libraries/pack-indexeddb"
	],
	"tasks": {
		"test": "deno test --allow-run --allow-read --allow-env && deno task conformance",
		"conformance": "deno test --quiet --allow-run --allow-read --allow-env conformance/run.ts --",
		"perf": "deno run --quiet --allow-run --allow-read --allow-env conformance/perf.ts",
		"check": "deno check .",
		"bench": "deno bench"
	},
	"imports": {
		"@std/assert": "jsr:@std/assert@^1",
		"@yowasp/clang": "npm:@yowasp/clang@22.0.0-git20542-10",
		"cbor-x": "npm:cbor-x@^1.6.6",
		"cbor-x/": "npm:/cbor-x@^1.6.6/"
	},
	"fmt": {
		"lineWidth": 100,
		"semiColons": false,
		"useTabs": true
	},
	"exclude": [
		"dist",
		"**/dist",
		"**/c",
		"**/target",
		".graveyard",
		"conformance/suites-aside",
		".claude",
		".agent-shell"
	]
}
