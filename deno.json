{
	"workspace": [
		"./core/op",
		"./core/node",
		"./filesystem/places",
		"./core/util",
		"./core/table",
		"./core/unread",
		"./core/scheduler",
		"./filesystem/protect",
		"./ermine/encoding",
		"./ermine/processes",
		"./ermine/boxes",
		"./ermine/programs",
		"./ermine/types",
		"./ermine/api",
		"./ermine/realms",
		"./ermine/sites",
		"./ermine/clingy",
		"./playground/slaygrounds-world",
		"./playground/programs",
		"./extensions/subduction",
		"./extensions/sync",
		"./playground/files",
		"./playground/solid",
		"./playground/demos",
		"./playground/demos/console",
		"./playground/places-fresh",
		"./playground/pack-indexeddb",
		"./playground/presence",
		"./playground/patch-nodes"
	],
	"tasks": {
		"test": "deno test --allow-run --allow-read --allow-env && deno task conformance",
		"conformance": "deno test --quiet --allow-run --allow-read --allow-env conformance/run.ts --",
		"check": "deno check .",
		"bench": "deno bench",
		"bundle": "deno run --allow-read --allow-write --allow-run playground/bundle/bundle.ts"
	},
	"imports": {
		"@std/assert": "jsr:@std/assert@^1",
		"@yowasp/clang": "npm:@yowasp/clang@22.0.0-git20542-10",
		"cbor-x": "npm:cbor-x@^1.6.6",
		"cbor-x/": "npm:/cbor-x@^1.6.6/"
	},
	"fmt": {
		"lineWidth": 100,
		"semiColons": false,
		"useTabs": true
	},
	"exclude": [
		"dist",
		"**/dist",
		"**/c",
		"**/target",
		".graveyard",
		"playground/experimental_os",
		"conformance/suites-aside",
		".claude",
		".agent-shell"
	]
}
