{
	"workspace": [
		"./lib/changeable",
		"./lib/crow",
		"./lib/blake3",
		"./lib/ed25519",
		"./core/graph",
		"./core/protect",
		"./core/reactivity",
		"./core/places",
		"./core/encoding",
		"./runtime/processes",
		"./runtime/system",
		"./tooling/bundling",
		"./experiments/tippet"
	],
	"tasks": {
		"test": "deno test --allow-run --allow-read --allow-env --allow-write --allow-net && deno task conformance",
		"conformance": "deno test --quiet --allow-run --allow-read --allow-env meta/conformance/run.ts --",
		"perf": "deno run --quiet --allow-run --allow-read --allow-env meta/conformance/perf.ts",
		"differ": "deno run --quiet --allow-run --allow-read --allow-write --allow-env meta/conformance/differ.ts",
		"plants": "deno run --quiet --allow-run --allow-read --allow-write --allow-env meta/conformance/plants/plants_run.ts",
		"check": "deno check .",
		"bench": "deno bench",
		"changes": "deno run --quiet --frozen --allow-read --allow-write --allow-run=deno meta/changes/changes.ts"
	},
	"imports": {
		"@std/assert": "jsr:@std/assert@^1",
		"@std/semver": "jsr:@std/semver@^1",
		"@yowasp/clang": "npm:@yowasp/clang@22.0.0-git20542-10",
		"cbor-x": "npm:cbor-x@^1.6.6",
		"cbor-x/": "npm:/cbor-x@^1.6.6/"
	},
	"fmt": {
		"lineWidth": 100,
		"indentWidth": 3,
		"semiColons": false,
		"useTabs": true,
		"exclude": [
			".github",
			"lib/changeable/conformance/apply/02-keys.json",
			"lib/changeable/conformance/apply/05-lone-surrogates.json",
			"lib/changeable/conformance/apply/18-typing.json",
			"lib/changeable/conformance/apply/25-frozen-batches.json",
			"lib/changeable/conformance/invert/05-lone-surrogates.json",
			"lib/changeable/conformance/invert/16-back-and-forth.json",
			"lib/changeable/conformance/invert/19-frozen-batches.json",
			"lib/changeable/conformance/invert/21-moves-back-edges.json",
			"lib/changeable/conformance/squish/25-lone-surrogates.json",
			"lib/changeable/conformance/squish/33-fouled-places.json",
			"lib/changeable/conformance/squish/35-encode-values.json",
			"lib/changeable/conformance/squish/37-same-meaning.json",
			"lib/changeable/conformance/squish/41-whole-put-clears-fouling.json",
			"lib/changeable/conformance/squish/42-fouling-moves-with-its-place.json",
			"lib/changeable/conformance/update/29-lone-surrogates.json",
			"core/encoding/conformance/cbor/old.json",
			"core/encoding/conformance/cbor/vectors.json",
			"core/graph/conformance/node/14-value-edges.json",
			"core/graph/conformance/node/15-node-edges.json",
			"core/graph/conformance/table/20-odd-keys.json",
			"core/places/conformance/places/44-merged-names-lone-surrogates.json",
			"core/reactivity/conformance/paths/32-odd-keys.json",
			"core/reactivity/conformance/scheduler/101-keys-any-string.json",
			"core/reactivity/conformance/tracker/35-names.json"
		]
	},
	"exclude": [
		"dist",
		"**/dist",
		"**/c",
		"**/target",
		".graveyard",
		"meta/conformance/suites-aside",
		".claude",
		".agent-shell"
	]
}
