{
	"title": "a handle follows its place: the node at its path replaced, the handle reaches the new one; its path reaching nothing, nothing-there, naming the path from the root",
	"steps": [
		{
			"op": "ermine",
			"expect": {}
		},
		{
			"op": "code",
			"at": "/code/q",
			"program": [
				{
					"do": [
						"ensureNode",
						"./doc",
						1
					],
					"as": "doc"
				}
			],
			"expect": {}
		},
		{
			"op": "start",
			"name": "q",
			"at": "/code/q",
			"expect": {
				"id": "proc:q"
			}
		},
		{
			"op": "do",
			"process": "q",
			"call": [
				"read",
				"$doc"
			],
			"expect": {
				"value": 1
			}
		},
		{
			"op": "host",
			"call": [
				"unplace",
				"/code/doc"
			]
		},
		{
			"op": "host",
			"call": [
				"ensureNode",
				"/code/doc",
				2
			]
		},
		{
			"op": "do",
			"process": "q",
			"call": [
				"read",
				"$doc"
			],
			"expect": {
				"value": 2
			}
		},
		{
			"op": "host",
			"call": [
				"unplace",
				"/code/doc"
			]
		},
		{
			"op": "do",
			"process": "q",
			"call": [
				"patch",
				"$doc",
				[
					{
						"path": [],
						"value": 3
					}
				]
			],
			"expect": {
				"error": "nothing-there"
			}
		}
	]
}
