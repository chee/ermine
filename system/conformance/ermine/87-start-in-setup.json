{
	"title": "start(fn, at, options), in setup [chee 10-27: \"processes should be able to start and stop processes\"]: the process runs fn at at, belongs to the starter, and stops when the starter does (its teardowns told ended). it is told nothing of its parent: the changes it writes name its own node and process, nothing of the starter's. the result: { process: { at, folder }, stop, status }",
	"steps": [
		{
			"op": "ermine",
			"expect": {}
		},
		{
			"op": "code",
			"at": "/code/c",
			"program": [
				{
					"do": [
						"ensureNode",
						"/c-out",
						0
					],
					"as": "o"
				},
				{
					"do": [
						"patch",
						"$o",
						[
							{
								"path": [],
								"value": 1
							}
						]
					]
				},
				{
					"do": [
						"addTeardown",
						"child-down"
					]
				}
			],
			"expect": {}
		},
		{
			"op": "code",
			"at": "/code/p",
			"program": [
				{
					"do": [
						"start",
						"c",
						"/work/c",
						"/code/c"
					],
					"as": "started"
				}
			],
			"expect": {}
		},
		{
			"op": "start",
			"name": "p",
			"at": "/code/p",
			"expect": {
				"id": "proc:p"
			}
		},
		{
			"op": "status",
			"name": "c",
			"expect": {
				"status": {
					"state": "done"
				}
			}
		},
		{
			"op": "host",
			"call": [
				"read",
				"/c-out"
			],
			"expect": {
				"value": 1
			}
		},
		{
			"op": "id",
			"path": [
				"c-out"
			],
			"expect": {
				"id": "n5"
			}
		},
		{
			"op": "frame",
			"part": "value",
			"id": "n5",
			"expect": {
				"frame": [
					{
						"process": [
							"work",
							"c"
						]
					},
					{
						"process": [
							"work",
							"c"
						],
						"node": "proc:c"
					},
					{
						"process": [
							"code",
							"p"
						]
					},
					{
						"process": [
							"code",
							"p"
						],
						"node": "proc:p",
						"locations": [
							"program"
						]
					},
					{
						"processes": "start"
					},
					{
						"actor": "test",
						"node": "n1"
					}
				]
			}
		},
		{
			"op": "do",
			"process": "p",
			"call": [
				"log",
				"at",
				[
					"pick",
					"$started",
					[
						"process",
						"at"
					]
				]
			]
		},
		{
			"op": "log",
			"name": "at",
			"expect": {
				"values": [
					[
						"work",
						"c"
					]
				]
			}
		},
		{
			"op": "log",
			"name": "child-down",
			"expect": {
				"values": []
			}
		},
		{
			"op": "stop",
			"name": "p",
			"why": "bye",
			"expect": {}
		},
		{
			"op": "log",
			"name": "child-down",
			"expect": {
				"values": [
					"ended"
				]
			}
		},
		{
			"op": "host",
			"call": [
				"hasNode",
				"/work/c"
			],
			"expect": {
				"value": false
			}
		}
	]
