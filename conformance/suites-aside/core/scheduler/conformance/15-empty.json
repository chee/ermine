{
	"title": "empty: a chased span with all of it removed is kept empty, or gone",
	"start": { "items": ["a", "b", "c", "d"] },
	"steps": [
		{ "op": "read", "name": "keep", "path": ["items", [1, 3]], "chase": true, "empty": "keep" },
		{ "op": "read", "name": "gone", "path": ["items", [1, 3]], "chase": true, "empty": "gone" },
		{ "op": "read", "name": "default", "path": ["items", [1, 3]], "chase": true },
		{
			"op": "patch",
			"patch": { "path": ["items"], "range": [0, 4] },
			"expect": {
				"keep": ["value", "moved"],
				"gone": ["value", "gone"],
				"default": ["value", "moved"]
			}
		},
		{
			"op": "where",
			"name": "keep",
			"expect": { "path": ["items", [0, 0]], "value": [], "live": true }
		},
		{ "op": "where", "name": "gone", "expect": { "live": false } }
	]
}
