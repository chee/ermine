{
	"title": "a given site is kept, with or without outside",
	"steps": [
		{
			"op": "make",
			"node": "a",
			"header": { "time": 1, "actor": "chee", "site": { "file": "x.c", "line": 4 } },
			"expect": { "time": 1, "actor": "chee", "site": { "file": "x.c", "line": 4 }, "node": "a" }
		},
		{
			"op": "make",
			"node": "a",
			"outside": true,
			"header": {
				"time": 1,
				"actor": "chee",
				"site": { "file": "x.c", "line": 4, "column": 2, "function": "main" }
			},
			"expect": {
				"time": 1,
				"actor": "chee",
				"site": { "file": "x.c", "line": 4, "column": 2, "function": "main" },
				"node": "a"
			}
		}
	]
}
