{
	"title": "outside, no site given: the caller's site",
	"steps": [
		{
			"op": "make",
			"node": "a",
			"outside": true,
			"header": { "time": 1, "actor": "chee" },
			"expect": { "time": 1, "actor": "chee", "site": "captured", "node": "a" }
