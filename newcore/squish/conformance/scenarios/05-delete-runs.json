{
	"title": "deletes that touch are one delete",
	"steps": [
		{
			"op": "squish",
			"patches": [
				{ "path": ["t"], "range": [5, 6] },
				{ "path": ["t"], "range": [4, 5] },
				{ "path": ["t"], "range": [3, 4] }
			],
			"expect": { "patches": [{ "path": ["t"], "range": [3, 6] }] }
		},
		{
			"op": "squish",
			"patches": [
				{ "path": ["t"], "range": [5, 6] },
				{ "path": ["t"], "range": [5, 6] },
				{ "path": ["t"], "range": [5, 6] }
			],
			"expect": { "patches": [{ "path": ["t"], "range": [5, 8] }] }
		},
		{
			"op": "squish",
			"patches": [{ "path": ["t"], "range": [5, 7] }, { "path": ["t"], "range": [4, 6] }],
			"expect": { "patches": [{ "path": ["t"], "range": [4, 8] }] }
		},
		{
			"op": "squish",
			"patches": [{ "path": ["t"], "range": [5, 6] }, { "path": ["t"], "range": [3, 4] }],
			"expect": {
				"patches": [{ "path": ["t"], "range": [5, 6] }, { "path": ["t"], "range": [3, 4] }]
			}
		},
		{
			"op": "squish",
			"patches": [{ "path": ["t"], "range": [5, 6] }, { "path": ["t"], "range": [7, 8] }],
			"expect": {
				"patches": [{ "path": ["t"], "range": [5, 6] }, { "path": ["t"], "range": [7, 8] }]
			}
		}
	]
}
