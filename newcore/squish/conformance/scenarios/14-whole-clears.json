{
	"title": "a put or removal of the whole clears everything before it",
	"steps": [
		{
			"op": "squish",
			"patches": [
				{ "path": ["t"], "range": [0, 0], "value": "x" },
				{ "path": ["a"], "value": 1 },
				{ "path": [], "value": { "n": 1 } }
			],
			"expect": { "patches": [{ "path": [], "value": { "n": 1 } }] }
		},
		{
			"op": "squish",
			"patches": [
				{ "path": ["t"], "range": [0, 0], "move": { "path": ["t"], "range": [1, 2] } },
				{ "path": [], "value": 5 }
			],
			"expect": { "patches": [{ "path": [], "value": 5 }] }
		},
		{
			"op": "squish",
			"patches": [{ "path": [], "value": 1 }, { "path": ["t"], "range": [0, 0], "value": "x" }],
			"expect": {
				"patches": [
					{ "path": [], "value": 1 },
					{ "path": ["t"], "range": [0, 0], "value": "x" }
				]
			}
		},
		{
			"op": "squish",
			"patches": [{ "path": ["t"], "range": [0, 0], "value": "x" }, { "path": [] }],
			"expect": { "patches": [{ "path": [] }] }
		},
		{
			"op": "squish",
			"patches": [
				{ "path": [], "range": [0, 0], "value": "x" },
				{ "path": [], "range": [1, 1], "value": "y" }
			],
			"expect": { "patches": [{ "path": [], "range": [0, 0], "value": "xy" }] }
		},
		{
			"op": "squish",
			"patches": [{ "path": [], "range": [0, 0], "value": "ab" }, { "path": [], "value": "z" }],
			"expect": { "patches": [{ "path": [], "value": "z" }] }
		}
	]
}
