{ "title": "a chased span replaced whole holds what replaced it; an end inside a replacement goes by its edge", "start": { "items": ["a", "b", "c", "d", "e", "f"] }, "steps": [
  { "op": "read", "name": "s", "path": ["items", [2, 5]], "chase": true },
  { "op": "patch", "patch": { "path": ["items"], "range": [2, 5], "value": ["x", "y"] }, "expect": { "s": ["value", "moved"] } },
  { "op": "where", "name": "s", "expect": { "path": ["items", [2, 4]], "value": ["x", "y"], "live": true } },
  { "op": "patch", "patch": { "path": ["items"], "range": [1, 3], "value": ["p"] }, "expect": { "s": ["value", "moved"] } },
  { "op": "where", "name": "s", "expect": { "path": ["items", [2, 3]], "value": ["y"], "live": true } }
] }
