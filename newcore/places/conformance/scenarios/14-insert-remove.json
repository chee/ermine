{
	"title": "insert: an id in a list; remove: ids out; pop: versions dropped whole",
	"steps": [
		{
			"op": "graph",
			"root": "root",
			"nodes": [
				{
					"id": "root",
					"children": []
				}
			],
			"expect": {}
		},
		{
			"op": "insert",
			"id": "root",
			"name": "kids",
			"child": "a",
			"expect": {
				"change": {
					"time": 1,
					"actor": "me",
					"node": "root"
				}
			}
		},
		{
			"op": "insert",
			"id": "root",
			"name": "kids",
			"child": "b",
			"index": 0,
			"expect": {
				"change": {
					"time": 2,
					"actor": "me",
					"node": "root"
				}
			}
		},
