{
	"title": "place: any value, never read",
	"steps": [
		{ "op": "create", "layer": "a", "place": null, "expect": { "layer": "a", "place": null } },
		{ "op": "create", "layer": "a", "place": [], "expect": { "layer": "a", "place": [] } },
		{ "op": "create", "layer": "a", "place": false, "expect": { "layer": "a", "place": false } },
		{ "op": "create", "layer": "a", "place": "", "expect": { "layer": "a", "place": "" } },
		{
			"op": "create",
			"layer": "a",
			"place": [[{ "x": [] }]],
			"expect": { "layer": "a", "place": [[{ "x": [] }]] }
		}
	]
}
