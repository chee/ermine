{
	"title": "bytes: one whole value, never spliced; a patch into them is wrong-kind (MUTATE.tex)",
	"steps": [
		{
			"op": "start",
			"value": [
				{
					"content": {
						"b": {
							"/": {
								"bytes": "AQID"
							}
						}
					},
					"change": {
						"time": 0,
						"actor": "host"
					}
				}
			],
			"expect": {}
		},
		{
			"op": "mutate",
			"which": "value",
			"patches": [
				{
					"path": [
						"b"
					],
					"range": [
						3,
						3
					],
					"value": {
						"/": {
							"bytes": "BA"
						}
					}
				}
			],
			"expect": {
				"fail": "wrong-kind",
				"patch": 0
			}
		},
		{
			"op": "mutate",
			"which": "value",
			"patches": [
				{
					"path": [
						"b"
					],
					"range": [
						0,
						1
					]
				}
			],
			"expect": {
				"fail": "wrong-kind",
				"patch": 0
			}
		},
		{
			"op": "mutate",
			"which": "value",
			"patches": [
				{
					"path": [
						"b",
						0
					],
					"value": 9
				}
			],
			"expect": {
				"fail": "wrong-kind",
				"patch": 0
			}
		},
		{
			"op": "mutate",
			"which": "value",
			"patches": [
				{
					"path": [
						"b"
					],
					"value": {
						"/": {
							"bytes": "BwgJ"
						}
					}
				}
			],
			"expect": {
				"change": {
					"time": 1,
					"actor": "me",
					"node": "a"
				}
			}
		},
		{
			"op": "node",
			"expect": {
				"node": {
					"id": "a",
					"value": [
						{
							"content": {
								"b": {
									"/": {
										"bytes": "BwgJ"
									}
								}
							},
							"change": {
								"time": 1,
								"actor": "me",
								"node": "a"
							}
						}
					],
					"info": []
				}
			}
		}
	]
}
