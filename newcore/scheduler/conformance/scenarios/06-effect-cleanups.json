{
	"title": "an effect acts on a new value; cleanups before the next, newest first, and at the kill",
	"steps": [
		{
			"op": "create",
			"value": 1,
			"id": "a",
			"expect": {
				"ok": "a"
			}
		},
		{
			"op": "insert",
			"id": "root",
			"name": "a",
			"child": "a",
			"expect": {
				"ok": 2
			}
		},
		{
			"op": "start",
			"address": [],
			"name": "p",
			"program": {
				"compute": [
					{
						"do": "content",
						"address": [
							"a"
						],
						"var": "x"
					},
					{
						"do": "return",
						"value": {
							"$get": [
								{
									"$var": "x"
								},
								0,
								"versions",
								0,
								"content"
							]
						}
					}
				],
				"effect": [
					{
						"do": "log",
						"value": {
							"effect": {
								"$given": "value"
							},
							"previous": {
								"$given": "previous"
							}
						}
					},
					{
						"do": "cleanup",
						"steps": [
							{
								"do": "log",
								"value": {
									"first": {
										"$given": "killed"
									}
								}
							}
						]
					},
					{
						"do": "cleanup",
						"steps": [
							{
								"do": "log",
								"value": {
									"second": {
										"$given": "killed"
									}
								}
							}
						]
					}
				]
			},
			"expect": {
				"ok": "@3"
			}
		},
		{
			"op": "write",
			"address": [
				"a"
			],
			"patches": [
				{
					"path": [],
					"value": 1
				}
			],
			"expect": {
				"ok": 8
			}
		},
		{
			"op": "write",
			"address": [
				"a"
			],
			"patches": [
				{
					"path": [],
					"value": 2
				}
			],
			"expect": {
				"ok": 10
			}
		},
		{
			"op": "outro",
			"id": "@3",
			"expect": {
				"ok": null
			}
		},
		{
			"op": "log",
			"expect": {
				"ok": [
					{
						"effect": 1,
						"previous": null
					},
					{
						"second": false
					},
					{
						"first": false
					},
					{
						"effect": 2,
						"previous": 1
					},
					{
						"second": true
					},
					{
						"first": true
					}
				]
			}
		},
		{
			"op": "node",
			"id": "@3",
			"expect": {
				"ok": null
			}
		}
	]
}
