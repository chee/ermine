		},
		{
			"op": "events",
			"expect": {
				"ok": [
					{
						"marked": "p",
						"by": {
							"actor": "host",
							"time": 11,
							"node": "a",
							"which": [
								"children",
								"x"
							]
						}
					},
					{
						"marked": "q",
						"by": {
							"actor": "host",
							"time": 11,
							"node": "a",
							"which": [
								"children",
								"x"
							]
						}
					}
				]
			}
		},
		{
			"op": "node",
			"id": "a",
			"expect": {
				"ok": {
					"value": [],
					"info": {
						"title": [
							{
								"content": "t",
								"time": 5
							}
						]
					},
					"children": {
						"z": [
							{
								"content": [
