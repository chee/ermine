				]
			}
		},
		{
			"op": "events",
			"expect": {
				"ok": [
					{
						"marked": "p",
						"by": {
							"actor": "host",
							"time": 8,
							"node": "a",
							"which": [
								"children",
								"y"
							]
						}
					},
					{
						"marked": "p",
						"by": {
							"actor": "host",
							"time": 9,
							"node": "a",
							"which": [
								"children",
								"z"
							]
						}
					}
				]
			}
		},
		{
			"op": "bind",
			"as": "q",
			"track": "q",
			"expect": {}
		},
		{
			"op": "children",
			"as": "q",
			"address": [
				"a"
			],
			"name": "x",
