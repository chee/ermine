				{
					"path": [],
					"value": "t"
				}
			],
			"expect": {
				"ok": 5
			}
		},
		{
			"op": "events",
			"expect": {
				"ok": []
			}
		},
		{
			"op": "insert",
			"id": "a",
			"name": "x",
			"child": "c",
			"expect": {
				"ok": 6
			}
		},
		{
			"op": "events",
			"expect": {
				"ok": []
			}
		},
		{
			"op": "insert",
			"id": "a",
			"name": "y",
			"child": "c",
			"expect": {
				"ok": 7
			}
		},
		{
			"op": "events",
			"expect": {
				"ok": [
