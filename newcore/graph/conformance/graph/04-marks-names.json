{
	"title": "reading a node's names is marked by a new name, not by what a name holds or by info",
	"steps": [
		{
			"op": "insert",
			"id": "root",
			"name": "a",
			"child": "a",
			"expect": {
				"ok": 1
			}
		},
		{
			"op": "intro",
			"id": "a",
			"children": {
				"x": [
					"b"
				]
			},
			"expect": {
				"ok": 2
			}
		},
		{
			"op": "intro",
			"id": "b",
			"expect": {
				"ok": 3
			}
		},
		{
			"op": "intro",
			"id": "c",
			"expect": {
				"ok": 4
			}
		},
		{
			"op": "bind",
			"as": "p",
			"track": "p",
			"expect": {}
		},
		{
			"op": "children",
			"as": "p",
			"address": [
				"a"
			],
			"expect": {
				"ok": [
					"x"
				]
			}
		},
		{
			"op": "set",
			"address": [
				"a"
			],
			"name": "title",
