{
	"title": "loading: an id read while not loaded marks its readers when it comes, and when it goes",
	"steps": [
		{
			"op": "insert",
			"id": "root",
			"name": "a",
			"child": "a",
			"expect": {
				"ok": 1
			}
		},
		{
			"op": "bind",
			"as": "p",
			"track": "p",
			"expect": {}
		},
		{
			"op": "look",
			"as": "p",
			"address": [
				"a"
			],
			"expect": {
				"ok": [
					{
						"id": "a",
						"loaded": false
					}
				]
			}
		},
		{
			"op": "content",
			"as": "p",
			"address": [
				"a"
			],
			"expect": {
				"ok": [
					{
						"id": "a"
					}
				]
			}
		},
		{
			"op": "intro",
			"id": "a",
			"value": 1,
			"expect": {
				"ok": 2
			}
		},
		{
			"op": "events",
			"expect": {
				"ok": [
					{
						"marked": "p",
						"by": {
							"actor": "host",
							"time": 2,
							"node": "a",
							"which": "loaded"
						}
					}
				]
			}
		},
		{
			"op": "content",
			"as": "p",
			"address": [
				"a"
			],
			"expect": {
				"ok": [
					{
						"id": "a",
						"versions": [
							{
								"content": 1,
								"time": 0
							}
						]
					}
				]
			}
		},
		{
			"op": "write",
			"address": [
				"a"
			],
			"patches": [
				{
					"path": [],
					"value": 2
				}
			],
			"expect": {
				"ok": 3
			}
		},
		{
			"op": "events",
			"expect": {
				"ok": [
					{
						"marked": "p",
						"by": {
							"actor": "host",
							"time": 3,
							"node": "a",
							"which": "value"
						}
					}
				]
			}
		},
		{
			"op": "release",
			"id": "a",
			"expect": {
				"ok": 4
			}
		},
		{
			"op": "events",
			"expect": {
				"ok": [
					{
						"released": "a"
					},
					{
						"marked": "p",
						"by": {
							"actor": "host",
							"time": 4,
							"node": "a",
							"which": "loaded"
						}
					}
				]
			}
		},
		{
			"op": "node",
			"id": "a",
			"expect": {
				"ok": null
			}
		},
		{
			"op": "look",
			"address": [
				"a"
			],
			"expect": {
				"ok": [
					{
						"id": "a",
						"loaded": false
					}
				]
			}
		},
		{
			"op": "release",
			"id": "a",
			"expect": {
				"ok": 5
			}
		},
		{
			"op": "events",
			"expect": {
				"ok": []
			}
		},
		{
			"op": "intro",
			"id": "a",
			"value": 9,
			"actor": "loader",
			"expect": {
				"ok": 6
			}
		},
		{
			"op": "events",
			"expect": {
				"ok": [
					{
						"marked": "p",
						"by": {
							"actor": "loader",
							"time": 6,
							"node": "a",
							"which": "loaded"
						}
					}
				]
			}
		},
		{
			"op": "write",
			"address": [
				"a"
			],
			"patches": [
				{
					"path": [],
					"value": 10
				}
			],
			"expect": {
				"ok": 7
			}
		},
		{
			"op": "events",
			"expect": {
				"ok": [
					{
						"marked": "p",
						"by": {
							"actor": "host",
							"time": 7,
							"node": "a",
							"which": "value"
						}
					}
				]
			}
		}
	]
}
