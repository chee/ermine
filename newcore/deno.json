{
	"workspace": [
		"./encoding",
		"./files",
		"./graph",
		"./nodes",
		"./notify",
		"./opstreams",
		"./programs",
		"./protect",
		"./scheduler",
		"./solid",
		"./sync",
		"./trackgraph",
		"./demos/console"
	],
	"tasks": {
		"test": "deno test --allow-run --allow-read --allow-env",
		"check": "deno check .",
		"bench": "deno bench",
		"bundle": "deno run --allow-read --allow-write --allow-run bundle.ts"
	},
	"imports": {
		"@std/assert": "jsr:@std/assert@^1",
		"cbor-x": "npm:cbor-x@^1.6.6",
		"cbor-x/": "npm:/cbor-x@^1.6.6/"
	},
	"fmt": {
		"lineWidth": 100,
		"semiColons": false,
		"useTabs": true
	},
	"exclude": ["dist", "*/c"]
}
