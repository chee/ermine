{
	"title": "time or actor not given: left out, nothing checked",
	"steps": [
		{
			"op": "make",
			"node": "a",
			"header": { "actor": "chee" },
			"expect": { "actor": "chee", "node": "a" }
		},
		{
			"op": "make",
			"node": "a",
			"header": { "time": 0 },
			"expect": { "time": 0, "node": "a" }
		},
		{ "op": "make", "node": "a", "header": {}, "expect": { "node": "a" } }
	]
}
