{
	"title": "bumping a compiler's version compiles again: its identity is in the key. its other attributes written (its loader, say), or its function replaced with no bump: no run, nothing compiled. bumped: compiled with the function it holds now",
	"steps": [
		{ "op": "builds", "cache": "CACHE", "expect": {} },
		{ "op": "kids", "id": "R", "value": { "cache": "CACHE", "catclock.c": "CAT" }, "expect": {} },
		{ "op": "value", "id": "CAT", "value": "hi", "expect": {} },
		{ "op": "compiler", "id": "UP", "compiler": "upper", "expect": {} },
		{
			"op": "attrs",
			"id": "UP",
			"value": {
				"ermine.programs.compiler": { "name": "upper", "version": 1 },
				"ermine.programs.loader": "loaders/wasm"
			},
			"expect": {}
		},
		{ "op": "watch", "name": "b", "compilers": ["UP"], "node": "CAT", "expect": {} },
		{ "op": "pulse", "expect": {} },
		{ "op": "state", "name": "b", "expect": { "value": "HI" } },
		{ "op": "runs", "name": "b", "expect": { "runs": 2 } },
		{
			"op": "upsert",
			"part": "attributes",
			"id": "UP",
			"path": ["ermine.programs.loader"],
			"value": "loaders/js",
			"expect": {}
		},
		{ "op": "pulse", "expect": {} },
		{ "op": "compiler", "id": "UP", "compiler": "wrap", "expect": {} },
		{ "op": "pulse", "expect": {} },
		{ "op": "runs", "name": "b", "expect": { "runs": 2 } },
		{ "op": "calls", "expect": { "upper": 1, "wrap": 0, "slow": 0, "boom": 0, "live": 0 } },
		{
			"op": "upsert",
			"part": "attributes",
			"id": "UP",
			"path": ["ermine.programs.compiler", "version"],
			"value": 2,
			"expect": {}
		},
		{ "op": "pulse", "expect": {} },
		{ "op": "state", "name": "b", "expect": { "value": { "wasm": "hi" } } },
		{ "op": "runs", "name": "b", "expect": { "runs": 4 } },
		{ "op": "calls", "expect": { "upper": 1, "wrap": 1, "slow": 0, "boom": 0, "live": 0 } },
		{ "op": "cache", "skip": ["entries"], "expect": { "size": 2 } }
	]
}
