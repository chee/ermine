{
	"title": "a compile: upper on catclock.c's value \"hi\" gives \"HI\", pending until the first pulse. the result is a node in the cache folder at its key, hex of hash([identity, input]): with no ermine.programs.compiler, the identity is the compiler's id (UP); with one, its value",
	"steps": [
		{ "op": "builds", "cache": "CACHE", "expect": {} },
		{ "op": "kids", "id": "R", "value": { "cache": "CACHE", "catclock.c": "CAT" }, "expect": {} },
		{ "op": "value", "id": "CAT", "value": "hi", "expect": {} },
		{ "op": "compiler", "id": "UP", "compiler": "upper", "expect": {} },
		{ "op": "watch", "name": "a", "compilers": ["UP"], "node": "CAT", "expect": {} },
		{ "op": "state", "name": "a", "expect": { "value": "pending" } },
		{ "op": "pulse", "expect": {} },
		{ "op": "state", "name": "a", "expect": { "value": "HI" } },
		{ "op": "calls", "expect": { "upper": 1, "wrap": 0, "slow": 0, "boom": 0, "live": 0 } },
		{
			"op": "cache",
			"expect": {
				"size": 1,
				"entries": { "23722319b76c942d5964e47e121277db9ea377fefb66cecf7efd7f36b1364e23": "HI" }
			}
		},
		{
			"op": "attrs",
			"id": "U1",
			"value": { "ermine.programs.compiler": { "name": "upper", "version": "1" } },
			"expect": {}
		},
		{ "op": "compiler", "id": "U1", "compiler": "upper", "expect": {} },
		{ "op": "watch", "name": "b", "compilers": ["U1"], "input": "hi", "expect": {} },
		{ "op": "pulse", "expect": {} },
		{ "op": "state", "name": "b", "expect": { "value": "HI" } },
		{ "op": "calls", "expect": { "upper": 2, "wrap": 0, "slow": 0, "boom": 0, "live": 0 } },
		{
			"op": "cache",
			"expect": {
				"size": 2,
				"entries": {
					"23722319b76c942d5964e47e121277db9ea377fefb66cecf7efd7f36b1364e23": "HI",
					"e8a4d998995a0c3cca4ca54ce84d672895eb27afb5ff37c5d24d4552ef203192": "HI"
				}
			}
		}
	]
}
