{
	"title": "a run reading a compile reruns when the compiler's identity changes or the step lands, and on nothing else: the compiler's other attributes, its function, another name in the cache folder: no run. its identity: a run that misses, a run as it lands",
	"steps": [
		{ "op": "builds", "cache": "CACHE", "expect": {} },
		{ "op": "kids", "id": "R", "value": { "cache": "CACHE", "catclock.c": "CAT" }, "expect": {} },
		{ "op": "value", "id": "CAT", "value": "hi", "expect": {} },
		{ "op": "compiler", "id": "UP", "compiler": "upper", "expect": {} },
		{
			"op": "attrs",
			"id": "UP",
			"value": { "ermine.programs.compiler": { "name": "upper", "version": 1 } },
			"expect": {}
		},
		{ "op": "watch", "name": "b", "compilers": ["UP"], "input": "hi", "expect": {} },
		{ "op": "pulse", "expect": {} },
		{ "op": "runs", "name": "b", "expect": { "runs": 2 } },
		{
			"op": "upsert",
			"part": "attributes",
			"id": "UP",
			"path": ["color"],
			"value": "red",
			"expect": {}
		},
		{ "op": "pulse", "expect": {} },
		{ "op": "compiler", "id": "UP", "compiler": "upper", "expect": {} },
		{ "op": "pulse", "expect": {} },
		{ "op": "watch", "name": "c", "compilers": ["UP"], "input": "ho", "expect": {} },
		{ "op": "pulse", "expect": {} },
		{ "op": "state", "name": "c", "expect": { "value": "HO" } },
		{ "op": "runs", "name": "b", "expect": { "runs": 2 } },
		{
			"op": "upsert",
			"part": "attributes",
			"id": "UP",
			"path": ["ermine.programs.compiler", "version"],
			"value": 2,
			"expect": {}
		},
		{ "op": "pulse", "expect": {} },
		{ "op": "runs", "name": "b", "expect": { "runs": 4 } },
		{ "op": "state", "name": "b", "expect": { "value": "HI" } },
		{ "op": "calls", "expect": { "upper": 4, "wrap": 0, "slow": 0, "boom": 0, "live": 0 } }
	]
}
