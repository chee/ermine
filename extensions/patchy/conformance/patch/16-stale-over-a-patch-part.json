{
	"title": "a patch node over a patch entry is stale by that entry's change time, as over any part",
	"steps": [
		{ "op": "value", "id": "N", "value": { "title": "t" }, "time": 100, "expect": {} },
		{
			"op": "patch",
			"id": "P",
			"on": "N",
			"at": 100,
			"time": 50,
			"patches": [{ "path": ["title"], "value": "x" }],
			"expect": {}
		},
		{
			"op": "patch",
			"id": "Q",
			"on": "P",
			"part": "patch",
			"at": 1,
			"patches": [{ "path": ["at"], "value": 2 }],
			"expect": {}
		},
		{
			"op": "entries",
			"id": "P",
			"part": "patch",
			"path": ["at"],
			"expect": {
				"items": [{ "value": 2, "from": "Q", "stale": true }, { "value": 100, "from": "table" }]
			}
		}
	]
}
