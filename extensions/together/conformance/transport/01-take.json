{
	"title": "a device's own take: in both histories at once, passed again, never announced; sealed, stored and sent; announced where it arrives",
	"steps": [
		{
			"op": "device",
			"name": "a",
			"seed": "0101010101010101010101010101010101010101010101010101010101010101",
			"expect": { "key": "ed018a88e3dd7409f195fd52db2d3cba5d72ca6709bf1d94121bf3748801b40f6f5c" }
		},
		{
			"op": "device",
			"name": "b",
			"seed": "0202020202020202020202020202020202020202020202020202020202020202",
			"expect": { "key": "ed018139770ea87d175f56a35466c34c7ecccb8d8a91b4ee37a25df60f5b8fc9b394" }
		},
		{ "op": "follow", "device": "a", "expect": {} },
		{ "op": "follow", "device": "b", "expect": {} },
		{ "op": "connect", "a": "a", "b": "b", "expect": {} },
		{
			"op": "take",
			"device": "a",
			"name": "c1",
			"nonce": 1,
			"patches": [{ "path": [], "value": { "n": 1 } }],
			"expect": { "added": "taken" }
		},
		{ "op": "heads", "device": "a", "expect": { "heads": ["c1"] } },
		{ "op": "heads", "device": "a", "layer": "ephemeral", "expect": { "heads": ["c1"] } },
		{ "op": "take", "device": "a", "name": "c1", "expect": { "added": "passed" } },
		{ "op": "quiet", "expect": {} },
		{ "op": "arrived", "device": "a", "expect": { "arrived": [] } },
		{
			"op": "arrived",
			"device": "b",
			"expect": {
				"arrived": [
					[
						"ermine://2a2a2a2a2a2a2a2a2a2a2a2a2a2a2a2a00000000000000000000000000000000",
						"stored",
						"c1",
						false
					],
					[
						"ermine://2a2a2a2a2a2a2a2a2a2a2a2a2a2a2a2a00000000000000000000000000000000",
						"ephemeral",
						"c1",
						false
					]
				]
			}
		},
		{ "op": "heads", "device": "b", "expect": { "heads": ["c1"] } },
		{ "op": "heads", "device": "b", "layer": "ephemeral", "expect": { "heads": ["c1"] } },
		{ "op": "stored", "device": "a", "expect": { "stored": ["c1"] } },
		{ "op": "stored", "device": "b", "expect": { "stored": ["c1"] } }
	]
}
