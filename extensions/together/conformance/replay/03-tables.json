{
	"title": "each table its own: a commit changes its own table, and each table's change is the one that last touched it",
	"steps": [
		{
			"op": "add",
			"name": "a",
			"time": 1,
			"patches": [{ "path": [], "value": "body" }],
			"expect": { "added": "taken" }
		},
		{
			"op": "add",
			"name": "b",
			"parents": ["a"],
			"time": 2,
			"table": "attributes",
			"patches": [{ "path": [], "value": { "color": "cherry" } }],
			"expect": { "added": "taken" }
		},
		{
			"op": "add",
			"name": "c",
			"parents": ["b"],
			"time": 3,
			"table": "children",
			"patches": [
				{
					"path": [],
					"value": {
						"notes": "ermine://abababababababababababababababababababababababababababababababab"
					}
				}
			],
			"expect": { "added": "taken" }
		},
		{
			"op": "add",
			"name": "d",
			"parents": ["c"],
			"time": 4,
			"table": "attributes",
			"patches": [{ "path": ["color"], "value": "lemon" }],
			"expect": { "added": "taken" }
		},
		{
			"op": "replay",
			"commit": "b",
			"expect": {
				"tables": {
					"value": {
						"value": "body",
						"change": {
							"time": 1,
							"actor": null,
							"metadata": {
								"signer": "ed018a88e3dd7409f195fd52db2d3cba5d72ca6709bf1d94121bf3748801b40f6f5c",
								"commit": "1e209b837c39052163d324c9fcf620283555b12a3f81cd0a517b10837a7b6b42094a"
							}
						}
					},
					"attributes": {
						"value": { "color": "cherry" },
						"change": {
							"time": 2,
							"actor": null,
							"metadata": {
								"signer": "ed018a88e3dd7409f195fd52db2d3cba5d72ca6709bf1d94121bf3748801b40f6f5c",
								"commit": "1e20fadbb1e6979000a6b9aeb2f322821b37cb8d4da24b1e2adefff320cca23c1bb3"
							}
						}
					}
				}
			}
		},
		{
			"op": "replay",
			"commit": "d",
			"expect": {
				"tables": {
					"value": {
						"value": "body",
						"change": {
							"time": 1,
							"actor": null,
							"metadata": {
								"signer": "ed018a88e3dd7409f195fd52db2d3cba5d72ca6709bf1d94121bf3748801b40f6f5c",
								"commit": "1e209b837c39052163d324c9fcf620283555b12a3f81cd0a517b10837a7b6b42094a"
							}
						}
					},
					"attributes": {
						"value": { "color": "lemon" },
						"change": {
							"time": 4,
							"actor": null,
							"metadata": {
								"signer": "ed018a88e3dd7409f195fd52db2d3cba5d72ca6709bf1d94121bf3748801b40f6f5c",
								"commit": "1e206f018214907231432a7bce6695919548fc64eb635cb8526ac5f0e596eea21f42"
							}
						}
					},
					"children": {
						"value": {
							"notes": "ermine://abababababababababababababababababababababababababababababababab"
						},
						"change": {
							"time": 3,
							"actor": null,
							"metadata": {
								"signer": "ed018a88e3dd7409f195fd52db2d3cba5d72ca6709bf1d94121bf3748801b40f6f5c",
								"commit": "1e20b89cad7847eaeba6dcab1bf50edafcdef963c1a675f51fcacfdcf2cf026186d6"
							}
						}
					}
				}
			}
		}
	]
}
