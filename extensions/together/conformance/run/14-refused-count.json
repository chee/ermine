{
	"title": "n a whole number from 0",
	"steps": [
		{
			"op": "make",
			"name": "a",
			"time": 1760000000,
			"nonce": 1,
			"patches": [{ "path": [], "value": { "body": "" } }]
		},
		{
			"op": "make",
			"name": "b",
			"time": 1760000000,
			"nonce": 2,
			"parents": ["a"],
			"patches": [{ "path": ["body"], "range": [0, 0], "value": "h" }]
		},
		{
			"op": "make",
			"name": "c",
			"time": 1760000000,
			"nonce": 3,
			"parents": ["b"],
			"patches": [{ "path": ["body"], "range": [1, 1], "value": "i" }]
		},
		{ "op": "pack", "commits": ["a", "b", "c"], "name": "r" },
		{ "op": "unpack", "run": "r", "set": { "n": -1 }, "expect": { "error": "count" } },
		{ "op": "unpack", "run": "r", "set": { "n": 1.5 }, "expect": { "error": "count" } },
		{ "op": "unpack", "run": "r", "set": { "n": "3" }, "expect": { "error": "count" } },
		{ "op": "unpack", "run": "r", "drop": ["n"], "expect": { "error": "count" } },
		{
			"op": "unpack",
			"run": "r",
			"set": { "n": 9007199254740992 },
			"expect": { "error": "count" }
		}
	]
}
