{
	"title": "a column of runs: a list of [value, how many ≥ 1] making n values",
	"steps": [
		{
			"op": "make",
			"name": "a",
			"time": 1760000000,
			"nonce": 1,
			"patches": [{ "path": [], "value": { "body": "" } }]
		},
		{
			"op": "make",
			"name": "b",
			"time": 1760000000,
			"nonce": 2,
			"parents": ["a"],
			"patches": [{ "path": ["body"], "range": [0, 0], "value": "h" }]
		},
		{
			"op": "make",
			"name": "c",
			"time": 1760000000,
			"nonce": 3,
			"parents": ["b"],
			"patches": [{ "path": ["body"], "range": [1, 1], "value": "i" }]
		},
		{ "op": "pack", "commits": ["a", "b", "c"], "name": "r" },
		{
			"op": "unpack",
			"run": "r",
			"set": { "table": "value" },
			"expect": { "error": "runs", "column": "table" }
		},
		{
			"op": "unpack",
			"run": "r",
			"set": { "table": [["value", 3, 0]] },
			"expect": { "error": "runs", "column": "table" }
		},
		{
			"op": "unpack",
			"run": "r",
			"set": { "table": [["value", 0], ["value", 3]] },
			"expect": { "error": "runs", "column": "table" }
		},
		{
			"op": "unpack",
			"run": "r",
			"set": { "actor": [[null, 1.5], [null, 1.5]] },
			"expect": { "error": "runs", "column": "actor" }
		},
		{
			"op": "unpack",
			"run": "r",
			"set": { "reader": [[null, 2]] },
			"expect": { "error": "runs", "column": "reader" }
		},
		{
			"op": "unpack",
			"run": "r",
			"set": { "external": [[null, 4]] },
			"expect": { "error": "runs", "column": "external" }
		},
		{
			"op": "unpack",
			"run": "r",
			"set": { "metadata": [[null, 9007199254740991]] },
			"expect": { "error": "runs", "column": "metadata" }
		},
		{
			"op": "unpack",
			"run": "r",
			"drop": ["signer"],
			"expect": { "error": "runs", "column": "signer" }
		},
		{
			"op": "unpack",
			"run": "r",
			"set": { "base": [null] },
			"expect": { "error": "runs", "column": "base" }
		},
		{
			"op": "unpack",
			"run": "r",
			"set": { "table": [["", 1]], "actor": [] },
			"expect": { "error": "runs", "column": "table" }
		}
	]
}
