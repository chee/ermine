{
	"title": "presence is kept out of a save unless the side says so",
	"steps": [
		{
			"op": "keep",
			"dev": "a",
			"part": "presence",
			"expect": {
				"keep": false
			}
		},
		{
			"op": "keep",
			"dev": "a",
			"part": "children",
			"expect": {
				"keep": true
			}
		},
		{
			"op": "keep",
			"save": true,
			"part": "presence",
			"expect": {
				"keep": true
			}
		},
		{
			"op": "save",
			"dev": "a",
			"save": true
		},
		{
			"op": "keep",
			"dev": "a",
			"part": "presence",
			"expect": {
				"keep": true
			}
		},
		{
			"op": "keep",
			"dev": "b",
			"part": "presence",
			"expect": {
				"keep": false
			}
		}
	]
}
