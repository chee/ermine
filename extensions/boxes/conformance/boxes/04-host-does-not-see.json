{
	"title": "the host's own walk does not see a box's names: nothing put in a box is at that path from the host's root, nor listed there, and when the box is over a folder, the folder's children are as they were. a process started in the box is a row on the box's root, so the host does not list it either",
	"steps": [
		{
			"op": "ermine",
			"expect": {}
		},
		{
			"op": "host",
			"call": [
				"ensureNode",
				"/catclock/face",
				"face-value"
			]
		},
		{
			"op": "host",
			"call": [
				"ensureNode",
				"/store/loaders",
				"loaders-v1"
			]
		},
		{
			"op": "box",
			"name": "b",
			"at": "/catclock",
			"expect": {}
		},
		{
			"op": "boxput",
			"box": "b",
			"path": "loaders",
			"node": "/store/loaders",
			"expect": {}
		},
		{
			"op": "boxput",
			"box": "b",
			"path": "lib/loaders",
			"node": "/store/loaders",
			"expect": {}
		},
		{
			"op": "code",
			"at": "/code/p",
			"program": [],
			"expect": {}
		},
		{
			"op": "start",
			"name": "p",
			"at": "/clock",
			"program": "/code/p",
			"in": "b",
			"expect": {
				"id": "proc:p"
			}
		},
		{
			"op": "look",
			"path": "/loaders",
			"in": "b",
			"expect": {
				"there": true,
				"value": "loaders-v1"
			}
		},
		{
			"op": "look",
			"path": "/lib/loaders",
			"in": "b",
			"expect": {
				"there": true,
				"value": "loaders-v1"
			}
		},
		{
			"op": "look",
			"path": "/catclock/loaders",
			"expect": {
				"there": false
			}
		},
		{
			"op": "look",
			"path": "/catclock/lib/loaders",
			"expect": {
				"there": false
			}
		},
		{
			"op": "look",
			"path": "/loaders",
			"expect": {
				"there": false
			}
		},
		{
			"op": "look",
			"path": "/clock",
			"expect": {
				"there": false
			}
		},
		{
			"op": "look",
			"path": "/catclock/clock",
			"expect": {
				"there": false
			}
		},
		{
			"op": "names",
			"path": "/catclock",
			"expect": {
				"names": [
					"face"
				]
			}
		},
		{
			"op": "names",
			"path": "/",
			"expect": {
				"names": [
					"catclock",
					"code",
					"store"
				]
			}
		},
		{
			"op": "names",
			"path": "/",
			"expect": {
				"names": [
					"clock",
					"face",
					"lib",
					"loaders"
				]
			},
			"in": "b"
		},
		{
			"op": "host",
			"call": [
				"hasNode",
				"/catclock/loaders"
			],
			"expect": {
				"value": false
			}
		},
		{
			"op": "host",
			"call": [
				"list",
				"/catclock"
			],
			"expect": {
				"value": [
					"face"
				]
			}
		}
	]
}
