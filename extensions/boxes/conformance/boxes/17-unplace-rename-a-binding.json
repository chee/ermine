{
	"title": "unplace and rename at a path a binding gives (not a running process) are nothing-there for a process in the box: the binding is not the process's to take out, and the saved child of the folder it shadows is left as it is (not unplaced, not moved); the binding stays. once the host takes the binding, the saved child shows again",
	"steps": [
		{
			"op": "ermine",
			"expect": {}
		},
		{
			"op": "host",
			"call": [
				"ensureNode",
				"/catclock/face",
				"face-value"
			],
			"expect": {
				"value": {
					"path": [
						"catclock",
						"face"
					],
					"part": "value"
				}
			}
		},
		{
			"op": "host",
			"call": [
				"ensureNode",
				"/store/loaders",
				"loaders-v1"
			],
			"expect": {
				"value": {
					"path": [
						"store",
						"loaders"
					],
					"part": "value"
				}
			}
		},
		{
			"op": "box",
			"name": "b",
			"at": "/catclock",
			"expect": {}
		},
		{
			"op": "boxput",
			"box": "b",
			"path": "loaders",
			"node": "/store/loaders",
			"expect": {}
		},
		{
			"op": "host",
			"call": [
				"ensureNode",
				"/catclock/loaders",
				"hidden-saved"
			],
			"expect": {
				"value": {
					"path": [
						"catclock",
						"loaders"
					],
					"part": "value"
				}
			}
		},
		{
			"op": "look",
			"in": "b",
			"path": "/loaders",
			"expect": {
				"there": true,
				"value": "loaders-v1"
			}
		},
		{
			"op": "code",
			"at": "/code/u",
			"program": [
				{
					"do": [
						"caught",
						"err",
						[
							{
								"do": [
									"unplace",
									"/loaders"
								]
							}
						]
					]
				},
				{
					"do": [
						"log",
						"unplaced",
						[
							"hasNode",
							"/loaders"
						]
					]
				}
			],
			"expect": {}
		},
		{
			"op": "code",
			"at": "/code/r",
			"program": [
				{
					"do": [
						"caught",
						"err",
						[
							{
								"do": [
									"rename",
									"/loaders",
									"/moved"
								]
							}
						]
					]
				},
				{
					"do": [
						"log",
						"renamed",
						[
							"hasNode",
							"/moved"
						]
					]
				},
				{
					"do": [
						"log",
						"renamed",
						[
							"hasNode",
							"/loaders"
						]
					]
				}
			],
			"expect": {}
		},
		{
			"op": "start",
			"name": "u",
			"at": "/u",
			"program": "/code/u",
			"in": "b",
			"expect": {
				"id": "proc:u"
			}
		},
		{
			"op": "log",
			"name": "unplaced",
			"expect": {
				"values": [
					true
				]
			}
		},
		{
			"op": "start",
			"name": "r",
			"at": "/r",
			"program": "/code/r",
			"in": "b",
			"expect": {
				"id": "proc:r"
			}
		},
		{
			"op": "log",
			"name": "renamed",
			"expect": {
				"values": [
					false,
					true
				]
			}
		},
		{
			"op": "look",
			"in": "b",
			"path": "/loaders",
			"expect": {
				"there": true,
				"value": "loaders-v1"
			}
		},
		{
			"op": "look",
			"in": "b",
			"path": "/moved",
			"expect": {
				"there": false
			}
		},
		{
			"op": "look",
			"path": "/catclock/loaders",
			"expect": {
				"there": true,
				"value": "hidden-saved"
			}
		},
		{
			"op": "look",
			"path": "/catclock/moved",
			"expect": {
				"there": false
			}
		},
		{
			"op": "look",
			"path": "/store/loaders",
			"expect": {
				"there": true,
				"value": "loaders-v1"
			}
		},
		{
			"op": "boxtake",
			"box": "b",
			"path": "loaders",
			"expect": {}
		},
		{
			"op": "look",
			"in": "b",
			"path": "/loaders",
			"expect": {
				"there": true,
				"value": "hidden-saved"
			}
		}
	]
}
