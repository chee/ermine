{
	"title": "put under a saved child, or under a running process, is fine (the header's rule: a binding above or under, or anything the box sees at the path, is already-there); the binding is seen beside what is saved or running there",
	"steps": [
		{
			"op": "ermine",
			"expect": {}
		},
		{
			"op": "host",
			"call": [
				"ensureNode",
				"/catclock/face",
				"face-value"
			],
			"expect": {
				"value": {
					"path": [
						"catclock",
						"face"
					],
					"part": "value"
				}
			}
		},
		{
			"op": "host",
			"call": [
				"ensureNode",
				"/store/loaders",
				"loaders-v1"
			],
			"expect": {
				"value": {
					"path": [
						"store",
						"loaders"
					],
					"part": "value"
				}
			}
		},
		{
			"op": "box",
			"name": "b",
			"at": "/catclock",
			"expect": {}
		},
		{
			"op": "boxput",
			"box": "b",
			"path": "face/sub",
			"node": "/store/loaders",
			"expect": {}
		},
		{
			"op": "look",
			"in": "b",
			"path": "/face",
			"expect": {
				"there": true,
				"value": "face-value"
			}
		},
		{
			"op": "look",
			"in": "b",
			"path": "/face/sub",
			"expect": {
				"there": true,
				"value": "loaders-v1"
			}
		},
		{
			"op": "names",
			"in": "b",
			"path": "/",
			"expect": {
				"names": [
					"face"
				]
			}
		},
		{
			"op": "names",
			"in": "b",
			"path": "/face",
			"expect": {
				"names": [
					"sub"
				]
			}
		},
		{
			"op": "boxstart",
			"box": "b",
			"name": "c",
			"at": "/clock",
			"expect": {}
		},
		{
			"op": "boxput",
			"box": "b",
			"path": "clock/x",
			"node": "/store/loaders",
			"expect": {}
		},
		{
			"op": "look",
			"in": "b",
			"path": "/clock",
			"expect": {
				"there": true
			}
		},
		{
			"op": "look",
			"in": "b",
			"path": "/clock/x",
			"expect": {
				"there": true,
				"value": "loaders-v1"
			}
		}
	]
}
