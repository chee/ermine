{
	"title": "a handle in an action's args or result is shown to a reader in a box as the path the box sees (the box's folder is its \"/\"), not as none: C walks up and resolves in the box's own places, as the TypeScript does",
	"steps": [
		{
			"op": "ermine",
			"expect": {}
		},
		{
			"op": "host",
			"call": [
				"ensureNode",
				"/catclock/face",
				"face-value"
			],
			"expect": {
				"value": {
					"path": [
						"catclock",
						"face"
					],
					"part": "value"
				}
			}
		},
		{
			"op": "box",
			"name": "b",
			"at": "/catclock",
			"expect": {}
		},
		{
			"op": "code",
			"at": "/code/p",
			"program": [
				{
					"do": [
						"getNode",
						"/face"
					],
					"as": "f"
				},
				{
					"do": [
						"createAction",
						"/act",
						[
							{
								"do": [
									"ensureNode",
									"/out",
									"x"
								]
							}
						],
						"$0"
					]
				},
				{
					"do": [
						"executeAction",
						"/act",
						"$f"
					]
				},
				{
					"do": [
						"log",
						"args",
						[
							"explainargs",
							"/out"
						]
					]
				},
				{
					"do": [
						"log",
						"args",
						[
							"explain",
							"/out"
						]
					]
				},
				{
					"do": [
						"log",
						"args",
						[
							"explain",
							"/face"
						]
					]
				}
			],
			"expect": {}
		},
		{
			"op": "start",
			"name": "p",
			"at": "/p",
			"program": "/code/p",
			"in": "b",
			"expect": {
				"id": "proc:p"
			}
		},
		{
			"op": "log",
			"name": "args",
			"expect": {
				"values": [
					{
						"args": [
							[
								"face"
							]
						],
						"returned": [
							"face"
						]
					},
					{
						"writer": "method",
						"path": [
							"act"
						],
						"n": 1
					},
					{
						"writer": "outside",
						"site": "program"
					}
				]
			}
		}
	]
}
