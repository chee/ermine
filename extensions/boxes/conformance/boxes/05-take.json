{
	"title": "take removes what put put, and only that: the box no longer sees it, a reader running in the box is told, the node itself and the host's graph are untouched. take of a path with no binding is nothing-there (a saved child of the folder is not a binding: it stays); a path can be put again after",
	"steps": [
		{
			"op": "ermine",
			"expect": {}
		},
		{
			"op": "host",
			"call": [
				"ensureNode",
				"/catclock/face",
				"face-value"
			]
		},
		{
			"op": "host",
			"call": [
				"ensureNode",
				"/store/loaders",
				"loaders-v1"
			]
		},
		{
			"op": "box",
			"name": "b",
			"at": "/catclock",
			"expect": {}
		},
		{
			"op": "boxput",
			"box": "b",
			"path": "loaders",
			"node": "/store/loaders",
			"expect": {}
		},
		{
			"op": "code",
			"at": "/code/p",
			"program": [
				{
					"do": [
						"createEffect",
						"watch",
						[
							"hasNode",
							"/loaders"
						],
						"watched"
					]
				}
			],
			"expect": {}
		},
		{
			"op": "start",
			"name": "p",
			"at": "/p",
			"program": "/code/p",
			"in": "b",
			"expect": {
				"id": "proc:p"
			}
		},
		{
			"op": "pulse",
			"expect": {}
		},
		{
			"op": "log",
			"name": "watched",
			"expect": {
				"values": [
					true
				]
			}
		},
		{
			"op": "boxtake",
			"box": "b",
			"path": "loaders",
			"expect": {}
		},
		{
			"op": "pulse",
			"expect": {}
		},
		{
			"op": "log",
			"name": "watched",
			"expect": {
				"values": [
					true,
					false
				]
			}
		},
		{
			"op": "look",
			"path": "/loaders",
			"in": "b",
			"expect": {
				"there": false
			}
		},
		{
			"op": "look",
			"path": "/store/loaders",
			"expect": {
				"there": true,
				"value": "loaders-v1"
			}
		},
		{
			"op": "boxtake",
			"box": "b",
			"path": "loaders",
			"expect": {
				"error": "nothing-there"
			}
		},
		{
			"op": "boxtake",
			"box": "b",
			"path": "face",
			"expect": {
				"error": "nothing-there"
			}
		},
		{
			"op": "look",
			"path": "/face",
			"in": "b",
			"expect": {
				"there": true,
				"value": "face-value"
			}
		},
		{
			"op": "look",
			"path": "/catclock/face",
			"expect": {
				"there": true,
				"value": "face-value"
			}
		},
		{
			"op": "boxtake",
			"box": "b",
			"path": "nothing/at/all",
			"expect": {
				"error": "nothing-there"
			}
		},
		{
			"op": "boxput",
			"box": "b",
			"path": "loaders",
			"node": "/store/loaders",
			"expect": {}
		},
		{
			"op": "pulse",
			"expect": {}
		},
		{
			"op": "log",
			"name": "watched",
			"expect": {
				"values": [
					true,
					false,
					true
				]
			}
		},
		{
			"op": "look",
			"path": "/loaders",
			"in": "b",
			"expect": {
				"there": true,
				"value": "loaders-v1"
			}
		}
	]
}
