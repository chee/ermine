{
	"title": "a process started in a box over an existing folder sees the folder as \"/\": what is in it by its short names, nothing above it (the folder's own path, a sibling of the folder). the host sees all of it from its own root; the box's places, asked from outside, show the same as the process does",
	"steps": [
		{
			"op": "ermine",
			"expect": {}
		},
		{
			"op": "host",
			"call": [
				"ensureNode",
				"/catclock/face",
				"face-value"
			]
		},
		{
			"op": "host",
			"call": [
				"ensureNode",
				"/outside",
				"out-value"
			]
		},
		{
			"op": "box",
			"name": "b",
			"at": "/catclock",
			"expect": {}
		},
		{
			"op": "code",
			"at": "/code/p",
			"program": [
				{
					"do": [
						"log",
						"seen",
						[
							"hasNode",
							"/face"
						]
					]
				},
				{
					"do": [
						"log",
						"face",
						[
							"read",
							"/face"
						]
					]
				},
				{
					"do": [
						"log",
						"folder",
						[
							"hasNode",
							"/catclock"
						]
					]
				},
				{
					"do": [
						"log",
						"outside",
						[
							"hasNode",
							"/outside"
						]
					]
				},
				{
					"do": [
						"log",
						"sibling",
						[
							"hasNode",
							"../outside"
						]
					]
				}
			],
			"expect": {}
		},
		{
			"op": "start",
			"name": "p",
			"at": "/p",
			"program": "/code/p",
			"in": "b",
			"expect": {
				"id": "proc:p"
			}
		},
		{
			"op": "log",
			"name": "seen",
			"expect": {
				"values": [
					true
				]
			}
		},
		{
			"op": "log",
			"name": "face",
			"expect": {
				"values": [
					"face-value"
				]
			}
		},
		{
			"op": "log",
			"name": "folder",
			"expect": {
				"values": [
					false
				]
			}
		},
		{
			"op": "log",
			"name": "outside",
			"expect": {
				"values": [
					false
				]
			}
		},
		{
			"op": "log",
			"name": "sibling",
			"expect": {
				"values": [
					false
				]
			}
		},
		{
			"op": "look",
			"path": "/face",
			"in": "b",
			"expect": {
				"there": true,
				"value": "face-value"
			}
		},
		{
			"op": "look",
			"path": "/outside",
			"in": "b",
			"expect": {
				"there": false
			}
		},
		{
			"op": "look",
			"path": "/catclock/face",
			"expect": {
				"there": true,
				"value": "face-value"
			}
		},
		{
			"op": "look",
			"path": "/outside",
			"expect": {
				"there": true,
				"value": "out-value"
			}
		},
		{
			"op": "look",
			"path": "/catclock",
			"in": "b",
			"expect": {
				"there": false
			}
		}
	]
}
