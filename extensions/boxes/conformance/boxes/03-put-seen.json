						[
							"hasNode",
							"/lib/loaders"
						],
						"watched"
					]
				},
				{
					"do": [
						"log",
						"early",
						[
							"hasNode",
							"/lib/loaders"
						]
					]
				}
			],
			"expect": {}
		},
		{
			"op": "start",
			"name": "p",
			"at": "/p",
			"program": "/code/p",
			"in": "b",
			"expect": {
