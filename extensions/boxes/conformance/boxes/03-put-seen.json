			"op": "log",
			"name": "early",
			"expect": {
				"values": [
					false
				]
			}
		},
		{
			"op": "pulse",
			"expect": {}
		},
		{
			"op": "log",
			"name": "watched",
			"expect": {
				"values": [
					false
				]
			}
		},
		{
			"op": "boxput",
			"box": "b",
			"path": "lib/loaders",
			"node": "/store/loaders",
			"expect": {}
		},
