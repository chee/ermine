{
	"title": "a status shows the paths a waiter recorded as the reader sees them: the process that waits on a node not there is shown its own path to its own reader, and a reader in a box, over a memo bound into it, sees none (node: null), never the host's path",
	"steps": [
		{
			"op": "ermine",
			"expect": {}
		},
		{
			"op": "code",
			"at": "/code/p",
			"program": [
				{
					"do": [
						"createMemo",
						"waits",
						{},
						[
							"read",
							"/private/diary/today"
						]
					],
					"as": "w"
				},
				{
					"do": [
						"createEffect",
						"watch",
						[
							"peep",
							[
								"read",
								"$w"
							]
						],
						"seen"
					]
				}
			],
			"expect": {}
		},
		{
			"op": "start",
			"name": "p",
			"at": "/secret/p",
			"program": "/code/p",
			"expect": {
				"id": "proc:p"
			}
		},
		{
			"op": "do",
			"process": "p",
			"call": [
				"getStatus",
				"/secret/p/waits"
			],
			"expect": {
				"value": {
					"state": "pending",
					"waiting": [
						{
							"node": [
								"private",
								"diary",
								"today"
							]
						}
					],
					"n": 2
				}
			}
		},
		{
			"op": "box",
			"name": "b",
			"expect": {}
		},
		{
			"op": "boxput",
			"box": "b",
			"path": "m",
			"node": "/secret/p/waits",
			"expect": {}
		},
		{
			"op": "code",
			"at": "/code/q",
			"program": [
				{
					"do": [
						"createEffect",
						"look",
						[
							"getStatus",
							"/m"
						],
						"boxsaw"
					]
				}
			],
			"expect": {}
		},
		{
			"op": "start",
			"name": "q",
			"at": "/q",
			"program": "/code/q",
			"in": "b",
			"expect": {
				"id": "proc:q"
			}
		},
		{
			"op": "log",
			"name": "boxsaw",
			"expect": {
				"values": [
					{
						"state": "pending",
						"waiting": [
							{
								"node": null
							}
						],
						"n": 2
					}
				]
			}
		}
	]
}
