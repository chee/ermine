{
	"title": "close: every binding the box put is gone (its rows removed as take does), every process started through the box is stopped with the why \"box closed\", and after it put, take and start are gone; a second close does nothing. the folder's own children are still seen through box.places, and the host's graph and the bound node are untouched",
	"steps": [
		{
			"op": "ermine",
			"expect": {}
		},
		{
			"op": "host",
			"call": [
				"ensureNode",
				"/catclock/face",
				"face-value"
			]
		},
		{
			"op": "host",
			"call": [
				"ensureNode",
				"/store/loaders",
				"loaders-v1"
			]
		},
		{
			"op": "box",
			"name": "b",
			"at": "/catclock",
			"expect": {}
		},
		{
			"op": "boxput",
			"box": "b",
			"path": "loaders",
			"node": "/store/loaders",
			"expect": {}
		},
		{
			"op": "boxput",
			"box": "b",
			"path": "lib/deep",
			"node": "/store/loaders",
			"expect": {}
		},
		{
			"op": "boxstart",
			"box": "b",
			"name": "p",
			"at": "/p",
			"expect": {}
		},
		{
			"op": "boxstart",
			"box": "b",
			"name": "q",
			"at": "/q",
			"expect": {}
		},
		{
			"op": "look",
			"path": "/loaders",
			"in": "b",
			"expect": {
				"there": true,
				"value": "loaders-v1"
			}
		},
		{
			"op": "boxwhy",
			"name": "p",
			"expect": {
				"whys": []
			}
		},
		{
			"op": "boxwhy",
			"name": "q",
			"expect": {
				"whys": []
			}
		},
		{
			"op": "boxclose",
			"box": "b",
			"expect": {}
		},
		{
			"op": "boxwhy",
			"name": "p",
			"expect": {
				"whys": [
					"box closed"
				]
			}
		},
		{
			"op": "boxwhy",
			"name": "q",
			"expect": {
				"whys": [
					"box closed"
				]
			}
		},
		{
			"op": "look",
			"path": "/loaders",
			"in": "b",
			"expect": {
				"there": false
			}
		},
		{
			"op": "look",
			"path": "/lib/deep",
			"in": "b",
			"expect": {
				"there": false
			}
		},
		{
			"op": "look",
			"path": "/p",
			"in": "b",
			"expect": {
				"there": false
			}
		},
		{
			"op": "names",
			"path": "/",
			"in": "b",
			"expect": {
				"names": [
					"face"
				]
			}
		},
		{
			"op": "look",
			"path": "/face",
			"in": "b",
			"expect": {
				"there": true,
				"value": "face-value"
			}
		},
		{
			"op": "look",
			"path": "/store/loaders",
			"expect": {
				"there": true,
				"value": "loaders-v1"
			}
		},
		{
			"op": "boxput",
			"box": "b",
			"path": "loaders",
			"node": "/store/loaders",
			"expect": {
				"error": "gone"
			}
		},
		{
			"op": "boxtake",
			"box": "b",
			"path": "loaders",
			"expect": {
				"error": "gone"
			}
		},
		{
			"op": "boxstart",
			"box": "b",
			"name": "r",
			"at": "/r",
			"expect": {
				"error": "gone"
			}
		},
		{
			"op": "boxclose",
			"box": "b",
			"expect": {}
		},
		{
			"op": "boxwhy",
			"name": "p",
			"expect": {
				"whys": [
					"box closed"
				]
			}
		},
		{
			"op": "boxwhy",
			"name": "q",
			"expect": {
				"whys": [
					"box closed"
				]
			}
		},
		{
			"op": "look",
			"path": "/face",
			"in": "b",
			"expect": {
				"there": true,
				"value": "face-value"
			}
		}
	]
}
