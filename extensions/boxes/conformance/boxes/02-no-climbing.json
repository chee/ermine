{
	"title": "\"..\" at \"/\" stays at \"/\", for every process: a boxed one resolves ../../x and /../x to /x of its box, and a write through such a path lands in the box, never above it; a process in no box has the same rule at the graph's root, and so does the host. (a name above \"/\" used to be nothing-there)",
	"steps": [
		{
			"op": "ermine",
			"expect": {}
		},
		{
			"op": "host",
			"call": [
				"ensureNode",
				"/catclock/face",
				"face-value"
			]
		},
		{
			"op": "box",
			"name": "b",
			"at": "/catclock",
			"expect": {}
		},
		{
			"op": "code",
			"at": "/code/p",
			"program": [
				{
					"do": [
						"ensureNode",
						"../../up",
						"up-value"
					]
				},
				{
					"do": [
						"ensureNode",
						"/../../../other",
						"other-value"
					]
				}
			],
			"expect": {}
		},
		{
			"op": "start",
			"name": "p",
			"at": "/work/p",
			"program": "/code/p",
			"in": "b",
			"expect": {
				"id": "proc:p"
			}
		},
		{
			"op": "look",
			"path": "/up",
			"in": "b",
			"expect": {
				"there": true,
				"value": "up-value"
			}
		},
		{
			"op": "look",
			"path": "/other",
			"in": "b",
			"expect": {
				"there": true,
				"value": "other-value"
			}
		},
		{
			"op": "look",
			"path": "/catclock/up",
			"expect": {
				"there": true,
				"value": "up-value"
			}
		},
		{
			"op": "look",
			"path": "/up",
			"expect": {
				"there": false
			}
		},
		{
			"op": "look",
			"path": "/other",
			"expect": {
				"there": false
			}
		},
		{
			"op": "start",
			"name": "q",
			"at": "/work/q",
			"program": "/code/p",
			"expect": {
				"id": "proc:q"
			}
		},
		{
			"op": "look",
			"path": "/up",
			"expect": {
				"there": true,
				"value": "up-value"
			}
		},
		{
			"op": "look",
			"path": "/other",
			"expect": {
				"there": true,
				"value": "other-value"
			}
		},
		{
			"op": "o",
			"call": [
				"resolve",
				"../../x"
			],
			"expect": {
				"value": [
					"x"
				]
			},
			"process": "p"
		},
		{
			"op": "o",
			"call": [
				"resolve",
				"/../x"
			],
			"expect": {
				"value": [
					"x"
				]
			},
			"process": "p"
		},
		{
			"op": "o",
			"call": [
				"resolve",
				"./x/../../../y"
			],
			"expect": {
				"value": [
					"y"
				]
			},
			"process": "p"
		},
		{
			"op": "o",
			"call": [
				"resolve",
				"../../../x"
			],
			"expect": {
				"value": [
					"x"
				]
			},
			"process": "q"
		},
		{
			"op": "o",
			"call": [
				"resolve",
				"../x"
			],
			"expect": {
				"value": [
					"x"
				]
			},
			"process": "q"
		},
		{
			"op": "o",
			"call": [
				"resolve",
				"../x"
			],
			"expect": {
				"value": [
					"x"
				]
			}
		},
		{
			"op": "host",
			"call": [
				"hasNode",
				"../../x"
			],
			"expect": {
				"value": false
			}
		}
	]
}
