{
	"title": "the process that made a pipe stopped: the pipe hears nothing more",
	"steps": [
		{
			"op": "ermine",
			"features": [
				"pipe"
			],
			"expect": {}
		},
		{
			"op": "code",
			"at": "/code/p",
			"program": [
				{
					"do": [
						"ensureNode",
						"/a",
						0
					]
				},
				{
					"do": [
						"pipe",
						"/a",
						{
							"fn": [
								{
									"do": [
										"log",
										"told",
										"$value"
									]
								}
							]
						}
					]
				}
			],
			"expect": {}
		},
		{
			"op": "start",
			"name": "p",
			"at": "/code/p",
			"expect": {
				"id": "proc:p"
			}
		},
		{
			"op": "host",
			"call": [
				"patch",
				"/a",
				[
					{
						"path": [],
						"value": 1
					}
				]
			]
		},
		{
			"op": "stop",
			"name": "p",
			"expect": {}
		},
		{
			"op": "host",
			"call": [
				"patch",
				"/a",
				[
					{
						"path": [],
						"value": 2
					}
				]
			]
		},
		{
			"op": "log",
			"name": "told",
			"expect": {
				"values": [
					1
				]
			}
		}
	]
}
