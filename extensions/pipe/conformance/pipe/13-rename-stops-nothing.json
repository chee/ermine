{
	"title": "renaming a pipe's folder stops nothing: it hears on, and explain names it where it is now",
	"steps": [
		{
			"op": "ermine",
			"features": [
				"pipe"
			],
			"expect": {}
		},
		{
			"op": "code",
			"at": "/code/p",
			"program": [
				{
					"do": [
						"ensureNode",
						"/a",
						0
					]
				},
				{
					"do": [
						"ensureNode",
						"/b",
						0
					]
				},
				{
					"do": [
						"ensureNode",
						"d",
						{}
					]
				},
				{
					"do": [
						"pipe",
						"/a",
						"/b",
						{
							"fn": [
								{
									"do": [
										"log",
										"told",
										"$value"
									]
								}
							],
							"back": [
								"whole",
								"$value"
							]
						},
						{
							"name": "d/w"
						}
					]
				}
			],
			"expect": {}
		},
		{
			"op": "start",
			"name": "p",
			"at": "/code/p",
			"expect": {
				"id": "proc:p"
			}
		},
		{
			"op": "host",
			"call": [
				"rename",
				"/code/p/d",
				"/code/p/e"
			]
		},
		{
			"op": "host",
			"call": [
				"patch",
				"/a",
				[
					{
						"path": [],
						"value": 1
					}
				]
			]
		},
		{
			"op": "log",
			"name": "told",
			"expect": {
				"values": [
					1
				]
			}
		},
		{
			"op": "host",
			"call": [
				"explain",
				"/b"
			],
			"expect": {
				"value": {
					"writer": "pipe",
					"path": [
						"code",
						"p",
						"e",
						"w"
					]
				}
			}
		}
	]
}
