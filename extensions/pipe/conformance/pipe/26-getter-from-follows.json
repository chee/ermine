{
	"title": "a from given as a getter is read in the pipe's memo: when what it reads changes, the pipe follows the new node: writes at it land, writes at the old no longer do",
	"steps": [
		{ "op": "ermine", "features": ["pipe"], "expect": {} },
		{
			"op": "code",
			"at": "/code/p",
			"program": [
				{ "do": ["ensureNode", "/sel", "/a"] },
				{ "do": ["ensureNode", "/a", 0] },
				{ "do": ["ensureNode", "/b", 0] },
				{ "do": ["ensureNode", "/out", 0] },
				{ "do": ["pipe", { "get": ["read", "/sel"] }, "/out", { "name": "copy" }] }
			],
			"expect": {}
		},
		{ "op": "start", "name": "p", "at": "/code/p", "expect": { "id": "proc:p" } },
		{ "op": "host", "call": ["patch", "/a", [{ "path": [], "value": 1 }]] },
		{ "op": "host", "call": ["read", "/out"], "expect": { "value": 1 } },
		{ "op": "host", "call": ["patch", "/sel", [{ "path": [], "value": "/b" }]] },
		{ "op": "host", "call": ["patch", "/b", [{ "path": [], "value": 2 }]] },
		{ "op": "host", "call": ["read", "/out"], "expect": { "value": 2 } },
		{ "op": "host", "call": ["patch", "/a", [{ "path": [], "value": 3 }]] },
		{ "op": "host", "call": ["read", "/out"], "expect": { "value": 2 } },
		{ "op": "host", "call": ["patch", "/b", [{ "path": [], "value": 4 }]] },
		{ "op": "host", "call": ["read", "/out"], "expect": { "value": 4 } }
	]
}
