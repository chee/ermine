{
	"title": "a to given as a getter (options.to, a mirror): the pipe writes at the node it gives now",
	"steps": [
		{ "op": "ermine", "features": ["pipe"], "expect": {} },
		{
			"op": "code",
			"at": "/code/p",
			"program": [
				{ "do": ["ensureNode", "/sel", "/x"] },
				{ "do": ["ensureNode", "/a", 0] },
				{ "do": ["ensureNode", "/x", 0] },
				{ "do": ["ensureNode", "/y", 0] },
				{ "do": ["pipe", "/a", { "name": "copy", "to": { "get": ["read", "/sel"] } }] }
			],
			"expect": {}
		},
		{ "op": "start", "name": "p", "at": "/code/p", "expect": { "id": "proc:p" } },
		{ "op": "host", "call": ["patch", "/a", [{ "path": [], "value": 1 }]] },
		{ "op": "host", "call": ["read", "/x"], "expect": { "value": 1 } },
		{ "op": "host", "call": ["patch", "/sel", [{ "path": [], "value": "/y" }]] },
		{ "op": "host", "call": ["patch", "/a", [{ "path": [], "value": 2 }]] },
		{ "op": "host", "call": ["read", "/y"], "expect": { "value": 2 } },
		{ "op": "host", "call": ["read", "/x"], "expect": { "value": 1 } }
	]
}
