{
	"title": "a pipe never hears its own writes: one from a node to itself is told the writer's write, not its own, at either timing",
	"steps": [
		{
			"op": "ermine",
			"features": [
				"pipe"
			],
			"expect": {}
		},
		{
			"op": "code",
			"at": "/code/p",
			"program": [
				{
					"do": [
						"ensureNode",
						"/a",
						0
					]
				},
				{
					"do": [
						"ensureNode",
						"/b",
						0
					]
				},
				{
					"do": [
						"pipe",
						"/a",
						"/a",
						{
							"fn": [
								{
									"do": [
										"log",
										"told",
										"$value"
									]
								}
							],
							"back": [
								"whole",
								[
									"inc",
									"$value"
								]
							]
						}
					]
				},
				{
					"do": [
						"pipe",
						"/b",
						"/b",
						{
							"fn": [
								{
									"do": [
										"log",
										"told2",
										"$value"
									]
								}
							],
							"back": [
								"whole",
								[
									"inc",
									"$value"
								]
							]
						},
						{
							"timing": "write"
						}
					]
				}
			],
			"expect": {}
		},
		{
			"op": "start",
			"name": "p",
			"at": "/code/p",
			"expect": {
				"id": "proc:p"
			}
		},
		{
			"op": "host",
			"call": [
				"patch",
				"/a",
				[
					{
						"path": [],
						"value": 1
					}
				]
			]
		},
		{
			"op": "host",
			"call": [
				"patch",
				"/b",
				[
					{
						"path": [],
						"value": 1
					}
				]
			]
		},
		{
			"op": "log",
			"name": "told",
			"expect": {
				"values": [
					1
				]
			}
		},
		{
			"op": "log",
			"name": "told2",
			"expect": {
				"values": [
					1
				]
			}
		},
		{
			"op": "host",
			"call": [
				"read",
				"/a"
			],
			"expect": {
				"value": 2
			}
		},
		{
			"op": "host",
			"call": [
				"read",
				"/b"
			],
			"expect": {
				"value": 2
			}
		}
	]
}
