			"features": [
				"pipe"
			],
			"deny": [
				{
					"op": "edit",
					"path": "b",
					"from": "code/p"
				}
			],
			"expect": {}
		},
		{
			"op": "host",
			"call": [
				"ensureNode",
				"/b",
				0
			]
		},
		{
			"op": "code",
			"at": "/code/p",
			"program": [
				{
					"do": [
						"ensureNode",
						"/a",
						0
					]
				},
				{
					"do": [
						"pipe",
						"/a",
						"/b"
					]
				}
			],
			"expect": {}
		},
		{
			"op": "start",
			"name": "p",
			"at": "/code/p",
			"expect": {
				"id": "proc:p"
			}
		},
		{
			"op": "host",
			"call": [
				"patch",
				"/a",
				[
					{
						"path": [],
						"value": 1
					}
				]
			],
			"expect": {}
		},
		{
			"op": "host",
			"call": [
				"read",
				"/b"
			],
			"expect": {
				"value": 0
			}
		},
		{
			"op": "host",
			"call": [
				"log",
				"status",
				[
					"all",
					[
						"pick",
						[
							"getStatus",
							"/code/p/pipe-1"
						],
						[
							"state"
						]
					],
					[
						"pick",
						[
							"getStatus",
							"/code/p/pipe-1"
						],
						[
							"error"
						]
					],
					[
						"pick",
						[
							"getStatus",
							"/code/p/pipe-1"
						],
						[
							"waiting"
						]
					]
				]
			],
			"expect": {
				"value": [
					"failed",
					"edit refused: denied",
					null
				]
			}
