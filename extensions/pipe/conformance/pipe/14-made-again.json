			"features": [
				"pipe"
			],
			"expect": {}
		},
		{
			"op": "code",
			"at": "/code/p",
			"program": [
				{
					"do": [
						"ensureNode",
						"/k",
						0
					],
					"as": "k"
				},
				{
					"do": [
						"ensureNode",
						"/a",
						0
					]
				},
				{
					"do": [
						"ensureNode",
						"/b",
						0
					]
				},
				{
					"do": [
						"ensureNode",
						"/c",
						0
					]
