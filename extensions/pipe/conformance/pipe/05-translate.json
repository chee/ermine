{
	"title": "a translate: a carries from's writes to to, b carries to's writes back to from. the pipe never hears its own writes, so neither comes back round",
	"steps": [
		{
			"op": "ermine",
			"features": [
				"pipe"
			],
			"expect": {}
		},
		{
			"op": "code",
			"at": "/code/p",
			"program": [
				{
					"do": [
						"ensureNode",
						"/a",
						0
					]
				},
				{
					"do": [
						"ensureNode",
						"/b",
						{
							"n": 0
						}
					]
				},
				{
					"do": [
						"pipe",
						"/a",
						"/b",
						{
							"fn": [
								{
									"do": [
										"log",
										"there",
										"$value"
									]
								}
							],
							"back": [
								"all",
								{
									"path": [
										"n"
									],
									"value": "$value"
								}
							]
						},
						{
							"fn": [
								{
									"do": [
										"log",
										"back",
										"$value"
									]
								}
							],
							"back": [
								"whole",
								[
									"pick",
									"$value",
									[
										"n"
									]
								]
							]
						}
					]
				}
			],
			"expect": {}
		},
		{
			"op": "start",
			"name": "p",
			"at": "/code/p",
			"expect": {
				"id": "proc:p"
			}
		},
		{
			"op": "host",
			"call": [
				"patch",
				"/a",
				[
					{
						"path": [],
						"value": 3
					}
				]
			]
		},
		{
			"op": "host",
			"call": [
				"read",
				"/b"
			],
			"expect": {
				"value": {
					"n": 3
				}
			}
		},
		{
			"op": "host",
			"call": [
				"patch",
				"/b",
				[
					{
						"path": [
							"n"
						],
						"value": 7
					}
				]
			]
		},
		{
			"op": "host",
			"call": [
				"read",
				"/a"
			],
			"expect": {
				"value": 7
			}
		},
		{
			"op": "host",
			"call": [
				"explain",
				"/a"
			],
			"expect": {
				"value": {
					"writer": "pipe",
					"path": [
						"code",
						"p",
						"pipe-1"
					]
				}
			}
		},
		{
			"op": "log",
			"name": "there",
			"expect": {
				"values": [
					3
				]
			}
		},
		{
			"op": "log",
			"name": "back",
			"expect": {
				"values": [
					{
						"n": 7
					}
				]
			}
		}
	]
}
