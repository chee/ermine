{
	"title": "attributes that are not a map (a list, a string) are replaced by a map with the status alone",
	"steps": [
		{
			"op": "providers",
			"expect": {}
		},
		{
			"op": "edit",
			"part": "attributes",
			"id": "N",
			"patches": [
				{
					"path": [],
					"value": [
						1,
						2
					]
				}
			],
			"expect": {}
		},
		{
			"op": "edit",
			"part": "attributes",
			"id": "M",
			"patches": [
				{
					"path": [],
					"value": "hi"
				}
			],
			"expect": {}
		},
		{
			"op": "provide",
			"name": "p",
			"id": "N",
			"expect": {}
		},
		{
			"op": "provide",
			"name": "q",
			"id": "M",
			"expect": {}
		},
		{
			"op": "read",
			"part": "attributes",
			"id": "N",
			"expect": {
				"value": {
					"ermine.provider.status": "asleep"
				}
			}
		},
		{
			"op": "read",
			"part": "attributes",
			"id": "M",
			"expect": {
				"value": {
					"ermine.provider.status": "asleep"
				}
			}
		}
	]
}
