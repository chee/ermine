{
	"title": "a write after the last reader left lands; the status stays asleep",
	"steps": [
		{
			"op": "ermine",
			"features": [
				"pully"
			],
			"expect": {}
		},
		{
			"op": "code",
			"at": "/code/cam",
			"program": [
				{
					"do": [
						"ensureNode",
						"/dev/cam",
						{
							"frame": 0
						}
					],
					"as": "cam"
				},
				{
					"do": [
						"createAction",
						"on/cam",
						[
							{
								"do": [
									"log",
									"said",
									[
										"all",
										"$0",
										"$2"
									]
								]
							}
						],
						[
							"if",
							[
								"is",
								"$0",
								"check"
							],
							"fresh"
						]
					],
					"as": "on"
				},
				{
					"do": [
						"provide",
						"$cam",
						"$on"
					]
				}
			],
			"expect": {}
		},
		{
			"op": "start",
			"name": "cam",
			"at": "/code/cam",
			"expect": {
				"id": "proc:cam"
			}
		},
		{
			"op": "code",
			"at": "/code/r",
			"program": [
				{
					"do": [
						"getNode",
						"/dev/cam"
					],
					"as": "cam"
				},
				{
					"do": [
						"ensureNode",
						"on",
						true
					],
					"as": "on"
				},
				{
					"do": [
						"createEffect",
						"see",
						[
							"if",
							[
								"read",
								"$on"
							],
							[
								"all",
								[
									"read",
									"$cam"
								],
								[
									"each",
									[
										"all",
										[
											"getStatus",
											"$cam"
										]
									],
									[
										"provider"
									]
								]
							]
						],
						"seen-r"
					]
				}
			],
			"expect": {}
		},
		{
			"op": "start",
			"name": "r",
			"at": "/code/r",
			"expect": {
				"id": "proc:r"
			}
		},
		{
			"op": "do",
			"process": "r",
			"call": [
				"patch",
				"$on",
				[
					{
						"path": [],
						"value": false
					}
				]
			],
			"expect": {}
		},
		{
			"op": "do",
			"process": "cam",
			"call": [
				"patch",
				"$cam",
				[
					{
						"path": [],
						"value": {
							"frame": 5
						}
					}
				]
			],
			"expect": {}
		},
		{
			"op": "host",
			"call": [
				"getStatus",
				"/dev/cam"
			],
			"expect": {
				"value": {
					"state": "done",
					"provider": "asleep"
				}
			}
		},
		{
			"op": "host",
			"call": [
				"read",
				"/dev/cam"
			],
			"expect": {
				"value": {
					"frame": 5
				}
			}
		}
	]
}
