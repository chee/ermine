{
	"title": "reads of its attributes (status(x) too) or its children wake nothing; nor does a read outside a run (the host's, a peep)",
	"steps": [
		{
			"op": "ermine",
			"features": [
				"pully"
			],
			"expect": {}
		},
		{
			"op": "code",
			"at": "/code/cam",
			"program": [
				{
					"do": [
						"ensureNode",
						"/dev/cam",
						{
							"frame": 0
						}
					],
					"as": "cam"
				},
				{
					"do": [
						"createAction",
						"on/cam",
						[
							{
								"do": [
									"log",
									"said",
									[
										"all",
										"$0",
										"$2"
									]
								]
							}
						],
						[
							"if",
							[
								"is",
								"$0",
								"check"
							],
							"fresh"
						]
					],
					"as": "on"
				},
				{
					"do": [
						"provide",
						"$cam",
						"$on"
					]
				}
			],
			"expect": {}
		},
		{
			"op": "start",
			"name": "cam",
			"at": "/code/cam",
			"expect": {
				"id": "proc:cam"
			}
		},
		{
			"op": "code",
			"at": "/code/a",
			"program": [
				{
					"do": [
						"getNode",
						"/dev/cam"
					],
					"as": "cam"
				},
				{
					"do": [
						"ensureNode",
						"on",
						true
					],
					"as": "on"
				},
				{
					"do": [
						"createEffect",
						"see",
						[
							"if",
							[
								"read",
								"$on"
							],
							[
								"read",
								{
									"path": [
										"dev",
										"cam"
									],
									"part": "attributes"
								}
							]
						],
						"seen-a"
					]
				}
			],
			"expect": {}
		},
		{
			"op": "code",
			"at": "/code/b",
			"program": [
				{
					"do": [
						"getNode",
						"/dev/cam"
					],
					"as": "cam"
				},
				{
					"do": [
						"ensureNode",
						"on",
						true
					],
					"as": "on"
				},
				{
					"do": [
						"createEffect",
						"see",
						[
							"if",
							[
								"read",
								"$on"
							],
							[
								"list",
								"$cam"
							]
						],
						"seen-b"
					]
				}
			],
			"expect": {}
		},
		{
			"op": "code",
			"at": "/code/c",
			"program": [
				{
					"do": [
						"getNode",
						"/dev/cam"
					],
					"as": "cam"
				},
				{
					"do": [
						"ensureNode",
						"on",
						true
					],
					"as": "on"
				},
				{
					"do": [
						"createEffect",
						"see",
						[
							"if",
							[
								"read",
								"$on"
							],
							[
								"getStatus",
								"$cam"
							]
						],
						"seen-c"
					]
				}
			],
			"expect": {}
		},
		{
			"op": "start",
			"name": "a",
			"at": "/code/a",
			"expect": {
				"id": "proc:a"
			}
		},
		{
			"op": "start",
			"name": "b",
			"at": "/code/b",
			"expect": {
				"id": "proc:b"
			}
		},
		{
			"op": "start",
			"name": "c",
			"at": "/code/c",
			"expect": {
				"id": "proc:c"
			}
		},
		{
			"op": "host",
			"call": [
				"read",
				"/dev/cam"
			],
			"expect": {
				"value": {
					"frame": 0
				}
			}
		},
		{
			"op": "host",
			"call": [
				"peep",
				[
					"read",
					"/dev/cam"
				]
			],
			"expect": {
				"value": {
					"frame": 0
				}
			}
		},
		{
			"op": "log",
			"name": "said",
			"expect": {
				"values": []
			}
		},
		{
			"op": "host",
			"call": [
				"getStatus",
				"/dev/cam"
			],
			"expect": {
				"value": {
					"state": "done",
					"provider": "asleep"
				}
			}
		}
	]
}
