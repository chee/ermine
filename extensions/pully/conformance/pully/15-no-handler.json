{
	"title": "a name whose handler isn't there (no node, or no value): the wake is pending, loudly: a wait from the namer at the handler's id, the status waking",
	"steps": [
		{
			"op": "ermine",
			"features": [
				"pully"
			],
			"expect": {}
		},
		{
			"op": "code",
			"at": "/code/cam",
			"program": [
				{
					"do": [
						"ensureNode",
						"/dev/cam",
						{
							"frame": 0
						}
					],
					"as": "cam"
				},
				{
					"do": [
						"patchAttributes",
						"$cam",
						[
							{
								"path": [
									"ermine.provider"
								],
								"value": "nowhere"
							}
						]
					]
				}
			],
			"expect": {}
		},
		{
			"op": "start",
			"name": "cam",
			"at": "/code/cam",
			"expect": {
				"id": "proc:cam"
			}
		},
		{
			"op": "code",
			"at": "/code/r",
			"program": [
				{
					"do": [
						"getNode",
						"/dev/cam"
					],
					"as": "cam"
				},
				{
					"do": [
						"ensureNode",
						"on",
						true
					],
					"as": "on"
				},
				{
					"do": [
						"createEffect",
						"see",
						[
							"if",
							[
								"read",
								"$on"
							],
							[
								"all",
								[
									"read",
									"$cam"
								],
								[
									"each",
									[
										"all",
										[
											"getStatus",
											"$cam"
										]
									],
									[
										"provider"
									]
								]
							]
						],
						"seen-r"
					]
				}
			],
			"expect": {}
		},
		{
			"op": "start",
			"name": "r",
			"at": "/code/r",
			"expect": {
				"id": "proc:r"
			}
		},
		{
			"op": "host",
			"call": [
				"getStatus",
				"/dev/cam"
			],
			"expect": {
				"value": {
					"state": "done",
					"provider": "waking"
				}
			}
		},
		{
			"op": "waits",
			"expect": {
				"waits": [
					{
						"caller": "proc:cam",
						"id": "nowhere"
					}
				]
			}
		}
	]
}
