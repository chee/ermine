{
	"title": "a snapshot holds every table, and a table it lacks is none",
	"steps": [
		{
			"op": "add",
			"name": "a",
			"patches": [{ "path": [], "value": 1 }],
			"expect": { "added": "taken" }
		},
		{
			"op": "add",
			"name": "b",
			"parents": ["a"],
			"table": "attributes",
			"patches": [{ "path": [], "value": { "k": 1 } }],
			"expect": { "added": "taken" }
		},
		{
			"op": "add",
			"name": "c",
			"parents": ["b"],
			"table": "children",
			"patches": [{ "path": [], "value": {} }],
			"expect": { "added": "taken" }
		},
		{
			"op": "keep",
			"commit": "b",
			"tables": {
				"attributes": { "value": { "k": 2 }, "change": { "time": 3, "actor": null } }
			},
			"expect": {}
		},
		{
			"op": "replay",
			"commit": "c",
			"expect": {
				"tables": {
					"attributes": { "value": { "k": 2 }, "change": { "time": 3, "actor": null } },
					"children": {
						"value": {},
						"change": {
							"time": 0,
							"actor": null,
							"metadata": {
								"signer": "ed018a88e3dd7409f195fd52db2d3cba5d72ca6709bf1d94121bf3748801b40f6f5c",
								"commit": "1e205622f48705163c198c897b825f9ae4466429b38617d4af1a4c61ed19fd016965"
							}
						}
					}
				}
			}
		}
	]
}
