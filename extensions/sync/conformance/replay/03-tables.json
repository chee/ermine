{
	"title": "each table its own: a commit changes its own table, and each table's change is the one that last touched it",
	"steps": [
		{
			"op": "add",
			"name": "a",
			"time": 1,
			"patches": [{ "path": [], "value": "body" }],
			"expect": { "added": "taken" }
		},
		{
			"op": "add",
			"name": "b",
			"parents": ["a"],
			"time": 2,
			"table": "attributes",
			"patches": [{ "path": [], "value": { "color": "cherry" } }],
			"expect": { "added": "taken" }
		},
		{
			"op": "add",
			"name": "c",
			"parents": ["b"],
			"time": 3,
			"table": "children",
			"patches": [
				{
					"path": [],
					"value": {
						"notes": "ermine://abababababababababababababababababababababababababababababababab"
					}
				}
			],
			"expect": { "added": "taken" }
		},
		{
			"op": "add",
			"name": "d",
			"parents": ["c"],
			"time": 4,
			"table": "attributes",
			"patches": [{ "path": ["color"], "value": "lemon" }],
			"expect": { "added": "taken" }
		},
		{
			"op": "replay",
			"commit": "b",
			"expect": {
				"tables": {
					"value": {
						"value": "body",
						"change": {
							"time": 1,
							"actor": null,
							"metadata": {
								"signer": "ed018a88e3dd7409f195fd52db2d3cba5d72ca6709bf1d94121bf3748801b40f6f5c",
								"commit": "9b837c39052163d324c9fcf620283555b12a3f81cd0a517b10837a7b6b42094a"
							}
						}
					},
					"attributes": {
						"value": { "color": "cherry" },
						"change": {
							"time": 2,
							"actor": null,
							"metadata": {
								"signer": "ed018a88e3dd7409f195fd52db2d3cba5d72ca6709bf1d94121bf3748801b40f6f5c",
								"commit": "4fb6d0c2da42b93949381c5942c2f89580a349a1dd997b704c13c6c7d579cab7"
							}
						}
					}
				}
			}
		},
		{
			"op": "replay",
			"commit": "d",
			"expect": {
				"tables": {
					"value": {
						"value": "body",
						"change": {
							"time": 1,
							"actor": null,
							"metadata": {
								"signer": "ed018a88e3dd7409f195fd52db2d3cba5d72ca6709bf1d94121bf3748801b40f6f5c",
								"commit": "9b837c39052163d324c9fcf620283555b12a3f81cd0a517b10837a7b6b42094a"
							}
						}
					},
					"attributes": {
						"value": { "color": "lemon" },
						"change": {
							"time": 4,
							"actor": null,
							"metadata": {
								"signer": "ed018a88e3dd7409f195fd52db2d3cba5d72ca6709bf1d94121bf3748801b40f6f5c",
								"commit": "670831686489db51d9cbcac684326a06023068d46406a168f2647e65f32ab8ee"
							}
						}
					},
					"children": {
						"value": {
							"notes": "ermine://abababababababababababababababababababababababababababababababab"
						},
						"change": {
							"time": 3,
							"actor": null,
							"metadata": {
								"signer": "ed018a88e3dd7409f195fd52db2d3cba5d72ca6709bf1d94121bf3748801b40f6f5c",
								"commit": "fd254c08bb591d43be2809338866cb2c4efdc73d4740b73b5b7293c2e3d5f940"
							}
						}
					}
				}
			}
		}
	]
}
