									"commit",
									"c8b6c2e076c6507e624eb4f00a7797b88e607d02fa11f4d180c4c2a39b0cb9bf"
								]
							]
						}
					},
					"attributes": {
						"value": { "color": "cherry" },
						"change": {
							"time": 2,
							"actor": null,
							"metadata": [
								[
									"signer",
									"ed018a88e3dd7409f195fd52db2d3cba5d72ca6709bf1d94121bf3748801b40f6f5c"
								],
								[
									"commit",
									"a8225d2d680d7a6135ef1947e3c7a44eec83a53e525fcd328b9ce713cc2ef61d"
								]
							]
						}
					}
				}
			}
		},
		{
			"op": "replay",
			"commit": "d",
			"expect": {
				"tables": {
					"value": {
						"value": "body",
						"change": {
							"time": 1,
							"actor": null,
							"metadata": [
								[
									"signer",
									"ed018a88e3dd7409f195fd52db2d3cba5d72ca6709bf1d94121bf3748801b40f6f5c"
								],
								[
									"commit",
									"c8b6c2e076c6507e624eb4f00a7797b88e607d02fa11f4d180c4c2a39b0cb9bf"
								]
							]
						}
					},
					"attributes": {
						"value": { "color": "lemon" },
