{
	"title": "a snapshot from elsewhere is a hint: kept only when a replay to its commit gives the same tables, so a forged one is never where replay starts; one that matches is, and changes nothing",
	"steps": [
		{
			"op": "add",
			"name": "a",
			"patches": [{ "path": [], "value": { "n": 0 } }],
			"expect": { "added": "taken" }
		},
		{
			"op": "add",
			"name": "b",
			"parents": ["a"],
			"patches": [{ "path": ["n"], "value": 1 }],
			"expect": { "added": "taken" }
		},
		{
			"op": "add",
			"name": "c",
			"parents": ["b"],
			"patches": [{ "path": ["m"], "value": 2 }],
			"expect": { "added": "taken" }
		},
		{
			"op": "hint",
			"commit": "b",
			"tables": { "value": { "value": { "n": 100 }, "change": { "time": 0, "actor": null } } },
			"expect": { "kept": false }
		},
		{
			"op": "hint",
			"commit": "b",
			"tables": { "value": { "value": { "n": 1 }, "change": { "time": 7, "actor": "kept" } } },
			"expect": { "kept": false }
		},
		{
			"op": "hint",
			"commit": "b",
			"tables": {
				"value": { "value": { "n": 1 }, "change": { "time": 0, "actor": null } },
				"extra": { "value": 1, "change": { "time": 0, "actor": null } }
			},
			"expect": { "kept": false }
		},
		{
			"op": "replay",
			"commit": "c",
			"expect": {
				"tables": {
					"value": {
						"value": { "n": 1, "m": 2 },
						"change": {
							"time": 0,
							"actor": null,
							"metadata": {
								"signer": "ed018a88e3dd7409f195fd52db2d3cba5d72ca6709bf1d94121bf3748801b40f6f5c",
								"commit": "7a4725773234775227646f15540ca32ebe9f8fd8e18657c5c3cf8dc1337e75d0"
							}
						}
					}
				}
			}
		},
		{
			"op": "hint",
			"commit": "b",
			"tables": {
				"value": {
					"value": { "n": 1 },
					"change": {
						"time": 0,
						"actor": null,
						"metadata": {
							"signer": "ed018a88e3dd7409f195fd52db2d3cba5d72ca6709bf1d94121bf3748801b40f6f5c",
							"commit": "1d8d3c833997bf17708cd96a9c728f643142682d569bd246c8dd2023af7888c7"
						}
					}
				}
			},
			"expect": { "kept": true }
		},
		{
			"op": "replay",
			"commit": "c",
			"expect": {
				"tables": {
					"value": {
						"value": { "n": 1, "m": 2 },
						"change": {
							"time": 0,
							"actor": null,
							"metadata": {
								"signer": "ed018a88e3dd7409f195fd52db2d3cba5d72ca6709bf1d94121bf3748801b40f6f5c",
								"commit": "7a4725773234775227646f15540ca32ebe9f8fd8e18657c5c3cf8dc1337e75d0"
							}
						}
					}
				}
			}
		},
		{
			"op": "hint",
			"commit": "zz",
			"tables": {},
			"fails": true
		},
		{
			"op": "hint",
			"commit": "a",
			"tables": {
				"value": {
					"value": { "n": 0 },
					"change": {
						"time": 0,
						"actor": null,
						"metadata": {
							"signer": "ed018a88e3dd7409f195fd52db2d3cba5d72ca6709bf1d94121bf3748801b40f6f5c",
							"commit": "dece98ee48de9f71740bc8035b2006adb88cca7e94d784e63c17dbb86abed949"
						}
					}
				}
			},
			"expect": { "kept": true }
		}
	]
}
