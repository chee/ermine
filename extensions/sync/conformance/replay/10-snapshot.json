{
	"title": "a snapshot from elsewhere is a hint: kept only when a replay to its commit gives the same tables, so a forged one is never where replay starts; one that matches is, and changes nothing",
	"steps": [
		{
			"op": "add",
			"name": "a",
			"patches": [{ "path": [], "value": { "n": 0 } }],
			"expect": { "added": "taken" }
		},
		{
			"op": "add",
			"name": "b",
			"parents": ["a"],
			"patches": [{ "path": ["n"], "value": 1 }],
			"expect": { "added": "taken" }
		},
		{
			"op": "add",
			"name": "c",
			"parents": ["b"],
			"patches": [{ "path": ["m"], "value": 2 }],
			"expect": { "added": "taken" }
		},
		{
			"op": "hint",
			"commit": "b",
			"tables": { "value": { "value": { "n": 100 }, "change": { "time": 0, "actor": null } } },
			"expect": { "kept": false }
		},
		{
			"op": "hint",
			"commit": "b",
			"tables": { "value": { "value": { "n": 1 }, "change": { "time": 7, "actor": "kept" } } },
			"expect": { "kept": false }
		},
		{
			"op": "hint",
			"commit": "b",
			"tables": {
				"value": { "value": { "n": 1 }, "change": { "time": 0, "actor": null } },
				"extra": { "value": 1, "change": { "time": 0, "actor": null } }
			},
			"expect": { "kept": false }
		},
		{
			"op": "replay",
			"commit": "c",
			"expect": {
				"tables": {
					"value": { "value": { "n": 1, "m": 2 }, "change": { "time": 0, "actor": null } }
				}
			}
		},
		{
			"op": "hint",
			"commit": "b",
			"tables": { "value": { "value": { "n": 1 }, "change": { "time": 0, "actor": null } } },
			"expect": { "kept": true }
		},
		{
			"op": "replay",
			"commit": "c",
			"expect": {
				"tables": {
					"value": { "value": { "n": 1, "m": 2 }, "change": { "time": 0, "actor": null } }
				}
			}
		},
		{
			"op": "hint",
			"commit": "zz",
			"tables": {},
			"fails": true
		},
		{
			"op": "hint",
			"commit": "a",
			"tables": { "value": { "value": { "n": 0 }, "change": { "time": 0, "actor": null } } },
			"expect": { "kept": true }
		}
	]
}
