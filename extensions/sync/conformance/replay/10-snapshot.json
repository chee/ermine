{
	"title": "a snapshot from elsewhere is a hint: kept only when a replay to its commit gives the same tables, so a forged one is never where replay starts; one that matches is, and changes nothing",
	"steps": [
		{
			"op": "add",
			"name": "a",
			"patches": [{ "path": [], "value": { "n": 0 } }],
			"expect": { "added": "taken" }
		},
		{
			"op": "add",
			"name": "b",
			"parents": ["a"],
			"patches": [{ "path": ["n"], "value": 1 }],
			"expect": { "added": "taken" }
		},
		{
			"op": "add",
			"name": "c",
			"parents": ["b"],
			"patches": [{ "path": ["m"], "value": 2 }],
			"expect": { "added": "taken" }
		},
		{
			"op": "hint",
			"commit": "b",
			"tables": { "value": { "value": { "n": 100 }, "change": { "time": 0, "actor": null } } },
			"expect": { "kept": false }
		},
		{
			"op": "hint",
			"commit": "b",
			"tables": { "value": { "value": { "n": 1 }, "change": { "time": 7, "actor": "kept" } } },
			"expect": { "kept": false }
		},
		{
			"op": "hint",
			"commit": "b",
			"tables": {
				"value": { "value": { "n": 1 }, "change": { "time": 0, "actor": null } },
				"extra": { "value": 1, "change": { "time": 0, "actor": null } }
			},
			"expect": { "kept": false }
		},
		{
			"op": "replay",
			"commit": "c",
			"expect": {
				"tables": {
					"value": {
						"value": { "n": 1, "m": 2 },
						"change": {
							"time": 0,
							"actor": null,
							"metadata": [
								[
									"signer",
									"ed018a88e3dd7409f195fd52db2d3cba5d72ca6709bf1d94121bf3748801b40f6f5c"
								],
								[
									"commit",
									"3285107bb63c10dfadcd01aa8e4f2672c426bd4874935a7e79cf6c26b1f97b3b"
								]
							]
						}
					}
				}
			}
		},
		{
			"op": "hint",
			"commit": "b",
			"tables": {
				"value": {
					"value": { "n": 1 },
					"change": {
						"time": 0,
						"actor": null,
						"metadata": [
							[
								"signer",
								"ed018a88e3dd7409f195fd52db2d3cba5d72ca6709bf1d94121bf3748801b40f6f5c"
							],
							["commit", "61b882b3f79ae2591eb7c822dc8671ce9d01bb1fea83de8ec11e29eadaeddbf1"]
						]
					}
				}
			},
			"expect": { "kept": true }
		},
		{
			"op": "replay",
			"commit": "c",
			"expect": {
				"tables": {
					"value": {
						"value": { "n": 1, "m": 2 },
						"change": {
							"time": 0,
							"actor": null,
							"metadata": [
								[
									"signer",
									"ed018a88e3dd7409f195fd52db2d3cba5d72ca6709bf1d94121bf3748801b40f6f5c"
								],
								[
									"commit",
									"3285107bb63c10dfadcd01aa8e4f2672c426bd4874935a7e79cf6c26b1f97b3b"
								]
							]
						}
					}
				}
			}
		},
		{
			"op": "hint",
			"commit": "zz",
			"tables": {},
			"fails": true
		},
		{
			"op": "hint",
			"commit": "a",
			"tables": {
				"value": {
					"value": { "n": 0 },
					"change": {
						"time": 0,
						"actor": null,
						"metadata": [
							[
								"signer",
								"ed018a88e3dd7409f195fd52db2d3cba5d72ca6709bf1d94121bf3748801b40f6f5c"
							],
							["commit", "cbc5d60a62249326bc064df0a9608ac295a12449a40953a98c10973662431eec"]
						]
					}
				}
			},
			"expect": { "kept": true }
		}
	]
}
