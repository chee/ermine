{
	"title": "replay walks back along each commit's base: a snapshot off that line is not used",
	"steps": [
		{
			"op": "add",
			"name": "a",
			"patches": [{ "path": [], "value": { "n": 0 } }],
			"expect": { "added": "taken" }
		},
		{
			"op": "add",
			"name": "b",
			"parents": ["a"],
			"patches": [{ "path": ["n"], "value": 1 }],
			"expect": { "added": "taken" }
		},
		{
			"op": "add",
			"name": "c",
			"parents": ["a"],
			"nonce": 1,
			"patches": [{ "path": ["x"], "value": 2 }],
			"expect": { "added": "taken" }
		},
		{
			"op": "keep",
			"commit": "c",
			"tables": {
				"value": { "value": { "from": "c" }, "change": { "time": 0, "actor": null } }
			},
			"expect": {}
		},
		{
			"op": "add",
			"name": "m",
			"parents": ["b", "c"],
			"base": "b",
			"patches": [],
			"expect": { "added": "taken" }
		},
		{
			"op": "replay",
			"commit": "m",
			"expect": {
				"tables": {
					"value": {
						"value": { "n": 1 },
						"change": {
							"time": 0,
							"actor": null,
							"metadata": [
								[
									"signer",
									"ed018a88e3dd7409f195fd52db2d3cba5d72ca6709bf1d94121bf3748801b40f6f5c"
								],
								[
									"commit",
									"119c39de16929adba9b143a8c3ad8b2679dd00fc3f739d6cddd189b6bac3b5d9"
								]
							]
						}
					}
				}
			}
		},
		{
			"op": "keep",
			"commit": "b",
			"tables": {
				"value": { "value": { "from": "b" }, "change": { "time": 0, "actor": null } }
			},
			"expect": {}
		},
		{
			"op": "replay",
			"commit": "m",
			"expect": {
				"tables": {
					"value": {
						"value": { "from": "b" },
						"change": {
							"time": 0,
							"actor": null,
							"metadata": [
								[
									"signer",
									"ed018a88e3dd7409f195fd52db2d3cba5d72ca6709bf1d94121bf3748801b40f6f5c"
								],
								[
									"commit",
									"119c39de16929adba9b143a8c3ad8b2679dd00fc3f739d6cddd189b6bac3b5d9"
								]
							]
						}
					}
				}
			}
		}
	]
}
