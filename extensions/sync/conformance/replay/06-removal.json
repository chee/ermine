{
	"title": "a table removed is gone from the tables after; before, it is there",
	"steps": [
		{
			"op": "add",
			"name": "a",
			"patches": [{ "path": [], "value": 1 }],
			"expect": { "added": "taken" }
		},
		{
			"op": "add",
			"name": "b",
			"parents": ["a"],
			"table": "attributes",
			"patches": [{ "path": [], "value": { "k": 1 } }],
			"expect": { "added": "taken" }
		},
		{
			"op": "add",
			"name": "c",
			"parents": ["b"],
			"table": "attributes",
			"patches": [{ "path": [] }],
			"expect": { "added": "taken" }
		},
		{
			"op": "replay",
			"commit": "b",
			"expect": {
				"tables": {
					"value": {
						"value": 1,
						"change": {
							"time": 0,
							"actor": null,
							"metadata": {
								"signer": "ed018a88e3dd7409f195fd52db2d3cba5d72ca6709bf1d94121bf3748801b40f6f5c",
								"commit": "a37eec233d6cfcfd272dd95ff19152b32b612a9adac42fa9c11c938cbba1ca3a"
							}
						}
					},
					"attributes": {
						"value": { "k": 1 },
						"change": {
							"time": 0,
							"actor": null,
							"metadata": {
								"signer": "ed018a88e3dd7409f195fd52db2d3cba5d72ca6709bf1d94121bf3748801b40f6f5c",
								"commit": "fc50c9b50929d96579fdc7b875c4e36f8b0711913de05f852379ffb8f6d82375"
							}
						}
					}
				}
			}
		},
		{
			"op": "replay",
			"commit": "c",
			"expect": {
				"tables": {
					"value": {
						"value": 1,
						"change": {
							"time": 0,
							"actor": null,
							"metadata": {
								"signer": "ed018a88e3dd7409f195fd52db2d3cba5d72ca6709bf1d94121bf3748801b40f6f5c",
								"commit": "a37eec233d6cfcfd272dd95ff19152b32b612a9adac42fa9c11c938cbba1ca3a"
							}
						}
					}
				}
			}
		},
		{
			"op": "add",
			"name": "d",
			"parents": ["c"],
			"patches": [{ "path": [] }],
			"expect": { "added": "taken" }
