{
	"title": "along a chain, each commit's tables are its patches applied in order from the root",
	"steps": [
		{
			"op": "add",
			"name": "a",
			"patches": [{ "path": [], "value": { "n": 0, "list": [] } }],
			"expect": { "added": "taken" }
		},
		{
			"op": "add",
			"name": "b",
			"parents": ["a"],
			"time": 1,
			"patches": [{ "path": ["n"], "value": 1 }],
			"expect": { "added": "taken" }
		},
		{
			"op": "add",
			"name": "c",
			"parents": ["b"],
			"time": 2,
			"patches": [{ "path": ["list"], "range": [0, 0], "value": [1, 2] }],
			"expect": { "added": "taken" }
		},
		{
			"op": "add",
			"name": "d",
			"parents": ["c"],
			"time": 3,
			"patches": [{ "path": ["list"], "range": [0, 1] }],
			"expect": { "added": "taken" }
		},
		{
			"op": "replay",
			"commit": "a",
			"expect": {
				"tables": {
					"value": {
						"value": { "n": 0, "list": [] },
						"change": {
							"time": 0,
							"actor": null,
							"metadata": {
								"signer": "ed018a88e3dd7409f195fd52db2d3cba5d72ca6709bf1d94121bf3748801b40f6f5c",
								"commit": "39a5272289f2dce388e164e960e92cad980922d1e2c143cbac16ea4ef7a7c647"
							}
						}
					}
				}
			}
		},
		{
			"op": "replay",
			"commit": "b",
			"expect": {
				"tables": {
					"value": {
						"value": { "n": 1, "list": [] },
						"change": {
							"time": 1,
							"actor": null,
							"metadata": {
								"signer": "ed018a88e3dd7409f195fd52db2d3cba5d72ca6709bf1d94121bf3748801b40f6f5c",
								"commit": "be1bb59a6539c71a7f45e11196b5211e4020c885ab6a9ff4fd8c0449801b0700"
							}
						}
					}
				}
			}
		},
		{
			"op": "replay",
			"commit": "c",
			"expect": {
				"tables": {
					"value": {
						"value": { "n": 1, "list": [1, 2] },
						"change": {
							"time": 2,
							"actor": null,
							"metadata": {
								"signer": "ed018a88e3dd7409f195fd52db2d3cba5d72ca6709bf1d94121bf3748801b40f6f5c",
								"commit": "834a189259ff55949e997ad19969bd89937ddc8ddc71056d14c5b89c0d9c4caf"
							}
						}
					}
				}
			}
		},
		{
			"op": "replay",
			"commit": "d",
			"expect": {
				"tables": {
					"value": {
						"value": { "n": 1, "list": [2] },
						"change": {
							"time": 3,
							"actor": null,
							"metadata": {
								"signer": "ed018a88e3dd7409f195fd52db2d3cba5d72ca6709bf1d94121bf3748801b40f6f5c",
								"commit": "b903d443d18af4935876cc12d052ba1e2906c4f8c1dd9b46fdb2e8a2c1080f02"
							}
						}
					}
				}
			}
		}
	]
}
