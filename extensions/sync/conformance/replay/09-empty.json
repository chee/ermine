{
	"title": "a commit whose node has no table has empty tables, which is not none; removing what is not there is refused",
	"steps": [
		{ "op": "add", "name": "a", "patches": [], "expect": { "added": "taken" } },
		{ "op": "replay", "commit": "a", "expect": { "tables": {} } },
		{
			"op": "add",
			"name": "b",
			"parents": ["a"],
			"patches": [{ "path": [] }],
			"expect": { "added": { "refused": "patches" } }
		}
	]
}
