{
	"title": "two lines from one commit: each head's tables are its own line's",
	"steps": [
		{
			"op": "add",
			"name": "a",
			"patches": [{ "path": [], "value": { "n": 0 } }],
			"expect": { "added": "taken" }
		},
		{
			"op": "add",
			"name": "b",
			"parents": ["a"],
			"patches": [{ "path": ["n"], "value": 1 }],
			"expect": { "added": "taken" }
		},
		{
			"op": "add",
			"name": "c",
			"parents": ["a"],
			"nonce": 1,
			"patches": [{ "path": ["x"], "value": 2 }],
			"expect": { "added": "taken" }
		},
		{
			"op": "add",
			"name": "d",
			"parents": ["c"],
			"patches": [{ "path": ["x"], "value": 3 }],
			"expect": { "added": "taken" }
		},
		{
			"op": "replay",
			"commit": "b",
			"expect": {
				"tables": {
					"value": {
						"value": { "n": 1 },
						"change": {
							"time": 0,
							"actor": null,
							"metadata": {
								"signer": "ed018a88e3dd7409f195fd52db2d3cba5d72ca6709bf1d94121bf3748801b40f6f5c",
								"commit": "1e20990548b7084080ef28ce81fd2600bb5085d059b4e260653ace20258513f28052"
							}
						}
					}
				}
			}
		},
		{
			"op": "replay",
			"commit": "d",
			"expect": {
				"tables": {
					"value": {
						"value": { "n": 0, "x": 3 },
						"change": {
							"time": 0,
							"actor": null,
							"metadata": {
								"signer": "ed018a88e3dd7409f195fd52db2d3cba5d72ca6709bf1d94121bf3748801b40f6f5c",
								"commit": "1e205e54bfab50f6ce9f06b18582309e184be9e997e297ce77e0541a4fc853381642"
							}
						}
					}
				}
			}
		},
		{
			"op": "replay",
			"commit": "a",
			"expect": {
				"tables": {
					"value": {
						"value": { "n": 0 },
						"change": {
							"time": 0,
							"actor": null,
							"metadata": {
								"signer": "ed018a88e3dd7409f195fd52db2d3cba5d72ca6709bf1d94121bf3748801b40f6f5c",
								"commit": "1e20dece98ee48de9f71740bc8035b2006adb88cca7e94d784e63c17dbb86abed949"
							}
						}
					}
				}
			}
		}
	]
}
