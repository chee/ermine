{
	"title": "two lines from one commit: each head's tables are its own line's",
	"steps": [
		{
			"op": "add",
			"name": "a",
			"patches": [{ "path": [], "value": { "n": 0 } }],
			"expect": { "added": "taken" }
		},
		{
			"op": "add",
			"name": "b",
			"parents": ["a"],
			"patches": [{ "path": ["n"], "value": 1 }],
			"expect": { "added": "taken" }
		},
		{
			"op": "add",
			"name": "c",
			"parents": ["a"],
			"nonce": 1,
			"patches": [{ "path": ["x"], "value": 2 }],
			"expect": { "added": "taken" }
		},
		{
			"op": "add",
			"name": "d",
			"parents": ["c"],
			"patches": [{ "path": ["x"], "value": 3 }],
			"expect": { "added": "taken" }
		},
		{
			"op": "replay",
			"commit": "b",
			"expect": {
				"tables": {
					"value": {
						"value": { "n": 1 },
						"change": {
							"time": 0,
							"actor": null,
							"metadata": {
								"signer": "ed018a88e3dd7409f195fd52db2d3cba5d72ca6709bf1d94121bf3748801b40f6f5c",
								"commit": "1d8d3c833997bf17708cd96a9c728f643142682d569bd246c8dd2023af7888c7"
							}
						}
					}
				}
			}
		},
		{
			"op": "replay",
			"commit": "d",
			"expect": {
				"tables": {
					"value": {
						"value": { "n": 0, "x": 3 },
						"change": {
							"time": 0,
							"actor": null,
							"metadata": {
								"signer": "ed018a88e3dd7409f195fd52db2d3cba5d72ca6709bf1d94121bf3748801b40f6f5c",
								"commit": "857df07479a4a382c16d33f41e07f6f1cbfeaf0290f23bb81c19d7c43deec61c"
							}
						}
					}
				}
			}
		},
		{
			"op": "replay",
			"commit": "a",
			"expect": {
				"tables": {
					"value": {
						"value": { "n": 0 },
						"change": {
							"time": 0,
							"actor": null,
							"metadata": {
								"signer": "ed018a88e3dd7409f195fd52db2d3cba5d72ca6709bf1d94121bf3748801b40f6f5c",
								"commit": "dece98ee48de9f71740bc8035b2006adb88cca7e94d784e63c17dbb86abed949"
							}
						}
					}
				}
			}
		}
	]
}
