{
	"title": "one write no commit can carry (a value with no encoding) is not sent, and the rest of the batch goes out: the node's status lists it as unsent, with why; a node with nothing wrong has no status; a later write there goes out, and the unsent stays listed",
	"steps": [
		{
			"op": "host",
			"name": "a",
			"seed": "0101010101010101010101010101010101010101010101010101010101010101",
			"expect": { "key": "ed018a88e3dd7409f195fd52db2d3cba5d72ca6709bf1d94121bf3748801b40f6f5c" }
		},
		{
			"op": "host",
			"name": "b",
			"seed": "0202020202020202020202020202020202020202020202020202020202020202",
			"expect": { "key": "ed018139770ea87d175f56a35466c34c7ecccb8d8a91b4ee37a25df60f5b8fc9b394" }
		},
		{
			"op": "mint",
			"host": "a",
			"as": "x",
			"expect": {
				"id": "ermine://b40fde52c568d2f3864d68739e98b72b9f144f5566afcbb238fd354ecdc7c755"
			}
		},
		{
			"op": "mint",
			"host": "a",
			"as": "y",
			"expect": {
				"id": "ermine://9b88febf6d4322956444b084a735e05da8aa437e2ceff806b8cb3a6db5d12bfb"
			}
		},
		{ "op": "follow", "host": "b", "id": "x", "expect": {} },
		{ "op": "follow", "host": "b", "id": "y", "expect": {} },
		{ "op": "connect", "a": "a", "b": "b", "expect": {} },
		{
			"op": "write",
			"host": "a",
			"id": "x",
			"patches": [{ "path": [], "value": { "n": 1 } }],
			"name": "x1",
			"expect": { "commits": 1 }
		},
		{
			"op": "write",
			"host": "a",
			"id": "y",
			"patches": [{ "path": [], "value": { "n": 1 } }],
			"name": "y1",
			"expect": { "commits": 1 }
		},
		{ "op": "quiet", "expect": {} },
		{
			"op": "writes",
			"host": "a",
			"writes": [
				{ "id": "x", "patches": [{ "path": ["n"], "value": { "/": { "symbol": "s" } } }] },
				{ "id": "y", "patches": [{ "path": ["n"], "value": 2 }] }
			],
			"expect": { "commits": 1 }
		},
		{
			"op": "status",
			"host": "a",
			"id": "x",
			"expect": {
				"status": {
					"waiting": [],
					"refused": [],
					"unsent": [{ "table": "value", "error": "cannot-carry", "field": "patches" }],
					"count": { "waiting": 0, "refused": 0, "unsent": 1 }
				}
			}
		},
		{ "op": "status", "host": "a", "id": "y", "expect": {} },
		{ "op": "quiet", "expect": {} },
		{ "op": "read", "host": "b", "id": "y", "expect": { "value": { "n": 2 } } },
		{ "op": "read", "host": "b", "id": "x", "expect": { "value": { "n": 1 } } },
		{ "op": "status", "host": "b", "id": "x", "expect": {} },
		{
			"op": "write",
			"host": "a",
			"id": "x",
			"patches": [{ "path": ["n"], "value": 3 }],
			"name": "x3",
			"expect": { "commits": 1 }
		},
		{ "op": "quiet", "expect": {} },
		{ "op": "read", "host": "b", "id": "x", "expect": { "value": { "n": 3 } } },
		{ "op": "heads", "host": "b", "id": "x", "expect": { "heads": ["x3"] } },
		{
			"op": "status",
			"host": "a",
			"id": "x",
			"expect": {
				"status": {
					"waiting": [],
					"refused": [],
					"unsent": [{ "table": "value", "error": "cannot-carry", "field": "patches" }],
					"count": { "waiting": 0, "refused": 0, "unsent": 1 }
				}
			}
		}
	]
}
