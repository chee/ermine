{
	"title": "a commit the check cannot judge yet waits on the check (waiting on none), never refused; what goes on it waits on it; judged again, each comes in or is refused as ever",
	"steps": [
		{
			"op": "add",
			"name": "a",
			"patches": [{ "path": [], "value": { "n": 0 } }],
			"expect": { "added": "taken" }
		},
		{ "op": "make", "name": "b", "parents": ["a"], "patches": [{ "path": ["n"], "value": 1 }] },
		{ "op": "hold", "commits": ["b"], "expect": {} },
		{ "op": "add", "name": "b", "expect": { "added": { "waiting": [] } } },
		{
			"op": "add",
			"name": "c",
			"parents": ["b"],
			"patches": [{ "path": ["n"], "value": 2 }],
			"expect": { "added": { "waiting": ["b"] } }
		},
		{ "op": "add", "name": "b", "expect": { "added": "passed" } },
		{ "op": "again", "expect": {} },
		{
			"op": "waiting",
			"expect": {
				"waiting": [{ "name": "b", "waiting": [] }, { "name": "c", "waiting": ["b"] }]
			}
		},
		{ "op": "heads", "expect": { "heads": ["a"] } },
		{ "op": "hold", "commits": [], "expect": {} },
		{ "op": "again", "expect": {} },
		{ "op": "waiting", "expect": { "waiting": [] } },
		{ "op": "all", "expect": { "all": ["a", "b", "c"] } },
		{
			"op": "make",
			"name": "x",
			"parents": ["c"],
			"patches": [{ "path": ["n", "deep"], "value": 3 }]
		},
		{ "op": "hold", "commits": ["x"], "expect": {} },
		{ "op": "add", "name": "x", "expect": { "added": { "waiting": [] } } },
		{
			"op": "add",
			"name": "y",
			"parents": ["x"],
			"patches": [{ "path": ["n"], "value": 4 }],
			"expect": { "added": { "waiting": ["x"] } }
		},
		{ "op": "hold", "commits": [], "expect": {} },
		{ "op": "again", "expect": {} },
		{ "op": "waiting", "expect": { "waiting": [] } },
		{ "op": "heads", "expect": { "heads": ["c"] } },
		{
			"op": "refused",
			"expect": {
				"refused": [{ "name": "x", "refused": "patches" }, { "name": "y", "refused": "parent" }]
			}
		}
	]
}
