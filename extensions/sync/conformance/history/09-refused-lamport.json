{
	"title": "a lamport is derived: 1 + the highest of its parents', 1 for a root; any other is refused, below, the same or above, up to 2^53 - 1",
	"steps": [
		{
			"op": "add",
			"name": "high-root",
			"lamport": 2,
			"patches": [{ "path": [], "value": { "n": 9 } }],
			"expect": { "added": { "refused": "lamport" } }
		},
		{
			"op": "add",
			"name": "a",
			"patches": [{ "path": [], "value": { "n": 0 } }],
			"expect": { "added": "taken" }
		},
		{
			"op": "add",
			"name": "above",
			"parents": ["a"],
			"lamport": 3,
			"patches": [{ "path": ["n"], "value": 1 }],
			"expect": { "added": { "refused": "lamport" } }
		},
		{
			"op": "add",
			"name": "same",
			"parents": ["a"],
			"lamport": 1,
			"patches": [{ "path": ["n"], "value": 2 }],
			"expect": { "added": { "refused": "lamport" } }
		},
		{
			"op": "add",
			"name": "b",
			"parents": ["a"],
			"patches": [{ "path": ["n"], "value": 3 }],
			"expect": { "added": "taken" }
		},
		{
			"op": "add",
			"name": "top",
			"parents": ["b"],
			"lamport": 9007199254740991,
			"patches": [{ "path": ["n"], "value": 4 }],
			"expect": { "added": { "refused": "lamport" } }
		},
		{
			"op": "add",
			"name": "on-top",
			"parents": ["top"],
			"lamport": 4,
			"patches": [{ "path": ["n"], "value": 5 }],
			"expect": { "added": { "refused": "parent" } }
		},
		{
			"op": "add",
			"name": "m-low",
			"parents": ["a", "b"],
			"base": "b",
			"lamport": 2,
			"expect": { "added": { "refused": "lamport" } }
		},
		{
			"op": "add",
			"name": "m",
			"parents": ["a", "b"],
			"base": "b",
			"nonce": 1,
			"patches": [{ "path": ["n"], "value": 6 }],
			"expect": { "added": "taken" }
		},
		{ "op": "heads", "expect": { "heads": ["m"] } },
		{
			"op": "refused",
			"expect": {
				"refused": [
					{ "name": "high-root", "refused": "lamport" },
					{ "name": "above", "refused": "lamport" },
					{ "name": "same", "refused": "lamport" },
					{ "name": "top", "refused": "lamport" },
					{ "name": "on-top", "refused": "parent" },
					{ "name": "m-low", "refused": "lamport" }
				]
			}
		}
	]
}
