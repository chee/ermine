{
	"title": "heads in the agreed order: the higher lamport first; at the same lamport, the greater name",
	"steps": [
		{
			"op": "add",
			"name": "a",
			"patches": [{ "path": [], "value": { "n": 0 } }],
			"expect": { "added": "taken" }
		},
		{
			"op": "add",
			"name": "b",
			"parents": ["a"],
			"patches": [{ "path": ["n"], "value": 1 }],
			"expect": { "added": "taken" }
		},
		{
			"op": "add",
			"name": "c",
			"parents": ["a"],
			"nonce": 1,
			"patches": [{ "path": ["n"], "value": 2 }],
			"expect": { "added": "taken" }
		},
		{
			"op": "name",
			"commit": "b",
			"expect": { "name": "61b882b3f79ae2591eb7c822dc8671ce9d01bb1fea83de8ec11e29eadaeddbf1" }
		},
		{
			"op": "name",
			"commit": "c",
			"expect": { "name": "09f43a95d7bb886707e2a908877c4be38696f16e8e57d9255fecd5ec83cd4b78" }
		},
		{ "op": "heads", "expect": { "heads": ["b", "c"] } },
		{
			"op": "add",
			"name": "d",
			"parents": ["a"],
			"lamport": 7,
			"nonce": 2,
			"patches": [{ "path": ["n"], "value": 3 }],
			"expect": { "added": "taken" }
		},
		{ "op": "heads", "expect": { "heads": ["d", "b", "c"] } },
		{
			"op": "add",
			"name": "e",
			"parents": ["c"],
			"patches": [{ "path": ["n"], "value": 5 }],
			"expect": { "added": "taken" }
		},
		{ "op": "heads", "expect": { "heads": ["d", "e", "b"] } }
	]
}
