{
	"title": "a column of differences: bytes holding n numbers, each at most 8 bytes, none past 2^53 - 1",
	"steps": [
		{
			"op": "make",
			"name": "a",
			"time": 1760000000,
			"nonce": 1,
			"patches": [{ "path": [], "value": { "body": "" } }]
		},
		{
			"op": "make",
			"name": "b",
			"time": 1760000000,
			"nonce": 2,
			"parents": ["a"],
			"patches": [{ "path": ["body"], "range": [0, 0], "value": "h" }]
		},
		{
			"op": "make",
			"name": "c",
			"time": 1760000000,
			"nonce": 3,
			"parents": ["b"],
			"patches": [{ "path": ["body"], "range": [1, 1], "value": "i" }]
		},
		{ "op": "pack", "commits": ["a", "b", "c"], "name": "r" },
		{
			"op": "unpack",
			"run": "r",
			"set": { "time": [1760000000, 1760000000, 1760000000] },
			"expect": { "error": "differences", "column": "time" }
		},
		{
			"op": "unpack",
			"run": "r",
			"set": { "time": { "/": { "bytes": "gOC7jg0A" } } },
			"expect": { "error": "differences", "column": "time" }
		},
		{
			"op": "unpack",
			"run": "r",
			"set": { "time": { "/": { "bytes": "gOC7jg0AAAA" } } },
			"expect": { "error": "differences", "column": "time" }
		},
		{
			"op": "unpack",
			"run": "r",
			"set": { "time": { "/": { "bytes": "gOC7jg0AgA" } } },
			"expect": { "error": "differences", "column": "time" }
		},
		{
			"op": "unpack",
			"run": "r",
			"set": { "nonce": { "/": { "bytes": "gICAgICAgIAAAgI" } } },
			"expect": { "error": "differences", "column": "nonce" }
		},
		{
			"op": "unpack",
			"run": "r",
			"set": { "nonce": { "/": { "bytes": "/////////38CAg" } } },
			"expect": { "error": "differences", "column": "nonce" }
		},
		{
			"op": "unpack",
			"run": "r",
			"set": { "lamport": { "/": { "bytes": "/v///////x8CAg" } } },
			"expect": { "error": "differences", "column": "lamport" }
		},
		{
			"op": "unpack",
			"run": "r",
			"drop": ["lamport"],
			"expect": { "error": "differences", "column": "lamport" }
		},
		{
			"op": "unpack",
			"run": "r",
			"set": { "time": { "/": { "bytes": "AQAA" } } },
			"expect": { "error": "commit" }
		}
	]
}
