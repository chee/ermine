{
	"title": "parents: a list of n, each a list of refs, or null after the first",
	"steps": [
		{
			"op": "make",
			"name": "a",
			"time": 1760000000,
			"nonce": 1,
			"patches": [{ "path": [], "value": { "body": "" } }]
		},
		{
			"op": "make",
			"name": "b",
			"time": 1760000000,
			"nonce": 2,
			"parents": ["a"],
			"patches": [{ "path": ["body"], "range": [0, 0], "value": "h" }]
		},
		{
			"op": "make",
			"name": "c",
			"time": 1760000000,
			"nonce": 3,
			"parents": ["b"],
			"patches": [{ "path": ["body"], "range": [1, 1], "value": "i" }]
		},
		{ "op": "pack", "commits": ["a", "b", "c"], "name": "r" },
		{
			"op": "unpack",
			"run": "r",
			"set": { "parents": [[], null] },
			"expect": { "error": "parents" }
		},
		{
			"op": "unpack",
			"run": "r",
			"set": { "parents": [null, null, null] },
			"expect": { "error": "parents" }
		},
		{
			"op": "unpack",
			"run": "r",
			"set": { "parents": [[], 5, null] },
			"expect": { "error": "parents" }
		},
		{ "op": "unpack", "run": "r", "set": { "parents": "a" }, "expect": { "error": "parents" } },
		{ "op": "unpack", "run": "r", "drop": ["parents"], "expect": { "error": "parents" } }
	]
}
