{
	"title": "a run written longhand unpacks the same: a stretch split in two, a parent by its place, an insert as a list, a number in more bytes than it needs",
	"steps": [
		{
			"op": "make",
			"name": "a",
			"time": 1760000000,
			"nonce": 1,
			"patches": [{ "path": [], "value": { "body": "" } }]
		},
		{
			"op": "make",
			"name": "b",
			"time": 1760000000,
			"nonce": 2,
			"parents": ["a"],
			"patches": [{ "path": ["body"], "range": [0, 0], "value": "h" }]
		},
		{
			"op": "make",
			"name": "c",
			"time": 1760000000,
			"nonce": 3,
			"parents": ["b"],
			"patches": [{ "path": ["body"], "range": [1, 1], "value": "i" }]
		},
		{ "op": "pack", "commits": ["a", "b", "c"], "name": "r" },
		{
			"op": "unpack",
			"run": "r",
			"set": { "table": [["value", 1], ["value", 2]] },
			"expect": { "sealed": ["a", "b", "c"] }
		},
		{
			"op": "unpack",
			"run": "r",
			"set": { "parents": [[], [0], [1]] },
			"expect": { "sealed": ["a", "b", "c"] }
		},
		{
			"op": "unpack",
			"run": "r",
			"set": {
				"patches": [
					[{ "path": [], "value": { "body": "" } }],
					[{ "path": ["body"], "range": [0, 0], "value": "h" }],
					[{ "path": ["body"], "range": [1, 1], "value": "i" }]
				]
			},
			"expect": { "sealed": ["a", "b", "c"] }
		},
		{
			"op": "unpack",
			"run": "r",
			"set": { "nonce": { "/": { "bytes": "ggCCgAAC" } } },
			"expect": { "sealed": ["a", "b", "c"] }
		}
	]
}
