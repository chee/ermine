{
	"title": "bytes that are not a pack are refused",
	"steps": [
		{ "op": "tables", "snapshot": "ff", "expect": { "error": "not-a-pack" } },
		{ "op": "tables", "value": [], "expect": { "error": "not-a-pack" } },
		{
			"op": "tables",
			"value": { "keys": [], "nodes": [], "more": 1 },
			"expect": { "error": "not-a-pack" }
		},
		{
			"op": "tables",
			"value": { "keys": [["value", "", 0]], "nodes": [{ "value": 1 }] },
			"expect": { "error": "not-a-pack" }
		},
		{
			"op": "tables",
			"value": {
				"keys": [["value", "", 1]],
				"nodes": [{ "value": 1, "change": { "time": 0 } }]
			},
			"expect": { "error": "not-a-pack" }
		},
		{
			"op": "tables",
			"value": {
				"keys": [["value", "", 0]],
				"nodes": [{ "value": 1, "change": { "time": 0 } }]
			},
			"expect": { "tables": { "value": { "value": 1, "change": { "time": 0 } } } }
		}
	]
}
