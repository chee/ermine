{
	"title": "the ephemeral history holds every stored commit too, so an ephemeral commit can go on from one",
	"steps": [
		{
			"op": "device",
			"name": "a",
			"seed": "0101010101010101010101010101010101010101010101010101010101010101",
			"expect": { "key": "8a88e3dd7409f195fd52db2d3cba5d72ca6709bf1d94121bf3748801b40f6f5c" }
		},
		{
			"op": "device",
			"name": "b",
			"seed": "0202020202020202020202020202020202020202020202020202020202020202",
			"expect": { "key": "8139770ea87d175f56a35466c34c7ecccb8d8a91b4ee37a25df60f5b8fc9b394" }
		},
		{ "op": "follow", "device": "a", "expect": {} },
		{ "op": "follow", "device": "b", "expect": {} },
		{ "op": "connect", "a": "a", "b": "b", "expect": {} },
		{
			"op": "take",
			"device": "a",
			"name": "c1",
			"nonce": 1,
			"patches": [{ "path": [], "value": { "n": 1 } }],
			"expect": { "added": "taken" }
		},
		{ "op": "quiet", "expect": {} },
		{
			"op": "take",
			"device": "a",
			"name": "e",
			"layer": "ephemeral",
			"nonce": 5,
			"parents": ["c1"],
			"patches": [{ "path": ["n"], "value": 9 }],
			"expect": { "added": "taken" }
		},
		{ "op": "quiet", "expect": {} },
		{ "op": "heads", "device": "b", "expect": { "heads": ["c1"] } },
		{ "op": "heads", "device": "b", "layer": "ephemeral", "expect": { "heads": ["e"] } },
		{
			"op": "arrived",
			"device": "b",
			"expect": {
				"arrived": [
					[
						"ermine://2a2a2a2a2a2a2a2a2a2a2a2a2a2a2a2a00000000000000000000000000000000",
						"stored",
						"c1",
						false
					],
					[
						"ermine://2a2a2a2a2a2a2a2a2a2a2a2a2a2a2a2a00000000000000000000000000000000",
						"ephemeral",
						"c1",
						false
					],
					[
						"ermine://2a2a2a2a2a2a2a2a2a2a2a2a2a2a2a2a00000000000000000000000000000000",
						"ephemeral",
						"e",
						true
					]
				]
			}
		}
	]
}
