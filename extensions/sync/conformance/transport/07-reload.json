{
	"title": "a device made again on its storage takes in its fragments, then its loose commits, each announced",
	"steps": [
		{
			"op": "device",
			"name": "a",
			"seed": "0101010101010101010101010101010101010101010101010101010101010101",
			"storage": "s",
			"expect": { "key": "ed018a88e3dd7409f195fd52db2d3cba5d72ca6709bf1d94121bf3748801b40f6f5c" }
		},
		{ "op": "follow", "device": "a", "expect": {} },
		{
			"op": "take",
			"device": "a",
			"name": "c1",
			"nonce": 1,
			"patches": [{ "path": [], "value": { "n": 1 } }],
			"expect": { "added": "taken" }
		},
		{
			"op": "take",
			"device": "a",
			"name": "c2",
			"nonce": 1528,
			"parents": ["c1"],
			"patches": [{ "path": ["n"], "value": 2 }],
			"expect": { "added": "taken" }
		},
		{
			"op": "take",
			"device": "a",
			"name": "c3",
			"nonce": 1529,
			"parents": ["c2"],
			"patches": [{ "path": ["n"], "value": 3 }],
			"expect": { "added": "taken" }
		},
		{ "op": "quiet", "expect": {} },
		{ "op": "close", "device": "a", "expect": {} },
		{
			"op": "device",
			"name": "a2",
			"seed": "0101010101010101010101010101010101010101010101010101010101010101",
			"storage": "s",
			"expect": { "key": "ed018a88e3dd7409f195fd52db2d3cba5d72ca6709bf1d94121bf3748801b40f6f5c" }
		},
		{ "op": "quiet", "expect": {} },
		{ "op": "heads", "device": "a2", "expect": { "heads": ["c3"] } },
		{ "op": "heads", "device": "a2", "layer": "ephemeral", "expect": { "heads": ["c3"] } },
		{
			"op": "fragments",
			"device": "a2",
			"expect": { "fragments": [{ "head": "c2", "members": ["c2", "c1"], "boundary": [] }] }
		},
		{
			"op": "snapshot",
			"device": "a2",
			"commit": "c2",
			"expect": {
				"tables": { "value": { "value": { "n": 2 }, "change": { "time": 0, "actor": null } } }
			}
		},
		{
			"op": "arrived",
			"device": "a2",
			"expect": {
				"arrived": [
					[
						"ermine://2a2a2a2a2a2a2a2a2a2a2a2a2a2a2a2a00000000000000000000000000000000",
						"stored",
						"c1",
						false
					],
					[
						"ermine://2a2a2a2a2a2a2a2a2a2a2a2a2a2a2a2a00000000000000000000000000000000",
						"ephemeral",
						"c1",
						false
					],
					[
						"ermine://2a2a2a2a2a2a2a2a2a2a2a2a2a2a2a2a00000000000000000000000000000000",
						"stored",
						"c2",
						false
					],
					[
						"ermine://2a2a2a2a2a2a2a2a2a2a2a2a2a2a2a2a00000000000000000000000000000000",
						"ephemeral",
						"c2",
						false
					],
					[
						"ermine://2a2a2a2a2a2a2a2a2a2a2a2a2a2a2a2a00000000000000000000000000000000",
						"stored",
						"c3",
						false
					],
					[
						"ermine://2a2a2a2a2a2a2a2a2a2a2a2a2a2a2a2a00000000000000000000000000000000",
						"ephemeral",
						"c3",
						false
					]
				]
			}
		}
	]
}
