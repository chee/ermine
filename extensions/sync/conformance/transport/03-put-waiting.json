{
	"title": "a loose commit whose parent's seal is not here waits on it; then both come in, announced",
	"steps": [
		{
			"op": "device",
			"name": "a",
			"seed": "0101010101010101010101010101010101010101010101010101010101010101",
			"expect": { "key": "8a88e3dd7409f195fd52db2d3cba5d72ca6709bf1d94121bf3748801b40f6f5c" }
		},
		{
			"op": "make",
			"name": "c1",
			"nonce": 1,
			"patches": [{ "path": [], "value": { "n": 1 } }],
			"expect": {}
		},
		{
			"op": "make",
			"name": "c2",
			"nonce": 137,
			"parents": ["c1"],
			"patches": [{ "path": ["n"], "value": 2 }],
			"expect": {}
		},
		{ "op": "put", "device": "a", "commit": "c2", "expect": {} },
		{ "op": "quiet", "expect": {} },
		{
			"op": "taking",
			"device": "a",
			"expect": { "waiting": [{ "commit": "c2", "waiting": ["c1"] }], "refused": [] }
		},
		{ "op": "heads", "device": "a", "expect": { "heads": [] } },
		{ "op": "put", "device": "a", "commit": "c1", "expect": {} },
		{ "op": "quiet", "expect": {} },
		{ "op": "taking", "device": "a", "expect": { "waiting": [], "refused": [] } },
		{ "op": "heads", "device": "a", "expect": { "heads": ["c2"] } },
		{
			"op": "arrived",
			"device": "a",
			"expect": {
				"arrived": [
					[
						"ermine://2a2a2a2a2a2a2a2a2a2a2a2a2a2a2a2a00000000000000000000000000000000",
						"stored",
						"c1",
						false
					],
					[
						"ermine://2a2a2a2a2a2a2a2a2a2a2a2a2a2a2a2a00000000000000000000000000000000",
						"ephemeral",
						"c1",
						false
					],
					[
						"ermine://2a2a2a2a2a2a2a2a2a2a2a2a2a2a2a2a00000000000000000000000000000000",
						"stored",
						"c2",
						false
					],
					[
						"ermine://2a2a2a2a2a2a2a2a2a2a2a2a2a2a2a2a00000000000000000000000000000000",
						"ephemeral",
						"c2",
						false
					]
				]
			}
		}
	]
}
