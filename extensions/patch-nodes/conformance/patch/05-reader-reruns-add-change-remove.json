				{
					"path": [
						"patches",
						0,
						"value"
					],
					"value": "b"
				}
			],
			"expect": {}
		},
		{
			"op": "pulse",
			"expect": {}
		},
		{
			"op": "state",
			"name": "n",
			"expect": {
				"runs": 3,
				"value": "b"
			}
		},
		{
			"op": "del",
			"part": "patch",
			"id": "P",
			"expect": {}
		},
		{
			"op": "pulse",
			"expect": {}
		},
		{
			"op": "state",
			"name": "n",
			"expect": {
				"runs": 4,
				"value": "base"
			}
		},
		{
			"op": "state",
			"name": "m",
			"expect": {
