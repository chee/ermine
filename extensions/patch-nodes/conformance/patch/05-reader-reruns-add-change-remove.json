		},
		{
			"op": "patch",
			"id": "P",
			"on": "N",
			"patches": [
				{
					"path": [
						"title"
					],
					"value": "a"
				}
			],
			"expect": {}
		},
		{
			"op": "pulse",
			"expect": {}
		},
		{
			"op": "state",
			"name": "n",
			"expect": {
				"runs": 2,
				"value": "a"
			}
		},
		{
			"op": "edit",
			"part": "patch",
			"id": "P",
