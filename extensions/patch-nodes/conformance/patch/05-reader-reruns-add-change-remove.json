{
	"title": "a reader reruns on a patch node added, changed and taken out; another node's reader never",
	"steps": [
		{
			"op": "value",
			"id": "N",
			"value": {
				"title": "base"
			},
			"expect": {}
		},
		{
			"op": "value",
			"id": "O",
			"value": {
				"title": "other"
			},
			"expect": {}
		},
		{
			"op": "root",
			"name": "o",
			"expect": {}
		},
		{
			"op": "watch",
			"name": "n",
			"scope": "o",
			"f": {
				"read": [
					"N",
					[
						"title"
					]
				]
			},
			"expect": {}
		},
		{
			"op": "watch",
			"name": "m",
			"scope": "o",
			"f": {
				"read": [
					"O",
					[
						"title"
					]
				]
			},
			"expect": {}
		},
		{
			"op": "pulse",
			"expect": {}
		},
		{
			"op": "state",
			"name": "n",
			"expect": {
				"runs": 1,
				"value": "base"
