		{
			"op": "pulse",
			"expect": {}
		},
		{
			"op": "state",
			"name": "n",
			"expect": {
				"runs": 6,
				"value": "base"
			}
		},
		{
			"op": "state",
			"name": "m",
			"expect": {
				"runs": 2,
				"value": "q"
			}
		},
		{
			"op": "index",
			"id": "N",
			"expect": {
				"ids": []
			}
		},
		{
			"op": "index",
			"id": "O",
			"expect": {
				"ids": [
					"Q"
				]
			}
		}
