{
	"title": "a loader that throws refuses: the caller gets the error, the call's record says failed, nothing is started",
	"steps": [
		{
			"op": "node",
			"path": "/apps/p",
			"value": 1,
			"expect": {}
		},
		{
			"op": "loader",
			"path": "/loaders/no",
			"kind": "refuse",
			"expect": {}
		},
		{
			"op": "run",
			"loader": "/loaders/no",
			"program": "/apps/p",
			"at": "/work/p",
			"fails": true
		},
		{
			"op": "call",
			"loader": "/loaders/no",
			"program": "/apps/p",
			"expect": {
				"end": "failed",
				"error": "no native code here",
				"readsProgram": true
			}
		},
		{
			"op": "has",
			"path": "/work/p",
			"expect": {
				"has": false
			}
		}
	]
}
