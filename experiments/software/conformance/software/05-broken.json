{
	"title": "a setup that throws fails its process, not the call",
	"steps": [
		{
			"op": "node",
			"path": "/apps/p",
			"value": 1,
			"expect": {}
		},
		{
			"op": "loader",
			"path": "/loaders/bad",
			"kind": "broken",
			"expect": {}
		},
		{
			"op": "run",
			"loader": "/loaders/bad",
			"program": "/apps/p",
			"at": "/work/p",
			"expect": {
				"at": [
					"work",
					"p"
				]
			}
		},
		{
			"op": "status",
			"path": "/work/p",
			"expect": {
				"state": "failed"
			}
		},
		{
			"op": "call",
			"loader": "/loaders/bad",
			"program": "/apps/p",
			"expect": {
				"end": "done",
				"readsProgram": true
			}
		}
	]
}
