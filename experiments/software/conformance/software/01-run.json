{
	"title": "a loader placed by the host, a program node run through it: a process at `at`, setup run once, what the loader made of the code its value; the same place again: taken; the call record shows the loader's end and the program among its reads",
	"steps": [
		{
			"op": "node",
			"path": "/apps/five",
			"value": 5,
			"expect": {}
		},
		{
			"op": "loader",
			"path": "/loaders/double",
			"kind": "double",
			"expect": {}
		},
		{
			"op": "run",
			"loader": "/loaders/double",
			"program": "/apps/five",
			"at": "/work/five",
			"expect": {
				"at": [
					"work",
					"five"
				]
			}
		},
		{
			"op": "read",
			"path": "/work/five",
			"expect": {
				"value": 10
			}
		},
		{
			"op": "status",
			"path": "/work/five",
			"expect": {
				"state": "done"
			}
		},
		{
			"op": "run",
			"loader": "/loaders/double",
			"program": "/apps/five",
			"at": "/work/five",
			"expect": {
				"refused": "taken",
				"at": [
					"work",
					"five"
				]
			}
		},
		{
			"op": "call",
			"loader": "/loaders/double",
			"program": "/apps/five",
			"expect": {
				"end": "done",
				"readsProgram": true
			}
		},
		{
			"op": "log",
			"expect": {
				"log": [
					[
						"ran",
						5
					]
				]
			}
		}
	]
}
