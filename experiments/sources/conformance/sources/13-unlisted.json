{
	"title": "a holder that can't list: nothing pulled from it by since; asked by node, it gives that node",
	"steps": [
		{ "op": "graph", "name": "A" },
		{ "op": "graph", "name": "B" },
		{ "op": "memory", "name": "H", "lists": false },
		{ "op": "link", "name": "AH", "a": "A", "b": "H" },
		{ "op": "link", "name": "HB", "a": "H", "b": "B" },
		{ "op": "set", "graph": "A", "node": "N", "value": 1 },
		{ "op": "set", "graph": "A", "node": "K", "value": 1 },
		{
			"op": "sync",
			"link": "AH",
			"skip": ["ba"],
			"expect": { "ab": { "sent": 2, "taken": 2, "passed": 0, "refused": [], "behind": false } }
		},
		{
			"op": "sync",
			"link": "HB",
			"skip": ["ba"],
			"expect": { "ab": { "sent": 0, "taken": 0, "passed": 0, "refused": [], "behind": false } }
		},
		{
			"op": "fetch",
			"link": "HB",
			"node": "N",
			"skip": ["ba"],
			"expect": { "ab": { "sent": 1, "taken": 1, "passed": 0, "refused": [], "behind": false } }
		},
		{ "op": "value", "graph": "B", "node": "N", "expect": { "value": 1 } },
		{ "op": "value", "graph": "B", "node": "K", "expect": {} }
	]
}
