{
	"title": "a file holder whose file won't write refuses, holding nothing; once it writes, a new link takes it",
	"steps": [
		{ "op": "graph", "name": "A" },
		{ "op": "file", "name": "F", "file": "graph.cbor" },
		{ "op": "link", "name": "AF", "a": "A", "b": "F" },
		{ "op": "fail", "file": "graph.cbor", "on": true },
		{ "op": "set", "graph": "A", "node": "N", "value": 1 },
		{
			"op": "sync",
			"link": "AF",
			"skip": ["ba"],
			"expect": {
				"ab": { "sent": 1, "taken": 0, "passed": 0, "refused": ["unwritable"], "behind": false }
			}
		},
		{ "op": "writes", "holder": "F", "expect": { "count": 0, "nodes": [] } },
		{ "op": "fail", "file": "graph.cbor", "on": false },
		{ "op": "link", "name": "AF2", "a": "A", "b": "F" },
		{
			"op": "sync",
			"link": "AF2",
			"skip": ["ba"],
			"expect": { "ab": { "sent": 1, "taken": 1, "passed": 0, "refused": [], "behind": false } }
		}
	]
}
