{
	"title": "two holders naming one node: the graph holds the union, the write both hold passed, not added twice; two graphs taking them in either order hold one value",
	"steps": [
		{ "op": "graph", "name": "P" },
		{ "op": "graph", "name": "Q" },
		{ "op": "memory", "name": "H1" },
		{ "op": "memory", "name": "H2" },
		{ "op": "link", "name": "P1", "a": "P", "b": "H1" },
		{ "op": "link", "name": "P2", "a": "P", "b": "H2" },
		{ "op": "link", "name": "Q2", "a": "Q", "b": "H2" },
		{ "op": "set", "graph": "P", "node": "N", "value": 1 },
		{ "op": "sync", "link": "P1", "skip": ["ab", "ba"] },
		{ "op": "sync", "link": "P2", "skip": ["ab", "ba"] },
		{ "op": "sync", "link": "Q2", "skip": ["ab", "ba"] },
		{ "op": "set", "graph": "P", "node": "N", "value": 2 },
		{ "op": "set", "graph": "Q", "node": "N", "value": 3 },
		{ "op": "sync", "link": "P1", "skip": ["ab", "ba"] },
		{ "op": "sync", "link": "Q2", "skip": ["ab", "ba"] },
		{ "op": "writes", "holder": "H1", "expect": { "count": 2, "nodes": ["N", "N"] } },
		{ "op": "writes", "holder": "H2", "expect": { "count": 2, "nodes": ["N", "N"] } },
		{ "op": "graph", "name": "G" },
		{ "op": "graph", "name": "G2" },
		{ "op": "link", "name": "G1", "a": "H1", "b": "G" },
		{ "op": "link", "name": "G2", "a": "H2", "b": "G" },
		{
			"op": "sync",
			"link": "G1",
			"skip": ["ba"],
			"expect": { "ab": { "sent": 2, "taken": 2, "passed": 0, "refused": [], "behind": false } }
		},
		{
			"op": "sync",
			"link": "G2",
			"skip": ["ba"],
			"expect": { "ab": { "sent": 2, "taken": 1, "passed": 1, "refused": [], "behind": false } }
		},
		{ "op": "writes", "holder": "G", "expect": { "count": 3, "nodes": ["N", "N", "N"] } },
		{ "op": "heads", "graph": "G", "node": "N", "expect": { "count": 2 } },
		{ "op": "link", "name": "X2", "a": "H2", "b": "G2" },
		{ "op": "link", "name": "X1", "a": "H1", "b": "G2" },
		{ "op": "sync", "link": "X2", "skip": ["ab", "ba"] },
		{ "op": "sync", "link": "X1", "skip": ["ab", "ba"] },
		{ "op": "same", "graphs": ["G", "G2"], "node": "N", "expect": { "same": true } }
	]
}
