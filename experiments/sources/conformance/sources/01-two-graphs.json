{
	"title": "two graphs through a link: each gets what the other wrote, as a write of its own history",
	"steps": [
		{ "op": "graph", "name": "A" },
		{ "op": "graph", "name": "B" },
		{ "op": "link", "name": "AB", "a": "A", "b": "B" },
		{ "op": "set", "graph": "A", "node": "N", "value": { "x": 1 } },
		{
			"op": "sync",
			"link": "AB",
			"expect": {
				"ab": { "sent": 1, "taken": 1, "passed": 0, "refused": [], "behind": false },
				"ba": { "sent": 0, "taken": 0, "passed": 0, "refused": [], "behind": false }
			}
		},
		{ "op": "value", "graph": "B", "node": "N", "expect": { "value": { "x": 1 } } },
		{ "op": "set", "graph": "B", "node": "N", "value": 2, "path": ["x"] },
		{
			"op": "sync",
			"link": "AB",
			"skip": ["ab"],
			"expect": { "ba": { "sent": 1, "taken": 1, "passed": 0, "refused": [], "behind": false } }
		},
		{ "op": "value", "graph": "A", "node": "N", "expect": { "value": { "x": 2 } } },
		{ "op": "writes", "holder": "A", "expect": { "count": 2, "nodes": ["N", "N"] } },
		{ "op": "writes", "holder": "B", "expect": { "count": 2, "nodes": ["N", "N"] } }
	]
}
