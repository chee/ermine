{
	"title": "a value mirror: a file edited by another process is an ordinary write by the device watching it, synced on like any other; the graph's writes reach the file",
	"steps": [
		{ "op": "graph", "name": "A" },
		{ "op": "graph", "name": "B" },
		{ "op": "set", "graph": "A", "node": "NOTE", "value": "first" },
		{ "op": "mirror", "graph": "A", "node": "NOTE", "file": "note.txt", "actor": "laptop" },
		{ "op": "text", "file": "note.txt", "expect": { "text": "first" } },
		{ "op": "link", "name": "AB", "a": "A", "b": "B", "live": true },
		{ "op": "edit", "file": "note.txt", "text": "edited by hand" },
		{ "op": "settle" },
		{ "op": "value", "graph": "A", "node": "NOTE", "expect": { "value": "edited by hand" } },
		{ "op": "value", "graph": "B", "node": "NOTE", "expect": { "value": "edited by hand" } },
		{ "op": "writes", "holder": "A", "expect": { "count": 2, "nodes": ["NOTE", "NOTE"] } },
		{ "op": "set", "graph": "B", "node": "NOTE", "value": "from b" },
		{ "op": "settle" },
		{ "op": "text", "file": "note.txt", "expect": { "text": "from b" } },
		{ "op": "writes", "holder": "A", "expect": { "count": 3, "nodes": ["NOTE", "NOTE", "NOTE"] } }
	]
}
