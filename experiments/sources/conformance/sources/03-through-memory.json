{
	"title": "A to a holder in memory to B, and back, over two links: each write held once in the middle",
	"steps": [
		{ "op": "graph", "name": "A" },
		{ "op": "graph", "name": "B" },
		{ "op": "memory", "name": "M" },
		{ "op": "link", "name": "AM", "a": "A", "b": "M" },
		{ "op": "link", "name": "MB", "a": "M", "b": "B" },
		{ "op": "set", "graph": "A", "node": "N", "value": "a" },
		{ "op": "sync", "link": "AM", "skip": ["ab", "ba"] },
		{ "op": "sync", "link": "MB", "skip": ["ab", "ba"] },
		{ "op": "value", "graph": "B", "node": "N", "expect": { "value": "a" } },
		{ "op": "set", "graph": "B", "node": "N", "value": "b" },
		{ "op": "sync", "link": "MB", "skip": ["ab", "ba"] },
		{ "op": "sync", "link": "AM", "skip": ["ab", "ba"] },
		{ "op": "value", "graph": "A", "node": "N", "expect": { "value": "b" } },
		{ "op": "writes", "holder": "M", "expect": { "count": 2, "nodes": ["N", "N"] } }
	]
}
