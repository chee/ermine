{
	"title": "a refused put: the holder says why, the link passes it by and goes on; refused writes are not held; a write not named for its content is refused everywhere",
	"steps": [
		{ "op": "graph", "name": "A" },
		{ "op": "memory", "name": "M", "refuse": "secret" },
		{ "op": "link", "name": "AM", "a": "A", "b": "M" },
		{ "op": "set", "graph": "A", "node": "secret", "value": 1 },
		{ "op": "set", "graph": "A", "node": "N", "value": 1 },
		{
			"op": "sync",
			"link": "AM",
			"skip": ["ba"],
			"expect": {
				"ab": { "sent": 2, "taken": 1, "passed": 0, "refused": ["not-here"], "behind": false }
			}
		},
		{ "op": "writes", "holder": "M", "expect": { "count": 1, "nodes": ["N"] } },
		{
			"op": "status",
			"link": "AM",
			"expect": {
				"state": { "code": "in-step", "words": "in step" },
				"known": { "a": 2, "b": 1 },
				"refused": ["not-here"]
			}
		},
		{ "op": "forge", "holder": "M", "expect": { "outcome": { "refused": "misnamed" } } },
		{ "op": "forge", "holder": "A", "expect": { "outcome": { "refused": "misnamed" } } }
	]
}
