{
	"title": "a mirror and a link are processes under /system, each showing on its node its state (code and words: its computer's value) and its records (attributes); a second mirror of one file is refused; those nodes are the device's, never recorded or sent",
	"steps": [
		{ "op": "graph", "name": "A" },
		{ "op": "graph", "name": "B" },
		{ "op": "set", "graph": "A", "node": "NOTE", "value": "hi" },
		{
			"op": "mirror",
			"name": "M",
			"graph": "A",
			"node": "NOTE",
			"file": "note.txt",
			"actor": "laptop"
		},
		{
			"op": "status",
			"mirror": "M",
			"expect": {
				"file": "note.txt",
				"node": "NOTE",
				"state": { "code": "in-step", "words": "in step" },
				"unwritten": 0
			}
		},
		{
			"op": "there",
			"graph": "A",
			"path": ["system", "mirrors", "note.txt"],
			"expect": { "there": true }
		},
		{
			"op": "mirror",
			"name": "M2",
			"graph": "A",
			"node": "OTHER",
			"file": "note.txt",
			"actor": "laptop",
			"expect": { "refused": "taken", "at": ["system", "mirrors", "note.txt"] }
		},
		{ "op": "link", "name": "AB", "a": "A", "b": "B" },
		{
			"op": "status",
			"link": "AB",
			"expect": {
				"state": { "code": "not-synced", "words": "not synced yet" },
				"known": { "a": 0, "b": 0 },
				"refused": []
			}
		},
		{ "op": "sync", "link": "AB", "skip": ["ab", "ba"] },
		{
			"op": "status",
			"link": "AB",
			"expect": {
				"state": { "code": "in-step", "words": "in step" },
				"known": { "a": 1, "b": 1 },
				"refused": []
			}
		},
		{ "op": "writes", "holder": "A", "expect": { "count": 1, "nodes": ["NOTE"] } },
		{ "op": "writes", "holder": "B", "expect": { "count": 1, "nodes": ["NOTE"] } }
	]
}
