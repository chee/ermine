{
	"title": "a log never takes its own device's steps: one seed in two logs, a run of the other chain is refused as own, and reported as a fork",
	"steps": [
		{
			"op": "device",
			"name": "a",
			"seed": "0101010101010101010101010101010101010101010101010101010101010101",
			"expect": {
				"key": "8a88e3dd7409f195fd52db2d3cba5d72ca6709bf1d94121bf3748801b40f6f5c"
			}
		},
		{
			"op": "device",
			"name": "twin",
			"seed": "0101010101010101010101010101010101010101010101010101010101010101",
			"expect": {
				"key": "8a88e3dd7409f195fd52db2d3cba5d72ca6709bf1d94121bf3748801b40f6f5c"
			}
		},
		{
			"op": "write",
			"device": "twin",
			"node": "pig",
			"patches": [
				{
					"path": [],
					"value": 1
				}
			],
			"expect": {
				"n": 1,
				"lamport": 1
			}
		},
		{
			"op": "write",
			"device": "twin",
			"node": "pig",
			"patches": [
				{
					"path": [],
					"value": 2
				}
			],
			"expect": {
				"n": 2,
				"lamport": 2
			}
		},
		{
			"op": "write",
			"device": "a",
			"node": "pig",
			"patches": [
				{
					"path": [],
					"value": 3
				}
			],
			"expect": {
				"n": 1,
				"lamport": 1
			}
		},
		{
			"op": "pass",
			"from": "twin",
			"to": "a",
			"of": "a",
			"at": 1,
			"expect": {
				"refused": "own"
			}
		},
		{
			"op": "count",
			"device": "a",
			"of": "a",
			"expect": {
				"count": 1
			}
		},
		{
			"op": "value",
			"device": "a",
			"node": "pig",
			"expect": {
				"value": 3
			}
		},
		{
			"op": "forks",
			"device": "a",
			"expect": {
				"forks": [
					{
						"device": "a",
						"n": 1,
						"hashes": [
							"5fede455c672696b2836e453d50bbab59e86a8bc4ede5fc6259f1354443940c9",
							"6617c81d0508ce81447c9880c31cbc2f9bd287b296472f7538d2a84be1f7cb40"
						]
					}
				]
			}
		}
	]
}
