{
	"title": "a log never takes its own device's steps: one seed in two logs, a run of the other chain is refused as own, and reported as a fork",
	"steps": [
		{
			"op": "device",
			"name": "a",
			"seed": "0101010101010101010101010101010101010101010101010101010101010101",
			"expect": {
				"key": "8a88e3dd7409f195fd52db2d3cba5d72ca6709bf1d94121bf3748801b40f6f5c"
			}
		},
		{
			"op": "device",
			"name": "twin",
			"seed": "0101010101010101010101010101010101010101010101010101010101010101",
			"expect": {
				"key": "8a88e3dd7409f195fd52db2d3cba5d72ca6709bf1d94121bf3748801b40f6f5c"
			}
		},
		{
			"op": "write",
			"device": "twin",
			"node": "pig",
			"patches": [
				{
					"path": [],
					"value": 1
				}
			],
			"expect": {
				"n": 1,
				"lamport": 1
			}
		},
		{
			"op": "write",
			"device": "twin",
			"node": "pig",
			"patches": [
				{
					"path": [],
					"value": 2
				}
			],
			"expect": {
				"n": 2,
				"lamport": 2
			}
		},
		{
			"op": "write",
			"device": "a",
			"node": "pig",
			"patches": [
				{
					"path": [],
					"value": 3
				}
			],
			"expect": {
				"n": 1,
				"lamport": 1
			}
		},
		{
			"op": "pass",
			"from": "twin",
			"to": "a",
			"of": "a",
			"at": 1,
			"expect": {
				"refused": "own"
			}
		},
		{
			"op": "count",
			"device": "a",
			"of": "a",
			"expect": {
				"count": 1
			}
		},
		{
			"op": "value",
			"device": "a",
			"node": "pig",
			"expect": {
				"value": 3
			}
		},
		{
			"op": "forks",
			"device": "a",
			"expect": {
				"forks": [
					{
						"device": "a",
						"n": 1,
						"hashes": [
							"8545ef947e33bf123f8a55f5eb8ac2387aa02ab6b3e0d531a48397f06927086e",
							"dafb4f3f83016a3309641f12b9a7debffa79ab9c36808fed2fbd7176d3212b5e"
						]
					}
				]
			}
		}
	]
}
