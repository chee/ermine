{
	"title": "a log never takes its own device's steps: one seed in two logs forks nothing",
	"steps": [
		{
			"op": "device",
			"name": "a",
			"seed": "0101010101010101010101010101010101010101010101010101010101010101",
			"expect": {
				"key": "8a88e3dd7409f195fd52db2d3cba5d72ca6709bf1d94121bf3748801b40f6f5c"
			}
		},
		{
			"op": "device",
			"name": "twin",
			"seed": "0101010101010101010101010101010101010101010101010101010101010101",
			"expect": {
				"key": "8a88e3dd7409f195fd52db2d3cba5d72ca6709bf1d94121bf3748801b40f6f5c"
			}
		},
		{
			"op": "write",
			"device": "twin",
			"node": "pig",
			"patches": [
				{
					"path": [],
					"value": 1
				}
			],
			"expect": {
				"n": 1,
				"lamport": 1
			}
		},
		{
			"op": "write",
			"device": "twin",
			"node": "pig",
			"patches": [
				{
					"path": [],
					"value": 2
				}
			],
			"expect": {
				"n": 2,
				"lamport": 2
			}
		},
		{
			"op": "write",
			"device": "a",
			"node": "pig",
			"patches": [
				{
					"path": [],
					"value": 3
				}
			],
			"expect": {
				"n": 1,
				"lamport": 1
			}
		},
		{
			"op": "pass",
			"from": "twin",
			"to": "a",
			"of": "a",
			"at": 1,
			"expect": {
				"refused": "own"
			}
		},
		{
			"op": "count",
			"device": "a",
			"of": "a",
			"expect": {
				"count": 1
			}
		},
		{
			"op": "value",
			"device": "a",
			"node": "pig",
			"expect": {
				"value": 3
			}
		}
	]
}
