CONFIG_IDF_TARGET="esp32s3"
CONFIG_ESPTOOLPY_FLASHSIZE_8MB=y
# partitions.csv: the app, NVS, and the den's FAT file system
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_240=y
CONFIG_COMPILER_OPTIMIZATION_PERF=y
CONFIG_ESP_MAIN_TASK_STACK_SIZE=16384
CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y
CONFIG_FREERTOS_HZ=1000
# https (main/wifi.c): a server's certificate checked against ESP-IDF's common CAs (ISRG Root X1 for
# galaxy.observer's Let's Encrypt chain)
CONFIG_MBEDTLS_CERTIFICATE_BUNDLE=y
CONFIG_MBEDTLS_CERTIFICATE_BUNDLE_DEFAULT_CMN=y
# room in the heap for the den, WiFi and two TLS connections at once (no PSRAM): fewer WiFi buffers,
# and mbedtls' buffers made per record and let go after
CONFIG_ESP_WIFI_STATIC_RX_BUFFER_NUM=4
CONFIG_ESP_WIFI_DYNAMIC_RX_BUFFER_NUM=16
CONFIG_ESP_WIFI_DYNAMIC_TX_BUFFER_NUM=16
CONFIG_MBEDTLS_DYNAMIC_BUFFER=y
CONFIG_MBEDTLS_DYNAMIC_FREE_CONFIG_DATA=y
CONFIG_MBEDTLS_DYNAMIC_FREE_CA_CERT=y
CONFIG_MBEDTLS_SSL_IN_CONTENT_LEN=10240
# the den's log on FAT (main/flash.c): 512-byte sectors (a 512-byte window in RAM, not 4 KB), 8.3
# names only (the log's are: log, key, snapshot), one volume
CONFIG_WL_SECTOR_SIZE_512=y
CONFIG_FATFS_SECTOR_512=y
CONFIG_FATFS_LFN_NONE=y
CONFIG_FATFS_VOLUME_COUNT=1
