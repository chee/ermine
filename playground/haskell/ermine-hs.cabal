cabal-version: 3.0
name:          ermine-hs
version:       0.1.0
synopsis:      A third implementation of ermine's core libraries, built from their conformance suites
build-type:    Simple

common shared
  default-language: GHC2021
  ghc-options:      -O1 -Wall -Wno-name-shadowing -Wno-unused-do-bind
  build-depends:    base, containers, bytestring, text, mtl, time

library
  import:          shared
  hs-source-dirs:  src
  exposed-modules: Json Form Line Apply Invert Squish Header Table Tracker Paths

executable apply-harness
  import:          shared
  hs-source-dirs:  app
  main-is:         ApplyHarness.hs
  build-depends:   ermine-hs

executable squish-harness
  import:          shared
  hs-source-dirs:  app
  main-is:         SquishHarness.hs
  build-depends:   ermine-hs

executable node-harness
  import:          shared
  hs-source-dirs:  app
  main-is:         NodeHarness.hs
  build-depends:   ermine-hs

executable update-harness
  import:          shared
  hs-source-dirs:  app
  main-is:         UpdateHarness.hs
  build-depends:   ermine-hs

executable table-harness
  import:          shared
  hs-source-dirs:  app
  main-is:         TableHarness.hs
  build-depends:   ermine-hs

executable unread-harness
  import:          shared
  hs-source-dirs:  app
  main-is:         UnreadHarness.hs
  build-depends:   ermine-hs

executable tracker-harness
  import:          shared
  hs-source-dirs:  app
  main-is:         TrackerHarness.hs
  build-depends:   ermine-hs

executable paths-harness
  import:          shared
  hs-source-dirs:  app
  main-is:         PathsHarness.hs
  build-depends:   ermine-hs

executable scheduler-harness
  import:          shared
  hs-source-dirs:  app
  main-is:         SchedulerHarness.hs
  build-depends:   ermine-hs
