{
	"title": "rows past until are not shown before they are swept; sweep takes them at a given time",
	"steps": [
		{
			"op": "now",
			"t": 1000
		},
		{
			"op": "connect",
			"dev": "a",
			"name": "ca",
			"topic": "work"
		},
		{
			"op": "connect",
			"dev": "b",
			"name": "cb",
			"topic": "work"
		},
		{
			"op": "set",
			"dev": "a",
			"anchor": "work",
			"who": "x",
			"value": 1,
			"ttl": 100
		},
		{
			"op": "set",
			"dev": "a",
			"anchor": "work",
			"who": "y",
			"value": 2,
			"ttl": 900
		},
		{
			"op": "now",
			"t": 1100
		},
		{
			"op": "presence",
			"dev": "a",
			"anchor": "work",
			"expect": {
				"rows": [
					{
						"who": "y",
						"value": 2,
						"until": 1900
					}
				]
			}
		},
		{
			"op": "presence",
			"dev": "b",
			"anchor": "work",
			"expect": {
				"rows": [
					{
						"who": "a",
						"value": 2,
						"until": 1900
					}
				]
			}
		},
		{
			"op": "row",
			"dev": "a",
			"anchor": "work",
			"who": "x",
			"expect": {}
		},
		{
			"op": "row",
			"dev": "a",
			"anchor": "work",
			"who": "y",
			"expect": {
				"row": {
					"who": "y",
					"value": 2,
					"until": 1900
				}
			}
		},
		{
			"op": "table",
			"dev": "a",
			"anchor": "work",
			"expect": {
				"value": {
					"x": {
						"value": 1,
						"until": 1100
					},
					"y": {
						"value": 2,
						"until": 1900
					}
				}
			}
		},
		{
			"op": "sweep",
			"dev": "a",
			"at": 1000,
			"expect": {
				"swept": []
			}
		},
		{
			"op": "sweep",
			"dev": "a",
			"expect": {
				"swept": [
					{
						"anchor": "work",
						"who": "x"
					}
				]
			}
		},
		{
			"op": "table",
			"dev": "a",
			"anchor": "work",
			"expect": {
				"value": {
					"y": {
						"value": 2,
						"until": 1900
					}
				}
			}
		}
	]
}
