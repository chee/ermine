			"nonce": 1,
			"patches": [{ "path": [], "value": { "n": 1 } }],
			"expect": { "added": "taken" }
		},
		{ "op": "quiet", "expect": {} },
		{ "op": "close", "device": "a", "expect": {} },
		{
			"op": "device",
			"name": "a2",
			"seed": "0101010101010101010101010101010101010101010101010101010101010101",
			"storage": "s",
			"expect": { "key": "ed018a88e3dd7409f195fd52db2d3cba5d72ca6709bf1d94121bf3748801b40f6f5c" }
		},
		{ "op": "quiet", "expect": {} },
		{ "op": "unnamed", "device": "a2", "expect": { "unnamed": 1 } },
		{ "op": "arrived", "device": "a2", "expect": { "arrived": [] } },
		{ "op": "heads", "device": "a2", "expect": { "heads": [] } },
		{ "op": "unnamed", "device": "a2", "expect": { "unnamed": 0 } },
		{ "op": "quiet", "expect": {} },
		{ "op": "arrived", "device": "a2", "expect": { "arrived": [] } },
		{ "op": "follow", "device": "a2", "expect": {} },
		{ "op": "quiet", "expect": {} },
		{ "op": "heads", "device": "a2", "expect": { "heads": ["c1"] } },
		{
			"op": "arrived",
			"device": "a2",
			"expect": {
