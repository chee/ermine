{
	"title": "a commit with a key no commit has (a later device's): its pack carries its exact bytes, so the name and the seal are the same coming out; a bytes column that is no list is refused",
	"steps": [
		{
			"op": "pack",
			"commits": [""],
			"name": "r",
			"expect": { "pack": "" }
		},
		{
			"op": "unpack",
			"pack": "r",
			"expect": { "sealed": [""] }
		},
		{
			"op": "unpack",
			"pack": "r",
			"set": { "bytes": "x" },
			"expect": { "error": "runs", "column": "bytes" }
		}
	]
}
