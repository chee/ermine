{
	"title": "a merge by a rule not known here is held, not refused: taken in as a head (its parents heads no more), in all, its record carrying the rule; what goes on it is held when it touches its path (its table: a merge's; its patches' key paths), down the line too, and taken when it doesn't; a merge on a line a held one marked is held; one whose patches don't apply to its rule's merge is refused \"patches\" as ever",
	"steps": [
		{
			"op": "add",
			"name": "r",
			"patches": [{ "path": [], "value": { "n": "ab" } }],
			"expect": { "added": "taken" }
		},
		{
			"op": "add",
			"name": "a",
			"parents": ["r"],
			"patches": [{ "path": ["n"], "range": [0, 0], "value": "x" }],
			"expect": { "added": "taken" }
		},
		{
			"op": "add",
			"name": "b",
			"parents": ["r"],
			"patches": [{ "path": ["n"] }],
			"expect": { "added": "taken" }
		},
		{
			"op": "add",
			"name": "m",
			"parents": ["a", "b"],
			"patches": [],
			"merge": "three-way",
			"expect": { "added": "held" }
		},
		{ "op": "heads", "expect": { "heads": ["m"] } },
		{
			"op": "add",
			"name": "w",
			"parents": ["m"],
			"patches": [],
			"expect": { "added": "taken" }
		},
		{
			"op": "add",
			"name": "p",
			"parents": ["a", "b"],
			"patches": [{ "path": ["n"], "range": [0, 1] }],
			"merge": "serial/1",
			"expect": { "added": { "refused": "patches" } }
		},
		{
			"op": "add",
			"name": "q",
			"parents": ["a", "b"],
			"patches": [{ "path": ["k"], "value": 1 }],
			"merge": "serial/1",
			"expect": { "added": "taken" }
		},
		{ "op": "heads", "expect": { "heads": ["w", "q"] } },
		{
			"op": "make",
			"name": "x",
			"parents": ["m"],
			"nonce": 1,
			"patches": [{ "path": ["n"], "value": "y" }]
		},
		{
			"op": "add",
			"name": "t",
			"parents": ["x"],
			"patches": [{ "path": ["n"], "value": "t" }],
			"expect": { "added": { "waiting": ["x"] } }
		},
		{ "op": "add", "name": "x", "expect": { "added": "held" } },
		{
			"op": "add",
			"name": "y",
			"parents": ["m"],
			"nonce": 2,
			"table": "attributes",
			"patches": [{ "path": ["k"], "value": 1 }],
			"expect": { "added": "taken" }
		},
		{
			"op": "add",
			"name": "u",
			"parents": ["w"],
			"patches": [{ "path": ["z"], "value": 1 }],
			"expect": { "added": "held" }
		},
		{
			"op": "add",
			"name": "v",
			"parents": ["y"],
			"table": "attributes",
			"patches": [{ "path": ["j"], "value": 2 }],
			"expect": { "added": "taken" }
		},
		{
			"op": "add",
			"name": "s",
			"parents": ["q", "v"],
			"patches": [],
			"merge": "serial/1",
			"expect": { "added": "held" }
		},
		{
			"op": "held",
			"expect": {
				"held": [
					{ "name": "m", "rule": "three-way" },
					{ "name": "x", "rule": "three-way" },
					{ "name": "t", "rule": "three-way" },
					{ "name": "u", "rule": "three-way" },
					{ "name": "s", "rule": "three-way" }
				]
			}
		},
		{
			"op": "all",
			"expect": { "all": ["r", "a", "b", "m", "w", "q", "x", "t", "y", "u", "v", "s"] }
		},
		{ "op": "heads", "expect": { "heads": ["s", "t", "u"] } },
		{ "op": "refused", "expect": { "refused": [{ "name": "p", "refused": "patches" }] } }
	]
}
