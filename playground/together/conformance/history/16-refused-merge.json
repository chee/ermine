{
	"title": "a merge commit by a rule not known here is refused \"merge\", and what waits on it \"parent\"; one whose patches don't apply to its rule's merge, \"patches\"",
	"steps": [
		{
			"op": "add",
			"name": "r",
			"patches": [
				{
					"path": [],
					"value": {
						"n": "ab"
					}
				}
			],
			"expect": {
				"added": "taken"
			}
		},
		{
			"op": "add",
			"name": "a",
			"parents": [
				"r"
			],
			"patches": [
				{
					"path": [
						"n"
					],
					"range": [
						0,
						0
					],
					"value": "x"
				}
			],
			"expect": {
				"added": "taken"
			}
		},
		{
			"op": "add",
			"name": "b",
			"parents": [
				"r"
			],
			"patches": [
				{
					"path": [
						"n"
					]
				}
			],
			"expect": {
				"added": "taken"
			}
		},
		{
			"op": "add",
			"name": "m",
			"parents": [
				"a",
				"b"
			],
			"patches": [],
			"merge": "three-way",
			"expect": {
				"added": {
					"refused": "merge"
				}
			}
		},
		{
			"op": "add",
			"name": "w",
			"parents": [
				"m"
			],
			"patches": [],
			"expect": {
				"added": {
					"refused": "parent"
				}
			}
		},
		{
			"op": "add",
			"name": "p",
			"parents": [
				"a",
				"b"
			],
			"patches": [
				{
					"path": [
						"n"
					],
					"range": [
						0,
						1
					]
				}
			],
			"merge": "serial",
			"expect": {
				"added": {
					"refused": "patches"
				}
			}
		},
		{
			"op": "add",
			"name": "q",
			"parents": [
				"a",
				"b"
			],
			"patches": [
				{
					"path": [
						"k"
					],
					"value": 1
				}
			],
			"merge": "serial",
			"expect": {
				"added": "taken"
			}
		},
		{
			"op": "heads",
			"expect": {
				"heads": [
					"q"
				]
			}
		},
		{
			"op": "refused",
			"expect": {
				"refused": [
					{
						"name": "m",
						"refused": "merge"
					},
					{
						"name": "w",
						"refused": "parent"
					},
					{
						"name": "p",
						"refused": "patches"
					}
				]
			}
		}
	]
}
