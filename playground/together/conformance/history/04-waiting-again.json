{
	"title": "a commit still waiting is passed when it comes again",
	"steps": [
		{ "op": "make", "name": "a", "patches": [{ "path": [], "value": { "n": 0 } }] },
		{
			"op": "add",
			"name": "b",
			"parents": ["a"],
			"patches": [{ "path": ["n"], "value": 1 }],
			"expect": { "added": { "waiting": ["a"] } }
		},
		{ "op": "add", "name": "b", "expect": { "added": "passed" } },
		{ "op": "waiting", "expect": { "waiting": [{ "name": "b", "waiting": ["a"] }] } }
	]
}
