{
	"title": "a merge of every head is the one head",
	"steps": [
		{
			"op": "add",
			"name": "a",
			"patches": [{ "path": [], "value": { "n": 0 } }],
			"expect": { "added": "taken" }
		},
		{
			"op": "add",
			"name": "b",
			"parents": ["a"],
			"patches": [{ "path": ["n"], "value": 1 }],
			"expect": { "added": "taken" }
		},
		{
			"op": "add",
			"name": "c",
			"parents": ["a"],
			"nonce": 1,
			"patches": [{ "path": ["n"], "value": 2 }],
			"expect": { "added": "taken" }
		},
		{
			"op": "add",
			"name": "d",
			"parents": ["c"],
			"patches": [{ "path": ["n"], "value": 3 }],
			"expect": { "added": "taken" }
		},
		{
			"op": "add",
			"name": "m",
			"parents": ["b", "d"],
			"base": "d",
			"patches": [],
			"expect": { "added": "taken" }
		},
		{ "op": "heads", "expect": { "heads": ["m"] } },
		{
			"op": "add",
			"name": "n",
			"parents": ["m"],
			"patches": [{ "path": ["n"], "value": 4 }],
			"expect": { "added": "taken" }
		},
		{ "op": "heads", "expect": { "heads": ["n"] } }
	]
}
