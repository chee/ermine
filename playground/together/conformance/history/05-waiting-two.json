{
	"title": "a merge waits on each parent not here; it comes in when the last does",
	"steps": [
		{
			"op": "add",
			"name": "a",
			"patches": [
				{
					"path": [],
					"value": {
						"n": 0
					}
				}
			],
			"expect": {
				"added": "taken"
			}
		},
		{
			"op": "make",
			"name": "b",
			"parents": [
				"a"
			],
			"patches": [
				{
					"path": [
						"n"
					],
					"value": 1
				}
			]
		},
		{
			"op": "make",
			"name": "c",
			"parents": [
				"a"
			],
			"nonce": 1,
			"patches": [
				{
					"path": [
						"n"
					],
					"value": 2
				}
			]
		},
		{
			"op": "add",
			"name": "m",
			"parents": [
				"b",
				"c"
			],
			"base": "b",
			"expect": {
				"added": {
					"waiting": [
						"c",
						"b"
					]
				}
			}
		},
		{
			"op": "waiting",
			"expect": {
				"waiting": [
					{
						"name": "m",
						"waiting": [
							"c",
							"b"
						]
					}
				]
			}
		},
		{
			"op": "add",
			"name": "c",
			"expect": {
				"added": "taken"
			}
		},
		{
			"op": "waiting",
			"expect": {
				"waiting": [
					{
						"name": "m",
						"waiting": [
							"b"
						]
					}
				]
			}
		},
		{
			"op": "add",
			"name": "b",
			"expect": {
				"added": "taken"
			}
		},
		{
			"op": "all",
			"expect": {
				"all": [
					"a",
					"c",
					"b",
					"m"
				]
			}
		},
		{
			"op": "heads",
			"expect": {
				"heads": [
					"m"
				]
			}
		}
	]
}
