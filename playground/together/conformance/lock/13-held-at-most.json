{
	"title": "what waits on the lock is held at most as many as the pending limit, the oldest let go of past it (still stored: it comes in again as the device starts)",
	"steps": [
		{
			"op": "device",
			"name": "a",
			"seed": "0101010101010101010101010101010101010101010101010101010101010101",
			"lock": "tag",
			"storage": "s",
			"limits": { "pending": 1 },
			"expect": { "key": "ed018a88e3dd7409f195fd52db2d3cba5d72ca6709bf1d94121bf3748801b40f6f5c" }
		},
		{ "op": "lock", "device": "a", "open": "wait", "expect": {} },
		{
			"op": "make",
			"name": "c1",
			"nonce": 1,
			"patches": [{ "path": [], "value": { "n": 1 } }],
			"expect": {}
		},
		{
			"op": "make",
			"name": "d1",
			"nonce": 2,
			"patches": [{ "path": [], "value": { "m": 1 } }],
			"expect": {}
		},
		{ "op": "put", "device": "a", "commit": "c1", "closed": true, "expect": {} },
		{ "op": "quiet", "expect": {} },
		{ "op": "put", "device": "a", "commit": "d1", "closed": true, "expect": {} },
		{ "op": "quiet", "expect": {} },
		{
			"op": "taking",
			"device": "a",
			"expect": { "waiting": [{ "commit": "d1", "waiting": [] }], "refused": [] }
		},
		{ "op": "stored", "device": "a", "expect": { "stored": ["d1", "c1"] } },
		{ "op": "lock", "device": "a", "open": "tag", "expect": {} },
		{ "op": "changed", "device": "a", "expect": {} },
		{ "op": "quiet", "expect": {} },
		{ "op": "heads", "device": "a", "expect": { "heads": ["d1"] } },
		{ "op": "taking", "device": "a", "expect": { "waiting": [], "refused": [] } },
		{ "op": "close", "device": "a", "expect": {} },
		{
			"op": "device",
			"name": "a",
			"seed": "0101010101010101010101010101010101010101010101010101010101010101",
			"lock": "tag",
			"storage": "s",
			"limits": { "pending": 1 },
			"expect": { "key": "ed018a88e3dd7409f195fd52db2d3cba5d72ca6709bf1d94121bf3748801b40f6f5c" }
		},
		{ "op": "follow", "device": "a", "expect": {} },
		{ "op": "quiet", "expect": {} },
		{ "op": "heads", "device": "a", "expect": { "heads": ["d1", "c1"] } }
	]
}
