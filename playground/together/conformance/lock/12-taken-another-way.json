{
	"title": "a commit waiting on the lock that is taken in another way (a fragment the lock opens) waits no more: it is not shown waiting, and the device told finds nothing to open again",
	"steps": [
		{
			"op": "device",
			"name": "a",
			"seed": "0101010101010101010101010101010101010101010101010101010101010101",
			"lock": "tag",
			"expect": { "key": "ed018a88e3dd7409f195fd52db2d3cba5d72ca6709bf1d94121bf3748801b40f6f5c" }
		},
		{ "op": "lock", "device": "a", "open": "wait", "expect": {} },
		{
			"op": "make",
			"name": "c1",
			"nonce": 1,
			"patches": [{ "path": [], "value": { "n": 1 } }],
			"expect": {}
		},
		{
			"op": "make",
			"name": "c2",
			"nonce": 109,
			"parents": ["c1"],
			"patches": [{ "path": ["n"], "value": 2 }],
			"expect": {}
		},
		{ "op": "put", "device": "a", "commit": "c1", "closed": true, "expect": {} },
		{ "op": "quiet", "expect": {} },
		{
			"op": "taking",
			"device": "a",
			"expect": { "waiting": [{ "commit": "c1", "waiting": [] }], "refused": [] }
		},
		{ "op": "lock", "device": "a", "open": "tag", "expect": {} },
		{
			"op": "fragment",
			"device": "a",
			"head": "c2",
			"members": ["c1", "c2"],
			"closed": true,
			"expect": {}
		},
		{ "op": "quiet", "expect": {} },
		{ "op": "heads", "device": "a", "expect": { "heads": ["c2"] } },
		{ "op": "taking", "device": "a", "expect": { "waiting": [], "refused": [] } },
		{ "op": "calls", "device": "a", "expect": { "closed": [], "opened": true } },
		{ "op": "changed", "device": "a", "expect": {} },
		{ "op": "quiet", "expect": {} },
		{ "op": "taking", "device": "a", "expect": { "waiting": [], "refused": [] } },
		{ "op": "calls", "device": "a", "expect": { "closed": [], "opened": false } }
	]
}
