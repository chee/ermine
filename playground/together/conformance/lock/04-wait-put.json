{
	"title": "a lock that cannot open yet holds a commit: waiting with no parents named, stored, in no history; the lock changing and the device told opens it again",
	"steps": [
		{
			"op": "device",
			"name": "a",
			"seed": "0101010101010101010101010101010101010101010101010101010101010101",
			"lock": "tag",
			"expect": { "key": "ed018a88e3dd7409f195fd52db2d3cba5d72ca6709bf1d94121bf3748801b40f6f5c" }
		},
		{ "op": "follow", "device": "a", "expect": {} },
		{ "op": "lock", "device": "a", "open": "wait", "expect": {} },
		{
			"op": "make",
			"name": "c1",
			"nonce": 1,
			"patches": [{ "path": [], "value": { "n": 1 } }],
			"expect": {}
		},
		{
			"op": "make",
			"name": "c2",
			"nonce": 444,
			"parents": ["c1"],
			"patches": [{ "path": ["n"], "value": 2 }],
			"expect": {}
		},
		{ "op": "put", "device": "a", "commit": "c2", "closed": true, "expect": {} },
		{ "op": "put", "device": "a", "commit": "c1", "closed": true, "expect": {} },
		{ "op": "quiet", "expect": {} },
		{
			"op": "taking",
			"device": "a",
			"expect": {
				"waiting": [{ "commit": "c2", "waiting": [] }, { "commit": "c1", "waiting": [] }],
				"refused": []
			}
		},
		{ "op": "heads", "device": "a", "expect": { "heads": [] } },
		{ "op": "stored", "device": "a", "expect": { "stored": ["c2", "c1"] } },
		{ "op": "calls", "device": "a", "expect": { "closed": [], "opened": true } },
		{ "op": "quiet", "expect": {} },
		{
			"op": "taking",
			"device": "a",
			"expect": {
				"waiting": [{ "commit": "c2", "waiting": [] }, { "commit": "c1", "waiting": [] }],
				"refused": []
			}
		},
		{ "op": "heads", "device": "a", "expect": { "heads": [] } },
		{ "op": "lock", "device": "a", "open": "tag", "expect": {} },
		{ "op": "heads", "device": "a", "expect": { "heads": [] } },
		{
			"op": "taking",
			"device": "a",
			"expect": {
				"waiting": [{ "commit": "c2", "waiting": [] }, { "commit": "c1", "waiting": [] }],
				"refused": []
			}
		},
		{ "op": "changed", "device": "a", "expect": {} },
		{ "op": "quiet", "expect": {} },
		{ "op": "taking", "device": "a", "expect": { "waiting": [], "refused": [] } },
		{ "op": "heads", "device": "a", "expect": { "heads": ["c2"] } },
		{
			"op": "arrived",
			"device": "a",
			"expect": {
				"arrived": [
					["ermine:00102a2a2a2a2a2a2a2a2a2a2a2a2a2a2a2a", "stored", "c1", false],
					["ermine:00102a2a2a2a2a2a2a2a2a2a2a2a2a2a2a2a", "ephemeral", "c1", false],
					["ermine:00102a2a2a2a2a2a2a2a2a2a2a2a2a2a2a2a", "stored", "c2", false],
					["ermine:00102a2a2a2a2a2a2a2a2a2a2a2a2a2a2a2a", "ephemeral", "c2", false]
				]
			}
		}
	]
}
