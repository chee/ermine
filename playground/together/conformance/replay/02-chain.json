{
	"title": "along a chain, each commit's tables are its patches applied in order from the root",
	"steps": [
		{
			"op": "add",
			"name": "a",
			"patches": [{ "path": [], "value": { "n": 0, "list": [] } }],
			"expect": { "added": "taken" }
		},
		{
			"op": "add",
			"name": "b",
			"parents": ["a"],
			"time": 1,
			"patches": [{ "path": ["n"], "value": 1 }],
			"expect": { "added": "taken" }
		},
		{
			"op": "add",
			"name": "c",
			"parents": ["b"],
			"time": 2,
			"patches": [{ "path": ["list"], "range": [0, 0], "value": [1, 2] }],
			"expect": { "added": "taken" }
		},
		{
			"op": "add",
			"name": "d",
			"parents": ["c"],
			"time": 3,
			"patches": [{ "path": ["list"], "range": [0, 1] }],
			"expect": { "added": "taken" }
		},
		{
			"op": "replay",
			"commit": "a",
			"expect": {
				"tables": {
					"value": {
						"value": { "n": 0, "list": [] },
						"change": {
							"time": 0,
							"actor": null,
							"metadata": {
								"signer": "ed018a88e3dd7409f195fd52db2d3cba5d72ca6709bf1d94121bf3748801b40f6f5c",
								"commit": "1e2039a5272289f2dce388e164e960e92cad980922d1e2c143cbac16ea4ef7a7c647"
							}
						}
					}
				}
			}
		},
		{
			"op": "replay",
			"commit": "b",
			"expect": {
				"tables": {
					"value": {
						"value": { "n": 1, "list": [] },
						"change": {
							"time": 1,
							"actor": null,
							"metadata": {
								"signer": "ed018a88e3dd7409f195fd52db2d3cba5d72ca6709bf1d94121bf3748801b40f6f5c",
								"commit": "1e202ca114a786d60a39418976c6f1c40b2f71bce0af709918259744f9ad1a1b0217"
							}
						}
					}
				}
			}
		},
		{
			"op": "replay",
			"commit": "c",
			"expect": {
				"tables": {
					"value": {
						"value": { "n": 1, "list": [1, 2] },
						"change": {
							"time": 2,
							"actor": null,
							"metadata": {
								"signer": "ed018a88e3dd7409f195fd52db2d3cba5d72ca6709bf1d94121bf3748801b40f6f5c",
								"commit": "1e20ed4e684d137634477e7f192676f653367b2b766c3e646bcd946c2ed3ba0cf0e8"
							}
						}
					}
				}
			}
		},
		{
			"op": "replay",
			"commit": "d",
			"expect": {
				"tables": {
					"value": {
						"value": { "n": 1, "list": [2] },
						"change": {
							"time": 3,
							"actor": null,
							"metadata": {
								"signer": "ed018a88e3dd7409f195fd52db2d3cba5d72ca6709bf1d94121bf3748801b40f6f5c",
								"commit": "1e2087da76aeb442735c86243b90d9ca1b6a0b3f4308616e64210072eb324c3b76a7"
							}
						}
					}
				}
			}
		}
	]
}
