{
	"title": "of the snapshots behind a commit, the nearest is where replay starts",
	"steps": [
		{
			"op": "add",
			"name": "a",
			"patches": [{ "path": [], "value": { "n": 0 } }],
			"expect": { "added": "taken" }
		},
		{
			"op": "add",
			"name": "b",
			"parents": ["a"],
			"patches": [{ "path": ["n"], "value": 1 }],
			"expect": { "added": "taken" }
		},
		{
			"op": "add",
			"name": "c",
			"parents": ["b"],
			"patches": [{ "path": ["n"], "value": 2 }],
			"expect": { "added": "taken" }
		},
		{
			"op": "add",
			"name": "d",
			"parents": ["c"],
			"patches": [{ "path": ["m"], "value": 3 }],
			"expect": { "added": "taken" }
		},
		{
			"op": "keep",
			"commit": "b",
			"tables": { "value": { "value": { "n": 100 }, "change": { "time": 0, "actor": "at b" } } },
			"expect": {}
		},
		{
			"op": "keep",
			"commit": "c",
			"tables": { "value": { "value": { "n": 200 }, "change": { "time": 0, "actor": "at c" } } },
			"expect": {}
		},
		{
			"op": "replay",
			"commit": "d",
			"expect": {
				"tables": {
					"value": {
						"value": { "n": 200, "m": 3 },
						"change": {
							"time": 0,
							"actor": null,
							"metadata": {
								"signer": "ed018a88e3dd7409f195fd52db2d3cba5d72ca6709bf1d94121bf3748801b40f6f5c",
								"commit": "1e20540a9d6658ad84643e32846e808362b22fa6bafbdc2df01bc7d1bfa956bb119b"
							}
						}
					}
				}
			}
		}
	]
}
