{
	"title": "a node's tables cross to a host following it, one commit per entry change",
	"steps": [
		{
			"op": "host",
			"name": "a",
			"seed": "0101010101010101010101010101010101010101010101010101010101010101",
			"expect": { "key": "ed018a88e3dd7409f195fd52db2d3cba5d72ca6709bf1d94121bf3748801b40f6f5c" }
		},
		{
			"op": "host",
			"name": "b",
			"seed": "0202020202020202020202020202020202020202020202020202020202020202",
			"expect": { "key": "ed018139770ea87d175f56a35466c34c7ecccb8d8a91b4ee37a25df60f5b8fc9b394" }
		},
		{
			"op": "mint",
			"host": "a",
			"as": "x",
			"expect": {
				"id": "ermine:0010b40fde52c568d2f3864d68739e98b72b"
			}
		},
		{ "op": "follow", "host": "b", "id": "x", "expect": {} },
		{ "op": "connect", "a": "a", "b": "b", "expect": {} },
		{
			"op": "write",
			"host": "a",
			"id": "x",
			"patches": [{ "path": [], "value": { "title": "hi" } }],
			"name": "w1",
			"expect": { "commits": 1 }
		},
		{
			"op": "write",
			"host": "a",
			"id": "x",
			"patches": [{ "path": ["title"], "value": "hello" }],
			"name": "w2",
			"expect": { "commits": 1 }
		},
		{
			"op": "write",
			"host": "a",
			"table": "attributes",
			"id": "x",
			"patches": [{ "path": [], "value": { "color": "cherry" } }],
			"name": "w3",
			"expect": { "commits": 1 }
		},
		{
			"op": "write",
			"host": "a",
			"table": "children",
			"id": "x",
			"patches": [
				{
					"path": [],
					"value": {
						"notes": "ermine:0010abababababababababababababababab"
					}
				}
			],
			"name": "w4",
			"expect": { "commits": 1 }
		},
		{ "op": "quiet", "expect": {} },
		{ "op": "read", "host": "b", "id": "x", "expect": { "value": { "title": "hello" } } },
		{
			"op": "read",
			"host": "b",
			"table": "attributes",
			"id": "x",
			"expect": { "value": { "color": "cherry" } }
		},
		{
			"op": "read",
			"host": "b",
			"table": "children",
			"id": "x",
			"expect": {
				"value": {
					"notes": "ermine:0010abababababababababababababababab"
				}
			}
		},
		{ "op": "commits", "host": "a", "id": "x", "expect": { "commits": 4 } },
		{ "op": "commits", "host": "b", "id": "x", "expect": { "commits": 4 } },
		{ "op": "heads", "host": "b", "id": "x", "expect": { "heads": ["w4"] } },
		{ "op": "conflicts", "host": "b", "id": "x", "expect": { "conflicts": [] } }
	]
}
