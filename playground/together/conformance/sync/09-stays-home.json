{
	"title": "what is not synced stays home: an id that is not an ermine id (a local string), a table not synced; a key id (ed01 and an Ed25519 key) is an ermine id and syncs as any other",
	"steps": [
		{
			"op": "host",
			"name": "a",
			"seed": "0101010101010101010101010101010101010101010101010101010101010101",
			"expect": { "key": "ed018a88e3dd7409f195fd52db2d3cba5d72ca6709bf1d94121bf3748801b40f6f5c" }
		},
		{
			"op": "host",
			"name": "b",
			"seed": "0202020202020202020202020202020202020202020202020202020202020202",
			"expect": { "key": "ed018139770ea87d175f56a35466c34c7ecccb8d8a91b4ee37a25df60f5b8fc9b394" }
		},
		{
			"op": "mint",
			"host": "a",
			"as": "x",
			"expect": {
				"id": "ermine:0010b40fde52c568d2f3864d68739e98b72b"
			}
		},
		{ "op": "follow", "host": "b", "id": "x", "expect": {} },
		{
			"op": "follow",
			"host": "b",
			"id": "ermine:ed012a2a2a2a2a2a2a2a2a2a2a2a2a2a2a2a2a2a2a2a2a2a2a2a2a2a2a2a2a2a2a2a",
			"expect": {}
		},
		{ "op": "connect", "a": "a", "b": "b", "expect": {} },
		{
			"op": "write",
			"host": "a",
			"id": "local",
			"patches": [{ "path": [], "value": 1 }],
			"expect": { "commits": 0 }
		},
		{
			"op": "write",
			"host": "a",
			"table": "presence",
			"id": "x",
			"patches": [{ "path": [], "value": { "me": 1 } }],
			"expect": { "commits": 0 }
		},
		{
			"op": "write",
			"host": "a",
			"id": "ermine:ed012a2a2a2a2a2a2a2a2a2a2a2a2a2a2a2a2a2a2a2a2a2a2a2a2a2a2a2a2a2a2a2a",
			"patches": [{ "path": [], "value": 2 }],
			"expect": { "commits": 1 }
		},
		{ "op": "quiet", "expect": {} },
		{ "op": "stored", "host": "a", "id": "x", "expect": { "stored": 0 } },
		{ "op": "commits", "host": "a", "id": "x", "expect": { "commits": 0 } },
		{ "op": "read", "host": "a", "id": "local", "expect": { "value": 1 } },
		{ "op": "read", "host": "b", "id": "local", "expect": {} },
		{ "op": "read", "host": "b", "table": "presence", "id": "x", "expect": {} },
		{
			"op": "read",
			"host": "a",
			"id": "ermine:ed012a2a2a2a2a2a2a2a2a2a2a2a2a2a2a2a2a2a2a2a2a2a2a2a2a2a2a2a2a2a2a2a",
			"expect": { "value": 2 }
		},
		{
			"op": "read",
			"host": "b",
			"id": "ermine:ed012a2a2a2a2a2a2a2a2a2a2a2a2a2a2a2a2a2a2a2a2a2a2a2a2a2a2a2a2a2a2a2a",
			"expect": { "value": 2 }
		}
	]
}
