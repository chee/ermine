{
	"title": "stop: a device's standing ephemeral commit ends when it says so: a peer drops it at once, not after ttl, and the stored shows again there; no beat carries it after; a new ephemeral write after the stop stands again",
	"steps": [
		{
			"op": "host",
			"name": "a",
			"seed": "0101010101010101010101010101010101010101010101010101010101010101",
			"expect": { "key": "ed018a88e3dd7409f195fd52db2d3cba5d72ca6709bf1d94121bf3748801b40f6f5c" }
		},
		{
			"op": "host",
			"name": "b",
			"seed": "0202020202020202020202020202020202020202020202020202020202020202",
			"expect": { "key": "ed018139770ea87d175f56a35466c34c7ecccb8d8a91b4ee37a25df60f5b8fc9b394" }
		},
		{
			"op": "mint",
			"host": "a",
			"as": "x",
			"expect": {
				"id": "ermine:0010b40fde52c568d2f3864d68739e98b72b"
			}
		},
		{ "op": "follow", "host": "b", "id": "x", "expect": {} },
		{ "op": "connect", "a": "a", "b": "b", "expect": {} },
		{ "op": "share", "host": "a", "id": "x", "expect": {} },
		{
			"op": "write",
			"host": "a",
			"id": "x",
			"patches": [{ "path": [], "value": { "x": 0, "y": 0 } }],
			"name": "w0",
			"expect": { "commits": 1 }
		},
		{ "op": "quiet", "expect": {} },
		{ "op": "ephemeral", "host": "a", "tables": ["value"], "expect": {} },
		{
			"op": "write",
			"host": "a",
			"id": "x",
			"patches": [{ "path": ["x"], "value": 1 }],
			"name": "e1",
			"expect": { "commits": 0, "ephemeral": 1 }
		},
		{ "op": "quiet", "expect": {} },
		{ "op": "read", "host": "b", "id": "x", "expect": { "value": { "x": 1, "y": 0 } } },
		{
			"op": "standing",
			"host": "b",
			"id": "x",
			"expect": {
				"standing": [
					["ed018a88e3dd7409f195fd52db2d3cba5d72ca6709bf1d94121bf3748801b40f6f5c", "e1"]
				]
			}
		},
		{ "op": "stop", "host": "a", "id": "x", "expect": {} },
		{ "op": "quiet", "expect": {} },
		{ "op": "standing", "host": "a", "id": "x", "expect": { "standing": [] } },
		{ "op": "overlay", "host": "a", "id": "x", "expect": {} },
		{ "op": "read", "host": "a", "id": "x", "expect": { "value": { "x": 0, "y": 0 } } },
		{ "op": "standing", "host": "b", "id": "x", "expect": { "standing": [] } },
		{ "op": "overlay", "host": "b", "id": "x", "expect": {} },
		{ "op": "read", "host": "b", "id": "x", "expect": { "value": { "x": 0, "y": 0 } } },
		{
			"op": "heads",
			"host": "b",
			"id": "x",
			"layer": "ephemeral",
			"expect": { "heads": ["w0"] }
		},
		{ "op": "commits", "host": "b", "id": "x", "layer": "ephemeral", "expect": { "commits": 1 } },
		{ "op": "commits", "host": "a", "id": "x", "layer": "ephemeral", "expect": { "commits": 1 } },
		{ "op": "advance", "ms": 1500, "expect": {} },
		{ "op": "quiet", "expect": {} },
		{ "op": "advance", "ms": 1500, "expect": {} },
		{ "op": "quiet", "expect": {} },
		{ "op": "standing", "host": "b", "id": "x", "expect": { "standing": [] } },
		{ "op": "commits", "host": "b", "id": "x", "layer": "ephemeral", "expect": { "commits": 1 } },
		{ "op": "read", "host": "b", "id": "x", "expect": { "value": { "x": 0, "y": 0 } } },
		{ "op": "stored", "host": "b", "id": "x", "expect": { "stored": 1 } },
		{
			"op": "write",
			"host": "a",
			"id": "x",
			"patches": [{ "path": ["y"], "value": 2 }],
			"name": "e2",
			"expect": { "commits": 0, "ephemeral": 1 }
		},
		{ "op": "quiet", "expect": {} },
		{ "op": "read", "host": "b", "id": "x", "expect": { "value": { "x": 0, "y": 2 } } },
		{
			"op": "standing",
			"host": "b",
			"id": "x",
			"expect": {
				"standing": [
					["ed018a88e3dd7409f195fd52db2d3cba5d72ca6709bf1d94121bf3748801b40f6f5c", "e2"]
				]
			}
		},
		{
			"op": "standing",
			"host": "a",
			"id": "x",
			"expect": {
				"standing": [
					["ed018a88e3dd7409f195fd52db2d3cba5d72ca6709bf1d94121bf3748801b40f6f5c", "e2"]
				]
			}
		},
		{
			"op": "overlay",
			"host": "b",
			"id": "x",
			"expect": {
				"overlay": {
					"under": { "value": { "x": 0, "y": 0 } },
					"on": [
						{
							"by": "ed018a88e3dd7409f195fd52db2d3cba5d72ca6709bf1d94121bf3748801b40f6f5c",
							"name": "e2",
							"tables": ["value"],
							"lamport": 2
						}
					]
				}
			}
		},
		{ "op": "advance", "ms": 1500, "expect": {} },
		{ "op": "quiet", "expect": {} },
		{ "op": "advance", "ms": 1500, "expect": {} },
		{ "op": "quiet", "expect": {} },
		{ "op": "advance", "ms": 1500, "expect": {} },
		{ "op": "quiet", "expect": {} },
		{
			"op": "standing",
			"host": "b",
			"id": "x",
			"expect": {
				"standing": [
					["ed018a88e3dd7409f195fd52db2d3cba5d72ca6709bf1d94121bf3748801b40f6f5c", "e2"]
				]
			}
		},
		{ "op": "read", "host": "b", "id": "x", "expect": { "value": { "x": 0, "y": 2 } } }
	]
}
