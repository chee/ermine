{
	"title": "pause stops carrying a node: a write after it is a commit, stored here, not sent; the node's status says it is paused (whoever has the id still has it)",
	"typescript": true,
	"steps": [
		{
			"op": "host",
			"name": "a",
			"seed": "0101010101010101010101010101010101010101010101010101010101010101",
			"expect": {
				"key": "ed018a88e3dd7409f195fd52db2d3cba5d72ca6709bf1d94121bf3748801b40f6f5c"
			}
		},
		{
			"op": "host",
			"name": "b",
			"seed": "0202020202020202020202020202020202020202020202020202020202020202",
			"expect": {
				"key": "ed018139770ea87d175f56a35466c34c7ecccb8d8a91b4ee37a25df60f5b8fc9b394"
			}
		},
		{
			"op": "mint",
			"host": "a",
			"as": "x",
			"expect": {
				"id": "ermine:0010b40fde52c568d2f3864d68739e98b72b"
			}
		},
		{
			"op": "share",
			"host": "a",
			"id": "x",
			"expect": {}
		},
		{
			"op": "follow",
			"host": "b",
			"id": "x",
			"expect": {}
		},
		{
			"op": "connect",
			"a": "a",
			"b": "b",
			"expect": {}
		},
		{
			"op": "write",
			"host": "a",
			"id": "x",
			"patches": [
				{
					"path": [],
					"value": {
						"n": 1
					}
				}
			],
			"name": "w1",
			"expect": {
				"commits": 1
			}
		},
		{
			"op": "quiet",
			"expect": {}
		},
		{
			"op": "read",
			"host": "b",
			"id": "x",
			"expect": {
				"value": {
					"n": 1
				}
			}
		},
		{
			"op": "pause",
			"host": "a",
			"id": "x",
			"expect": {}
		},
		{
			"op": "write",
			"host": "a",
			"id": "x",
			"patches": [
				{
					"path": [
						"n"
					],
					"value": 2
				}
			],
			"name": "w2",
			"expect": {
				"commits": 1
			}
		},
		{
			"op": "quiet",
			"expect": {}
		},
		{
			"op": "commits",
			"host": "a",
			"id": "x",
			"expect": {
				"commits": 2
			}
		},
		{
			"op": "stored",
			"host": "a",
			"id": "x",
			"expect": {
				"stored": 2
			}
		},
		{
			"op": "read",
			"host": "b",
			"id": "x",
			"expect": {
				"value": {
					"n": 1
				}
			}
		},
		{
			"op": "heads",
			"host": "b",
			"id": "x",
			"expect": {
				"heads": [
					"w1"
				]
			}
		},
		{
			"op": "status",
			"host": "a",
			"id": "x",
			"expect": {
				"status": {
					"waiting": [],
					"refused": [],
					"unsent": [],
					"count": {
						"waiting": 0,
						"refused": 0,
						"unsent": 0
					},
					"paused": true
				}
			}
		},
		{
			"op": "share",
			"host": "a",
			"id": "x",
			"expect": {}
		},
		{
			"op": "quiet",
			"expect": {}
		},
		{
			"op": "status",
			"host": "a",
			"id": "x",
			"expect": {}
		},
		{
			"op": "read",
			"host": "b",
			"id": "x",
			"expect": {
				"value": {
					"n": 2
				}
			}
		},
		{
			"op": "heads",
			"host": "b",
			"id": "x",
			"expect": {
				"heads": [
					"w2"
				]
			}
		}
	]
}
