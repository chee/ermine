{
	"title": "an unsent row goes only when the next write to the same node and the same table goes out: a write to another table leaves it listed",
	"steps": [
		{
			"op": "host",
			"name": "a",
			"seed": "0101010101010101010101010101010101010101010101010101010101010101",
			"expect": { "key": "ed018a88e3dd7409f195fd52db2d3cba5d72ca6709bf1d94121bf3748801b40f6f5c" }
		},
		{
			"op": "host",
			"name": "b",
			"seed": "0202020202020202020202020202020202020202020202020202020202020202",
			"expect": { "key": "ed018139770ea87d175f56a35466c34c7ecccb8d8a91b4ee37a25df60f5b8fc9b394" }
		},
		{
			"op": "mint",
			"host": "a",
			"as": "x",
			"expect": {
				"id": "ermine:0010b40fde52c568d2f3864d68739e98b72b"
			}
		},
		{ "op": "follow", "host": "b", "id": "x", "expect": {} },
		{ "op": "connect", "a": "a", "b": "b", "expect": {} },
		{ "op": "share", "host": "a", "id": "x", "expect": {} },
		{
			"op": "write",
			"host": "a",
			"id": "x",
			"patches": [{ "path": [], "value": { "n": 1 } }],
			"expect": { "commits": 1 }
		},
		{ "op": "quiet", "expect": {} },
		{
			"op": "writes",
			"host": "a",
			"writes": [
				{ "id": "x", "patches": [{ "path": ["n"], "value": { "/": { "symbol": "s" } } }] }
			],
			"expect": { "commits": 0 }
		},
		{
			"op": "status",
			"host": "a",
			"id": "x",
			"expect": {
				"status": {
					"waiting": [],
					"refused": [],
					"unsent": [{ "table": "value", "error": "cannot-carry", "field": "patches" }],
					"count": { "waiting": 0, "refused": 0, "unsent": 1 }
				}
			}
		},
		{
			"op": "write",
			"host": "a",
			"table": "attributes",
			"id": "x",
			"patches": [{ "path": [], "value": { "color": "cherry" } }],
			"expect": { "commits": 1 }
		},
		{ "op": "quiet", "expect": {} },
		{
			"op": "status",
			"host": "a",
			"id": "x",
			"expect": {
				"status": {
					"waiting": [],
					"refused": [],
					"unsent": [{ "table": "value", "error": "cannot-carry", "field": "patches" }],
					"count": { "waiting": 0, "refused": 0, "unsent": 1 }
				}
			}
		},
		{
			"op": "write",
			"host": "a",
			"id": "x",
			"patches": [{ "path": ["n"], "value": 2 }],
			"expect": { "commits": 1 }
		},
		{ "op": "quiet", "expect": {} },
		{ "op": "status", "host": "a", "id": "x", "expect": {} },
		{ "op": "read", "host": "b", "id": "x", "expect": { "value": { "n": 2 } } }
	]
}
