{
	"title": "an error, then a fix: BM is boom, which throws. the read is its Error, and nothing is cached. the host puts upper in its place and says so in its identity: compiled",
	"steps": [
		{ "op": "builds", "cache": "CACHE", "expect": {} },
		{ "op": "kids", "id": "R", "value": { "cache": "CACHE", "catclock.c": "CAT" }, "expect": {} },
		{ "op": "value", "id": "CAT", "value": "hi", "expect": {} },
		{ "op": "compiler", "id": "BM", "compiler": "boom", "expect": {} },
		{
			"op": "attrs",
			"id": "BM",
			"value": { "ermine.programs.compiler": { "name": "boom", "version": 1 } },
			"expect": {}
		},
		{ "op": "watch", "name": "b", "compilers": ["BM"], "node": "CAT", "expect": {} },
		{ "op": "pulse", "expect": {} },
		{ "op": "state", "name": "b", "expect": { "value": { "failed": "boom" } } },
		{ "op": "calls", "expect": { "upper": 0, "wrap": 0, "slow": 0, "boom": 1, "live": 0 } },
		{ "op": "cache", "skip": ["entries"], "expect": { "size": 0 } },
		{ "op": "compiler", "id": "BM", "compiler": "upper", "expect": {} },
		{
			"op": "upsert",
			"part": "attributes",
			"id": "BM",
			"path": ["ermine.programs.compiler"],
			"value": { "name": "upper", "version": 1 },
			"expect": {}
		},
		{ "op": "pulse", "expect": {} },
		{ "op": "state", "name": "b", "expect": { "value": "HI" } },
		{ "op": "calls", "expect": { "upper": 1, "wrap": 0, "slow": 0, "boom": 1, "live": 0 } },
		{ "op": "cache", "skip": ["entries"], "expect": { "size": 1 } }
	]
}
