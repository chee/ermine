{
	"title": "a vouch is for one session of one install: claimed for another install in the keys, or another session's vouch taken, not believed",
	"steps": [
		{
			"op": "session",
			"name": "tab1",
			"install": "I1",
			"expect": {}
		},
		{
			"op": "session",
			"name": "tab2",
			"install": "I1",
			"expect": {}
		},
		{
			"op": "session",
			"name": "card",
			"install": "I2",
			"expect": {}
		},
		{
			"op": "keys",
			"value": {
				"I1": {},
				"I2": {}
			},
			"expect": {}
		},
		{
			"op": "check",
			"session": "card",
			"message": "hello",
			"as": "I1",
			"expect": {
				"trusted": false
			}
		},
		{
			"op": "check",
			"session": "card",
			"message": "hello",
			"from": "tab1",
			"expect": {
				"trusted": false
			}
		},
		{
			"op": "check",
			"session": "tab1",
			"message": "hello",
			"from": "tab2",
			"expect": {
				"trusted": false
			}
		},
		{
			"op": "check",
			"session": "card",
			"message": "hello",
			"as": "I1",
			"from": "tab1",
			"expect": {
				"trusted": false
			}
		},
		{
			"op": "check",
			"session": "card",
			"message": "hello",
			"expect": {
				"trusted": true
			}
		}
	]
}
