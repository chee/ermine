{
	"title": "signed by another session, even of the same install: not believed",
	"steps": [
		{
			"op": "session",
			"name": "tab1",
			"install": "I1",
			"expect": {}
		},
		{
			"op": "session",
			"name": "tab2",
			"install": "I1",
			"expect": {}
		},
		{
			"op": "session",
			"name": "card",
			"install": "I2",
			"expect": {}
		},
		{
			"op": "keys",
			"value": {
				"I1": {},
				"I2": {}
			},
			"expect": {}
		},
		{
			"op": "check",
			"session": "tab1",
			"message": "hello",
			"signer": "tab2",
			"expect": {
				"trusted": false
			}
		},
		{
			"op": "check",
			"session": "tab1",
			"message": "hello",
			"signer": "card",
			"expect": {
				"trusted": false
			}
		},
		{
			"op": "check",
			"session": "tab2",
			"message": "hello",
			"expect": {
				"trusted": true
			}
		}
	]
}
