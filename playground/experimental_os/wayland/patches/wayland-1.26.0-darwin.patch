+int
+wl_os_socket_peercred(int sockfd, uid_t *uid, gid_t *gid, pid_t *pid)
+{
+	socklen_t len;
+	struct xucred ucred;
+	pid_t peer;
+
+	len = sizeof(ucred);
+	if (getsockopt(sockfd, SOL_LOCAL, LOCAL_PEERCRED, &ucred, &len) < 0 ||
+	    ucred.cr_version != XUCRED_VERSION)
+		return -1;
+	*uid = ucred.cr_uid;
+	*gid = ucred.cr_ngroups > 0 ? ucred.cr_groups[0] : (gid_t)-1;
+	len = sizeof(peer);
+	if (getsockopt(sockfd, SOL_LOCAL, LOCAL_PEERPID, &peer, &len) < 0)
