diff -ruN -x .unpacked a/src/connection.c wayland-1.26.0/src/connection.c
--- a/src/connection.c	2026-07-16 16:24:51
+++ b/src/connection.c	2026-10-10 14:17:14
@@ -329,6 +329,18 @@
 
 	connection->fd = fd;
 
+#ifdef __APPLE__
+	/* Darwin's sendmsg on a stream AF_UNIX socket blocks when the peer's
+	 * buffer is full, MSG_DONTWAIT or not; only O_NONBLOCK stops it.
+	 * Every read and write here is meant not to wait. */
+	{
+		int flags = fcntl(fd, F_GETFL);
+
+		if (flags != -1)
+			fcntl(fd, F_SETFL, flags | O_NONBLOCK);
+	}
+#endif
+
 	return connection;
 }
 
