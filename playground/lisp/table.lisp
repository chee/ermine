;;; table.lisp — (part, id) → node, with every order kept: at an id, a node's ids, who
(in-package :ermine)

(defvar *cells* (make-hash-table :test 'equal) "(part . id) → node")
(defvar *at* (make-hash-table :test 'equal) "id → parts in the order put")
(defvar *who* (make-hash-table :test 'equal) "node → ((part . ids) ...) in the order first taken")
(defvar *events* '() "told events, newest first: (part id entries)")

(defun key-json (k) (if (jsym-p k) (jmap "symbol" (jsym-name k)) k))
(defun read-key (req name)
  (multiple-value-bind (k there) (jget req name)
    (unless there (fail "~a missing" name))
    (cond ((stringp k) k)
          ((and (jmap-p k) (= (jcount k) 1) (stringp (jget k "symbol"))) (intern-jsym (jget k "symbol")))
          (t (fail "~a: not a key" name)))))
(defun read-node (req)
  (multiple-value-bind (n there) (jget req "node")
    (unless (and there (stringp n)) (fail "node: not a string"))
    n))

(defun entries-at (id)
  (mklist (mapcar (lambda (part) (jlist (key-json part) (gethash (cons part id) *cells*)))
                  (gethash id *at*))))
(defun tell (part id) (push (list part id (entries-at id)) *events*))

(defun node-ids (node part) (cdr (assoc part (gethash node *who*) :test #'equal)))
(defun link (part id node)
  "the key put, last everywhere"
  (setf (gethash (cons part id) *cells*) node)
  (setf (gethash id *at*) (append (gethash id *at*) (list part)))
  (let* ((groups (gethash node *who*)) (g (assoc part groups :test #'equal)))
    (if g (setf (cdr g) (append (cdr g) (list id)))
        (setf (gethash node *who*) (append groups (list (list part id)))))))
(defun unlink (part id)
  "the key taken out; what is left empty goes"
  (let ((node (gethash (cons part id) *cells*)))
    (remhash (cons part id) *cells*)
    (let ((parts (remove part (gethash id *at*) :test #'equal)))
      (if parts (setf (gethash id *at*) parts) (remhash id *at*)))
    (let* ((groups (gethash node *who*)) (g (assoc part groups :test #'equal)))
      (setf (cdr g) (remove id (cdr g) :test #'equal))
      (let ((left (remove-if (lambda (g) (null (cdr g))) groups)))
        (if left (setf (gethash node *who*) left) (remhash node *who*))))))

(defun table-add (part id node &key sub)
  (let ((there (gethash (cons part id) *cells*)))
    (cond ((equal there node) (jmap))
          ((and there (not sub)) (jmap "error" "already-there"))
          (t (when there (unlink part id))
             (link part id node)
             (tell part id)
             (jmap)))))

(defun take-all (keys)
  "every key taken, then each told"
  (if (null keys) (jmap "error" "nothing-there")
      (progn (dolist (k keys) (unlink (car k) (cdr k)))
             (dolist (k keys) (tell (car k) (cdr k)))
             (jmap))))

(defharness "table" (req)
  (let ((op (jget req "op")))
    (unless (stringp op) (fail "unknown op ~a" op))
    (cond
      ((or (string= op "add") (string= op "sub"))
       (let ((part (read-key req "part")) (id (read-key req "id")) (node (read-node req)))
         (table-add part id node :sub (string= op "sub"))))
      ((string= op "get")
       (let ((n (gethash (cons (read-key req "part") (read-key req "id")) *cells*)))
         (if n (jmap "node" n) (jmap))))
      ((string= op "ids")
       (let ((part (read-key req "part")) (node (read-node req)))
         (jmap "ids" (mklist (mapcar #'key-json (node-ids node part))))))
      ((string= op "at") (jmap "entries" (entries-at (read-key req "id"))))
      ((string= op "who")
       (let ((node (read-node req)))
         (jmap "keys" (mklist (loop for (part . ids) in (gethash node *who*)
                                    append (mapcar (lambda (id) (jlist (key-json part) (key-json id))) ids))))))
      ((string= op "del")
       (cond ((and (jhas req "part") (jhas req "node"))
              (let ((part (read-key req "part")) (node (read-node req)))
                (take-all (mapcar (lambda (id) (cons part id)) (node-ids node part)))))
             ((jhas req "part")
              (let* ((part (read-key req "part")) (id (read-key req "id")))
                (take-all (and (gethash (cons part id) *cells*) (list (cons part id))))))
             ((jhas req "node")
              (let ((node (read-node req)))
                (take-all (loop for (part . ids) in (gethash node *who*)
                                append (mapcar (lambda (id) (cons part id)) ids)))))
             (t (fail "del: nothing named"))))
      ((string= op "events")
       (let ((at (eq (jget req "at") :true)) (evs (reverse *events*)))
         (setf *events* '())
         (jmap "events" (mklist (mapcar (lambda (e)
                                          (destructuring-bind (part id entries) e
                                            (if at (jlist (key-json part) (key-json id) entries)
                                                (jlist (key-json part) (key-json id)))))
                                        evs)))))
      (t (fail "unknown op ~a" op)))))
