;;; ops.lisp — the op suites' harnesses: apply, invert, squish
(in-package :ermine)

(defun patches-of (req)
  "the request's patches, a list, each patch's value revived"
  (multiple-value-bind (ps there) (field req "patches")
    (unless (and there (jlistp ps)) (fail "patches: not a list"))
    (mklist (map 'list (lambda (p)
                         (if (and (jmap-p p) (jhas p "value"))
                             (%make-jmap :entries (mapcar (lambda (e)
                                                            (if (string= (car e) "value")
                                                                (cons (car e) (revive (cdr e)))
                                                                e))
                                                          (jmap-entries p)))
                             p))
                 ps))))
(defun value-of (req)
  (multiple-value-bind (v there) (field req "value")
    (if there (revive v) +none+)))
(defun refusal (e) (jmap "error" (jmap "code" (code e) "patch" (index e))))
(defun value-answer (v) (if (eq v +none+) (jmap) (jmap "value" (form v))))

(defharness "apply" (req)
  (let ((op (op-of req)))
    (cond ((string= op "apply")
           (let ((ps (patches-of req)) (v (value-of req)))
             (handler-case (value-answer (apply-patches v ps))
               (apply-error (e) (refusal e)))))
          ((string= op "invert")
           (let ((ps (patches-of req)) (v (value-of req)))
             (handler-case (jmap "undo" (form (invert-patches v ps)))
               (apply-error (e) (refusal e)))))
          (t (fail "unknown op ~a" op)))))
(setf (gethash "invert" *harnesses*) (gethash "apply" *harnesses*))
