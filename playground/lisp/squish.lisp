;;; squish.lisp — patches pushed one by one, joined and killed; and their columns form
;;; squish never reads content beyond what joining needs: values stay raw JSON
(in-package :ermine)

(defstruct sq path range (value +none+) (move +none+))

(defun sq-key (k) (if (stringp k) k (index-of k)))
(defun read-sq (x)
  (unless (jmap-p x) (fail "a patch is not a map"))
  (let ((path (jget x "path" (mklist))) (range (jget x "range")))
    (unless (jlistp path) (fail "a path is not a list"))
    (make-sq :path (map 'list #'sq-key path)
             :range (and range (jlistp range) (list (index-of (aref range 0)) (index-of (aref range 1))))
             :value (multiple-value-bind (v there) (jget x "value") (if there v +none+))
             :move (multiple-value-bind (v there) (jget x "move") (if there v +none+)))))
(defun sq-json (p)
  (let ((m (jmap "path" (mklist (sq-path p)))))
    (when (sq-range p) (jput m "range" (mklist (sq-range p))))
    (unless (eq (sq-value p) +none+) (jput m "value" (sq-value p)))
    (unless (eq (sq-move p) +none+) (jput m "move" (sq-move p)))
    m))
(defun sq-move-p (p) (not (eq (sq-move p) +none+)))
(defun sq-has-value (p) (not (eq (sq-value p) +none+)))

;;; raw values as sequences: a string, a list, or a typed array's "/" form
(defun raw-typed-kind (v)
  (and (slash-map-p v)
       (let ((f (jget v "/")))
         (and (jmap-p f) (= (jcount f) 1)
              (member (car (first (jmap-entries f))) +kinds+ :test #'string=)
              (jlistp (cdr (first (jmap-entries f))))
              (car (first (jmap-entries f)))))))
(defun raw-kind (v)
  (cond ((stringp v) :string) ((jlistp v) :list) (t (raw-typed-kind v))))
(defun raw-items (v) (if (raw-typed-kind v) (jget (jget v "/") (raw-typed-kind v)) v))
(defun raw-length (v) (length (raw-items v)))
(defun raw-of-kind (kind items)
  (cond ((eq kind :string) (normalize (coerce items 'string)))
        ((eq kind :list) (mklist (coerce items 'list)))
        (t (slash (jmap kind (mklist (coerce items 'list)))))))
(defun raw-splice (v a b w)
  "v with [a, b) replaced by w's items (w +none+: nothing)"
  (let ((items (raw-items v)) (kind (raw-kind v)))
    (raw-of-kind kind (concatenate 'list (subseq items 0 a)
                                   (if (eq w +none+) '() (coerce (raw-items w) 'list))
                                   (subseq items b)))))
(defun raw-lone-p (v)
  "a lone surrogate anywhere in v: strings, list elements, map values; never map keys"
  (cond ((stringp v) (has-lone-p v))
        ((jlistp v) (some #'raw-lone-p v))
        ((jmap-p v) (some (lambda (e) (raw-lone-p (cdr e))) (jmap-entries v)))
        (t nil)))

(defun join (l n)
  "l with n joined into it, or nil"
  (destructuring-bind (a b) (sq-range l)
    (destructuring-bind (c d) (sq-range n)
      (if (sq-has-value l)
          (let* ((v (sq-value l)) (kind (raw-kind v)) (w (sq-value n)))
            (when (and kind (or (eq w +none+) (equal (raw-kind w) kind)))
              (let ((len (raw-length v)))
                (cond ((and (<= a c) (<= d (+ a len)))
                       (make-sq :path (sq-path l) :range (list a b) :value (raw-splice v (- c a) (- d a) w)))
                      ((and (= c (+ a len)) (> d (+ a len)))
                       (make-sq :path (sq-path l) :range (list a (+ b (- d c)))
                                :value (raw-splice v len len w)))))))
          (cond ((and (not (sq-has-value n)) (<= c a d))
                 (make-sq :path (sq-path l) :range (list c (+ b (- d a)))))
                ((and (sq-has-value n) (raw-kind (sq-value n)) (= c d a))
                 (make-sq :path (sq-path l) :range (list a b) :value (sq-value n))))))))

(defun squish (patches)
  (let ((kept (make-array 0 :adjustable t :fill-pointer 0)) (fouled '()))
    (flet ((last-kept () (and (plusp (length kept)) (aref kept (1- (length kept)))))
           (fouled-p (path) (some (lambda (q) (prefix-p q path)) fouled))
           (foul (path) (push path fouled)))
      (loop for x across patches
            for p = (read-sq x)
            for path = (sq-path p)
            do (cond
                 ((sq-move-p p)
                  (let* ((mv (sq-move p))
                         (from (and (jmap-p mv) (jlistp (jget mv "path")) (map 'list #'sq-key (jget mv "path")))))
                    (when from
                      (when (fouled-p from) (foul path))
                      (dolist (q fouled)
                        (when (and (> (length q) (length from)) (prefix-p from q))
                          (foul (append path (nthcdr (length from) q)))))))
                  (vector-push-extend p kept))
                 ((and (null path) (not (sq-range p)))
                  (setf (fill-pointer kept) 0 fouled '())
                  (vector-push-extend p kept))
                 ((not (sq-range p))
                  ;; kills, last first, until one is not
                  (loop for l = (last-kept)
                        while (and l (not (sq-move-p l)) (prefix-p path (sq-path l))
                                   (not (and (equal (sq-path l) path) (not (sq-range l)) (not (sq-has-value l))
                                             (integerp (car (last path))))))
                        do (decf (fill-pointer kept)))
                  (when (raw-lone-p (sq-value p)) (foul path))
                  (vector-push-extend p kept))
                 (t
                  (let* ((l (last-kept))
                         (joined (and l (sq-range l) (not (sq-move-p l)) (equal (sq-path l) path)
                                      (not (fouled-p path))
                                      (not (raw-lone-p (sq-value p))) (not (raw-lone-p (sq-value l)))
                                      (join l p))))
                    (when (raw-lone-p (sq-value p)) (foul path))
                    (if joined
                        (progn
                          (setf (aref kept (1- (length kept))) joined)
                          ;; merges reach back: the joined patch joined into the one before it, while they join
                          (loop while (>= (length kept) 2)
                                do (let* ((e (aref kept (- (length kept) 2)))
                                          (j (and (sq-range e) (not (sq-move-p e)) (equal (sq-path e) path)
                                                  (not (raw-lone-p (sq-value e)))
                                                  (join e (aref kept (1- (length kept)))))))
                                     (unless j (return))
                                     (decf (fill-pointer kept))
                                     (setf (aref kept (1- (length kept))) j))))
                        (vector-push-extend p kept)))))))
    (mklist (map 'list #'sq-json kept))))

;;; columns
(defun runs (xs)
  (let ((out '()))
    (dolist (x xs)
      (if (and out (equal (second out) x))
          (incf (first out))
          (progn (push x out) (push 1 out))))
    (mklist (nreverse out))))
(defun unruns (r)
  (unless (and (jlistp r) (evenp (length r))) (fail "bad columns"))
  (loop for i from 0 below (length r) by 2
        for count = (aref r (1+ i))
        do (unless (and (integerp count) (>= count 0)) (fail "bad columns"))
        append (make-list count :initial-element (aref r i))))

(defun encode-columns (patches)
  (let ((ps (map 'list #'read-sq patches)) (paths '()) (last-from 0) (from '()) (size '()))
    (dolist (p ps)
      (unless (member (sq-path p) paths :test #'equal) (setf paths (append paths (list (sq-path p))))))
    (dolist (p ps)
      (when (sq-range p)
        (push (- (first (sq-range p)) last-from) from)
        (push (- (second (sq-range p)) (first (sq-range p))) size)
        (setf last-from (first (sq-range p)))))
    (jmap "paths" (mklist (mapcar #'mklist paths))
          "path" (runs (mapcar (lambda (p) (position (sq-path p) paths :test #'equal)) ps))
          "shape" (runs (mapcar (lambda (p) (+ (if (sq-range p) 1 0) (if (sq-has-value p) 2 0) (if (sq-move-p p) 4 0))) ps))
          "from" (runs (nreverse from))
          "size" (runs (nreverse size))
          "value" (mklist (loop for p in ps when (sq-has-value p) collect (sq-value p)))
          "move" (mklist (loop for p in ps when (sq-move-p p) collect (sq-move p))))))

(defun decode-columns (c)
  (unless (jmap-p c) (fail "columns: not a map"))
  (flet ((col (name) (let ((v (jget c name))) (unless (jlistp v) (fail "columns: ~a not a list" name)) v)))
    (let* ((paths (col "paths")) (path (unruns (col "path"))) (shape (unruns (col "shape")))
           (from (unruns (col "from"))) (size (unruns (col "size")))
           (values (coerce (col "value") 'list)) (moves (coerce (col "move") 'list))
           (at 0) (out '()))
      (unless (= (length path) (length shape)) (fail "bad columns"))
      (loop for ix in path
            for s in shape
            do (unless (and (integerp ix) (< -1 ix (length paths)) (integerp s)) (fail "bad columns"))
               (let ((m (jmap "path" (aref paths ix))))
                 (when (logtest s 1)
                   (when (null from) (fail "bad columns"))
                   (incf at (pop from))
                   (jput m "range" (jlist at (+ at (pop size)))))
                 (when (logtest s 2) (when (null values) (fail "bad columns")) (jput m "value" (pop values)))
                 (when (logtest s 4) (when (null moves) (fail "bad columns")) (jput m "move" (pop moves)))
                 (push m out)))
      (mklist (nreverse out)))))

(defharness "squish" (req)
  (let ((op (op-of req)))
    (flet ((patches () (let ((ps (jget req "patches"))) (unless (jlistp ps) (fail "patches: not a list")) ps)))
      (cond ((string= op "squish") (jmap "patches" (squish (patches))))
            ((string= op "encode") (jmap "columns" (encode-columns (patches))))
            ((string= op "decode") (jmap "patches" (decode-columns (jget req "columns"))))
            (t (fail "unknown op ~a" op))))))
