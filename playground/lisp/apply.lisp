;;; apply.lisp — op's patches applied to a value (apply), and their undo (invert)
(in-package :ermine)

(define-condition apply-error (error)
  ((code :initarg :code :reader code) (index :initarg :index :initform nil :accessor index))
  (:report (lambda (c s) (format s "~a" (code c)))))
(defun refuse (code) (error 'apply-error :code code))

(defvar +none+ '+none+ "nothing there")

;;; a patch, read and checked: path keys are strings or integers
(defstruct patch path range value has-value move-path move-range has-move)

(defun path-key-p (k) (or (stringp k) (and (realp k) (whole-number-p k) (not (minusp k)))))
(defun read-path (p)
  (unless (and (jlistp p) (every #'path-key-p p)) (refuse "not-a-patch"))
  (map 'list (lambda (k) (if (stringp k) k (index-of k))) p))
(defun read-range (r)
  (unless (and (jlistp r) (= (length r) 2)
               (every (lambda (x) (and (realp x) (whole-number-p x) (not (minusp x)))) r))
    (refuse "not-a-patch"))
  (list (index-of (aref r 0)) (index-of (aref r 1))))

(defun read-patch (x)
  "a patch from its JSON (values already revived); not-a-patch when no patch has its shape"
  (unless (jmap-p x) (refuse "not-a-patch"))
  (multiple-value-bind (path has-path) (jget x "path")
    (unless has-path (refuse "not-a-patch"))
    (multiple-value-bind (value has-value) (jget x "value")
      (multiple-value-bind (move has-move) (jget x "move")
        (multiple-value-bind (range has-range) (jget x "range")
          (let ((p (make-patch :path (read-path path)
                               :range (and has-range (read-range range))
                               :value value :has-value has-value :has-move has-move)))
            (when (and has-value has-move) (refuse "not-a-patch"))
            (when has-move
              (unless (and (jmap-p move) (jhas move "path")) (refuse "not-a-patch"))
              (when (or (jhas move "value") (jhas move "move")) (refuse "not-a-patch"))
              (setf (patch-move-path p) (read-path (jget move "path")))
              (multiple-value-bind (mr has-mr) (jget move "range")
                (when has-mr (setf (patch-move-range p) (read-range mr)))))
            p))))))

;;; sequences: strings, lists, typed arrays
(defun seq-p (x) (or (stringp x) (jlistp x) (typed-p x)))
(defun seq-length (x)
  (cond ((stringp x) (length x)) ((jlistp x) (length x)) ((typed-p x) (length (typed-elems x)))))
(defun same-kind-p (target value)
  "value fits in target's span: a string in a string, a list in a list, a typed array of its kind"
  (cond ((stringp target) (stringp value))
        ((jlistp target) (jlistp value))
        ((typed-p target) (and (typed-p value) (string= (typed-kind value) (typed-kind target))))))
(defun seq-sub (x a b)
  "the span [a, b) of x, a sequence of x's kind"
  (cond ((stringp x) (subseq x a b))
        ((jlistp x) (mklist (coerce (subseq x a b) 'list)))
        ((typed-p x) (make-typed :kind (typed-kind x) :elems (subseq (typed-elems x) a b)))))
(defun seq-items (x) (cond ((typed-p x) (typed-elems x)) (t x)))
(defun seq-splice (x a b ins)
  "x with [a, b) replaced by the items of ins (a sequence of x's kind); a list changes in place"
  (cond ((stringp x) (normalize (concatenate 'string (subseq x 0 a) ins (subseq x b))))
        ((jlistp x)
         (let ((tail (coerce (subseq x b) 'list)))
           (setf (fill-pointer x) a)
           (loop for e across ins do (vector-push-extend e x))
           (dolist (e tail) (vector-push-extend e x))
           x))
        ((typed-p x)
         (make-typed :kind (typed-kind x)
                     :elems (concatenate 'simple-vector (subseq (typed-elems x) 0 a)
                                         (typed-elems ins) (subseq (typed-elems x) b))))))
(defun list-remove-at (l i)
  (replace l l :start1 i :start2 (1+ i))
  (decf (fill-pointer l)))

;;; the root lives in a box so the whole has a place like any other
(defstruct box (root +none+))

;;; copy on write, for unread: off by default (apply and invert copy the whole root up front)
(defvar *owned* nil "nil, or an eq hash set of the containers a writer may change in place")
(defvar *copy-values* t "values put go in as copies (apply), or as given (unread)")
(defun container-p (x) (or (jmap-p x) (jlistp x)))
(defun shallow (x) (if (jmap-p x) (make-jmap (jmap-entries x)) (mklist (coerce x 'list))))
(defun own (x)
  "x, or an owned copy of it"
  (if (or (not (container-p x)) (gethash x *owned*)) x
      (let ((c (shallow x))) (setf (gethash c *owned*) t) c)))
(defun disown (x)
  "x and all under it no longer owned"
  (when (and *owned* (container-p x))
    (remhash x *owned*)
    (if (jmap-p x) (dolist (e (jmap-entries x)) (disown (cdr e))) (loop for e across x do (disown e)))))

(defun child (c k)
  "the key k of container c, walking: wrong-kind for a key c can't have, no-key when not there"
  (cond ((jlistp c) (unless (integerp k) (refuse "wrong-kind"))
                    (unless (< k (length c)) (refuse "no-key"))
                    (aref c k))
        ((jmap-p c) (unless (stringp k) (refuse "wrong-kind"))
                    (multiple-value-bind (v there) (jget c k)
                      (unless there (refuse "no-key"))
                      v))
        (t (refuse "wrong-kind"))))
(defun walk (box keys)
  (when (eq (box-root box) +none+) (refuse "no-key"))
  (let ((v (box-root box)))
    (dolist (k keys v) (setf v (child v k)))))
(defun mutable (box keys)
  "what is at keys (there), owned along the way when copying on write"
  (if (null *owned*) (walk box keys)
      (let ((v (own (box-root box))))
        (setf (box-root box) v)
        (dolist (k keys v)
          (let* ((c (if (jlistp v) (aref v k) (jget v k))) (o (own c)))
            (unless (eq o c) (if (jlistp v) (setf (aref v k) o) (jput v k o)))
            (setf v o))))))

(defun replace-at (box keys new)
  "set what is at keys (there already) to new; a container's place in its parent"
  (if (null keys) (setf (box-root box) new)
      (let ((parent (mutable box (butlast keys))) (k (car (last keys))))
        (if (jlistp parent) (setf (aref parent k) new) (jput parent k new)))))

(defun put-at (box keys v)
  (if (null keys) (setf (box-root box) v)
      (let ((parent (walk box (butlast keys))) (k (car (last keys))))
        (cond ((jlistp parent) (unless (integerp k) (refuse "wrong-kind"))
                               (unless (< k (length parent)) (refuse "no-key"))
                               (setf (aref (mutable box (butlast keys)) k) v))
              ((jmap-p parent) (unless (stringp k) (refuse "wrong-kind"))
                               (jput (mutable box (butlast keys)) k v))
              (t (refuse "wrong-kind"))))))
(defun remove-at (box keys &key strict)
  "remove what is at keys and return it (+none+ for a missing map key; strict: no-key then)"
  (if (null keys)
      (prog1 (box-root box) (setf (box-root box) +none+))
      (let ((parent (walk box (butlast keys))) (k (car (last keys))))
        (cond ((jlistp parent) (unless (integerp k) (refuse "wrong-kind"))
                               (unless (< k (length parent)) (refuse "no-key"))
                               (prog1 (aref parent k) (list-remove-at (mutable box (butlast keys)) k)))
              ((jmap-p parent) (unless (stringp k) (refuse "wrong-kind"))
                               (multiple-value-bind (v there) (jget parent k)
                                 (cond (there (jdel (mutable box (butlast keys)) k) v)
                                       (strict (refuse "no-key"))
                                       (t +none+))))
              (t (refuse "wrong-kind"))))))

(defun span-target (box keys range)
  "the sequence a span [a, b) at keys lands in, checked: range, wrong-kind, range"
  (let ((target (if (and (null keys) (eq (box-root box) +none+)) +none+ (walk box keys))))
    (destructuring-bind (a b) range
      (when (> a b) (refuse "range"))
      (unless (seq-p target) (refuse "wrong-kind"))
      (when (> b (seq-length target)) (refuse "range"))
      target)))
(defun splice-at (box keys range ins)
  (let ((target (span-target box keys range)))
    (unless (same-kind-p target ins) (refuse "wrong-kind"))
    (when (jlistp target) (setf target (mutable box keys)))
    (let ((new (seq-splice target (first range) (second range) ins)))
      (unless (eq new target) (replace-at box keys new)))))
(defun take-span (box keys range)
  (let* ((target (span-target box keys range))
         (taken (seq-sub target (first range) (second range))))
    (when (jlistp target) (setf target (mutable box keys)))
    (let ((new (seq-splice target (first range) (second range) (seq-sub target 0 0))))
      (unless (eq new target) (replace-at box keys new)))
    taken))

(defun prefix-p (a b)
  "a is a prefix of b"
  (and (<= (length a) (length b)) (every #'equal a b)))
(defun into-itself-p (p)
  (let ((from (patch-move-path p)) (to (patch-path p)) (fr (patch-move-range p)))
    (if fr
        (and (> (length to) (length from)) (prefix-p from to)
             (let ((k (nth (length from) to)))
               (and (integerp k) (<= (first fr) k) (< k (second fr)))))
        (and (> (length to) (length from)) (prefix-p from to)))))

(defun apply-one (box p)
  (let ((path (patch-path p)) (range (patch-range p)))
    (when (and (eq (box-root box) +none+)
               (not (and (null path) (not range) (patch-has-value p))))
      (refuse "no-key"))
    (cond
      ((patch-has-move p)
       (when (into-itself-p p) (refuse "into-itself"))
       (let ((from (patch-move-path p)) (fr (patch-move-range p)))
         (if (and (not fr) (not range) (equal from path))
             (walk box path)            ; onto itself: it must be there
             (let ((taken (if fr (take-span box from fr) (remove-at box from :strict t))))
               ;; the whole taken: a put at [] lands, a span at [] meets no sequence (wrong-kind)
               (when (and (eq (box-root box) +none+) path) (refuse "no-key"))
               (cond ((not range) (put-at box path taken))
                     (t (let ((target (span-target box path range)))
                          (splice-at box path range
                                     (if (and (jlistp target) (not fr)) (mklist (list taken)) taken)))))))))
      (range (if (patch-has-value p)
                 (splice-at box path range (if *copy-values* (deep-copy (patch-value p)) (patch-value p)))
                 (take-span box path range)))
      ((patch-has-value p) (put-at box path (if *copy-values* (deep-copy (patch-value p)) (patch-value p))))
      (t (remove-at box path)))))

(defun apply-patches (root patches)
  "root after patches (a list of raw patch JSON, values revived); a refusal signals apply-error
   with the patch's index. root itself is never changed"
  (let ((box (make-box :root (deep-copy root))))
    (loop for x across patches
          for i from 0
          do (handler-bind ((apply-error (lambda (e) (unless (index e) (setf (index e) i)))))
               (apply-one box (read-patch x))))
    (box-root box)))
