;;; tracker.lisp — who reads what: links from a reader to a spot, kept in the order read, rerun
;;; with a cursor that confirms what is read again in order and drops the rest at the end
(in-package :ermine)

(defstruct link from to (run 0))
(defstruct tnode name (reads '()) (readers '()) (cursor nil) (running nil) (run 0))

(defvar *tnodes* (make-hash-table :test 'equal))
(defvar *runs* 0 "runs begun, to tell this run's links from older ones")

(defun tnode (name)
  (or (gethash name *tnodes*) (setf (gethash name *tnodes*) (make-tnode :name name))))

(defun after-cursor (n)
  "the link after n's cursor: its first with no cursor"
  (if (tnode-cursor n)
      (second (member (tnode-cursor n) (tnode-reads n)))
      (first (tnode-reads n))))
(defun insert-after-cursor (n l)
  (let ((c (tnode-cursor n)))
    (if c
        (let ((cell (member c (tnode-reads n)))) (push l (cdr cell)))
        (push l (tnode-reads n)))))
(defun drop-link (l)
  (let ((from (tnode (link-from l))) (to (tnode (link-to l))))
    (setf (tnode-reads from) (remove l (tnode-reads from))
          (tnode-readers to) (remove l (tnode-readers to)))))

(defun track (from to)
  (let* ((n (tnode from)) (spot (tnode to)) (c (tnode-cursor n)) (next (after-cursor n))
         (newest (car (last (tnode-readers spot)))))
    (cond ((and c (equal (link-to c) to)))
          ((and next (equal (link-to next) to))
           (setf (link-run next) (tnode-run n) (tnode-cursor n) next))
          ((and newest (equal (link-from newest) from) (tnode-running n) (= (link-run newest) (tnode-run n))))
          (t (let ((l (make-link :from from :to to :run (tnode-run n))))
               (insert-after-cursor n l)
               (setf (tnode-readers spot) (append (tnode-readers spot) (list l))
                     (tnode-cursor n) l))))))

(defun begin-run (from)
  (let ((n (tnode from)))
    (when (tnode-running n) (fail "begin in a run: end it first"))
    (setf (tnode-running n) t (tnode-cursor n) nil (tnode-run n) (incf *runs*))))

(defun end-run (from)
  (let ((n (tnode from)))
    (when (tnode-running n)
      (let ((tail (if (tnode-cursor n) (cdr (member (tnode-cursor n) (tnode-reads n))) (tnode-reads n))))
        (dolist (l (copy-list tail)) (drop-link l)))
      (setf (tnode-running n) nil (tnode-cursor n) nil))))

(defun untrack (from &optional (to nil to-p))
  (let ((n (tnode from)))
    (if (not to-p)
        (progn (dolist (l (copy-list (tnode-reads n))) (drop-link l))
               (setf (tnode-cursor n) nil))
        (let ((c (tnode-cursor n)))
          ;; the cursor on a link going: back to the nearest link before it that stays
          (when (and c (equal (link-to c) to))
            (setf (tnode-cursor n)
                  (let ((before nil))
                    (dolist (l (tnode-reads n) before)
                      (when (eq l c) (return before))
                      (unless (equal (link-to l) to) (setf before l))))))
          (dolist (l (remove-if-not (lambda (l) (equal (link-to l) to)) (tnode-reads n)))
            (drop-link l))))))

(defun add (from to)
  (let ((n (tnode from)))
    (unless (some (lambda (l) (equal (link-to l) to)) (tnode-reads n))
      (let ((l (make-link :from from :to to :run -1)))
        (setf (tnode-reads n) (append (tnode-reads n) (list l)))
        (let ((spot (tnode to))) (setf (tnode-readers spot) (append (tnode-readers spot) (list l))))))))

(defun name-field (req name)
  (multiple-value-bind (v there) (jget req name)
    (unless (and there (stringp v)) (fail "~a missing" name))
    v))

(defharness "tracker" (req)
  (let ((op (op-of req)))
    (cond
      ((string= op "begin")
       (begin-run (name-field req "from"))
       (jmap))
      ((string= op "end") (end-run (name-field req "from")) (jmap))
      ((string= op "track") (track (name-field req "from") (name-field req "to")) (jmap))
      ((string= op "add")
       (let ((from (name-field req "from")) (to (name-field req "to")))
         (when (tnode-running (tnode from)) (fail "add in a run: use track"))
         (add from to)
         (jmap)))
      ((string= op "untrack")
       (let ((from (name-field req "from")))
         (if (jhas req "to") (untrack from (name-field req "to")) (untrack from))
         (jmap)))
      ((string= op "reads")
       (jmap "names" (mklist (mapcar #'link-to (tnode-reads (tnode (name-field req "of")))))))
      ((string= op "readers")
       (jmap "names" (mklist (mapcar #'link-from (tnode-readers (tnode (name-field req "of")))))))
      (t (fail "unknown op ~a" op)))))
