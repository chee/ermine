;;; json.lisp — values and their JSON form, read and written by hand.
;;;
;;; a value, in lisp:
;;;   :null :true :false            null and the booleans
;;;   integer                       a whole number (|n| <= 2^53)
;;;   double-float                  every other number: -0, fractions, NaN, the infinities, big ones
;;;   string                        code points; a lone surrogate is a surrogate char, a high then a
;;;                                 low always joined into one char (normalize)
;;;   jmap                          a map, its keys in order
;;;   (vector t) with fill-pointer  a list
;;;   typed, bytes, live, jsym      the "/" forms: typed arrays, bytes, stand-ins, symbols
(in-package :ermine)

(defstruct (jmap (:constructor %make-jmap)) (entries nil))
(defstruct typed kind (elems #() :type simple-vector))
(defstruct bytes (data #() :type vector))
(defstruct live kind)
(defstruct jsym name)

(defun make-jmap (&optional pairs) (%make-jmap :entries (mapcar (lambda (p) (cons (car p) (cdr p))) pairs)))
(defun jmap (&rest kvs)
  "a map from alternating keys and values; a value of NIL leaves its key out"
  (%make-jmap :entries (loop for (k v) on kvs by #'cddr unless (null v) collect (cons k v))))
(defun jget (m k &optional default)
  (let ((e (assoc k (jmap-entries m) :test #'string=)))
    (if e (values (cdr e) t) (values default nil))))
(defun jhas (m k) (and (assoc k (jmap-entries m) :test #'string=) t))
(defun jput (m k v)
  "put v at k: a key there keeps its place, a new key goes last"
  (let ((e (assoc k (jmap-entries m) :test #'string=)))
    (if e (setf (cdr e) v)
        (setf (jmap-entries m) (nconc (jmap-entries m) (list (cons k v)))))
    v))
(defun jdel (m k)
  (setf (jmap-entries m) (remove k (jmap-entries m) :key #'car :test #'string= :count 1)))
(defun jkeys (m) (mapcar #'car (jmap-entries m)))
(defun jcount (m) (length (jmap-entries m)))

(defun mklist (&optional (items '()))
  (let* ((n (length items)) (v (make-array n :adjustable t :fill-pointer n)))
    (replace v items) v))
(defun jlistp (x) (and (vectorp x) (not (stringp x))))
(defun jlist (&rest xs) (mklist xs))

;;; symbols: one per name
(defvar *symbols* (make-hash-table :test 'equal))
(defun intern-jsym (name)
  (or (gethash name *symbols*) (setf (gethash name *symbols*) (make-jsym :name name))))

;;; numbers
(defconstant +2^53+ 9007199254740992)
(defvar *inf* sb-ext:double-float-positive-infinity)
(defvar *-inf* sb-ext:double-float-negative-infinity)
(defvar *nan* (sb-kernel:make-double-float -524288 0))
(defun nanp (x) (and (floatp x) (sb-ext:float-nan-p x)))
(defun minus-zero-p (x) (and (floatp x) (zerop x) (minusp (float-sign x))))
(defun numberish (x) (realp x))
(defun whole-number-p (x)
  "a whole number as JavaScript's Number.isInteger has it (-0 and 1e300 too)"
  (or (integerp x)
      (and (floatp x) (not (sb-ext:float-nan-p x)) (not (sb-ext:float-infinity-p x))
           (= x (ffloor x)))))
(defun norm-number (x)
  "a number in its one lisp shape: whole and within 2^53 an integer, else a double; -0 a double"
  (cond ((integerp x) (if (<= (abs x) +2^53+) x (coerce x 'double-float)))
        ((rationalp x) (coerce x 'double-float))
        ((floatp x)
         (let ((d (coerce x 'double-float)))
           (if (and (whole-number-p d) (not (minus-zero-p d)) (<= (abs d) +2^53+))
               (round d) d)))
        (t x)))
(defun index-of (x)
  "a whole number >= 0 as an integer (-0 is 0, big doubles their integer)"
  (if (integerp x) x (round x)))

;;; strings: surrogates
(defun high-p (c) (<= #xD800 (char-code c) #xDBFF))
(defun low-p (c) (<= #xDC00 (char-code c) #xDFFF))
(defun lone-p (c) (<= #xD800 (char-code c) #xDFFF))
(defun normalize (s)
  "a lone high followed by a lone low joined into one code point"
  (if (loop for i from 0 below (1- (length s))
            thereis (and (high-p (char s i)) (low-p (char s (1+ i)))))
      (with-output-to-string (o)
        (let ((i 0) (n (length s)))
          (loop while (< i n)
                do (let ((c (char s i)))
                     (if (and (high-p c) (< (1+ i) n) (low-p (char s (1+ i))))
                         (progn (write-char (code-char (+ #x10000 (ash (- (char-code c) #xD800) 10)
                                                          (- (char-code (char s (1+ i))) #xDC00)))
                                            o)
                                (incf i 2))
                         (progn (write-char c o) (incf i)))))))
      s))
(defun has-lone-p (s) (some #'lone-p s))
(defun utf16-length (s) (loop for c across s sum (if (> (char-code c) #xFFFF) 2 1)))

;;; reading JSON text into raw JSON (maps are jmaps, lists vectors)
(define-condition bad-json (error) ((why :initarg :why :reader why))
  (:report (lambda (c s) (format s "~a" (why c)))))
(defun bad (fmt &rest args) (error 'bad-json :why (apply #'format nil fmt args)))

(defun parse-json (text)
  (let ((i 0) (n (length text)))
    (labels ((peek () (if (< i n) (char text i) nil))
             (ws () (loop while (and (< i n) (member (char text i) '(#\Space #\Tab #\Newline #\Return)))
                          do (incf i)))
             (expect (c) (if (eql (peek) c) (incf i) (bad "expected ~a at ~a" c i)))
             (word (w v) (if (and (<= (+ i (length w)) n) (string= w text :start2 i :end2 (+ i (length w))))
                             (progn (incf i (length w)) v)
                             (bad "bad word at ~a" i)))
             (val ()
               (ws)
               (let ((c (peek)))
                 (case c
                   (#\{ (incf i) (obj))
                   (#\[ (incf i) (arr))
                   (#\" (incf i) (str))
                   (#\t (word "true" :true))
                   (#\f (word "false" :false))
                   (#\n (word "null" :null))
                   (t (if (and c (or (digit-char-p c) (char= c #\-))) (num) (bad "unexpected ~a at ~a" c i))))))
             (obj ()
               (let ((m (%make-jmap)) (tail nil))
                 (ws)
                 (if (eql (peek) #\}) (progn (incf i) m)
                     (loop
                       (ws) (expect #\")
                       (let ((k (str)))
                         (ws) (expect #\:)
                         (let* ((v (val)) (e (assoc k (jmap-entries m) :test #'string=)))
                           ;; a key given twice: the last wins, in the first's place (JSON.parse)
                           (if e (setf (cdr e) v)
                               (let ((cell (list (cons k v))))
                                 (if tail (setf (cdr tail) cell) (setf (jmap-entries m) cell))
                                 (setf tail cell)))))
                       (ws)
                       (case (peek)
                         (#\, (incf i))
                         (#\} (incf i) (return m))
                         (t (bad "bad object at ~a" i)))))))
             (arr ()
               (let ((items '()))
                 (ws)
                 (if (eql (peek) #\]) (progn (incf i) (mklist))
                     (loop
                       (push (val) items)
                       (ws)
                       (case (peek)
                         (#\, (incf i))
                         (#\] (incf i) (return (mklist (nreverse items))))
                         (t (bad "bad array at ~a" i)))))))
             (hex4 ()
               (when (> (+ i 4) n) (bad "short escape"))
               (let ((v (parse-integer text :start i :end (+ i 4) :radix 16)))
                 (incf i 4) v))
             (str ()
               (let ((o (make-string-output-stream)) (escaped nil))
                 (loop
                   (when (>= i n) (bad "unterminated string"))
                   (let ((c (char text i)))
                     (incf i)
                     (cond ((char= c #\") (return))
                           ((char= c #\\)
                            (when (>= i n) (bad "bad escape"))
                            (let ((e (char text i)))
                              (incf i)
                              (case e
                                (#\" (write-char #\" o)) (#\\ (write-char #\\ o)) (#\/ (write-char #\/ o))
                                (#\b (write-char (code-char 8) o)) (#\f (write-char (code-char 12) o))
                                (#\n (write-char (code-char 10) o)) (#\r (write-char (code-char 13) o))
                                (#\t (write-char (code-char 9) o))
                                (#\u (setf escaped t) (write-char (code-char (hex4)) o))
                                (t (bad "bad escape ~a" e)))))
                           ((< (char-code c) 32) (bad "control character in string"))
                           (t (write-char c o)))))
                 (let ((s (get-output-stream-string o)))
                   (if escaped (normalize s) s))))
             (num ()
               (let ((start i) (neg nil) (frac nil) (ex nil))
                 (when (eql (peek) #\-) (setf neg t) (incf i))
                 (unless (and (peek) (digit-char-p (peek))) (bad "bad number"))
                 (if (eql (peek) #\0) (incf i)
                     (loop while (and (peek) (digit-char-p (peek))) do (incf i)))
                 (let ((int-end i))
                   (when (eql (peek) #\.)
                     (incf i) (setf frac i)
                     (unless (and (peek) (digit-char-p (peek))) (bad "bad number"))
                     (loop while (and (peek) (digit-char-p (peek))) do (incf i)))
                   (let ((frac-end i))
                     (when (member (peek) '(#\e #\E))
                       (incf i)
                       (let ((es i))
                         (when (member (peek) '(#\+ #\-)) (incf i))
                         (unless (and (peek) (digit-char-p (peek))) (bad "bad number"))
                         (loop while (and (peek) (digit-char-p (peek))) do (incf i))
                         (setf ex (parse-integer text :start es :end i))))
                     (let* ((ip (parse-integer text :start (if neg (1+ start) start) :end int-end))
                            (fp (if frac (parse-integer text :start frac :end frac-end) 0))
                            (fd (if frac (- frac-end frac) 0))
                            (r (* (+ ip (/ fp (expt 10 fd))) (if ex (expt 10 ex) 1))))
                       (make-number r neg)))))))
      (let ((v (val)))
        (ws)
        (when (< i n) (bad "trailing text"))
        v))))

(defun make-number (r neg)
  "the number of rational magnitude r, negative when neg, as JavaScript reads it"
  (cond ((zerop r) (if neg -0d0 0))
        ((and (integerp r) (<= r +2^53+)) (if neg (- r) r))
        ((> r most-positive-double-float) (if neg *-inf* *inf*))
        (t (norm-number (let ((d (coerce r 'double-float))) (if neg (- d) d))))))

;;; writing raw JSON
(defun write-json-string (s o)
  (write-char #\" o)
  (loop for c across s
        for code = (char-code c)
        do (cond ((char= c #\") (write-string "\\\"" o))
                 ((char= c #\\) (write-string "\\\\" o))
                 ((= code 10) (write-string "\\n" o))
                 ((= code 13) (write-string "\\r" o))
                 ((= code 9) (write-string "\\t" o))
                 ((= code 8) (write-string "\\b" o))
                 ((= code 12) (write-string "\\f" o))
                 ((or (< code 32) (<= #xD800 code #xDFFF)) (format o "\\u~(~4,'0x~)" code))
                 (t (write-char c o))))
  (write-char #\" o))

(defun write-number (x o)
  (cond ((integerp x) (format o "~d" x))
        ((minus-zero-p x) (write-string "-0" o))
        ((sb-ext:float-nan-p x) (write-string "null" o))
        ((sb-ext:float-infinity-p x) (write-string "null" o))
        ((and (whole-number-p x) (< (abs x) 1d21)) (format o "~d" (round x)))
        (t (let ((*read-default-float-format* 'double-float))
             (write-string (substitute #\e #\d (prin1-to-string x)) o)))))

(defun write-json (x o)
  (cond ((eq x :null) (write-string "null" o))
        ((eq x :true) (write-string "true" o))
        ((eq x :false) (write-string "false" o))
        ((realp x) (write-number x o))
        ((stringp x) (write-json-string x o))
        ((jmap-p x)
         (write-char #\{ o)
         (loop for (e . more) on (jmap-entries x)
               do (write-json-string (car e) o) (write-char #\: o) (write-json (cdr e) o)
                  (when more (write-char #\, o)))
         (write-char #\} o))
        ((jlistp x)
         (write-char #\[ o)
         (loop for j from 0 below (length x)
               do (when (> j 0) (write-char #\, o)) (write-json (aref x j) o))
         (write-char #\] o))
        (t (write-json (form x) o))))

(defun json-text (x) (with-output-to-string (o) (write-json x o)))

;;; the "/" forms: values from their JSON form and back (form.ts)
(define-condition bad-form (error) ((why :initarg :why :reader why))
  (:report (lambda (c s) (format s "not a value: ~a" (why c)))))
(defun no-form (why) (error 'bad-form :why why))

(defparameter +kinds+ '("int8" "int16" "uint16" "int32" "uint32" "int64" "uint64" "float32" "float64"))
(defun kind-range (kind)
  (cdr (assoc kind '(("int8" -128 . 127) ("int16" -32768 . 32767) ("uint16" 0 . 65535)
                     ("int32" -2147483648 . 2147483647) ("uint32" 0 . 4294967295)
                     ("int64" -9223372036854775808 . 9223372036854775807)
                     ("uint64" 0 . 18446744073709551615))
              :test #'string=)))
(defun float-kind-p (kind) (member kind '("float32" "float64") :test #'string=))
(defun big-kind-p (kind) (member kind '("int64" "uint64") :test #'string=))

(defun slash-map-p (x) (and (jmap-p x) (= (jcount x) 1) (string= (car (first (jmap-entries x))) "/")))

(defun to-float32 (x)
  "x rounded as a float32 holds it, as a double"
  (cond ((or (nanp x) (and (floatp x) (sb-ext:float-infinity-p x))) x)
        ((minus-zero-p x) -0d0)
        ((> (abs x) 3.4028235677973366d38)
         ;; past the largest float32, rounding to it or to infinity
         (if (>= (abs x) 3.4028235677973366d38) (if (plusp x) *inf* *-inf*) x))
        (t (norm-number (coerce (coerce x 'single-float) 'double-float)))))

(defun typed-elem (kind e)
  "one element of a typed array from its JSON form"
  (cond ((big-kind-p kind)
         (unless (and (stringp e) (plusp (length e))
                      (let ((d (if (char= (char e 0) #\-) (subseq e 1) e)))
                        (and (plusp (length d)) (every #'digit-char-p d))))
           (no-form "typed"))
         (let ((v (parse-integer e)) (r (kind-range kind)))
           (when (or (< v (car r)) (> v (cdr r)) (and (string= kind "uint64") (char= (char e 0) #\-)))
             (no-form "typed"))
           v))
        ((float-kind-p kind)
         (let ((v (cond ((realp e) e)
                        ((equal e "NaN") *nan*) ((equal e "Infinity") *inf*) ((equal e "-Infinity") *-inf*)
                        (t (no-form "typed")))))
           (if (string= kind "float32") (to-float32 v) v)))
        (t (let ((r (kind-range kind)))
             (unless (and (realp e) (whole-number-p e) (<= (car r) e (cdr r))) (no-form "typed"))
             (index-of e)))))

(defparameter +b64+ "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/")
(defun b64-decode (s)
  (unless (and (stringp s) (/= (mod (length s) 4) 1)) (no-form "bytes"))
  (let ((out (make-array 0 :element-type '(unsigned-byte 8) :adjustable t :fill-pointer 0))
        (bits 0) (held 0))
    (loop for c across s
          for d = (position c +b64+)
          do (unless d (no-form "bytes"))
             (setf bits (logior (ash bits 6) d))
             (incf held 6)
             (when (>= held 8)
               (decf held 8)
               (vector-push-extend (logand (ash bits (- held)) #xff) out))
             (setf bits (logand bits (1- (ash 1 held)))))
    (unless (zerop bits) (no-form "bytes"))
    (coerce out '(simple-array (unsigned-byte 8) (*)))))
(defun b64-encode (data)
  (with-output-to-string (o)
    (loop for i from 0 below (length data) by 3
          for n = (min 3 (- (length data) i))
          for w = (logior (ash (aref data i) 16)
                          (if (> n 1) (ash (aref data (+ i 1)) 8) 0)
                          (if (> n 2) (aref data (+ i 2)) 0))
          do (loop for k from 0 to n
                   do (write-char (char +b64+ (logand (ash w (- (* 6 (- 3 k)))) 63)) o)))))

(defun revive (x &key (symbols t) (surrogates t))
  "a value from its JSON form; a form that stands for none signals bad-form"
  (cond ((stringp x) (if (or surrogates (not (has-lone-p x))) x (no-form "a lone surrogate")))
        ((jlistp x) (mklist (map 'list (lambda (e) (revive e :symbols symbols :surrogates surrogates)) x)))
        ((slash-map-p x)
         (let ((f (cdr (first (jmap-entries x)))))
           (unless (and (jmap-p f) (= (jcount f) 1)) (no-form "form"))
           (destructuring-bind ((tag . body)) (jmap-entries f)
             (cond ((string= tag "map")
                    (unless (slash-map-p body) (no-form "map"))
                    (jmap "/" (revive (jget body "/") :symbols symbols :surrogates surrogates)))
                   ((string= tag "live") (make-live :kind (revive body :symbols symbols :surrogates surrogates)))
                   ((string= tag "symbol")
                    (unless (and symbols (stringp body)) (no-form "symbol"))
                    (intern-jsym body))
                   ((string= tag "bytes") (make-bytes :data (b64-decode body)))
                   ((string= tag "number")
                    (cond ((equal body "NaN") *nan*) ((equal body "Infinity") *inf*)
                          ((equal body "-Infinity") *-inf*) (t (no-form "number"))))
                   ((member tag +kinds+ :test #'string=)
                    (unless (jlistp body) (no-form "typed"))
                    (make-typed :kind tag :elems (map 'simple-vector (lambda (e) (typed-elem tag e)) body)))
                   (t (no-form "unknown tag"))))))
        ((jmap-p x)
         (%make-jmap :entries (mapcar (lambda (e)
                                        (unless (or surrogates (not (has-lone-p (car e)))) (no-form "a lone surrogate"))
                                        (cons (car e) (revive (cdr e) :symbols symbols :surrogates surrogates)))
                                      (jmap-entries x))))
        (t x)))

(defun slash (x) (jmap "/" x))
(defun float-word (e)
  (cond ((nanp e) "NaN") ((eql e *inf*) "Infinity") ((eql e *-inf*) "-Infinity") (t e)))
(defun form (x)
  "a value's JSON form (raw JSON)"
  (cond ((floatp x)
         (cond ((nanp x) (slash (jmap "number" "NaN")))
               ((eql x *inf*) (slash (jmap "number" "Infinity")))
               ((eql x *-inf*) (slash (jmap "number" "-Infinity")))
               (t x)))
        ((typed-p x)
         (let ((k (typed-kind x)))
           (slash (jmap k (mklist (map 'list (lambda (e)
                                               (cond ((big-kind-p k) (format nil "~d" e))
                                                     ((float-kind-p k) (float-word e))
                                                     (t e)))
                                       (typed-elems x)))))))
        ((bytes-p x) (slash (jmap "bytes" (b64-encode (bytes-data x)))))
        ((live-p x) (slash (jmap "live" (form (live-kind x)))))
        ((jsym-p x) (slash (jmap "symbol" (jsym-name x))))
        ((jlistp x) (mklist (map 'list #'form x)))
        ((slash-map-p x) (slash (jmap "map" (jmap "/" (form (jget x "/"))))))
        ((jmap-p x) (%make-jmap :entries (mapcar (lambda (e) (cons (car e) (form (cdr e)))) (jmap-entries x))))
        (t x)))

;;; equality and copying of values
(defun deep-copy (x)
  (cond ((jlistp x) (mklist (map 'list #'deep-copy x)))
        ((jmap-p x) (%make-jmap :entries (mapcar (lambda (e) (cons (car e) (deep-copy (cdr e)))) (jmap-entries x))))
        ((typed-p x) (make-typed :kind (typed-kind x) :elems (copy-seq (typed-elems x))))
        ((bytes-p x) (make-bytes :data (copy-seq (bytes-data x))))
        (t x)))

(defun same-number (a b)
  "Object.is on numbers"
  (cond ((and (nanp a) (nanp b)) t)
        ((or (nanp a) (nanp b)) nil)
        ((and (zerop a) (zerop b)) (eq (minus-zero-p a) (minus-zero-p b)))
        (t (= a b))))
