;;; node.lisp — entries (a value and the change that made it), nodes (tables of entries), and
;;; update (patches applied to an entry, the change their header with op: { patches, undo })
(in-package :ermine)

(defun now () (- (get-universal-time) 2208988800))

(defun site-json (s)
  (unless (jmap-p s) (fail "a site is not a map"))
  (let ((m (jmap "file" (jget s "file") "line" (jget s "line"))))
    (multiple-value-bind (c there) (jget s "column") (when there (jput m "column" c)))
    (multiple-value-bind (f there) (jget s "function") (when there (jput m "function" f)))
    m))

(defun change-json (header &key add-time)
  "a header's known fields in their one order: time, actor, reader, external, metadata (op apart).
   add-time: the time now when it has none"
  (let ((h (or header (jmap))) (m (jmap)))
    (unless (jmap-p h) (fail "header: not a map"))
    (multiple-value-bind (time there) (jget h "time")
      (cond (there (jput m "time" (if (minus-zero-p time) 0 time)))
            (add-time (jput m "time" (if (integerp add-time) add-time (now))))))
    (multiple-value-bind (actor there) (jget h "actor") (when there (jput m "actor" actor)))
    (multiple-value-bind (reader there) (jget h "reader") (when there (jput m "reader" reader)))
    (multiple-value-bind (ext there) (jget h "external")
      (when there
        (unless (jlistp ext) (fail "external: not a list"))
        (jput m "external" (mklist (map 'list #'site-json ext)))))
    (multiple-value-bind (md there) (jget h "metadata")
      (when there
        (unless (and (jlistp md)
                     (every (lambda (e) (and (jlistp e) (= (length e) 2) (stringp (aref e 0)))) md))
          (fail "metadata: an entry is not a [string, value] pair"))
        (jput m "metadata" md)))
    m))

(defun entry-json (value change)
  (let ((m (jmap)))
    (unless (eq value +none+) (jput m "value" (form value)))
    (jput m "change" change)
    m))

(defharness "node" (req)
  (let ((op (op-of req)))
    (cond ((string= op "entry")
           (let ((v (value-of req)))
             (jmap "entry" (entry-json v (change-json (jget req "header") :add-time t)))))
          ((string= op "node")
           (let ((values (jget req "values")) (time (now)))
             (unless (jmap-p values) (fail "node: values is not a map"))
             (let ((tables (mapcar (lambda (e) (cons (car e) (revive (cdr e)))) (jmap-entries values))))
               (jmap "node" (%make-jmap
                             :entries (mapcar (lambda (e)
                                                (cons (car e)
                                                      (entry-json (cdr e) (change-json (jget req "header") :add-time time))))
                                              tables))))))
          (t (fail "unknown op ~a" op)))))

;;; update: one entry for the process
(defvar *entry-value* +none+)
(defvar *entry-change* nil)

(defun patch-json (p)
  "a patch as path, range, value, move; nothing else; -0 as an index 0"
  (let ((m (jmap "path" (mklist (patch-path p)))))
    (when (patch-range p) (jput m "range" (mklist (patch-range p))))
    (when (patch-has-value p) (jput m "value" (form (patch-value p))))
    (when (patch-has-move p)
      (jput m "move" (if (patch-move-range p)
                         (jmap "path" (mklist (patch-move-path p)) "range" (mklist (patch-move-range p)))
                         (jmap "path" (mklist (patch-move-path p))))))
    m))

(defharness "update" (req)
  (unless *entry-change* (setf *entry-change* (jmap "time" (now))))
  (let ((op (op-of req)))
    (cond ((string= op "start")
           (let ((v (value-of req)) (change (change-json (jget req "header") :add-time t)))
             (setf *entry-value* v *entry-change* change)
             (jmap)))
          ((string= op "update")
           (let ((ps (patches-of req)))
             (handler-case
                 (multiple-value-bind (undo after) (invert-patches *entry-value* ps)
                   (let ((change (if (jhas req "header") (change-json (jget req "header"))
                                     (jmap "time" 1 "actor" "me"))))
                     (jput change "op" (jmap "patches" (mklist (map 'list (lambda (x) (patch-json (read-patch x))) ps))
                                             "undo" (form undo)))
                     (setf *entry-value* after *entry-change* change)
                     (jmap)))
               (apply-error (e) (refusal e)))))
          ((string= op "entry") (jmap "entry" (entry-json *entry-value* *entry-change*)))
          (t (fail "unknown op ~a" op)))))
