;;; paths.lisp — reads kept as spots in a trie of path steps per key; a patch marks the spots it
;;; reaches, walked in one order
(in-package :ermine)

;;; a place: one patch's footprint; n the length put (:unknown when not known)
(defstruct place path range put n)

(defun read-index-path (p)
  "a path: strings and whole numbers 0 <= n < 1e15 (-0 is 0)"
  (unless (and (jlistp p)
               (every (lambda (k) (or (stringp k)
                                      (and (realp k) (whole-number-p k) (>= k 0) (< k 1000000000000000))))
                      p))
    (fail "bad path"))
  (map 'list (lambda (k) (if (stringp k) k (index-of k))) p))

(defun places-of (patch)
  (unless (and (jmap-p patch) (jhas patch "path")) (fail "a malformed patch"))
  (let* ((path (read-index-path (jget patch "path")))
         (r (jget patch "range"))
         (range (and (jlistp r) (list (index-of (aref r 0)) (index-of (aref r 1)))))
         (move (jget patch "move")))
    (if (jmap-p move)
        (let* ((from (read-index-path (jget move "path")))
               (mr (jget move "range"))
               (mrange (and (jlistp mr) (list (index-of (aref mr 0)) (index-of (aref mr 1))))))
          (list (make-place :path from :range mrange :put nil :n 0)
                (make-place :path path :range range :put t
                            :n (if mrange (- (second mrange) (first mrange)) 1))))
        (multiple-value-bind (v has) (jget patch "value")
          (list (make-place :path path :range range :put has
                            :n (cond ((not has) 0) ((jlistp v) (length v)) (t :unknown))))))))

(defun removal-at-index-p (q)
  (and (not (place-range q)) (not (place-put q)) (place-path q) (integerp (car (last (place-path q))))))
(defun span-reaches (q k)
  (destructuring-bind (a b) (place-range q)
    (if (eql (place-n q) (- b a)) (and (<= a k) (< k b)) (>= k a))))

(defun reaches (q p &optional keys)
  "the rule: place q reaches a plain read of p (keys: a keys read)"
  (let ((qp (place-path q)) (lq (length (place-path q))) (lp (length p)))
    (if (and keys (> lq lp))
        (and (= lq (1+ lp)) (prefix-p p qp) (not (place-range q)))
        (or (prefix-p p qp)
            (and (removal-at-index-p q) (> lp (1- lq)) (prefix-p (butlast qp) p)
                 (integerp (nth (1- lq) p)) (> (nth (1- lq) p) (car (last qp))))
            (and (< lq lp) (prefix-p qp p) (not (place-range q)))
            (and (place-range q) (< lq lp) (prefix-p qp p) (integerp (nth lq p))
                 (span-reaches q (nth lq p)))))))

;;; the trie
(defstruct (pstep (:conc-name step-)) key path (spot nil) (keys nil) (kids '()))
(defstruct pkey (change nil) top)
(defvar *pkeys* (make-hash-table :test 'equal) "(source . id) → pkey, in no order")

(defun read-source (req name)
  (multiple-value-bind (k there) (jget req name)
    (cond ((and there (stringp k)) k)
          ((and there (jmap-p k) (= (jcount k) 1) (stringp (jget k "symbol"))) (intern-jsym (jget k "symbol")))
          (t (fail "~a: neither a string nor a symbol" name)))))
(defun key-of (req) (cons (read-source req "source") (read-source req "id")))

(defun kid (s k) (find k (step-kids s) :key #'step-key :test #'equal))
(defun step-at (top path &key make)
  (let ((s top))
    (loop for k in path
          for i from 1
          do (let ((next (kid s k)))
               (unless next
                 (if make
                     (progn (setf next (make-pstep :key k :path (subseq path 0 i)))
                            (setf (step-kids s) (append (step-kids s) (list next))))
                     (return-from step-at nil)))
               (setf s next)))
    s))
(defun empty-step-p (s) (not (or (step-spot s) (step-keys s) (step-kids s))))
(defun prune (top path)
  "steps along path left with nothing go, deepest first"
  (loop for i from (length path) downto 1
        do (let ((parent (step-at top (subseq path 0 (1- i)))) (s (step-at top (subseq path 0 i))))
             (when (and parent s (empty-step-p s))
               (setf (step-kids parent) (remove s (step-kids parent)))))))
(defun drop-key-if-empty (key)
  (let ((pk (gethash key *pkeys*)))
    (when (and pk (not (pkey-change pk)) (empty-step-p (pkey-top pk)))
      (remhash key *pkeys*))))

;;; the walk
(defun number-kids (s pred)
  (sort (copy-list (remove-if-not (lambda (c) (and (integerp (step-key c)) (funcall pred (step-key c)))) (step-kids s)))
        #'< :key #'step-key))

(defun walk-marks (pk patches)
  (let ((out '()) (seen (make-hash-table :test 'equal)))
    (labels ((emit (s kind)
               (when (and (if (eq kind :keys) (step-keys s) (step-spot s)) (not (gethash (cons s kind) seen)))
                 (setf (gethash (cons s kind) seen) t)
                 (push (if (eq kind :keys) (jmap "keys" (mklist (step-path s))) (mklist (step-path s))) out)))
             (wholly (s)
               (emit s :spot) (emit s :keys)
               (dolist (c (step-kids s)) (wholly c)))
             (walk (q)
               (let ((s (pkey-top pk)) (path (place-path q)))
                 (loop for k in path
                       for i from 1
                       do (emit s :spot)
                          (when (= i (length path))
                            (unless (place-range q) (emit s :keys))
                            (when (removal-at-index-p q)
                              (dolist (c (number-kids s (lambda (j) (> j k)))) (wholly c))))
                          (setf s (kid s k))
                          (unless s (return-from walk)))
                 (if (not (place-range q))
                     (wholly s)
                     (destructuring-bind (a b) (place-range q)
                       (emit s :spot) (emit s :keys)
                       (dolist (c (number-kids s (lambda (j) (and (>= j a)
                                                                  (or (not (eql (place-n q) (- b a))) (< j b))))))
                         (wholly c)))))))
      (when (pkey-change pk) (push "change" out))
      (dolist (p patches) (dolist (q (places-of p)) (walk q))))
    (mklist (nreverse out))))

(defharness "paths" (req)
  (let ((op (op-of req)))
    (cond
      ((string= op "spot")
       (let ((key (key-of req)))
         (unless (jhas req "path") (fail "spot: no path"))
         (let* ((path (read-index-path (jget req "path")))
                (pk (or (gethash key *pkeys*)
                        (setf (gethash key *pkeys*) (make-pkey :top (make-pstep :key nil :path '())))))
                (s (step-at (pkey-top pk) path :make t)))
           (if (eq (jget req "keys") :true) (setf (step-keys s) t) (setf (step-spot s) t))
           (jmap))))
      ((string= op "change")
       (let ((key (key-of req)))
         (setf (pkey-change (or (gethash key *pkeys*)
                                (setf (gethash key *pkeys*) (make-pkey :top (make-pstep :key nil :path '())))))
               t)
         (jmap)))
      ((string= op "release")
       (let* ((key (key-of req)) (pk (gethash key *pkeys*)))
         (if (jhas req "path")
             (let ((path (read-index-path (jget req "path"))))
               (when pk
                 (let ((s (step-at (pkey-top pk) path)))
                   (when s
                     (if (eq (jget req "keys") :true) (setf (step-keys s) nil) (setf (step-spot s) nil))
                     (prune (pkey-top pk) path)))))
             (when pk (setf (pkey-change pk) nil)))
         (drop-key-if-empty key)
         (jmap)))
      ((or (string= op "mark") (string= op "event"))
       (let* ((key (key-of req))
              (patches (if (string= op "event") (list (jmap "path" (mklist)))
                           (let ((ps (jget req "patches")))
                             (unless (jlistp ps) (fail "mark: no list of patches"))
                             (coerce ps 'list)))))
         (dolist (p patches) (places-of p))   ; checked before anything
         (let ((pk (gethash key *pkeys*)))
           (jmap "spots" (if pk (walk-marks pk patches) (mklist))))))
      ((string= op "marks")
       (unless (and (jhas req "patch") (jlistp (jget req "paths"))) (fail "marks: no patch or paths"))
       (let ((places (places-of (jget req "patch")))
             (paths (map 'list #'read-index-path (jget req "paths")))
             (keys (eq (jget req "keys") :true)))
         (jmap "marks" (mklist (mapcar (lambda (p) (if (some (lambda (q) (reaches q p keys)) places) :true :false))
                                       paths)))))
      ((string= op "kept")
       (let ((keys 0) (spots 0) (steps 0))
         (maphash (lambda (k pk)
                    (declare (ignore k))
                    (incf keys)
                    (when (pkey-change pk) (incf spots))
                    (labels ((count-step (s)
                               (incf steps)
                               (when (step-spot s) (incf spots))
                               (when (step-keys s) (incf spots))
                               (mapc #'count-step (step-kids s))))
                      (count-step (pkey-top pk))))
                  *pkeys*)
         (jmap "keys" keys "spots" spots "steps" steps)))
      (t (fail "unknown op ~a" op)))))
