{
	"title": "the name belongs to the placement, not the node: one node (A) at a.c and a.txt has two types by name; a node with an explicit ermine.type (E) has the same type at both names",
	"steps": [
		{
			"op": "kids",
			"id": "R",
			"value": {
				"work": "W"
			},
			"expect": {}
		},
		{
			"op": "types",
			"expect": {}
		},
		{
			"op": "kids",
			"id": "W",
			"value": {
				"clocks": "CL"
			},
			"expect": {}
		},
		{
			"op": "kids",
			"id": "CL",
			"value": {
				"a.c": "A",
				"a.txt": "A",
				"e.c": "E",
				"e.txt": "E",
				"m.txt": "M"
			},
			"expect": {}
		},
		{
			"op": "attrs",
			"id": "E",
			"value": {
				"ermine.type": "public.json"
			},
			"expect": {}
		},
		{
			"op": "type",
			"folder": [
				"work",
				"clocks"
			],
			"expect": {
				"types": {
					"a.c": "public.c-source",
					"a.txt": "public.plain-text",
					"e.c": "public.json",
					"e.txt": "public.json",
					"m.txt": "public.plain-text"
				}
			}
		},
		{
			"op": "type",
			"node": {
				"id": "A",
				"at": [
					"work",
					"clocks",
					"a.c"
				]
			},
			"expect": {
				"type": "public.c-source"
			}
		},
		{
			"op": "type",
			"node": {
				"id": "A",
				"at": [
					"work",
					"clocks",
					"a.txt"
				]
			},
			"expect": {
				"type": "public.plain-text"
			}
		},
		{
			"op": "type",
			"node": {
				"id": "E",
				"at": [
					"work",
					"clocks",
					"e.c"
				]
			},
			"expect": {
				"type": "public.json"
			}
		},
		{
			"op": "type",
			"node": {
				"id": "E",
				"at": [
					"work",
					"clocks",
					"e.txt"
				]
			},
			"expect": {
				"type": "public.json"
			}
		}
	]
}
