					"notes.xyz": null,
					"Makefile": null,
					".c": null,
					"x.tar.gz": "org.gnu.gnu-zip-tar-archive",
					"x.gz": "org.gnu.gnu-zip-archive",
					"x.tar": "public.tar-archive",
					"w.c": "public.c-source",
					"Y.Json": "public.json",
					"v.TAR.GZ": "org.gnu.gnu-zip-tar-archive"
				}
			}
		},
		{
			"op": "type",
			"node": {
				"id": "A",
				"at": [
					"work",
					"clocks",
					"a.c"
				]
			},
			"expect": {
				"type": "public.c-source"
			}
		},
		{
