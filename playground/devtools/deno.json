{
  "tasks": {
    "build": "deno run --allow-read --allow-write --allow-env --allow-run --allow-sys build.ts",
    "install": "deno run --allow-read --allow-write --allow-env --allow-run --allow-sys build.ts install",
    "firefox": "deno task build && npx --yes web-ext run --source-dir dist/firefox --firefox-profile .firefox-profile --profile-create-if-missing --keep-profile-changes --start-url http://localhost:8040/shape/ --devtools",
    "test": "deno test --allow-read --config ../../deno.json agent_test.ts"
  },
  "nodeModulesDir": "auto",
  "imports": {
    "solid-js": "npm:solid-js@2.0.0-rc.8",
    "@solidjs/web": "npm:@solidjs/web@2.0.0-rc.8",
    "babel-preset-solid": "npm:babel-preset-solid@2.0.0-rc.2",
    "@babel/core": "npm:@babel/core@^7",
    "@babel/preset-typescript": "npm:@babel/preset-typescript@^7",
    "esbuild": "npm:esbuild@^0.25"
  },
  "compilerOptions": {
    "jsx": "preserve",
    "jsxImportSource": "@solidjs/web",
    "lib": [
      "dom",
      "dom.iterable",
      "esnext",
      "deno.ns"
    ]
  },
  "fmt": {
    "lineWidth": 100
  },
  "lint": {
    "exclude": [
      "dist"
    ]
  },
  "exclude": [
    "dist"
  ]
}
