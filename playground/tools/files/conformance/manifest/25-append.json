						"manifest",
						"00000005a16161413100000008a26161f661624132"
					]
				]
			}
		},
		{
			"op": "read",
			"expect": {
				"records": [
					[
						"b",
						"32"
					]
				]
			}
		},
		{
			"op": "open",
			"expect": {}
		},
		{
			"op": "read",
			"expect": {
				"records": [
					[
						"b",
						"32"
					]
				]
			}
		}
	]
