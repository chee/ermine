{
	"title": "each append is one frame at the log's end; a new log's folder is synced too",
	"steps": [
		{
			"op": "open",
			"expect": {}
		},
		{
			"op": "make",
			"expect": {}
		},
		{
			"op": "append",
			"frame": [
				[
					"a",
					"31"
				]
			],
			"expect": {
				"synced": [
					"manifest",
					"."
				]
			}
		},
		{
			"op": "exists",
			"expect": {
				"exists": true
			}
		},
		{
			"op": "files",
