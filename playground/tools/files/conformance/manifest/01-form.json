					"bytes": ""
				}
			},
			"expect": {
				"form": "bin"
			}
		},
		{
			"op": "form",
			"value": {
				"/": {
					"int8": [
						-1,
						127
					]
				}
			},
			"expect": {
				"form": "int8"
			}
		},
		{
			"op": "form",
			"value": {
				"/": {
