{
	"title": "a string is txt, bytes bin, a typed array its kind, anything else cbor",
	"steps": [
		{
			"op": "form",
			"value": "hi",
			"expect": {
				"form": "txt"
			}
		},
		{
			"op": "form",
			"value": "",
			"expect": {
				"form": "txt"
			}
		},
		{
			"op": "form",
			"value": {
				"/": {
					"bytes": "AQI"
				}
			},
			"expect": {
				"form": "bin"
			}
		},
		{
			"op": "form",
			"value": {
