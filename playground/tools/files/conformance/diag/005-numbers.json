				0.30000000000000004,
				0.000001,
				1e-7,
				1.5e-10,
				4294967296,
				9007199254740992,
				123456789012345680000,
				1e+21,
				1.5e+300,
				5e-324,
				1.7976931348623157e+308
			],
			"expect": {
				"text": "[\n  0,\n  0,\n  1,\n  -1,\n  1.5,\n  0.1,\n  100,\n  0.30000000000000004,\n  0.000001,\n  1e-7,\n  1.5e-10,\n  4294967296,\n  9007199254740992,\n  123456789012345680000,\n  1000000000000000000000,\n  ,\n  5e-324,\n  \n]"
			}
		},
		{
			"op": "read",
			"text": "[\n  0,\n  -0.0,\n  1,\n  -1,\n  1.5,\n  0.1,\n  100,\n  0.30000000000000004,\n  0.000001,\n  1e-7,\n  1.5e-10,\n  4294967296,\n  9007199254740992,\n  123456789012345680000,\n  1000000000000000000000,\n  ,\n  5e-324,\n  \n]",
			"expect": {
