{
	"title": "a map's keys in code point order, not UTF-16's",
	"steps": [
		{
			"op": "write",
			"value": {
				"b": 1,
				"😀": 1,
				"a": 1,
				"￿": 1,
				"aa": 1,
				"é": 1,
				"": 1,
				"B": 1
			},
			"expect": {
				"text": "{\n  \"\": 1,\n  \"B\": 1,\n  \"a\": 1,\n  \"aa\": 1,\n  \"b\": 1,\n  \"é\": 1,\n  \"￿\": 1,\n  \"😀\": 1\n}"
			}
		},
		{
			"op": "read",
			"text": "{\n  \"\": 1,\n  \"B\": 1,\n  \"a\": 1,\n  \"aa\": 1,\n  \"b\": 1,\n  \"é\": 1,\n  \"￿\": 1,\n  \"😀\": 1\n}",
			"expect": {
				"value": {
					"b": 1,
					"😀": 1,
					"a": 1,
					"￿": 1,
					"aa": 1,
					"é": 1,
					"": 1,
					"B": 1
				}
			}
		}
	]
}
