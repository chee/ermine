{
	"title": "bytes as h'' in lowercase",
	"steps": [
		{
			"op": "write",
			"value": {
				"/": {
					"bytes": "AAGr/w"
				}
			},
			"expect": {
				"text": "h'0001abff'"
			}
		},
		{
			"op": "read",
			"text": "h'0001abff'",
			"expect": {
				"value": {
					"/": {
						"bytes": "AAGr/w"
					}
				}
			}
		}
	]
}
