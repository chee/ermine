{
	"title": "NaN, Infinity and -Infinity are words",
	"steps": [
		{
			"op": "write",
			"value": [
				{
					"/": {
						"number": "NaN"
					}
				},
				{
					"/": {
						"number": "Infinity"
					}
				},
				{
					"/": {
						"number": "-Infinity"
					}
				}
			],
			"expect": {
				"text": "[\n  NaN,\n  Infinity,\n  -Infinity\n]"
			}
		},
		{
			"op": "read",
			"text": "[\n  NaN,\n  Infinity,\n  -Infinity\n]",
			"expect": {
				"value": [
					{
						"/": {
							"number": "NaN"
						}
					},
					{
						"/": {
							"number": "Infinity"
						}
					},
					{
						"/": {
							"number": "-Infinity"
						}
					}
				]
			}
		}
	]
}
