{
	"title": "a folder's uuid that is no uuid (\"..\" in it) names no folder outside: it is a store with no uuid, and nothing outside is moved or removed",
	"steps": [
		{ "op": "edit", "edit": "mkdir", "path": "@Home/.ermine/external" },
		{ "op": "edit", "edit": "mkdir", "path": "@Outside/Store/.ermine" },
		{ "op": "edit", "edit": "write", "path": "@Outside/Store/.ermine/manifest", "text": "" },
		{ "op": "edit", "edit": "mkdir", "path": "@Victim" },
		{ "op": "edit", "edit": "write", "path": "@Victim/precious", "text": "mine" },
		{
			"op": "edit",
			"edit": "attr",
			"path": "@Outside/Store",
			"name": "party.chee.ermine.store",
			"text": "../../../Victim"
		},
		{ "op": "open", "folder": "@Outside/Store", "expect": {} },
		{ "op": "read" },
		{ "op": "edit", "edit": "remove", "path": "@Victim/precious", "expect": {} }
	]
}
