{
	"title": "a name less an extension that fits, or the whole name and the extension added",
	"steps": [
		{
			"op": "split",
			"name": "clock",
			"form": "txt",
			"expect": {
				"result": {
					"stem": "clock",
					"ext": "txt",
					"added": true
				}
			}
		},
		{
			"op": "split",
			"name": "notes.md",
			"form": "txt",
			"expect": {
				"result": {
					"stem": "notes",
					"ext": "md",
					"added": false
				}
			}
		},
		{
			"op": "split",
			"name": "a.FINAL",
			"form": "txt",
			"expect": {
				"result": {
					"stem": "a.FINAL",
					"ext": "txt",
					"added": true
				}
			}
		},
		{
			"op": "split",
			"name": "notes.md",
			"form": "cbor",
			"expect": {
				"result": {
					"stem": "notes.md",
					"ext": "text",
					"added": true
				}
			}
		},
		{
			"op": "split",
			"name": "notes.text",
			"form": "cbor",
			"expect": {
				"result": {
					"stem": "notes",
					"ext": "text",
					"added": false
				}
			}
		},
		{
			"op": "split",
			"name": "notes.text",
			"form": "txt",
			"expect": {
				"result": {
					"stem": "notes.text",
					"ext": "txt",
					"added": true
				}
			}
		},
		{
			"op": "split",
			"name": "a.float32",
			"form": "float32",
			"expect": {
				"result": {
					"stem": "a",
					"ext": "float32",
					"added": false
				}
			}
		},
		{
			"op": "split",
			"name": "a.float32",
			"form": "bin",
			"expect": {
				"result": {
					"stem": "a.float32",
					"ext": "bin",
					"added": true
				}
			}
		},
		{
			"op": "split",
			"name": "a.float64",
			"form": "float32",
			"expect": {
				"result": {
					"stem": "a.float64",
					"ext": "float32",
					"added": true
				}
			}
		},
		{
			"op": "split",
			"name": ".bashrc",
			"form": "txt",
			"expect": {
				"result": {
					"stem": ".bashrc",
					"ext": "txt",
					"added": true
				}
			}
		},
		{
			"op": "split",
			"name": "pic",
			"form": "bin",
			"head": "89504e470d0a1a0a",
			"expect": {
				"result": {
					"stem": "pic",
					"ext": "png",
					"added": true
				}
			}
		},
		{
			"op": "split",
			"name": "pic.png",
			"form": "bin",
			"head": "89504e470d0a1a0a",
			"expect": {
				"result": {
					"stem": "pic",
					"ext": "png",
					"added": false
				}
			}
		},
		{
			"op": "split",
			"name": "pic.jpg",
			"form": "bin",
			"head": "89504e470d0a1a0a",
			"expect": {
				"result": {
					"stem": "pic",
					"ext": "jpg",
					"added": false
				}
			}
		},
		{
			"op": "split",
			"name": "日本.txt",
			"form": "txt",
			"expect": {
				"result": {
					"stem": "日本",
					"ext": "txt",
					"added": false
				}
			}
		},
		{
			"op": "split",
			"name": "a.b.c.d",
			"form": "txt",
			"expect": {
				"result": {
					"stem": "a.b.c",
					"ext": "d",
					"added": false
				}
			}
		}
	]
}
