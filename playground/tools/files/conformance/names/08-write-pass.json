{
	"title": "a stem that would be passed over is wrapped in _",
	"steps": [
		{
			"op": "write",
			"name": ".DS_Store",
			"pass": [
				".DS_Store",
				".localized",
				"._*",
				"Icon\r",
				"*~",
				"*.swp",
				"#*#",
				"4913"
			],
			"expect": {
				"result": "_.DS_Store_"
			}
		},
		{
			"op": "write",
			"name": ".localized",
			"pass": [
				".DS_Store",
				".localized",
				"._*",
				"Icon\r",
				"*~",
				"*.swp",
				"#*#",
				"4913"
			],
			"expect": {
				"result": "_.localized_"
			}
		},
		{
			"op": "write",
			"name": "._foo",
			"pass": [
				".DS_Store",
				".localized",
				"._*",
				"Icon\r",
				"*~",
				"*.swp",
				"#*#",
				"4913"
			],
			"expect": {
				"result": "_._foo_"
			}
		},
		{
			"op": "write",
			"name": "Icon\r",
			"pass": [
				".DS_Store",
				".localized",
				"._*",
				"Icon\r",
				"*~",
				"*.swp",
				"#*#",
				"4913"
			],
			"expect": {
				"result": "_Icon\r_"
			}
		},
		{
			"op": "write",
			"name": "Icon",
			"pass": [
				".DS_Store",
				".localized",
				"._*",
				"Icon\r",
				"*~",
				"*.swp",
				"#*#",
				"4913"
			],
			"expect": {
				"result": "Icon"
			}
		},
		{
			"op": "write",
			"name": "draft~",
			"pass": [
				".DS_Store",
				".localized",
				"._*",
				"Icon\r",
				"*~",
				"*.swp",
				"#*#",
				"4913"
			],
			"expect": {
				"result": "_draft~_"
			}
		},
		{
			"op": "write",
			"name": "foo.swp",
			"pass": [
				".DS_Store",
				".localized",
				"._*",
				"Icon\r",
				"*~",
				"*.swp",
				"#*#",
				"4913"
			],
			"expect": {
				"result": "_foo.swp_"
			}
		},
		{
			"op": "write",
			"name": "#x#",
			"pass": [
				".DS_Store",
				".localized",
				"._*",
				"Icon\r",
				"*~",
				"*.swp",
				"#*#",
				"4913"
			],
			"expect": {
				"result": "_#x#_"
			}
		},
		{
			"op": "write",
			"name": "#",
			"pass": [
				".DS_Store",
				".localized",
				"._*",
				"Icon\r",
				"*~",
				"*.swp",
				"#*#",
				"4913"
			],
			"expect": {
				"result": "#"
			}
		},
		{
			"op": "write",
			"name": "4913",
			"pass": [
				".DS_Store",
				".localized",
				"._*",
				"Icon\r",
				"*~",
				"*.swp",
				"#*#",
				"4913"
			],
			"expect": {
				"result": "_4913_"
			}
		},
		{
			"op": "write",
			"name": "49130",
			"pass": [
				".DS_Store",
				".localized",
				"._*",
				"Icon\r",
				"*~",
				"*.swp",
				"#*#",
				"4913"
			],
			"expect": {
				"result": "49130"
			}
		},
		{
			"op": "write",
			"name": "a/b~",
			"pass": [
				".DS_Store",
				".localized",
				"._*",
				"Icon\r",
				"*~",
				"*.swp",
				"#*#",
				"4913"
			],
			"expect": {
				"result": "_a:b~_"
			}
		},
		{
			"op": "write",
			"name": ".DS_Store",
			"pass": [],
			"expect": {
				"result": ".DS_Store"
			}
		},
		{
			"op": "write",
			"name": "x",
			"pass": [
				"x"
			],
			"expect": {
				"result": "_x_"
			}
		},
		{
			"op": "write",
			"name": "x",
			"pass": [
				"*"
			],
			"expect": {
				"result": "_x_"
			}
		},
		{
			"op": "write",
			"name": "",
			"pass": [
				"*"
			],
			"expect": {
				"result": "_untitled_"
			}
		},
		{
			"op": "write",
			"name": "",
			"pass": [
				"untitled"
			],
			"expect": {
				"result": "_untitled_"
			}
		}
	]
}
