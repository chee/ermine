{
	"title": "a union member's stem: its number, then words kept as written",
	"steps": [
		{
			"op": "member",
			"n": 1,
			"expect": {
				"result": "1"
			}
		},
		{
			"op": "member",
			"n": 1,
			"words": "",
			"expect": {
				"result": "1"
			}
		},
		{
			"op": "member",
			"n": 2,
			"words": " second",
			"expect": {
				"result": "2 second"
			}
		},
		{
			"op": "member",
			"n": 10,
			"words": "x",
			"expect": {
				"result": "10x"
			}
		},
		{
			"op": "member",
			"n": 3,
			"words": " — ünï 日本",
			"expect": {
				"result": "3 — ünï 日本"
			}
		},
		{
			"op": "member",
			"n": 123456789,
			"words": "",
			"expect": {
				"result": "123456789"
			}
		},
		{
			"op": "member",
			"n": 0,
			"words": "a",
			"expect": {
				"result": "0a"
			}
		},
		{
			"op": "member",
			"n": 9007199254740991,
			"words": "",
			"expect": {
				"result": "9007199254740991"
			}
		},
		{
			"op": "member",
			"n": 4,
			"words": "\n\t",
			"expect": {
				"result": "4\n\t"
			}
		}
	]
}
