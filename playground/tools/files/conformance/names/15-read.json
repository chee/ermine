{
	"title": "a person's name read back: : as /, U+FF1A as :",
	"steps": [
		{
			"op": "read",
			"name": "a:b",
			"expect": {
				"result": "a/b"
			}
		},
		{
			"op": "read",
			"name": "a：b",
			"expect": {
				"result": "a:b"
			}
		},
		{
			"op": "read",
			"name": "a:b：c:d",
			"expect": {
				"result": "a/b:c/d"
			}
		},
		{
			"op": "read",
			"name": "a/b",
			"expect": {
				"result": "a/b"
			}
		},
		{
			"op": "read",
			"name": "",
			"expect": {
				"result": ""
			}
		},
		{
			"op": "read",
			"name": "日本：語:😀",
			"expect": {
				"result": "日本:語/😀"
			}
		},
		{
			"op": "read",
			"name": "�",
			"expect": {
				"result": "�"
			}
		},
		{
			"op": "read",
			"name": "：：::",
			"expect": {
				"result": ":://"
			}
		},
		{
			"op": "read",
			"name": "ａ",
			"expect": {
				"result": "ａ"
			}
		}
	]
}
