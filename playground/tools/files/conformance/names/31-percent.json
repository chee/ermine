{
	"title": "an id as a URL segment: encodeURIComponent, with . as %2E",
	"steps": [
		{
			"op": "percent",
			"id": "abc",
			"expect": {
				"result": "abc"
			}
		},
		{
			"op": "percent",
			"id": "a.b",
			"expect": {
				"result": "a%2Eb"
			}
		},
		{
			"op": "percent",
			"id": ".",
			"expect": {
				"result": "%2E"
			}
		},
		{
			"op": "percent",
			"id": "..",
			"expect": {
				"result": "%2E%2E"
			}
		},
		{
			"op": "percent",
			"id": "",
			"expect": {
				"result": ""
			}
		},
		{
			"op": "percent",
			"id": "a b",
			"expect": {
				"result": "a%20b"
			}
		},
		{
			"op": "percent",
			"id": "a/b?c=d&e#f",
			"expect": {
				"result": "a%2Fb%3Fc%3Dd%26e%23f"
			}
		},
		{
			"op": "percent",
			"id": "-_!~*'()",
			"expect": {
				"result": "-_!~*'()"
			}
		},
		{
			"op": "percent",
			"id": "AZaz09",
			"expect": {
				"result": "AZaz09"
			}
		},
		{
			"op": "percent",
			"id": "%",
			"expect": {
				"result": "%25"
			}
		},
		{
			"op": "percent",
			"id": "%2E",
			"expect": {
				"result": "%252E"
			}
		},
		{
			"op": "percent",
			"id": "+",
			"expect": {
				"result": "%2B"
			}
		},
		{
			"op": "percent",
			"id": "@:;,$[]",
			"expect": {
				"result": "%40%3A%3B%2C%24%5B%5D"
			}
		},
		{
			"op": "percent",
			"id": "é",
			"expect": {
				"result": "%C3%A9"
			}
		},
		{
			"op": "percent",
			"id": "日本",
			"expect": {
				"result": "%E6%97%A5%E6%9C%AC"
			}
		},
		{
			"op": "percent",
			"id": "😀",
			"expect": {
				"result": "%F0%9F%98%80"
			}
		},
		{
			"op": "percent",
			"id": "\u0000",
			"expect": {
				"result": "%00"
			}
		},
		{
			"op": "percent",
			"id": "a\u0000b",
			"expect": {
				"result": "a%00b"
			}
		},
		{
			"op": "percent",
			"id": "",
			"expect": {
				"result": "%7F"
			}
		},
		{
			"op": "percent",
			"id": "\n",
			"expect": {
				"result": "%0A"
			}
		},
		{
			"op": "percent",
			"id": "�",
			"expect": {
				"result": "%EF%BF%BD"
			}
		},
		{
			"op": "percent",
			"id": "￿",
			"expect": {
				"result": "%EF%BF%BF"
			}
		},
		{
			"op": "percent",
			"id": "􏿿",
			"expect": {
				"result": "%F4%8F%BF%BF"
			}
		},
		{
			"op": "percent",
			"id": "é",
			"expect": {
				"result": "e%CC%81"
			}
		},
		{
			"op": "percent",
			"id": "abc.def.ghi",
			"expect": {
				"result": "abc%2Edef%2Eghi"
			}
		},
		{
			"op": "percent",
			"id": "clockument://tx/1",
			"expect": {
				"result": "clockument%3A%2F%2Ftx%2F1"
			}
		}
	]
}
