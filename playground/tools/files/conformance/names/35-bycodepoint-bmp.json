{
	"title": "code point order against UTF-16 order: they differ for astral scalar values and U+E000 to U+FFFF",
	"steps": [
		{
			"op": "bycodepoint",
			"a": "a",
			"b": "b",
			"expect": {
				"result": -1
			}
		},
		{
			"op": "bycodepoint",
			"a": "b",
			"b": "a",
			"expect": {
				"result": 1
			}
		},
		{
			"op": "bycodepoint",
			"a": "a",
			"b": "a",
			"expect": {
				"result": 0
			}
		},
		{
			"op": "bycodepoint",
			"a": "",
			"b": "",
			"expect": {
				"result": 0
			}
		},
		{
			"op": "bycodepoint",
			"a": "",
			"b": "a",
			"expect": {
				"result": -1
			}
		},
		{
			"op": "bycodepoint",
			"a": "a",
			"b": "",
			"expect": {
				"result": 1
			}
		},
		{
			"op": "bycodepoint",
			"a": "a",
			"b": "ab",
			"expect": {
				"result": -1
			}
		},
		{
			"op": "bycodepoint",
			"a": "ab",
			"b": "a",
			"expect": {
				"result": 1
			}
		},
		{
			"op": "bycodepoint",
			"a": "abc",
			"b": "abd",
			"expect": {
				"result": -1
			}
		},
		{
			"op": "bycodepoint",
			"a": "Z",
			"b": "a",
			"expect": {
				"result": -1
			}
		},
		{
			"op": "bycodepoint",
			"a": "é",
			"b": "z",
			"expect": {
				"result": 1
			}
		},
		{
			"op": "bycodepoint",
			"a": "日",
			"b": "é",
			"expect": {
				"result": 1
			}
		},
		{
			"op": "bycodepoint",
			"a": "\u0000",
			"b": "a",
			"expect": {
				"result": -1
			}
		},
		{
			"op": "bycodepoint",
			"a": "\u0000",
			"b": "",
			"expect": {
				"result": 1
			}
		},
		{
			"op": "bycodepoint",
			"a": "a\u0000",
			"b": "a",
			"expect": {
				"result": 1
			}
		},
		{
			"op": "bycodepoint",
			"a": "a\u0000",
			"b": "a\u0001",
			"expect": {
				"result": -1
			}
		},
		{
			"op": "bycodepoint",
			"a": "",
			"b": "",
			"expect": {
				"result": -1
			}
		},
		{
			"op": "bycodepoint",
			"a": "߿",
			"b": "ࠀ",
			"expect": {
				"result": -1
			}
		},
		{
			"op": "bycodepoint",
			"a": "퟿",
			"b": "",
			"expect": {
				"result": -1
			}
		},
		{
			"op": "bycodepoint",
			"a": "",
			"b": "￿",
			"expect": {
				"result": -1
			}
		},
		{
			"op": "bycodepoint",
			"a": "￿",
			"b": "",
			"expect": {
				"result": 1
			}
		}
	]
}
