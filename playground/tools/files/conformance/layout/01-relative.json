{
	"title": "relative: the path a link in one folder holds to another path",
	"steps": [
		{
			"op": "relative",
			"from": "",
			"to": "a.txt",
			"expect": {
				"path": "a.txt"
			}
		},
		{
			"op": "relative",
			"from": "",
			"to": "",
			"expect": {
				"path": "."
			}
		},
		{
			"op": "relative",
			"from": "a",
			"to": "a",
			"expect": {
				"path": "."
			}
		},
		{
			"op": "relative",
			"from": "a",
			"to": "a/b.txt",
			"expect": {
				"path": "b.txt"
			}
		},
		{
			"op": "relative",
			"from": "a",
			"to": "b.txt",
			"expect": {
				"path": "../b.txt"
			}
		},
		{
			"op": "relative",
			"from": "a/b/c",
			"to": "a/x/y.txt",
			"expect": {
				"path": "../../x/y.txt"
			}
		},
		{
			"op": "relative",
			"from": "a/b",
			"to": "",
			"expect": {
				"path": "../.."
			}
		},
		{
			"op": "relative",
			"from": "docs",
			"to": ".ermine/id/x%2Fy",
			"expect": {
				"path": "../.ermine/id/x%2Fy"
			}
		},
		{
			"op": "relative",
			"from": "",
			"to": ".ermine/root.txt",
			"expect": {
				"path": ".ermine/root.txt"
			}
		},
		{
			"op": "relative",
			"from": "ab",
			"to": "a/b",
			"expect": {
				"path": "../a/b"
			}
		},
		{
			"op": "relative",
			"from": "a/b",
			"to": "a/bc/d",
			"expect": {
				"path": "../bc/d"
			}
		}
	]
}
