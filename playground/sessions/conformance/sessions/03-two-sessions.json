{
	"title": "two sessions of one install beat at one node: two entries, neither writing over the other; one renewed, one lapsing; one leaving takes out its own only",
	"steps": [
		{ "op": "start", "name": "tab1", "install": "I1", "skip": ["kind", "differs"] },
		{ "op": "start", "name": "tab2", "install": "I1", "skip": ["kind", "differs"] },
		{ "op": "beat", "session": "tab1", "node": "D", "until": 10000, "expect": {} },
		{ "op": "beat", "session": "tab2", "node": "D", "until": 12000, "expect": {} },
		{
			"op": "online",
			"node": "D",
			"now": 5000,
			"expect": {
				"here": [
					{ "session": "tab1", "install": "I1", "until": 10000 },
					{ "session": "tab2", "install": "I1", "until": 12000 }
				]
			}
		},
		{ "op": "beat", "session": "tab1", "node": "D", "until": 20000, "expect": {} },
		{
			"op": "online",
			"node": "D",
			"now": 15000,
			"expect": { "here": [{ "session": "tab1", "install": "I1", "until": 20000 }] }
		},
		{ "op": "leave", "session": "tab1", "node": "D", "expect": {} },
		{
			"op": "entry",
			"node": "D",
			"expect": { "value": { "tab2": { "install": "I1", "until": 12000 } } }
		},
		{ "op": "leave", "session": "tab1", "node": "D", "expect": {} }
	]
}
