{
	"title": "a vouch is the install's for that session only: claimed for another install, or another session's vouch taken, it is not; the same install's two sessions each have their own",
	"steps": [
		{
			"op": "start",
			"name": "tab1",
			"install": "I1",
			"skip": [
				"kind",
				"differs",
				"vouched"
			]
		},
		{
			"op": "start",
			"name": "tab2",
			"install": "I1",
			"skip": [
				"kind",
				"differs",
				"vouched"
			]
		},
		{
			"op": "start",
			"name": "card",
			"install": "I2",
			"skip": [
				"kind",
				"differs",
				"vouched"
			]
		},
		{
			"op": "vouched",
			"session": "tab1",
			"expect": {
				"vouched": true
			}
		},
		{
			"op": "vouched",
			"session": "tab1",
			"as": "I2",
			"expect": {
				"vouched": false
			}
		},
		{
			"op": "vouched",
			"session": "tab1",
			"from": "tab2",
			"expect": {
				"vouched": false
			}
		},
		{
			"op": "vouched",
			"session": "card",
			"from": "tab1",
			"expect": {
				"vouched": false
			}
		},
		{
			"op": "vouched",
			"session": "card",
			"as": "I1",
			"from": "tab1",
			"expect": {
				"vouched": false
			}
		},
		{
			"op": "vouched",
			"session": "card",
			"expect": {
				"vouched": true
			}
		}
	]
}
