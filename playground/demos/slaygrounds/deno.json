{
	"tasks": {
		"serve": "deno install --quiet && deno run -A npm:vite",
		"build": "deno install --quiet && deno run -A npm:vite build",
		"preview": "deno run -A npm:vite preview"
	},
	"fmt": {
		"lineWidth": 100,
		"semiColons": false,
		"useTabs": true,
		"exclude": [
			"dist",
			"src/demo.ts",
			"src/tsgo",
			"node_modules"
		]
	},
	"imports": {
		"@codemirror/commands": "npm:@codemirror/commands@^6.11.1",
		"@codemirror/lang-javascript": "npm:@codemirror/lang-javascript@^6.2.5",
		"@codemirror/language": "npm:@codemirror/language@^6.12.4",
		"@codemirror/state": "npm:@codemirror/state@^6.7.6",
		"@codemirror/view": "npm:@codemirror/view@^6.43.13",
		"@lezer/highlight": "npm:@lezer/highlight@^1.2.5",
		"codemirror": "npm:codemirror@^6.0.2",
		"ses": "npm:ses@^2.3.0",
		"sucrase": "npm:sucrase@^3.35.0",
		"@codemirror/lsp-client": "npm:@codemirror/lsp-client@^6.3.0",
		"tsgo-wasm": "npm:tsgo-wasm@7.0.2",
		"@solidjs/signals": "npm:@solidjs/signals@2.0.0-rc.14",
		"@solidjs/web": "npm:@solidjs/web@2.0.0-rc.13",
		"solid-js": "npm:solid-js@2.0.0-rc.13",
		"vite": "npm:vite@^8.3.4",
		"cbor-x": "npm:cbor-x@^1.6.6",
		"@noble/hashes": "npm:@noble/hashes@1.8.0",
		"@noble/curves": "npm:@noble/curves@1.9.7",
		"@automerge/subduction": "npm:@automerge/subduction@0.23.0",
		"@automerge/automerge": "npm:@automerge/automerge@3.3.2",
		"@automerge/automerge-repo": "npm:@automerge/automerge-repo@2.6.0-subduction.48",
		"@automerge/automerge-subduction": "npm:@automerge/automerge-subduction@0.16.1",
		"@codemirror/lang-markdown": "npm:@codemirror/lang-markdown@^6.3.4"
	},
	"exclude": [
		"dist"
	],
	"nodeModulesDir": "auto",
	"allowScripts": ["npm:cbor-extract@2.2.2", "npm:fsevents@2.3.3"]
}
