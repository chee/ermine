{
	"tasks": {
		"install": "deno install --node-modules-dir=auto --quiet",
		"dev": "deno task install && deno run -A --node-modules-dir=auto npm:vite@^8.3.4",
		"build": "deno task install && deno run -A --node-modules-dir=auto npm:vite@^8.3.4 build"
	},
	"imports": {
		"vite": "npm:vite@^8.3.4",
		"@deno/vite-plugin": "npm:@deno/vite-plugin@^2.0.4",
		"codemirror": "npm:codemirror@6",
		"@codemirror/commands": "npm:@codemirror/commands@6",
		"@codemirror/lang-javascript": "npm:@codemirror/lang-javascript@6",
		"@codemirror/language": "npm:@codemirror/language@6",
		"@codemirror/lint": "npm:@codemirror/lint@6",
		"@codemirror/state": "npm:@codemirror/state@6",
		"@codemirror/view": "npm:@codemirror/view@6",
		"@lezer/highlight": "npm:@lezer/highlight@1"
	}
}
