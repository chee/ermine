{
	"title": "errorFormatter(error, fn): given each error ermine throws through its own functions, and the function's name; what it gives back is what is thrown, and what the program catches",
	"steps": [
		{
			"op": "ermine",
			"errorFormatter": "replace",
			"expect": {}
		},
		{
			"op": "code",
			"at": "/code/p",
			"program": [
				{
					"do": [
						"createMemo",
						"x",
						{},
						1
					]
				},
				{
					"do": [
						"caught",
						"caught",
						[
							{
								"do": [
									"createMemo",
									"x",
									{},
									1
								]
							}
						]
					]
				}
			],
			"expect": {}
		},
		{
			"op": "start",
			"name": "p",
			"at": "/code/p",
			"expect": {
				"id": "proc:p"
			}
		},
		{
			"op": "log",
			"name": "formatted",
			"expect": {
				"values": [
					[
						"createMemo",
						"already-there"
					]
				]
			}
		},
		{
			"op": "log",
			"name": "caught",
			"expect": {
				"values": [
					"gone"
				]
			}
		}
	]
}
