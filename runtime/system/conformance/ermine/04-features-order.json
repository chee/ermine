{
	"title": "features: needs and their order. a need not given: missing-feature; a name twice: feature-twice; needs going round: needs-loop. chain order: the list, each one's needs first; the first outermost, so its hook is called first",
	"steps": [
		{
			"op": "ermine",
			"features": [
				{
					"name": "a",
					"needs": [
						"b"
					]
				}
			],
			"fails": true,
			"expect": {
				"error": "missing-feature"
			}
		},
		{
			"op": "ermine",
			"features": [
				{
					"name": "a"
				},
				{
					"name": "a"
				}
			],
			"fails": true,
			"expect": {
				"error": "feature-twice"
			}
		},
		{
			"op": "ermine",
			"features": [
				{
					"name": "a",
					"needs": [
						"b"
					]
				},
				{
					"name": "b",
					"needs": [
						"a"
					]
				}
			],
			"fails": true,
			"expect": {
				"error": "needs-loop"
			}
		},
		{
			"op": "ermine",
			"features": [
				{
					"name": "b",
					"needs": [
						"a"
					],
					"onRead": "log"
				},
				{
					"name": "a",
					"onRead": "log"
				},
				{
					"name": "c",
					"onRead": "log"
				}
			],
			"expect": {}
		},
		{
			"op": "host",
			"call": [
				"ensureNode",
				"/x",
				1
			],
			"expect": {
				"value": {
					"path": [
						"x"
					],
					"part": "value"
				}
			}
		},
		{
			"op": "host",
			"call": [
				"log",
				"x",
				[
					"all",
					[
						"each",
						[
							"readAll",
							"/x"
						],
						[
							"value"
						]
					]
				]
			],
			"expect": {
				"value": [
					[
						1
					]
				]
			}
		},
		{
			"op": "log",
			"name": "hooks",
			"expect": {
				"values": [
					[
						"a",
						"onRead",
						"n1"
					],
					[
						"b",
						"onRead",
						"n1"
					],
					[
						"c",
						"onRead",
						"n1"
					]
				]
			}
		}
	]
}
