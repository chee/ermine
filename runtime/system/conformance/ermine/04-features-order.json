{
	"title": "features: needs and their order. a need not given: missing-feature; a name twice: feature-twice; needs going round: needs-loop. setup order: the list, each one's needs first",
	"steps": [
		{
			"op": "ermine",
			"features": [
				{
					"name": "a",
					"needs": [
						"b"
					]
				}
			],
			"fails": true,
			"expect": {
				"error": "missing-feature"
			}
		},
		{
			"op": "ermine",
			"features": [
				{
					"name": "a"
				},
				{
					"name": "a"
				}
			],
			"fails": true,
			"expect": {
				"error": "feature-twice"
			}
		},
		{
			"op": "ermine",
			"features": [
				{
					"name": "a",
					"needs": [
						"b"
					]
				},
				{
					"name": "b",
					"needs": [
						"a"
					]
				}
			],
			"fails": true,
			"expect": {
				"error": "needs-loop"
			}
		},
		{
			"op": "ermine",
			"features": [
				{
					"name": "b",
					"needs": [
						"a"
					]
				},
				{
					"name": "a"
				},
				{
					"name": "c"
				}
			],
			"expect": {}
		},
		{
			"op": "log",
			"name": "setups",
			"expect": {
				"values": [
					"a",
					"b",
					"c"
				]
			}
		}
	]
}
