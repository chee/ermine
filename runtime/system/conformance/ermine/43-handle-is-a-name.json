{
	"title": "a handle is a name, not power [chee 10-26: \"take the maker out now\"; \"maybe it should be an absolute path?\"]: q hands s its ./doc; a patch through it reaches q's doc (the handle names the place from the root), asked as whoever acts, never as the handle's maker: inside s's action that is s and its caller [chee 10-25: \"so it should run as both\"]. a deny on q's edits refuses q's call, but not the host's call with the same place; a deny on s's refuses both",
	"steps": [
		{
			"op": "ermine",
			"deny": [
				{
					"op": "edit",
					"from": "code/q"
				}
			],
			"expect": {}
		},
		{
			"op": "code",
			"at": "/system/s",
			"program": [
				{
					"do": [
						"createAction",
						"on/save",
						[
							{
								"do": [
									"patch",
									"$0",
									[
										{
											"path": [
												"saved"
											],
											"value": true
										}
									]
								]
							}
						],
						"ok"
					]
				}
			],
			"expect": {}
		},
		{
			"op": "start",
			"name": "s",
			"at": "/system/s",
			"expect": {
				"id": "proc:s"
			}
		},
		{
			"op": "code",
			"at": "/code/q",
			"program": [
				{
					"do": [
						"ensureNode",
						"./doc",
						{
							"saved": false
						}
					],
					"as": "doc"
				}
			],
			"expect": {}
		},
		{
			"op": "start",
			"name": "q",
			"at": "/code/q",
			"expect": {
				"id": "proc:q"
			}
		},
		{
			"op": "do",
			"process": "q",
			"call": [
				"patch",
				"$doc",
				[]
			],
			"expect": {
				"error": "refused"
			}
		},
		{
			"op": "do",
			"process": "q",
			"call": [
				"executeAction",
				"/system/s/on/save",
				"$doc"
			],
			"expect": {
				"error": "refused"
			}
		},
		{
			"op": "host",
			"call": [
				"read",
				"/code/doc"
			],
			"expect": {
				"value": {
					"saved": false
				}
			}
		},
		{
			"op": "host",
			"call": [
				"executeAction",
				"/system/s/on/save",
				{
					"path": [
						"code",
						"doc"
					],
					"part": "value"
				}
			],
			"expect": {
				"value": "ok"
			}
		},
		{
			"op": "host",
			"call": [
				"read",
				"/code/doc"
			],
			"expect": {
				"value": {
					"saved": true
				}
			}
		},
		{
			"op": "ermine",
			"deny": [
				{
					"op": "edit",
					"from": "system/s"
				}
			],
			"expect": {}
		},
		{
			"op": "code",
			"at": "/system/s",
			"program": [
				{
					"do": [
						"createAction",
						"on/save",
						[
							{
								"do": [
									"patch",
									"$0",
									[
										{
											"path": [
												"saved"
											],
											"value": true
										}
									]
								]
							}
						],
						"ok"
					]
				}
			],
			"expect": {}
		},
		{
			"op": "start",
			"name": "s",
			"at": "/system/s",
			"expect": {
				"id": "proc:s"
			}
		},
		{
			"op": "code",
			"at": "/code/q",
			"program": [
				{
					"do": [
						"ensureNode",
						"./doc",
						{
							"saved": false
						}
					],
					"as": "doc"
				}
			],
			"expect": {}
		},
		{
			"op": "start",
			"name": "q",
			"at": "/code/q",
			"expect": {
				"id": "proc:q"
			}
		},
		{
			"op": "do",
			"process": "q",
			"call": [
				"executeAction",
				"/system/s/on/save",
				"$doc"
			],
			"expect": {
				"error": "refused"
			}
		},
		{
			"op": "host",
			"call": [
				"read",
				"/code/doc"
			],
			"expect": {
				"value": {
					"saved": false
				}
			}
		}
	]
}
