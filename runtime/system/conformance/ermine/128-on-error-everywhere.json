{
	"title": "onError covers every function ermine gives, reads, patches, names and nodes too: each failing call goes through the hooks once, named, and what they give is what is thrown",
	"steps": [
		{
			"op": "ermine",
			"features": [
				{
					"name": "a",
					"onError": "log"
				}
			],
			"expect": {}
		},
		{
			"op": "host",
			"call": ["ensureNode", "/x", 1]
		},
		{
			"op": "host",
			"call": ["read", "/x", { "path": [], "range": [0, 1] }],
			"expect": { "error": "Error: wrong-kind" }
		},
		{
			"op": "host",
			"call": ["patch", "/x", [{ "path": ["y"], "value": 1 }]],
			"expect": { "error": "Error: wrong-kind (patch 0)" }
		},
		{
			"op": "host",
			"call": ["unplace", "/nowhere"],
			"expect": { "error": "nothing-there" }
		},
		{
			"op": "host",
			"call": ["remove", "/nowhere"],
			"expect": { "error": "nothing-there" }
		},
		{
			"op": "log",
			"name": "hooks",
			"expect": {
				"values": [
					["a", "onError", "read", "wrong-kind"],
					["a", "onError", "patch", "wrong-kind"],
					["a", "onError", "unplace", "nothing-there"],
					["a", "onError", "remove", "nothing-there"]
				]
			}
		}
	]
}
