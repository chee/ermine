{
	"title": "getArgs gives the arguments a process was started with, as a list of text; none, or outside any process: empty",
	"steps": [
		{
			"op": "ermine",
			"expect": {}
		},
		{
			"op": "host",
			"call": [
				"getArgs"
			],
			"expect": {
				"value": []
			}
		},
		{
			"op": "code",
			"at": "/code/p",
			"program": [
				{
					"do": [
						"getArgs"
					],
					"as": "a"
				},
				{
					"do": [
						"log",
						"args",
						"$a"
					]
				}
			],
			"expect": {}
		},
		{
			"op": "start",
			"name": "p",
			"at": "/code/p",
			"args": [
				"x",
				"y"
			],
			"expect": {
				"id": "proc:p"
			}
		},
		{
			"op": "log",
			"name": "args",
			"expect": {
				"values": [
					[
						"x",
						"y"
					]
				]
			}
		},
		{
			"op": "code",
			"at": "/code/q",
			"program": [
				{
					"do": [
						"getArgs"
					],
					"as": "a"
				},
				{
					"do": [
						"log",
						"none",
						"$a"
					]
				}
			],
			"expect": {}
		},
		{
			"op": "start",
			"name": "q",
			"at": "/code/q",
			"expect": {
				"id": "proc:q"
			}
		},
		{
			"op": "log",
			"name": "none",
			"expect": {
				"values": [
					[]
				]
			}
		}
	]
}
