		{"op":"apply","value":{"a":1},"patches":[{"path":[]}],"expect":{}},
		{"op":"invert","value":{"k":"ab","l":["x","y"]},"patches":[{"path":["k"],"range":[1,1],"value":"c"},{"path":["l",0],"move":{"path":["l",1]}},{"path":["k"],"move":{"path":["l",0]}},{"path":["m"],"value":{"n":[]}},{"path":["m","n"],"range":[0,0],"move":{"path":["l"],"range":[0,0]}}]},
		{"op":"apply","value":{"k":"y","l":[],"m":{"n":[]}},"patches":[{"path":["m"]},{"path":["l"],"range":[0,0],"move":{"path":["k"]}},{"path":["k"],"value":"acb"},{"path":["l"],"range":[1,1],"value":["x"]},{"path":["l"],"range":[1,1],"move":{"path":["l",0]}},{"path":["k"],"range":[1,2]}],"expect":{"value":{"l":["x","y"],"k":"ab"}}},
		{"op":"invert","value":{"k":"y","l":[],"m":{"n":[]}},"patches":[{"path":["m"]},{"path":["l"],"range":[0,0],"move":{"path":["k"]}},{"path":["k"],"value":"acb"},{"path":["l"],"range":[1,1],"value":["x"]},{"path":["l"],"range":[1,1],"move":{"path":["l",0]}},{"path":["k"],"range":[1,2]}]},
		{"op":"apply","value":{"l":["x","y"],"k":"ab"},"patches":[{"path":["k"],"range":[1,1],"value":"c"},{"path":["l"],"range":[0,0],"move":{"path":["l",1]}},{"path":["l"],"range":[1,2]},{"path":["k"]},{"path":["k"],"move":{"path":["l",0]}},{"path":["m"],"value":{"n":[]}}],"expect":{"value":{"l":[],"k":"y","m":{"n":[]}}}}
	]
