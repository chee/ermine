		{"op":"apply","value":{"s":"a\ud83d","f":"\ude00b"},"patches":[{"path":["f"],"range":[0,1]},{"path":["s"],"range":[1,2],"value":"😀"}],"expect":{"value":{"s":"a😀","f":"b"}}},
