{
	"title": "kinds that differ do not join",
	"steps": [
		{
			"op": "squish",
			"patches": [
				{ "path": ["t"], "range": [0, 0], "value": "a" },
				{ "path": ["t"], "range": [1, 1], "value": [1] }
			],
			"expect": {
				"patches": [
					{ "path": ["t"], "range": [0, 0], "value": "a" },
					{ "path": ["t"], "range": [1, 1], "value": [1] }
				]
			}
		},
		{
			"op": "squish",
			"patches": [
				{ "path": ["l"], "range": [0, 0], "value": [1] },
				{ "path": ["l"], "range": [1, 1], "value": { "/": { "bytes": "AQ" } } }
			],
			"expect": {
				"patches": [
					{ "path": ["l"], "range": [0, 0], "value": [1] },
					{ "path": ["l"], "range": [1, 1], "value": { "/": { "bytes": "AQ" } } }
				]
			}
		},
		{
			"op": "squish",
			"patches": [
				{ "path": ["t"], "range": [0, 0], "value": "a" },
				{ "path": ["t"], "range": [1, 1], "value": 5 }
			],
			"expect": {
				"patches": [
					{ "path": ["t"], "range": [0, 0], "value": "a" },
					{ "path": ["t"], "range": [1, 1], "value": 5 }
				]
			}
		},
		{
			"op": "squish",
			"patches": [
				{ "path": ["t"], "range": [0, 0], "value": 5 },
				{ "path": ["t"], "range": [1, 1], "value": "a" }
			],
			"expect": {
				"patches": [
					{ "path": ["t"], "range": [0, 0], "value": 5 },
					{ "path": ["t"], "range": [1, 1], "value": "a" }
				]
			}
		},
		{
			"op": "squish",
			"patches": [
				{ "path": ["t"], "range": [0, 0], "value": null },
				{ "path": ["t"], "range": [1, 1], "value": "a" }
			],
			"expect": {
				"patches": [
					{ "path": ["t"], "range": [0, 0], "value": null },
					{ "path": ["t"], "range": [1, 1], "value": "a" }
				]
			}
		},
		{
			"op": "squish",
			"patches": [
				{ "path": ["t"], "range": [0, 0], "value": {} },
				{ "path": ["t"], "range": [1, 1], "value": "a" }
			],
			"expect": {
				"patches": [
					{ "path": ["t"], "range": [0, 0], "value": {} },
					{ "path": ["t"], "range": [1, 1], "value": "a" }
				]
			}
		},
		{
			"op": "squish",
			"patches": [
				{ "path": ["t"], "range": [0, 0], "value": "a" },
				{ "path": ["t"], "range": [1, 1], "value": null }
			],
			"expect": {
				"patches": [
					{ "path": ["t"], "range": [0, 0], "value": "a" },
					{ "path": ["t"], "range": [1, 1], "value": null }
				]
			}
		}
	]
}
