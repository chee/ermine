		{
			"op": "ask",
			"policy": { "grants": ["value", "rules"] },
			"what": "edit",
			"who": { "actor": { "/": { "bytes": "AQID" } } },
			"target": { "id": "A" },
			"expect": { "answer": "no", "grant": { "part": "value", "id": "rules", "index": 0 } }
		},
		{
			"op": "ask",
			"policy": { "grants": ["value", "rules"] },
			"what": "read",
			"who": { "actor": { "/": { "bytes": "AQIE" } } },
			"target": { "id": "A" },
			"expect": { "answer": "no" }
