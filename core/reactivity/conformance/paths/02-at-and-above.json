{
	"title": "a patch marks the reads at its path and above it, never beside it",
	"steps": [
		{ "op": "spot", "source": "v", "id": "n", "path": [], "expect": {} },
		{ "op": "spot", "source": "v", "id": "n", "path": ["doc"], "expect": {} },
		{ "op": "spot", "source": "v", "id": "n", "path": ["doc", "title"], "expect": {} },
		{ "op": "spot", "source": "v", "id": "n", "path": ["doc", "body"], "expect": {} },
		{ "op": "spot", "source": "v", "id": "n", "path": ["other"], "expect": {} },
		{
			"op": "mark",
			"source": "v",
			"id": "n",
			"patches": [{ "path": ["doc", "body"], "range": [3, 3], "value": "x" }],
			"expect": { "spots": [[], ["doc"], ["doc", "body"]] }
		},
		{
			"op": "mark",
			"source": "v",
			"id": "n",
			"patches": [{ "path": ["doc", "title", "deeper"], "value": 1 }],
			"expect": { "spots": [[], ["doc"], ["doc", "title"]] }
		},
		{
			"op": "mark",
			"source": "v",
			"id": "n",
			"patches": [{ "path": ["missing", "x"], "value": 1 }],
			"expect": { "spots": [[]] }
		}
	]
}
