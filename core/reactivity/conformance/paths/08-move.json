{
	"title": "a move marks its take and its landing, each by the rows above",
	"steps": [
		{ "op": "spot", "source": "v", "id": "n", "path": [], "expect": {} },
		{ "op": "spot", "source": "v", "id": "n", "path": ["b"], "expect": {} },
		{ "op": "spot", "source": "v", "id": "n", "path": ["c"], "expect": {} },
		{ "op": "spot", "source": "v", "id": "n", "path": ["c", "x"], "expect": {} },
		{ "op": "spot", "source": "v", "id": "n", "path": ["d"], "expect": {} },
		{
			"op": "mark",
			"source": "v",
			"id": "n",
			"patches": [{ "path": ["d"], "move": { "path": ["c"] } }],
			"expect": { "spots": [[], ["c"], ["c", "x"], ["d"]] }
		},
		{ "op": "spot", "source": "v", "id": "n", "path": ["l", 0], "expect": {} },
		{ "op": "spot", "source": "v", "id": "n", "path": ["l", 1], "expect": {} },
		{ "op": "spot", "source": "v", "id": "n", "path": ["l", 2], "expect": {} },
		{ "op": "spot", "source": "v", "id": "n", "path": ["l", 3], "expect": {} },
		{ "op": "spot", "source": "v", "id": "n", "path": ["l", 4], "expect": {} },
		{
			"op": "mark",
			"source": "v",
			"id": "n",
			"patches": [
				{ "path": ["l"], "range": [0, 0], "move": { "path": ["l"], "range": [3, 4] } }
			],
			"expect": { "spots": [[], ["l", 3], ["l", 4], ["l", 0], ["l", 1], ["l", 2]] }
		},
		{
			"op": "mark",
			"source": "v",
			"id": "n",
			"patches": [
				{ "path": ["l"], "range": [0, 1], "move": { "path": ["l"], "range": [3, 4] } }
			],
			"expect": { "spots": [[], ["l", 3], ["l", 4], ["l", 0]] }
		},
		{
			"op": "mark",
			"source": "v",
			"id": "n",
			"patches": [{ "path": ["b"], "move": { "path": ["l", 2] } }],
			"expect": { "spots": [[], ["l", 3], ["l", 4], ["l", 2], ["b"]] }
		},
		{
			"op": "mark",
			"source": "v",
			"id": "n",
			"patches": [{ "path": ["l"], "range": [1, 2], "move": { "path": ["b"] } }],
			"expect": { "spots": [[], ["b"], ["l", 1]] }
		}
	]
}
