{
	"title": "the change spot, reads of the change itself: every patch and event at its key marks it",
	"steps": [
		{ "op": "change", "source": "v", "id": "n", "expect": {} },
		{ "op": "spot", "source": "v", "id": "n", "path": ["x"], "expect": {} },
		{
			"op": "mark",
			"source": "v",
			"id": "n",
			"patches": [{ "path": ["y"], "value": 1 }],
			"expect": { "spots": ["change"] }
		},
		{
			"op": "mark",
			"source": "v",
			"id": "n",
			"patches": [{ "path": ["x"], "value": 1 }, { "path": ["y"] }],
			"expect": { "spots": ["change", ["x"]] }
		},
		{ "op": "mark", "source": "v", "id": "n", "patches": [], "expect": { "spots": ["change"] } },
		{
			"op": "mark",
			"source": "v",
			"id": "m",
			"patches": [{ "path": ["x"], "value": 1 }],
			"expect": { "spots": [] }
		},
		{ "op": "change", "source": "v", "id": "n", "expect": {} },
		{ "op": "event", "source": "v", "id": "n", "expect": { "spots": ["change", ["x"]] } }
	]
}
