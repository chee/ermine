{
	"title": "a change answers the header's own fields only, nothing else; a time of -0 is 0",
	"steps": [
		{
			"op": "entry",
			"header": { "time": 1, "custom": "x" },
			"expect": { "entry": { "change": { "time": 1 } } }
		},
		{
			"op": "entry",
			"header": { "time": -0 },
			"expect": { "entry": { "change": { "time": 0 } } }
		}
	]
}
