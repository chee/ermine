{
	"title": "bytes and typed arrays are values, given back whole",
	"steps": [
		{
			"op": "entry",
			"value": {
				"/": {
					"bytes": "AQID"
				}
			},
			"expect": {
				"entry": {
					"value": {
						"/": {
							"bytes": "AQID"
						}
					},
					"change": {
						"time": "now"
					}
				}
			}
		},
		{
			"op": "entry",
			"value": {
				"/": {
					"int8": [
						1,
						-2,
						3
					]
				}
			},
			"expect": {
				"entry": {
					"value": {
						"/": {
							"int8": [
								1,
								-2,
								3
							]
						}
					},
					"change": {
						"time": "now"
					}
				}
			}
		},
		{
			"op": "entry",
			"value": {
				"a": [
					{
						"/": {
							"uint16": [
								65535,
								0
							]
						}
					}
				]
			},
			"expect": {
				"entry": {
					"value": {
						"a": [
							{
								"/": {
									"uint16": [
										65535,
										0
									]
								}
							}
						]
					},
					"change": {
						"time": "now"
					}
				}
			}
		}
	]
}
