{
	"title": "a compute that throws: its run failed, the error told; nothing given to set, nothing after it runs",
	"steps": [
		{ "op": "root", "name": "o", "info": [["actor", "test"]], "expect": {} },
		{ "op": "write", "values": { "a": 1 }, "expect": { "tick": 1 } },
		{
			"op": "compute",
			"name": "c",
			"scope": "o",
			"f": {
				"if": [
					{ "eq": [{ "read": "a" }, 0] },
					{ "throw": "zero" },
					{ "sum": [{ "read": "a" }] }
				]
			},
			"to": "c",
			"expect": {}
		},
		{
			"op": "effect",
			"name": "e",
			"scope": "o",
			"f": { "read": "c" },
			"act": { "log": ["e", { "given": "value" }] },
			"expect": {}
		},
		{ "op": "pulse", "expect": {} },
		{ "op": "log", "expect": { "log": [["e", 1]] } },
		{
			"op": "moments",
			"expect": {
				"moments": [
					{
						"due": "c",
						"tick": 2
					},
					{
						"due": "e",
						"tick": 3
					},
					{
						"starts": "c",
						"run": 1
					},
					{
						"ends": "c",
						"run": 1,
						"ended": "done",
						"equal": false
					},
					{
						"starts": "e",
						"run": 1
					},
					{
						"ends": "e",
						"run": 1,
						"ended": "done",
						"equal": false
					},
					{
						"acts": "e",
						"run": 1
					}
				]
			}
		},
		{ "op": "write", "values": { "a": 0 }, "expect": { "tick": 5 } },
		{ "op": "pulse", "expect": {} },
		{
			"op": "moments",
			"expect": {
				"moments": [
					{ "due": "c", "tick": 5 },
					{ "starts": "c", "run": 2 },
					{ "ends": "c", "run": 2, "ended": "failed", "error": "zero" }
				]
			}
		},
		{ "op": "get", "key": "c", "expect": { "value": 1 } },
		{ "op": "log", "expect": { "log": [] } },
		{ "op": "write", "values": { "a": 2 }, "expect": { "tick": 6 } },
		{ "op": "pulse", "expect": {} },
		{ "op": "log", "expect": { "log": [["e", 2]] } },
		{ "op": "get", "key": "c", "expect": { "value": 2 } }
	]
}
