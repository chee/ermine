{
	"title": "disposing a scope takes everything under it: children first, newest first, then its cleanups, newest first",
	"steps": [
		{ "op": "root", "name": "o", "info": [["actor", "test"]], "expect": {} },
		{ "op": "scope", "name": "p", "parent": "o", "info": [["why", "p"]], "expect": {} },
		{ "op": "cleanup", "scope": "o", "do": { "log": "o1" }, "expect": {} },
		{ "op": "compute", "name": "c", "scope": "p", "f": { "read": "x" }, "to": "c", "expect": {} },
		{ "op": "scope", "name": "g", "parent": "p", "info": [["why", "g"]], "expect": {} },
		{ "op": "cleanup", "scope": "g", "do": { "log": "g" }, "expect": {} },
		{
			"op": "effect",
			"name": "e",
			"scope": "g",
			"f": { "read": "x" },
			"act": { "log": ["e", { "given": "value" }] },
			"expect": {}
		},
		{ "op": "cleanup", "scope": "p", "do": { "log": "p" }, "expect": {} },
		{ "op": "cleanup", "scope": "o", "do": { "log": "o2" }, "expect": {} },
		{ "op": "scope", "name": "q", "parent": "o", "info": [["why", "q"]], "expect": {} },
		{ "op": "cleanup", "scope": "q", "do": { "log": "q" }, "expect": {} },
		{ "op": "write", "values": { "x": 1 }, "expect": { "tick": 3 } },
		{ "op": "pulse", "expect": {} },
		{ "op": "log", "expect": { "log": [["e", 1]] } },
		{
			"op": "moments",
			"expect": {
				"moments": [
					{
						"due": "c",
						"tick": 1
					},
					{
						"due": "e",
						"tick": 2
					},
					{
						"starts": "c",
						"run": 1
					},
					{
						"ends": "c",
						"run": 1,
						"ended": "done",
						"equal": false
					},
					{
						"starts": "e",
						"run": 1
					},
					{
						"ends": "e",
						"run": 1,
						"ended": "done",
						"equal": false
					},
					{
						"acts": "e",
						"run": 1
					}
				]
			}
		},
		{ "op": "dispose", "scope": "o", "expect": {} },
		{ "op": "log", "expect": { "log": ["q", "g", "p", "o2", "o1"] } },
		{ "op": "write", "values": { "x": 2 }, "expect": { "tick": 5 } },
		{ "op": "pulse", "expect": {} },
		{ "op": "moments", "expect": { "moments": [] } },
		{ "op": "get", "key": "c", "expect": { "value": 1 } },
		{
			"op": "scope",
			"name": "r",
			"parent": "o",
			"info": [["why", "r"]],
			"expect": { "error": "disposed" }
		},
		{ "op": "compute", "name": "c2", "scope": "p", "f": 1, "expect": { "error": "disposed" } },
		{ "op": "cleanup", "scope": "o", "do": { "log": "late" }, "expect": { "error": "disposed" } },
		{ "op": "run", "scope": "o", "do": 1, "expect": { "error": "disposed" } },
		{ "op": "log", "expect": { "log": [] } },
		{ "op": "dispose", "scope": "o", "expect": {} },
		{ "op": "log", "expect": { "log": [] } }
	]
}
