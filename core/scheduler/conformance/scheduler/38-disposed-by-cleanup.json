{
	"title": "a computation disposed by a cleanup: a compute's cleanups wait till its next run is done, so that run goes ahead and its value lands, then the cleanup disposes it; an effect's run before its act, so it does not act (proof D2)",
	"steps": [
		{ "op": "root", "name": "o", "info": [["actor", "test"]], "expect": {} },
		{
			"op": "compute",
			"name": "c",
			"scope": "o",
			"f": {
				"do": [{ "cleanup": ["c", { "dispose": "c" }] }, { "log": ["c", { "read": "k" }] }]
			},
			"to": "c",
			"expect": {}
		},
		{ "op": "scope", "name": "p", "parent": "o", "info": [["why", "p"]], "expect": {} },
		{
			"op": "compute",
			"name": "d",
			"scope": "p",
			"f": {
				"do": [{ "cleanup": ["d", { "dispose": "p" }] }, { "log": ["d", { "read": "k" }] }]
			},
			"to": "d",
			"expect": {}
		},
		{
			"op": "effect",
			"name": "e",
			"scope": "o",
			"f": { "read": "k" },
			"act": {
				"do": [{ "log": ["e", { "given": "value" }] }, { "cleanup": ["e", { "dispose": "e" }] }]
			},
			"expect": {}
		},
		{ "op": "write", "values": { "k": 1 }, "expect": { "tick": 4 } },
		{ "op": "pulse", "expect": {} },
		{ "op": "log", "expect": { "log": [["c", 1], ["d", 1], ["e", 1]] } },
		{ "op": "write", "values": { "k": 2 }, "expect": { "tick": 7 } },
		{ "op": "pulse", "expect": {} },
		{ "op": "log", "expect": { "log": [["c", 2], ["d", 2]] } },
		{ "op": "get", "key": "c", "expect": { "value": ["c", 2] } },
		{ "op": "get", "key": "d", "expect": { "value": ["d", 2] } },
		{ "op": "write", "values": { "k": 3 }, "expect": { "tick": 10 } },
		{ "op": "pulse", "expect": {} },
		{ "op": "log", "expect": { "log": [] } }
	]
}
