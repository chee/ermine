{
	"title": "a scope's info is made with it: one made in an act says the run acted on, past a later run that did not act (its result equal, what the act made stays)",
	"steps": [
		{ "op": "root", "name": "o", "info": [["actor", "test"]], "expect": {} },
		{
			"op": "effect",
			"name": "e",
			"scope": "o",
			"f": { "do": [{ "read": "a" }, 1] },
			"act": { "scope": ["k", [["why", "listen"]]] },
			"expect": {}
		},
		{ "op": "pulse", "expect": {} },
		{ "op": "write", "values": { "a": 1 }, "expect": { "tick": 2 } },
		{ "op": "pulse", "expect": {} },
		{
			"op": "run",
			"scope": "e",
			"do": { "current": null },
			"expect": {
				"value": {
					"scope": "e",
					"pairs": [["run", 2], ["mark", 2], ["owner", [["actor", "test"]]]]
				}
			}
		},
		{
			"op": "run",
			"scope": "k",
			"do": { "current": null },
			"expect": {
				"value": {
					"scope": "k",
					"pairs": [
						["why", "listen"],
						["owner", [["run", 1], ["mark", 1], ["owner", [["actor", "test"]]]]]
					]
				}
			}
		}
	]
}
