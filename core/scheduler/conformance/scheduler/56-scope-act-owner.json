{
	"title": "a scope made in an act stays past a later run that did not act (its result equal); its info is its own pairs, the effect's the latest run's",
	"steps": [
		{ "op": "root", "name": "o", "info": [["actor", "test"]], "expect": {} },
		{
			"op": "effect",
			"name": "e",
			"scope": "o",
			"f": { "do": [{ "read": "a" }, 1] },
			"act": { "scope": ["k", [["why", "listen"]]] },
			"expect": {}
		},
		{ "op": "pulse", "expect": {} },
		{ "op": "write", "values": { "a": 1 }, "expect": { "tick": 2 } },
		{ "op": "pulse", "expect": {} },
		{
			"op": "run",
			"scope": "e",
			"do": { "current": null },
			"expect": {
				"value": {
					"scope": "e",
					"pairs": [["run", 2], ["mark", 2]]
				}
			}
		},
		{
			"op": "run",
			"scope": "k",
			"do": { "current": null },
			"expect": {
				"value": {
					"scope": "k",
					"pairs": [["why", "listen"]]
				}
			}
		}
	]
}
