{
	"title": "equal by its own comparison: a list equal by JSON stops there; by Object.is, a new list goes on",
	"steps": [
		{ "op": "root", "name": "o", "info": [["actor", "test"]], "expect": {} },
		{ "op": "write", "values": { "a": 1, "b": 2 }, "expect": { "tick": 1 } },
		{
			"op": "compute",
			"name": "l",
			"scope": "o",
			"f": [{ "read": "a" }, { "read": "b" }],
			"to": "l",
			"equal": "json",
			"expect": {}
		},
		{
			"op": "compute",
			"name": "m",
			"scope": "o",
			"f": [{ "read": "a" }, { "read": "b" }],
			"to": "m",
			"expect": {}
		},
		{
			"op": "effect",
			"name": "el",
			"scope": "o",
			"f": { "read": "l" },
			"act": { "log": ["el", { "given": "value" }] },
			"expect": {}
		},
		{
			"op": "effect",
			"name": "em",
			"scope": "o",
			"f": { "read": "m" },
			"act": { "log": ["em", { "given": "value" }] },
			"expect": {}
		},
		{ "op": "pulse", "expect": {} },
		{ "op": "log", "expect": { "log": [["el", [1, 2]], ["em", [1, 2]]] } },
		{ "op": "write", "values": { "a": 1 }, "expect": { "tick": 8 } },
		{ "op": "pulse", "expect": {} },
		{ "op": "log", "expect": { "log": [["em", [1, 2]]] } }
	]
}
