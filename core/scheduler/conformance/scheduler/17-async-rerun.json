{
	"title": "a compute run again while pending: the earlier promise's settling lands nowhere",
	"steps": [
		{ "op": "root", "name": "o", "info": [["actor", "test"]], "expect": {} },
		{ "op": "write", "values": { "a": "p1" }, "expect": { "tick": 1 } },
		{
			"op": "compute",
			"name": "c",
			"scope": "o",
			"f": { "wait": [{ "read": "a" }] },
			"to": "c",
			"expect": {}
		},
		{ "op": "pulse", "expect": {} },
		{ "op": "write", "values": { "a": "p2" }, "expect": { "tick": 3 } },
		{ "op": "pulse", "expect": {} },
		{ "op": "resolve", "promise": "p1", "value": 1, "expect": {} },
		{ "op": "pulse", "expect": {} },
		{ "op": "get", "key": "c", "expect": { "value": null } },
		{ "op": "resolve", "promise": "p2", "value": 2, "expect": {} },
		{ "op": "pulse", "expect": {} },
		{ "op": "get", "key": "c", "expect": { "value": 2 } },
		{
			"op": "moments",
			"expect": {
				"moments": [
					{ "due": "c", "tick": 2 },
					{ "starts": "c", "run": 1 },
					{ "ends": "c", "run": 1, "ended": "pending" },
					{ "due": "c", "tick": 3 },
					{ "starts": "c", "run": 2 },
					{ "ends": "c", "run": 2, "ended": "pending" },
					{ "ends": "c", "run": 2, "ended": "done", "equal": false }
				]
			}
		}
	]
}
