{
	"title": "a cleanup that changes what its computation reads: a loop through it, that ends; a compute's (its cleanup runs once its next run is done and the round's runs are, so the value set is the one read before the cleanup wrote; the loop's run after it ends looping and keeps its own cleanups set aside) and an effect's (proof C5)",
	"steps": [
		{ "op": "root", "name": "o", "info": { "actor": "test" }, "expect": {} },
		{
			"op": "compute",
			"name": "c",
			"scope": "o",
			"f": {
				"do": [
					{ "cleanup": ["c", { "write": ["k", { "sum": [{ "read": "k" }, 1] }] }] },
					{ "read": "k" }
				]
			},
			"to": "c",
			"expect": {}
		},
		{ "op": "pulse", "expect": {} },
		{ "op": "get", "key": "c", "expect": { "value": null } },
		{ "op": "write", "values": { "k": 10 }, "expect": { "tick": 3 } },
		{ "op": "pulse", "expect": {} },
		{ "op": "get", "key": "k", "expect": { "value": 11 } },
		{ "op": "get", "key": "c", "expect": { "value": 10 } },
		{
			"op": "effect",
			"name": "e",
			"scope": "o",
			"f": { "read": "m" },
			"act": {
				"do": [
					{ "log": ["act", { "given": "value" }] },
					{ "cleanup": ["e", { "write": ["m", { "sum": [{ "given": "value" }, 1] }] }] }
				]
			},
			"expect": {}
		},
		{ "op": "write", "values": { "m": 1 }, "expect": { "tick": 7 } },
		{ "op": "pulse", "expect": {} },
		{ "op": "log", "expect": { "log": [["act", 1]] } },
		{ "op": "write", "values": { "m": 5 }, "expect": { "tick": 8 } },
		{ "op": "pulse", "expect": {} },
		{ "op": "log", "expect": { "log": [["act", 5]] } },
		{ "op": "get", "key": "m", "expect": { "value": 2 } }
	]
}
