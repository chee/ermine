{
	"title": "one tree: a scope is made under the one given, else the one open (none: unscoped, before anything else); no pairs: empty; what is open shows its info, then its owner's under \"owner\", nested to the root; disposing a root takes what is under it",
	"steps": [
		{ "op": "scope", "name": "x", "expect": { "error": "unscoped" } },
		{ "op": "current", "expect": { "value": null } },
		{ "op": "root", "name": "z", "info": [], "expect": { "error": "empty" } },
		{ "op": "root", "name": "a", "info": [["actor", "chee"]], "expect": {} },
		{ "op": "scope", "name": "y", "parent": "a", "info": [], "expect": { "error": "empty" } },
		{
			"op": "scope",
			"name": "b",
			"parent": "a",
			"info": [["app", "notes"], ["actor", "notes"]],
			"expect": {}
		},
		{
			"op": "run",
			"scope": "b",
			"do": { "current": null },
			"expect": {
				"value": {
					"scope": "b",
					"pairs": [["app", "notes"], ["actor", "notes"], ["owner", [["actor", "chee"]]]]
				}
			}
		},
		{
			"op": "run",
			"scope": "b",
			"do": {
				"do": [{ "scope": ["k", [["why", "save"]]] }, { "in": ["k", { "current": null }] }]
			},
			"expect": {
				"value": {
					"scope": "k",
					"pairs": [
						["why", "save"],
						["owner", [["app", "notes"], ["actor", "notes"], ["owner", [["actor", "chee"]]]]]
					]
				}
			}
		},
		{ "op": "current", "expect": { "value": null } },
		{ "op": "dispose", "scope": "a", "expect": {} },
		{ "op": "run", "scope": "k", "do": 1, "expect": { "error": "disposed" } },
		{
			"op": "scope",
			"name": "k2",
			"parent": "b",
			"info": [["why", "late"]],
			"expect": { "error": "disposed" }
		}
	]
}
