			}
		},
		{
			"op": "effect",
			"name": "e",
			"scope": "o",
			"f": {
				"read": "x"
			},
			"act": {
				"log": [
					"e",
					{
						"given": "value"
					},
					{
						"given": "previous"
					}
				]
			},
			"expect": {}
		},
		{
			"op": "effect",
			"name": "f",
			"scope": "o",
