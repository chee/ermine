{
	"title": "a run-return listener that throws: finish, then rethrow. c's run goes ahead: its set is given the result (d due), its end told; then the error comes out of the pulse, left there, so d runs at the next",
	"steps": [
		{ "op": "root", "name": "o", "info": { "actor": "test" }, "expect": {} },
		{ "op": "write", "values": { "x": 1 }, "expect": { "tick": 1 } },
		{
			"op": "compute",
			"name": "c",
			"scope": "o",
			"f": { "do": [{ "log": "body" }, { "read": "x" }] },
			"to": "c",
			"set": { "log": ["set", { "given": "value" }] },
			"expect": {}
		},
		{
			"op": "compute",
			"name": "d",
			"scope": "o",
			"f": { "sum": [{ "read": "c" }, 100] },
			"to": "d",
			"expect": {}
		},
		{ "op": "pulse", "expect": {} },
		{ "op": "log", "expect": { "log": ["body", ["set", 1]] } },
		{
			"op": "moments",
			"expect": {
				"moments": [
					{ "due": "c", "tick": 2 },
					{ "due": "d", "tick": 3 },
					{ "starts": "c", "run": 1, "rank": 0 },
					{ "ends": "c", "run": 1, "ended": "done", "equal": false },
					{ "starts": "d", "run": 1, "rank": 0 },
					{ "ends": "d", "run": 1, "ended": "done", "equal": false }
				]
			}
		},
		{ "op": "listener", "on": "returns", "at": "c", "throw": "returns threw", "expect": {} },
		{ "op": "write", "values": { "x": 2 }, "expect": { "tick": 6 } },
		{ "op": "pulse", "expect": { "error": "returns threw" } },
		{
			"op": "moments",
			"returns": true,
			"expect": {
				"moments": [
					{ "due": "c", "tick": 6 },
					{ "starts": "c", "run": 2, "rank": 0 },
					{ "returns": "c", "run": 2 },
					{ "due": "d", "tick": 7, "writer": "c" },
					{ "ends": "c", "run": 2, "ended": "done", "equal": false }
				]
			}
		},
		{ "op": "log", "expect": { "log": ["body", ["set", 2]] } },
		{ "op": "get", "key": "c", "expect": { "value": 2 } },
		{ "op": "get", "key": "d", "expect": { "value": 101 } },
		{ "op": "pulse", "expect": {} },
		{
			"op": "moments",
			"returns": true,
			"expect": {
				"moments": [
					{ "starts": "d", "run": 2, "rank": 1 },
					{ "returns": "d", "run": 2 },
					{ "ends": "d", "run": 2, "ended": "done", "equal": false }
				]
			}
		},
		{ "op": "get", "key": "d", "expect": { "value": 102 } },
		{ "op": "write", "values": { "x": 3 }, "expect": { "tick": 9 } },
		{ "op": "pulse", "expect": {} },
		{ "op": "get", "key": "d", "expect": { "value": 103 } }
	]
}
