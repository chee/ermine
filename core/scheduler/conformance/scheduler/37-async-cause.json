{
	"title": "a pending run's cause ends with its pulse: its landing in a later pulse makes no false loop, and an outside change is not lost (proof async3)",
	"steps": [
		{ "op": "root", "name": "o", "info": [["actor", "test"]], "expect": {} },
		{ "op": "write", "values": { "x": 1, "flag": false }, "expect": { "tick": 1 } },
		{
			"op": "compute",
			"name": "a",
			"scope": "o",
			"f": { "do": [{ "read": "c" }, { "wait": ["pa"] }] },
			"to": "a"
		},
		{
			"op": "compute",
			"name": "c",
			"scope": "o",
			"f": { "sum": [{ "read": "x" }, { "if": [{ "read": "flag" }, { "read": "e" }, 0] }] },
			"to": "c"
		},
		{ "op": "compute", "name": "e", "scope": "o", "f": { "read": "a" }, "to": "e" },
		{ "op": "pulse", "expect": {} },
		{ "op": "get", "key": "c", "expect": { "value": 1 } },
		{ "op": "resolve", "promise": "pa", "value": 20, "expect": {} },
		{ "op": "write", "values": { "x": 2, "flag": true } },
		{ "op": "pulse", "expect": {} },
		{ "op": "get", "key": "e", "expect": { "value": 20 } },
		{ "op": "get", "key": "c", "expect": { "value": 22 } }
	]
}
