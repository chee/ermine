{
	"title": "an effect is an owner: its cleanups run before its next act, and when it goes",
	"steps": [
		{ "op": "root", "name": "o", "info": [["actor", "test"]], "expect": {} },
		{
			"op": "effect",
			"name": "e",
			"scope": "o",
			"f": { "read": "x" },
			"act": {
				"do": [
					{ "log": ["act", { "given": "value" }] },
					{ "cleanup": ["e", { "log": ["undo", { "given": "value" }] }] }
				]
			},
			"expect": {}
		},
		{ "op": "write", "values": { "x": 1 }, "expect": { "tick": 2 } },
		{ "op": "pulse", "expect": {} },
		{ "op": "log", "expect": { "log": [["act", 1]] } },
		{ "op": "write", "values": { "x": 2 }, "expect": { "tick": 3 } },
		{ "op": "pulse", "expect": {} },
		{ "op": "log", "expect": { "log": [["undo", 1], ["act", 2]] } },
		{
			"op": "moments",
			"expect": {
				"moments": [
					{
						"due": "e",
						"tick": 1
					},
					{
						"starts": "e",
						"run": 1
					},
					{
						"ends": "e",
						"run": 1,
						"ended": "done",
						"equal": false
					},
					{
						"acts": "e",
						"run": 1
					},
					{
						"due": "e",
						"tick": 3
					},
					{
						"starts": "e",
						"run": 2
					},
					{
						"ends": "e",
						"run": 2,
						"ended": "done",
						"equal": false
					},
					{
						"acts": "e",
						"run": 2
					}
				]
			}
		},
		{ "op": "write", "values": { "x": 2 }, "expect": { "tick": 4 } },
		{ "op": "pulse", "expect": {} },
		{
			"op": "moments",
			"expect": {
				"moments": [
					{ "due": "e", "tick": 4 },
					{ "starts": "e", "run": 3 },
					{ "ends": "e", "run": 3, "ended": "done", "equal": true }
				]
			}
		},
		{ "op": "log", "expect": { "log": [] } },
		{ "op": "dispose", "scope": "e", "expect": {} },
		{ "op": "log", "expect": { "log": [["undo", 2]] } }
	]
}
