{
	"title": "effects act after the round's last run, in the order their runs ended",
	"steps": [
		{ "op": "owner", "name": "o", "expect": {} },
		{
			"op": "effect",
			"name": "e1",
			"owner": "o",
			"f": { "read": "a" },
			"act": { "log": ["e1", { "given": "value" }] }
		},
		{
			"op": "compute",
			"name": "c",
			"owner": "o",
			"f": { "sum": [{ "read": "a" }, 1] },
			"to": "c"
		},
		{
			"op": "compute",
			"name": "d",
			"owner": "o",
			"f": { "sum": [{ "read": "c" }, 1] },
			"to": "d"
		},
		{
			"op": "effect",
			"name": "e2",
			"owner": "o",
			"f": { "read": "d" },
			"act": { "log": ["e2", { "given": "value" }] }
		},
		{ "op": "write", "values": { "a": 1 }, "expect": { "tick": 5 } },
		{ "op": "pulse", "expect": {} },
		{ "op": "log", "expect": { "log": [["e1", 1], ["e2", 3]] } },
		{ "op": "moments" },
		{ "op": "write", "values": { "a": 2 }, "expect": { "tick": 8 } },
		{ "op": "pulse", "expect": {} },
		{
			"op": "moments",
			"expect": {
				"moments": [
					{ "due": "e1", "tick": 8 },
					{ "due": "c", "tick": 8 },
					{ "starts": "e1", "run": 2, "rank": 0 },
					{ "ends": "e1", "run": 2, "ended": "done", "equal": false },
					{ "starts": "c", "run": 2, "rank": 0 },
					{ "due": "d", "tick": 9 },
					{ "ends": "c", "run": 2, "ended": "done", "equal": false },
					{ "starts": "d", "run": 2, "rank": 1 },
					{ "due": "e2", "tick": 10 },
					{ "ends": "d", "run": 2, "ended": "done", "equal": false },
					{ "starts": "e2", "run": 2, "rank": 2 },
					{ "ends": "e2", "run": 2, "ended": "done", "equal": false },
					{ "acts": "e1", "run": 2 },
					{ "acts": "e2", "run": 2 }
				]
			}
		},
		{ "op": "log", "expect": { "log": [["e1", 2], ["e2", 4]] } }
	]
}
