{
	"title": "a result equal to the last stops there: nothing given to set, nothing after it runs",
	"steps": [
		{ "op": "root", "name": "o", "info": [["actor", "test"]], "expect": {} },
		{ "op": "write", "values": { "x": 1 }, "expect": { "tick": 1 } },
		{
			"op": "compute",
			"name": "p",
			"scope": "o",
			"f": { "mod": [{ "read": "x" }, 2] },
			"to": "p",
			"expect": {}
		},
		{
			"op": "compute",
			"name": "q",
			"scope": "o",
			"f": { "sum": [{ "read": "p" }, 10] },
			"to": "q",
			"expect": {}
		},
		{
			"op": "effect",
			"name": "e",
			"scope": "o",
			"f": { "read": "q" },
			"act": { "log": ["e", { "given": "value" }] },
			"expect": {}
		},
		{ "op": "pulse", "expect": {} },
		{ "op": "log", "expect": { "log": [["e", 11]] } },
		{
			"op": "moments",
			"expect": {
				"moments": [
					{
						"due": "p",
						"tick": 2
					},
					{
						"due": "q",
						"tick": 3
					},
					{
						"due": "e",
						"tick": 4
					},
					{
						"starts": "p",
						"run": 1,
						"rank": 0
					},
					{
						"ends": "p",
						"run": 1,
						"ended": "done",
						"equal": false
					},
					{
						"starts": "q",
						"run": 1,
						"rank": 0
					},
					{
						"ends": "q",
						"run": 1,
						"ended": "done",
						"equal": false
					},
					{
						"starts": "e",
						"run": 1,
						"rank": 0
					},
					{
						"ends": "e",
						"run": 1,
						"ended": "done",
						"equal": false
					},
					{
						"acts": "e",
						"run": 1
					}
				]
			}
		},
		{ "op": "write", "values": { "x": 3 }, "expect": { "tick": 7 } },
		{ "op": "pulse", "expect": {} },
		{
			"op": "moments",
			"expect": {
				"moments": [
					{ "due": "p", "tick": 7 },
					{ "starts": "p", "run": 2, "rank": 0 },
					{ "ends": "p", "run": 2, "ended": "done", "equal": true }
				]
			}
		},
		{ "op": "log", "expect": { "log": [] } },
		{ "op": "write", "values": { "x": 4 }, "expect": { "tick": 8 } },
		{ "op": "pulse", "expect": {} },
		{ "op": "log", "expect": { "log": [["e", 10]] } },
		{ "op": "get", "key": "q", "expect": { "value": 10 } }
