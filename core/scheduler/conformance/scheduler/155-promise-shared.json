{
	"title": "one promise awaited by two computes lands at both; awaited once settled, it lands its value at the next pulse",
	"steps": [
		{ "op": "root", "name": "o", "info": { "actor": "test" }, "expect": {} },
		{
			"op": "compute",
			"name": "a",
			"scope": "o",
			"f": { "wait": ["p"] },
			"to": "a",
			"expect": {}
		},
		{
			"op": "compute",
			"name": "b",
			"scope": "o",
			"f": { "await": "p" },
			"to": "b",
			"expect": {}
		},
		{ "op": "pulse", "expect": {} },
		{ "op": "get", "key": "a", "expect": { "value": null } },
		{ "op": "get", "key": "b", "expect": { "value": null } },
		{ "op": "resolve", "promise": "p", "value": { "n": 7 }, "expect": {} },
		{ "op": "pulse", "expect": {} },
		{ "op": "get", "key": "a", "expect": { "value": { "n": 7 } } },
		{ "op": "get", "key": "b", "expect": { "value": { "n": 7 } } },
		{ "op": "moments", "skip": ["moments"], "expect": { "moments": [] } },
		{
			"op": "compute",
			"name": "c",
			"scope": "o",
			"f": { "await": "p" },
			"to": "c",
			"expect": {}
		},
		{ "op": "pulse", "expect": {} },
		{ "op": "get", "key": "c", "expect": { "value": null } },
		{ "op": "pulse", "expect": {} },
		{ "op": "get", "key": "c", "expect": { "value": { "n": 7 } } },
		{
			"op": "moments",
			"expect": {
				"moments": [
					{ "due": "c", "tick": 5 },
					{ "starts": "c", "run": 1, "rank": 0 },
					{ "ends": "c", "run": 1, "ended": "pending" },
					{ "ends": "c", "run": 1, "ended": "done", "equal": false }
				]
			}
		},
		{ "op": "dispose", "scope": "o", "expect": {} }
	]
}
