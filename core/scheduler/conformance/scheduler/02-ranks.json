{
	"title": "readers run after the writers of what they read: ranks, learned from the keys a set changes",
	"steps": [
		{ "op": "owner", "name": "o", "expect": {} },
		{ "op": "write", "values": { "a": 1, "x": 0 }, "expect": { "tick": 1 } },
		{
			"op": "compute",
			"name": "c",
			"owner": "o",
			"f": { "sum": [{ "read": "b" }, { "read": "x" }] },
			"to": "c"
		},
		{
			"op": "compute",
			"name": "b",
			"owner": "o",
			"f": { "sum": [{ "read": "a" }, 1] },
			"to": "b"
		},
		{ "op": "pulse", "expect": {} },
		{
			"op": "moments",
			"expect": {
				"moments": [
					{ "due": "c", "tick": 2 },
					{ "due": "b", "tick": 3 },
					{ "starts": "c", "run": 1, "rank": 0 },
					{ "ends": "c", "run": 1, "ended": "done", "equal": false },
					{ "starts": "b", "run": 1, "rank": 0 },
					{ "due": "c", "tick": 5 },
					{ "ends": "b", "run": 1, "ended": "done", "equal": false },
					{ "starts": "c", "run": 2, "rank": 0 },
					{ "ends": "c", "run": 2, "ended": "done", "equal": false }
				]
			}
		},
		{ "op": "get", "key": "c", "expect": { "value": 2 } },
		{ "op": "write", "values": { "a": 10, "x": 1 }, "expect": { "tick": 7 } },
		{ "op": "pulse", "expect": {} },
		{
			"op": "moments",
			"expect": {
				"moments": [
					{ "due": "b", "tick": 7 },
					{ "due": "c", "tick": 7 },
					{ "starts": "b", "run": 2, "rank": 0 },
					{ "ends": "b", "run": 2, "ended": "done", "equal": false },
					{ "starts": "c", "run": 3, "rank": 1 },
					{ "ends": "c", "run": 3, "ended": "done", "equal": false }
				]
			}
		},
		{ "op": "get", "key": "c", "expect": { "value": 12 } }
	]
}
