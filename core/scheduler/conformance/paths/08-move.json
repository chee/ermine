{
	"title": "a move marks its take and its landing, each by the rows above",
	"steps": [
		{ "op": "spot", "source": "v", "id": "n", "path": [] },
		{ "op": "spot", "source": "v", "id": "n", "path": ["b"] },
		{ "op": "spot", "source": "v", "id": "n", "path": ["c"] },
		{ "op": "spot", "source": "v", "id": "n", "path": ["c", "x"] },
		{ "op": "spot", "source": "v", "id": "n", "path": ["d"] },
		{
			"op": "mark",
			"source": "v",
			"id": "n",
			"patches": [{ "path": ["d"], "move": { "path": ["c"] } }],
			"expect": [[], ["c"], ["c", "x"], ["d"]]
		},
		{ "op": "spot", "source": "v", "id": "n", "path": ["l", 0] },
		{ "op": "spot", "source": "v", "id": "n", "path": ["l", 1] },
		{ "op": "spot", "source": "v", "id": "n", "path": ["l", 2] },
		{ "op": "spot", "source": "v", "id": "n", "path": ["l", 3] },
		{ "op": "spot", "source": "v", "id": "n", "path": ["l", 4] },
		{
			"op": "mark",
			"source": "v",
			"id": "n",
			"patches": [
				{ "path": ["l"], "range": [0, 0], "move": { "path": ["l"], "range": [3, 4] } }
			],
			"expect": [[], ["l", 0], ["l", 1], ["l", 2], ["l", 3], ["l", 4]]
		},
		{
			"op": "mark",
			"source": "v",
			"id": "n",
			"patches": [
				{ "path": ["l"], "range": [0, 1], "move": { "path": ["l"], "range": [3, 4] } }
			],
			"expect": [[], ["l", 0], ["l", 3], ["l", 4]]
		},
		{
			"op": "mark",
			"source": "v",
			"id": "n",
			"patches": [{ "path": ["b"], "move": { "path": ["l", 2] } }],
			"expect": [[], ["b"], ["l", 2], ["l", 3], ["l", 4]]
		},
		{
			"op": "mark",
			"source": "v",
			"id": "n",
			"patches": [{ "path": ["l"], "range": [1, 2], "move": { "path": ["b"] } }],
			"expect": [[], ["b"], ["l", 1]]
		}
	]
}
