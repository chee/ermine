{
	"title": "several patches in one update: each in its own coordinates, each spot once",
	"steps": [
		{ "op": "spot", "source": "v", "id": "n", "path": ["doc"] },
		{ "op": "spot", "source": "v", "id": "n", "path": ["doc", "title"] },
		{ "op": "spot", "source": "v", "id": "n", "path": ["doc", "body"] },
		{ "op": "spot", "source": "v", "id": "n", "path": ["side"] },
		{
			"op": "mark",
			"source": "v",
			"id": "n",
			"patches": [
				{ "path": ["doc", "title"], "value": "a" },
				{ "path": ["doc", "title"], "range": [0, 0], "value": "b" },
				{ "path": ["doc", "body"], "value": "c" }
			],
			"expect": [["doc"], ["doc", "title"], ["doc", "body"]]
		},
		{ "op": "spot", "source": "v", "id": "n", "path": ["l", 0] },
		{ "op": "spot", "source": "v", "id": "n", "path": ["l", 1] },
		{ "op": "spot", "source": "v", "id": "n", "path": ["l", 2] },
		{
			"op": "mark",
			"source": "v",
			"id": "n",
			"patches": [
				{ "path": ["l"], "range": [1, 1], "value": ["x"] },
				{ "path": ["l", 0], "value": "y" }
			],
			"expect": [["l", 0], ["l", 1], ["l", 2]]
		},
		{ "op": "mark", "source": "v", "id": "n", "patches": [], "expect": [] }
	]
}
