{
	"title": "symbols as source and id: one per name, never equal to a string",
	"steps": [
		{ "op": "spot", "source": { "symbol": "v" }, "id": "n", "path": ["x"], "expect": {} },
		{ "op": "spot", "source": "v", "id": "n", "path": ["x", "y"], "expect": {} },
		{ "op": "spot", "source": "v", "id": { "symbol": "n" }, "path": ["x", "z"], "expect": {} },
		{
			"op": "spot",
			"source": { "symbol": "w" },
			"id": { "symbol": "n" },
			"path": [],
			"expect": {}
		},
		{
			"op": "mark",
			"source": { "symbol": "v" },
			"id": "n",
			"patches": [{ "path": ["x"] }],
			"expect": { "spots": [["x"]] }
		},
		{
			"op": "mark",
			"source": "v",
			"id": "n",
			"patches": [{ "path": ["x"] }],
			"expect": { "spots": [["x", "y"]] }
		},
		{
			"op": "mark",
			"source": "v",
			"id": { "symbol": "n" },
			"patches": [{ "path": ["x"] }],
			"expect": { "spots": [["x", "z"]] }
		},
		{
			"op": "event",
			"source": { "symbol": "w" },
			"id": { "symbol": "n" },
			"expect": { "spots": [[]] }
		},
		{ "op": "event", "source": { "symbol": "w" }, "id": "n", "expect": { "spots": [] } },
		{ "op": "held", "expect": { "keys": 4, "spots": 4, "steps": 9 } },
		{ "op": "release", "source": { "symbol": "v" }, "id": "n", "path": ["x"], "expect": {} },
		{ "op": "held", "expect": { "keys": 3, "spots": 3, "steps": 7 } }
	]
}
