{
	"title": "neither path a prefix of the other: never; a number key and a string key differ",
	"steps": [
		{ "op": "spot", "source": "v", "id": "n", "path": ["a", "c"] },
		{ "op": "spot", "source": "v", "id": "n", "path": ["a", "bb"] },
		{ "op": "spot", "source": "v", "id": "n", "path": ["b"] },
		{ "op": "spot", "source": "v", "id": "n", "path": ["l", "0"] },
		{ "op": "spot", "source": "v", "id": "n", "path": ["l", 0] },
		{
			"op": "mark",
			"source": "v",
			"id": "n",
			"patches": [{ "path": ["a", "b"], "value": 1 }],
			"expect": []
		},
		{
			"op": "mark",
			"source": "v",
			"id": "n",
			"patches": [{ "path": ["l", 0], "value": 1 }],
			"expect": [["l", 0]]
		},
		{
			"op": "mark",
			"source": "v",
			"id": "n",
			"patches": [{ "path": ["l", "0"], "value": 1 }],
			"expect": [["l", "0"]]
		}
	]
}
