{
	"title": "a move out of a list index lands in a list: take marks from its index, landing from its own (from notify 09-move-item)",
	"steps": [
		{ "op": "spot", "source": "v", "id": "n", "path": ["l"], "expect": {} },
		{ "op": "spot", "source": "v", "id": "n", "path": ["l", 0], "expect": {} },
		{ "op": "spot", "source": "v", "id": "n", "path": ["l", 1], "expect": {} },
		{ "op": "spot", "source": "v", "id": "n", "path": ["l", 2], "expect": {} },
		{ "op": "spot", "source": "v", "id": "n", "path": ["l", 3], "expect": {} },
		{ "op": "spot", "source": "v", "id": "n", "path": ["l", 4], "expect": {} },
		{
			"op": "mark",
			"source": "v",
			"id": "n",
			"patches": [{ "path": ["l"], "range": [0, 0], "move": { "path": ["l", 3] } }],
			"expect": { "spots": [["l"], ["l", 4], ["l", 3], ["l", 0], ["l", 1], ["l", 2]] }
		},
		{
			"op": "mark",
			"source": "v",
			"id": "n",
			"patches": [{ "path": ["l"], "range": [2, 2], "move": { "path": ["l", 3] } }],
			"expect": { "spots": [["l"], ["l", 4], ["l", 3], ["l", 2]] }
		}
	]
}
