		{ "op": "spot", "source": "v", "id": "n", "path": "ab", "fails": true },
		{ "op": "spot", "source": "v", "id": "n", "path": ["l", 1e15], "fails": true },
		{ "op": "spot", "source": "v", "id": "n", "fails": true },
		{ "op": "kept", "expect": { "keys": 0, "spots": 0, "steps": 0 } },
