{
	"title": "spots by address: a read of nothing has a spot, and what is made there marks it",
	"steps": [
		{ "op": "spot", "source": "v", "id": "later", "path": [], "expect": {} },
		{ "op": "spot", "source": "v", "id": "later", "path": ["x"], "expect": {} },
		{ "op": "event", "source": "v", "id": "later", "expect": { "spots": [[], ["x"]] } },
		{ "op": "spot", "source": "v", "id": "n", "path": ["missing"], "expect": {} },
		{ "op": "spot", "source": "v", "id": "n", "path": ["a"], "expect": {} },
		{
			"op": "mark",
			"source": "v",
			"id": "n",
			"patches": [{ "path": ["missing"], "value": 1 }],
			"expect": { "spots": [["missing"]] }
		},
		{
			"op": "mark",
			"source": "v",
			"id": "n",
			"patches": [{ "path": ["a"], "value": { "b": 1 } }],
			"expect": { "spots": [["a"]] }
		}
	]
}
