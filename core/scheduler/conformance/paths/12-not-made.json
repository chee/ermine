{
	"title": "spots by address: a read of nothing has a spot, and what is made there marks it",
	"steps": [
		{ "op": "spot", "source": "v", "id": "later", "path": [] },
		{ "op": "spot", "source": "v", "id": "later", "path": ["x"] },
		{ "op": "event", "source": "v", "id": "later", "expect": [[], ["x"]] },
		{ "op": "spot", "source": "v", "id": "n", "path": ["missing"] },
		{ "op": "spot", "source": "v", "id": "n", "path": ["a"] },
		{
			"op": "mark",
			"source": "v",
			"id": "n",
			"patches": [{ "path": ["missing"], "value": 1 }],
			"expect": [["missing"]]
		},
		{
			"op": "mark",
			"source": "v",
			"id": "n",
			"patches": [{ "path": ["a"], "value": { "b": 1 } }],
			"expect": [["a"]]
		}
	]
}
