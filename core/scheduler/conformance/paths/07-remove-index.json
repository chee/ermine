{
	"title": "an unranged removal at a list index marks from that index on; a put there replaces",
	"steps": [
		{ "op": "spot", "source": "v", "id": "n", "path": ["l"], "expect": {} },
		{ "op": "spot", "source": "v", "id": "n", "path": ["l", 0], "expect": {} },
		{ "op": "spot", "source": "v", "id": "n", "path": ["l", 1], "expect": {} },
		{ "op": "spot", "source": "v", "id": "n", "path": ["l", 2, "x"], "expect": {} },
		{ "op": "spot", "source": "v", "id": "n", "path": ["l", 6], "expect": {} },
		{ "op": "spot", "source": "v", "id": "n", "path": ["m", "j"], "expect": {} },
		{ "op": "spot", "source": "v", "id": "n", "path": ["m", "k"], "expect": {} },
		{
			"op": "mark",
			"source": "v",
			"id": "n",
			"patches": [{ "path": ["l", 1] }],
			"expect": { "spots": [["l"], ["l", 2, "x"], ["l", 6], ["l", 1]] }
		},
		{
			"op": "mark",
			"source": "v",
			"id": "n",
			"patches": [{ "path": ["l", 4] }],
			"expect": { "spots": [["l"], ["l", 6]] }
		},
		{
			"op": "mark",
			"source": "v",
			"id": "n",
			"patches": [{ "path": ["l", 1], "value": "new" }],
			"expect": { "spots": [["l"], ["l", 1]] }
		},
		{
			"op": "mark",
			"source": "v",
			"id": "n",
			"patches": [{ "path": ["m", "k"] }],
			"expect": { "spots": [["m", "k"]] }
		}
	]
}
