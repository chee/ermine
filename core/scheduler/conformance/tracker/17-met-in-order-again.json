{
	"title": "a spot read out of order, then met in order again: the old link is confirmed, so two links; the rest still confirmed",
	"steps": [
		{ "op": "begin", "from": "r" },
		{ "op": "track", "from": "r", "to": "a" },
		{ "op": "track", "from": "r", "to": "b" },
		{ "op": "track", "from": "r", "to": "c" },
		{ "op": "end", "from": "r" },
		{ "op": "begin", "from": "s" },
		{ "op": "track", "from": "s", "to": "b" },
		{ "op": "end", "from": "s" },
		{ "op": "begin", "from": "r" },
		{ "op": "track", "from": "r", "to": "b" },
		{ "op": "readers", "of": "b", "expect": { "names": ["r", "s", "r"] } },
		{ "op": "track", "from": "r", "to": "a" },
		{ "op": "track", "from": "r", "to": "b" },
		{ "op": "readers", "of": "b", "expect": { "names": ["r", "s", "r"] } },
