		{ "op": "end", "from": "q" },
		{ "op": "track", "from": "r", "to": "c" },
		{ "op": "track", "from": "r", "to": "b" },
		{ "op": "end", "from": "r" },
		{ "op": "reads", "of": "r", "expect": { "names": ["b", "a", "b", "c"] } },
		{ "op": "readers", "of": "a", "expect": { "names": ["r"] } },
		{ "op": "readers", "of": "b", "expect": { "names": ["r", "s", "r"] } },
		{ "op": "readers", "of": "c", "expect": { "names": ["r", "q"] } }
	]
}
