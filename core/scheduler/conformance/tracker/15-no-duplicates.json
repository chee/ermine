{
	"title": "a spot read again in a run is linked again where the checks miss (not the last read, not next in order, not the spot's newest reader)",
	"steps": [
		{ "op": "begin", "from": "p" },
		{ "op": "track", "from": "p", "to": "a" },
		{ "op": "track", "from": "p", "to": "b" },
		{ "op": "begin", "from": "q" },
		{ "op": "track", "from": "q", "to": "a" },
		{ "op": "begin", "from": "r" },
		{ "op": "track", "from": "r", "to": "a" },
		{ "op": "track", "from": "q", "to": "b" },
		{ "op": "track", "from": "p", "to": "a" },
		{ "op": "track", "from": "q", "to": "a" },
		{ "op": "track", "from": "r", "to": "a" },
		{ "op": "track", "from": "p", "to": "b" },
		{ "op": "end", "from": "r" },
		{ "op": "end", "from": "q" },
		{ "op": "end", "from": "p" },
		{ "op": "reads", "of": "p", "expect": { "names": ["a", "b", "a", "b"] } },
		{ "op": "reads", "of": "q", "expect": { "names": ["a", "b", "a"] } },
		{ "op": "reads", "of": "r", "expect": { "names": ["a"] } },
		{ "op": "readers", "of": "a", "expect": { "names": ["p", "q", "r", "p", "q"] } },
		{ "op": "readers", "of": "b", "expect": { "names": ["p", "q", "p"] } }
	]
}
