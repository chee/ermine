{
	"title": "readers keep the order made when others leave",
	"steps": [
		{ "op": "add", "from": "r0", "to": "hot" },
		{ "op": "add", "from": "r1", "to": "hot" },
		{ "op": "add", "from": "r2", "to": "hot" },
		{ "op": "add", "from": "r3", "to": "hot" },
		{ "op": "add", "from": "r4", "to": "hot" },
		{ "op": "add", "from": "r5", "to": "hot" },
		{ "op": "add", "from": "r6", "to": "hot" },
		{ "op": "add", "from": "r7", "to": "hot" },
		{ "op": "untrack", "from": "r1", "to": "hot" },
		{ "op": "untrack", "from": "r3", "to": "hot" },
		{ "op": "untrack", "from": "r5", "to": "hot" },
		{ "op": "untrack", "from": "r7", "to": "hot" },
		{ "op": "untrack", "from": "r2", "to": "hot" },
		{ "op": "readers", "of": "hot", "expect": { "names": ["r0", "r4", "r6"] } },
		{ "op": "add", "from": "r1", "to": "hot" },
		{ "op": "readers", "of": "hot", "expect": { "names": ["r0", "r4", "r6", "r1"] } }
	]
}
