{
	"title": "a node: the entries given by table name, each as an entry is made, and no others",
	"steps": [
		{
			"op": "node",
			"entries": {
				"value": { "value": { "title": "hi" }, "header": { "time": 5, "actor": "me" } },
				"attributes": { "value": [["k", 1]], "header": { "time": 6, "actor": "you" } },
				"children": { "value": [], "header": { "time": 7 } }
			},
			"expect": {
				"node": {
					"value": { "value": { "title": "hi" }, "change": { "time": 5, "actor": "me" } },
					"attributes": { "value": [["k", 1]], "change": { "time": 6, "actor": "you" } },
					"children": { "value": [], "change": { "time": 7 } }
				}
			}
		},
		{
			"op": "node",
			"entries": { "value": { "value": null } },
			"expect": { "node": { "value": { "value": null, "change": { "time": "now" } } } }
		}
	]
}
