{
	"title": "null is a value, kept; only not giving one means none",
	"steps": [
		{
			"op": "make",
			"value": null,
			"expect": {
				"node": {
					"value": null,
					"change": {
						"time": "now"
					}
				}
			}
		},
		{
			"op": "make",
			"value": false,
			"expect": {
				"node": {
					"value": false,
					"change": {
						"time": "now"
					}
				}
			}
		},
		{
			"op": "make",
			"expect": {
				"node": {
					"change": {
						"time": "now"
					}
				}
			}
		}
	]
}
