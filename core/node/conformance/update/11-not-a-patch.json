{
	"title": "not-a-patch: bad shapes, at their index",
	"steps": [
		{
			"op": "start",
			"value": {
				"l": [
					1
				]
			},
			"header": {
				"time": 0,
				"actor": "host"
			},
			"expect": {}
		},
		{
			"op": "update",
			"patches": [
				{
					"path": "l"
				}
			],
			"expect": {
				"error": {
					"code": "not-a-patch",
					"patch": 0
				}
			}
		},
		{
			"op": "update",
			"patches": [
				{
					"path": [
						"l",
						0
					],
					"value": 2
				},
				{
					"path": [
						"l",
						-1
					]
				}
			],
			"expect": {
				"error": {
					"code": "not-a-patch",
					"patch": 1
				}
			}
		},
		{
			"op": "update",
			"patches": [
				{
					"path": [
						"l"
					],
					"range": [
						-1,
						0
					]
				}
			],
			"expect": {
				"error": {
					"code": "not-a-patch",
					"patch": 0
				}
			}
		},
		{
			"op": "update",
			"patches": [
				{
					"path": [
						"l"
					],
					"range": [
						0
					]
				}
			],
			"expect": {
				"error": {
					"code": "not-a-patch",
					"patch": 0
				}
			}
		},
		{
			"op": "update",
			"patches": [
				{
					"path": [
						"l",
						1.5
					],
					"value": 1
				}
			],
			"expect": {
				"error": {
					"code": "not-a-patch",
					"patch": 0
				}
			}
		},
		{
			"op": "update",
			"patches": [
				{
					"path": [
						"a"
					],
					"value": 1,
					"move": {
						"path": [
							"l"
						]
					}
				}
			],
			"expect": {
				"error": {
					"code": "not-a-patch",
					"patch": 0
				}
			}
		},
		{
			"op": "update",
			"patches": [
				{
					"path": [
						"a"
					],
					"move": {
						"path": "l"
					}
				}
			],
			"expect": {
				"error": {
					"code": "not-a-patch",
					"patch": 0
				}
			}
		},
		{
			"op": "update",
			"patches": [
				{
					"value": 1
				}
			],
			"expect": {
				"error": {
					"code": "not-a-patch",
					"patch": 0
				}
			}
		},
		{
			"op": "update",
			"patches": [
				{
					"path": [
						true
					],
					"value": 1
				}
			],
			"expect": {
				"error": {
					"code": "not-a-patch",
					"patch": 0
				}
			}
		},
		{
			"op": "node",
			"expect": {
				"node": {
					"value": {
						"l": [
							1
						]
					},
					"change": {
						"time": 0,
						"actor": "host"
					}
				}
			}
		}
	]
}
