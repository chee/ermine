			],
			"expect": {
				"error": {
					"code": "no-key",
					"patch": 0
				}
			}
		},
		{
			"op": "update",
			"patches": [
				{
					"path": [],
					"range": [
						0,
						0
					],
					"value": "x"
				}
			],
			"expect": {
				"error": {
					"code": "no-key",
					"patch": 0
				}
			}
		},
		{
			"op": "update",
			"patches": [
				{
					"path": [
						"z"
					],
					"move": {
						"path": [
							"a"
						]
					}
				}
			],
			"expect": {
				"error": {
					"code": "no-key",
					"patch": 0
