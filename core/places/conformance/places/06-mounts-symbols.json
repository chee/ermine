{
	"title": "one id under two names; symbols as source and id; ROOT as the root's source",
	"steps": [
		{ "op": "make", "root": ["s", "R"], "expect": {} },
		{
			"op": "children",
			"source": "s",
			"id": "R",
			"value": { "a": [["s", "M"]], "b": [["s", "M"]], "both": [["s", "M"], ["s", "M"]] },
			"expect": {}
		},
		{ "op": "children", "source": "s", "id": "M", "value": { "x": [["s", "X"]] }, "expect": {} },
		{
			"op": "get",
			"address": ["a", "x"],
			"expect": {
				"items": [{ "source": "s", "id": "X", "name": "x", "at": 0, "path": ["a", "x"] }],
				"reads": [
					{ "source": "s", "id": "R", "path": ["a"] },
					{ "source": "s", "id": "M", "path": ["x"] }
				]
			}
		},
		{
			"op": "get",
			"address": ["b", "x"],
			"expect": {
				"items": [{ "source": "s", "id": "X", "name": "x", "at": 0, "path": ["b", "x"] }],
				"reads": [
					{ "source": "s", "id": "R", "path": ["b"] },
					{ "source": "s", "id": "M", "path": ["x"] }
				]
			}
		},
		{
			"op": "get",
			"address": ["both", "x"],
			"expect": {
				"items": [
					{ "source": "s", "id": "X", "name": "x", "at": 0, "path": ["both", "x"] },
					{ "source": "s", "id": "X", "name": "x", "at": 0, "path": ["both", "x"] }
				],
				"reads": [
					{ "source": "s", "id": "R", "path": ["both"] },
					{ "source": "s", "id": "M", "path": ["x"] },
					{ "source": "s", "id": "M", "path": ["x"] }
				]
			}
		},
		{
			"op": "children",
			"source": "s",
			"id": "R",
			"value": {
				"t": [[{ "symbol": "drag" }, { "symbol": "here" }], ["s", "T"]],
				"u": [[{ "symbol": "drag" }, "plain"], ["stored", { "symbol": "here" }]]
			},
			"expect": {}
		},
		{
			"op": "get",
			"address": ["t"],
			"expect": {
				"items": [
					{
						"source": { "symbol": "drag" },
						"id": { "symbol": "here" },
						"name": "t",
						"at": 0,
						"path": ["t"]
					},
					{ "source": "s", "id": "T", "name": "t", "at": 1, "path": ["t"] }
				],
				"reads": [{ "source": "s", "id": "R", "path": ["t"] }]
			}
		},
		{
			"op": "get",
			"address": ["u"],
			"expect": {
				"items": [
					{
						"source": { "symbol": "drag" },
						"id": "plain",
						"name": "u",
						"at": 0,
						"path": ["u"]
					},
					{
						"source": "stored",
						"id": { "symbol": "here" },
						"name": "u",
						"at": 1,
						"path": ["u"]
					}
				],
				"reads": [{ "source": "s", "id": "R", "path": ["u"] }]
			}
		},
		{
			"op": "children",
			"source": { "symbol": "drag" },
			"id": { "symbol": "here" },
			"value": { "in": [["s", "I"]] },
			"expect": {}
		},
		{
			"op": "get",
			"address": ["t", "in"],
			"expect": {
				"items": [{ "source": "s", "id": "I", "name": "in", "at": 0, "path": ["t", "in"] }],
				"reads": [
					{ "source": "s", "id": "R", "path": ["t"] },
					{ "source": { "symbol": "drag" }, "id": { "symbol": "here" }, "path": ["in"] },
					{ "source": "s", "id": "T", "path": ["in"] }
				]
			}
		},
		{
			"op": "get",
			"address": ["u", "in"],
			"expect": {
				"items": [],
				"reads": [
					{ "source": "s", "id": "R", "path": ["u"] },
					{ "source": { "symbol": "drag" }, "id": "plain", "path": ["in"] },
					{ "source": "stored", "id": { "symbol": "here" }, "path": ["in"] }
				]
			}
		},
		{
			"op": "children",
			"source": { "symbol": "drag" },
			"id": "plain",
			"value": { "in2": [["s", "I2"]] },
			"expect": {}
		},
		{
			"op": "get",
			"address": ["u", "in2"],
			"expect": {
				"items": [{ "source": "s", "id": "I2", "name": "in2", "at": 0, "path": ["u", "in2"] }],
				"reads": [
					{ "source": "s", "id": "R", "path": ["u"] },
					{ "source": { "symbol": "drag" }, "id": "plain", "path": ["in2"] },
					{ "source": "stored", "id": { "symbol": "here" }, "path": ["in2"] }
				]
			}
		},
		{
			"op": "children",
			"source": "stored",
			"id": { "symbol": "here" },
			"value": { "s": [["s", "SS"]] },
			"expect": {}
		},
		{
			"op": "get",
			"address": ["u", "s"],
			"expect": {
				"items": [{ "source": "s", "id": "SS", "name": "s", "at": 0, "path": ["u", "s"] }],
				"reads": [
					{ "source": "s", "id": "R", "path": ["u"] },
					{ "source": { "symbol": "drag" }, "id": "plain", "path": ["s"] },
					{ "source": "stored", "id": { "symbol": "here" }, "path": ["s"] }
				]
			}
		},
		{
			"op": "get",
			"address": ["t"],
			"save": "t",
			"expect": {
				"items": [
					{
						"source": { "symbol": "drag" },
						"id": { "symbol": "here" },
						"name": "t",
						"at": 0,
						"path": ["t"]
					},
					{ "source": "s", "id": "T", "name": "t", "at": 1, "path": ["t"] }
				],
				"reads": [{ "source": "s", "id": "R", "path": ["t"] }]
			}
		},
		{ "op": "path", "item": "t", "expect": { "path": ["t"] } },
		{ "op": "path", "item": "t", "at": 1, "expect": { "path": ["t"] } },
		{
			"op": "place",
			"parent": ["s", "R"],
			"name": "t",
			"entry": [{ "symbol": "other" }, { "symbol": "drag" }],
			"expect": {
				"changes": [
					{
						"source": "s",
						"id": "R",
						"value": {
							"t": [
								[{ "symbol": "drag" }, { "symbol": "here" }],
								["s", "T"],
								[{ "symbol": "other" }, { "symbol": "drag" }]
							],
							"u": [[{ "symbol": "drag" }, "plain"], ["stored", { "symbol": "here" }]]
						},
						"time": 1,
						"patches": [
							{
								"path": ["t"],
								"range": [2, 2],
								"value": [[{ "symbol": "other" }, { "symbol": "drag" }]]
							}
						]
					}
				]
			}
		},
		{
			"op": "get",
			"address": ["t"],
			"expect": {
				"items": [
					{
						"source": { "symbol": "drag" },
						"id": { "symbol": "here" },
						"name": "t",
						"at": 0,
						"path": ["t"]
					},
					{ "source": "s", "id": "T", "name": "t", "at": 1, "path": ["t"] },
					{
						"source": { "symbol": "other" },
						"id": { "symbol": "drag" },
						"name": "t",
						"at": 2,
						"path": ["t"]
					}
				],
				"reads": [{ "source": "s", "id": "R", "path": ["t"] }]
			}
		},
		{
			"op": "order",
			"parent": ["s", "R"],
			"name": "t",
			"from": 2,
			"to": 0,
			"expect": {
				"changes": [
					{
						"source": "s",
						"id": "R",
						"value": {
							"t": [
								[{ "symbol": "other" }, { "symbol": "drag" }],
								[{ "symbol": "drag" }, { "symbol": "here" }],
								["s", "T"]
							],
							"u": [[{ "symbol": "drag" }, "plain"], ["stored", { "symbol": "here" }]]
						},
						"time": 1,
						"patches": [
							{ "path": ["t"], "range": [0, 0], "move": { "path": ["t"], "range": [2, 3] } }
						]
					}
				]
			}
		},
		{
			"op": "get",
			"address": ["t"],
			"expect": {
				"items": [
					{
						"source": { "symbol": "other" },
						"id": { "symbol": "drag" },
						"name": "t",
						"at": 0,
						"path": ["t"]
					},
					{
						"source": { "symbol": "drag" },
						"id": { "symbol": "here" },
						"name": "t",
						"at": 1,
						"path": ["t"]
					},
					{ "source": "s", "id": "T", "name": "t", "at": 2, "path": ["t"] }
				],
				"reads": [{ "source": "s", "id": "R", "path": ["t"] }]
			}
		},
		{ "op": "make", "root": "R", "expect": {} },
		{
			"op": "get",
			"address": [],
			"expect": { "items": [{ "source": { "root": true }, "id": "R", "path": [] }], "reads": [] }
		},
		{
			"op": "get",
			"address": ["a"],
			"expect": {
				"items": [],
				"reads": [{ "source": { "root": true }, "id": "R", "path": ["a"] }]
			}
		},
		{
			"op": "children",
			"source": { "root": true },
			"id": "R",
			"value": { "a": [["s", "A"]] },
			"expect": {}
		},
		{
			"op": "get",
			"address": [],
			"expect": { "items": [{ "source": { "root": true }, "id": "R", "path": [] }], "reads": [] }
		},
		{
			"op": "get",
			"address": ["a"],
			"expect": {
				"items": [{ "source": "s", "id": "A", "name": "a", "at": 0, "path": ["a"] }],
				"reads": [{ "source": { "root": true }, "id": "R", "path": ["a"] }]
			}
		},
		{
			"op": "get",
			"address": [],
			"save": "r",
			"expect": { "items": [{ "source": { "root": true }, "id": "R", "path": [] }], "reads": [] }
		},
		{
			"op": "get",
			"address": ["a"],
			"save": "a",
			"expect": {
				"items": [{ "source": "s", "id": "A", "name": "a", "at": 0, "path": ["a"] }],
				"reads": [{ "source": { "root": true }, "id": "R", "path": ["a"] }]
			}
		},
		{
			"op": "get",
			"address": [".."],
			"from": { "item": "a" },
			"expect": { "items": [{ "source": { "root": true }, "id": "R", "path": [] }], "reads": [] }
		},
		{
			"op": "get",
			"address": ["..", "a"],
			"from": { "item": "a" },
			"expect": {
				"items": [{ "source": "s", "id": "A", "name": "a", "at": 0, "path": ["a"] }],
				"reads": [{ "source": { "root": true }, "id": "R", "path": ["a"] }]
			}
		},
		{
			"op": "get",
			"address": ["/", "a"],
			"from": { "item": "a" },
			"expect": {
				"items": [{ "source": "s", "id": "A", "name": "a", "at": 0, "path": ["a"] }],
				"reads": [{ "source": { "root": true }, "id": "R", "path": ["a"] }]
			}
		},
		{
			"op": "lookup",
			"address": ["a"],
			"from": { "item": "a" },
			"all": true,
			"expect": {
				"items": [{ "source": "s", "id": "A", "name": "a", "at": 0, "path": ["a"] }],
				"reads": [
					{ "source": "s", "id": "A", "path": ["a"] },
					{ "source": { "root": true }, "id": "R", "path": ["a"] }
				]
			}
		},
		{
			"op": "place",
			"parent": ["x", "R"],
			"name": "q",
			"entry": ["s", "Q"],
			"expect": { "error": "nothing-there", "changes": [] }
		},
		{ "op": "children", "source": "s", "id": "R", "value": { "a": [["s", "AS"]] }, "expect": {} },
		{
			"op": "get",
			"address": ["a"],
			"expect": {
				"items": [{ "source": "s", "id": "A", "name": "a", "at": 0, "path": ["a"] }],
				"reads": [{ "source": { "root": true }, "id": "R", "path": ["a"] }]
			}
		},
		{
			"op": "get",
			"address": ["a"],
			"from": ["s", "R"],
			"expect": {
				"items": [{ "source": "s", "id": "AS", "name": "a", "at": 0, "path": ["a"] }],
				"reads": [{ "source": "s", "id": "R", "path": ["a"] }]
			}
		},
		{
			"op": "get",
			"address": ["a"],
			"from": [{ "root": true }, "R"],
			"expect": {
				"items": [{ "source": "s", "id": "A", "name": "a", "at": 0, "path": ["a"] }],
				"reads": [{ "source": { "root": true }, "id": "R", "path": ["a"] }]
			}
		},
		{
			"op": "children",
			"source": { "root": true },
			"id": "R",
			"value": { "r": [[{ "root": true }, "R"]] },
			"expect": {}
		},
		{
			"op": "get",
			"address": ["r", "a"],
			"expect": {
				"items": [],
				"reads": [
					{ "source": { "root": true }, "id": "R", "path": ["r"] },
					{ "source": { "root": true }, "id": "R", "path": ["a"] }
				]
			}
		},
		{
			"op": "get",
			"address": ["r", "r", "r", "a"],
			"expect": {
				"items": [],
				"reads": [
					{ "source": { "root": true }, "id": "R", "path": ["r"] },
					{ "source": { "root": true }, "id": "R", "path": ["r"] },
					{ "source": { "root": true }, "id": "R", "path": ["r"] },
					{ "source": { "root": true }, "id": "R", "path": ["a"] }
				]
			}
		},
		{ "op": "make", "root": [{ "symbol": "src" }, { "symbol": "top" }], "expect": {} },
		{
			"op": "get",
			"address": [],
			"expect": {
				"items": [{ "source": { "symbol": "src" }, "id": { "symbol": "top" }, "path": [] }],
				"reads": []
			}
		},
		{
			"op": "children",
			"source": { "symbol": "src" },
			"id": { "symbol": "top" },
			"value": { "a": [["s", "A"]] },
			"expect": {}
		},
		{
			"op": "get",
			"address": ["a"],
			"expect": {
				"items": [{ "source": "s", "id": "A", "name": "a", "at": 0, "path": ["a"] }],
				"reads": [{ "source": { "symbol": "src" }, "id": { "symbol": "top" }, "path": ["a"] }]
			}
		},
		{
			"op": "get",
			"address": [],
			"save": "t0",
			"expect": {
				"items": [{ "source": { "symbol": "src" }, "id": { "symbol": "top" }, "path": [] }],
				"reads": []
			}
		},
		{ "op": "path", "item": "t0", "expect": { "path": [] } },
		{ "op": "make", "root": [{ "root": true }, "R"], "expect": {} },
		{
			"op": "get",
			"address": ["a"],
			"expect": {
				"items": [],
				"reads": [{ "source": { "root": true }, "id": "R", "path": ["a"] }]
			}
		}
	]
}
