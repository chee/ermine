{
	"title": "names: the keys that hold an array, in the order of the value; one read of the whole value",
	"steps": [
		{ "op": "make", "root": ["s", "R"], "expect": {} },
		{
			"op": "names",
			"from": ["s", "R"],
			"expect": {
				"names": [],
				"reads": [{ "source": "s", "id": "R", "path": [], "keys": true }]
			}
		},
		{ "op": "children", "source": "s", "id": "R", "expect": {} },
		{
			"op": "names",
			"from": ["s", "R"],
			"expect": {
				"names": [],
				"reads": [{ "source": "s", "id": "R", "path": [], "keys": true }]
			}
		},
		{
			"op": "children",
			"source": "s",
			"id": "R",
			"value": {
				"b": [["s", "B"]],
				"a": [["s", "A"]],
				"bad": 5,
				"worse": "x",
				"nul": null,
				"map": { "k": [] },
				"empty": [],
				"z": [5]
			},
			"expect": {}
		},
		{
			"op": "names",
			"from": ["s", "R"],
			"expect": {
				"names": ["b", "a", "empty", "z"],
				"reads": [{ "source": "s", "id": "R", "path": [], "keys": true }]
			}
		},
		{ "op": "children", "source": "s", "id": "R", "value": [["x", "y"]], "expect": {} },
		{
			"op": "names",
			"from": ["s", "R"],
			"expect": {
				"names": [],
				"reads": [{ "source": "s", "id": "R", "path": [], "keys": true }]
			}
		},
		{ "op": "children", "source": "s", "id": "R", "value": "text", "expect": {} },
		{
			"op": "names",
			"from": ["s", "R"],
			"expect": {
				"names": [],
				"reads": [{ "source": "s", "id": "R", "path": [], "keys": true }]
			}
		},
		{ "op": "children", "source": "s", "id": "R", "value": {}, "expect": {} },
		{
			"op": "names",
			"from": ["s", "R"],
			"expect": {
				"names": [],
				"reads": [{ "source": "s", "id": "R", "path": [], "keys": true }]
			}
		},
		{
			"op": "children",
			"source": "s",
			"id": "R",
			"value": {
				"__proto__": [["s", "P"]],
				"constructor": [["s", "C"]],
				"toString": [["s", "T"]],
				"hasOwnProperty": []
			},
			"expect": {}
		},
		{
			"op": "names",
			"from": ["s", "R"],
			"expect": {
				"names": ["__proto__", "constructor", "toString", "hasOwnProperty"],
				"reads": [{ "source": "s", "id": "R", "path": [], "keys": true }]
			}
		},
		{
			"op": "get",
			"address": ["__proto__"],
			"expect": {
				"items": [
					{ "source": "s", "id": "P", "name": "__proto__", "at": 0, "path": ["__proto__"] }
				],
				"reads": [{ "source": "s", "id": "R", "path": ["__proto__"] }]
			}
		},
		{
			"op": "get",
			"address": ["constructor"],
			"expect": {
				"items": [
					{ "source": "s", "id": "C", "name": "constructor", "at": 0, "path": ["constructor"] }
				],
				"reads": [{ "source": "s", "id": "R", "path": ["constructor"] }]
			}
		},
		{
			"op": "get",
			"address": ["toString"],
			"expect": {
				"items": [
					{ "source": "s", "id": "T", "name": "toString", "at": 0, "path": ["toString"] }
				],
				"reads": [{ "source": "s", "id": "R", "path": ["toString"] }]
			}
		},
		{
			"op": "get",
			"address": ["hasOwnProperty"],
			"expect": {
				"items": [],
				"reads": [{ "source": "s", "id": "R", "path": ["hasOwnProperty"] }]
			}
		},
		{
			"op": "get",
			"address": ["valueOf"],
			"expect": { "items": [], "reads": [{ "source": "s", "id": "R", "path": ["valueOf"] }] }
		},
		{
			"op": "get",
			"address": ["__defineGetter__"],
			"expect": {
				"items": [],
				"reads": [{ "source": "s", "id": "R", "path": ["__defineGetter__"] }]
			}
		},
		{
			"op": "get",
			"address": ["a"],
			"save": "a",
			"expect": { "items": [], "reads": [{ "source": "s", "id": "R", "path": ["a"] }] }
		},
		{ "op": "children", "source": "s", "id": "P", "value": { "x": [["s", "X"]] }, "expect": {} },
		{
			"op": "names",
			"from": ["s", "P"],
			"expect": {
				"names": ["x"],
				"reads": [{ "source": "s", "id": "P", "path": [], "keys": true }]
			}
		},
		{
			"op": "get",
			"address": ["__proto__"],
			"save": "p",
			"expect": {
				"items": [
					{ "source": "s", "id": "P", "name": "__proto__", "at": 0, "path": ["__proto__"] }
				],
				"reads": [{ "source": "s", "id": "R", "path": ["__proto__"] }]
			}
		},
		{
			"op": "names",
			"from": { "item": "p" },
			"expect": {
				"names": ["x"],
				"reads": [{ "source": "s", "id": "P", "path": [], "keys": true }]
			}
		},
		{
			"op": "names",
			"from": ["other", "P"],
			"expect": {
				"names": [],
				"reads": [{ "source": "other", "id": "P", "path": [], "keys": true }]
			}
		},
		{
			"op": "children",
			"source": "s",
			"id": "R",
			"value": {
				"": [["s", "E"]],
				" ": [["s", "S"]],
				"a b": [["s", "AB"]],
				"é": [["s", "U"]],
				"\u0000": [["s", "N"]]
			},
			"expect": {}
		},
		{
			"op": "names",
			"from": ["s", "R"],
			"expect": {
				"names": ["", " ", "a b", "é", "\u0000"],
				"reads": [{ "source": "s", "id": "R", "path": [], "keys": true }]
			}
		},
		{
			"op": "get",
			"address": [""],
			"expect": {
				"items": [{ "source": "s", "id": "E", "name": "", "at": 0, "path": [""] }],
				"reads": [{ "source": "s", "id": "R", "path": [""] }]
			}
		},
		{
			"op": "get",
			"address": [" "],
			"expect": {
				"items": [{ "source": "s", "id": "S", "name": " ", "at": 0, "path": [" "] }],
				"reads": [{ "source": "s", "id": "R", "path": [" "] }]
			}
		},
		{
			"op": "get",
			"address": ["a b"],
			"expect": {
				"items": [{ "source": "s", "id": "AB", "name": "a b", "at": 0, "path": ["a b"] }],
				"reads": [{ "source": "s", "id": "R", "path": ["a b"] }]
			}
		},
		{
			"op": "get",
			"address": ["é"],
			"expect": {
				"items": [{ "source": "s", "id": "U", "name": "é", "at": 0, "path": ["é"] }],
				"reads": [{ "source": "s", "id": "R", "path": ["é"] }]
			}
		},
		{
			"op": "get",
			"address": ["\u0000"],
			"expect": {
				"items": [{ "source": "s", "id": "N", "name": "\u0000", "at": 0, "path": ["\u0000"] }],
				"reads": [{ "source": "s", "id": "R", "path": ["\u0000"] }]
			}
		}
	]
}
