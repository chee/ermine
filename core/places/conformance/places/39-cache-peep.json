{
	"title": "a cache works an entry out under a peep as under none: what it reads is recorded, so a later write there reworks it and its reader runs again",
	"steps": [
		{ "op": "kids", "id": "R", "value": { "work": "W" }, "expect": {} },
		{ "op": "kids", "id": "W", "value": { "clock": "C0", "notes": "N" }, "expect": {} },
		{ "op": "kids", "id": "C0", "value": {}, "expect": {} },
		{ "op": "kids", "id": "N", "value": {}, "expect": {} },
		{ "op": "cache", "expect": {} },
		{ "op": "root", "name": "o", "info": { "actor": "o" }, "expect": {} },
		{ "op": "watch", "name": "r", "scope": "o", "f": { "cached": ["work", "clock"] }, "expect": {} },
		{ "op": "pulse", "expect": {} },
		{ "op": "state", "name": "r", "expect": { "runs": 1, "value": "C0" } },
		{
			"op": "peep",
			"request": { "op": "rename", "at": "W", "name": "clock", "to": "X" },
			"expect": {}
		},
		{ "op": "pulse", "expect": {} },
		{ "op": "state", "name": "r", "expect": { "runs": 2, "value": null } },
		{ "op": "rename", "at": "W", "name": "X", "to": "clock", "expect": {} },
		{ "op": "pulse", "expect": {} },
		{ "op": "cached", "path": ["work", "clock"], "expect": { "id": "C0" } },
		{ "op": "state", "name": "r", "expect": { "runs": 3, "value": "C0" } },
		{
			"op": "peep",
			"request": { "op": "cached", "path": ["work", "notes"] },
			"expect": { "id": "N" }
		},
		{ "op": "watch", "name": "q", "scope": "o", "f": { "cached": ["work", "notes"] }, "expect": {} },
		{ "op": "pulse", "expect": {} },
		{ "op": "rename", "at": "W", "name": "notes", "to": "Y", "expect": {} },
		{ "op": "pulse", "expect": {} },
		{ "op": "state", "name": "q", "expect": { "runs": 2, "value": null } }
	]
}
