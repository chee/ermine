{
	"title": "getOrSet at an empty path, no entry there: the entry is made holding the value, and given back; one there already: its value, nothing written",
	"steps": [
		{
			"op": "getOrSet",
			"part": "value",
			"id": "e",
			"path": [],
			"value": { "k": 1 },
			"expect": { "value": { "k": 1 } }
		},
		{ "op": "node", "part": "value", "id": "e", "expect": { "value": { "k": 1 } } },
		{
			"op": "getOrSet",
			"part": "value",
			"id": "e",
			"path": [],
			"value": { "k": 2 },
			"expect": { "value": { "k": 1 } }
		},
		{ "op": "node", "part": "value", "id": "e", "expect": { "value": { "k": 1 } } }
	]
}
