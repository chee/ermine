{
	"title": "open: addresses of every shape; reads told on every call",
	"steps": [
		{ "op": "make", "root": ["s", "R"], "expect": {} },
		{
			"op": "children",
			"source": "s",
			"id": "R",
			"value": { "a": [["s", "A"]], "z": [["s", "Z"]] },
			"expect": {}
		},
		{ "op": "children", "source": "s", "id": "A", "value": { "b": [["s", "B"]] }, "expect": {} },
		{ "op": "open", "address": [], "as": "none", "expect": {} },
		{
			"op": "items",
			"open": "none",
			"expect": {
				"items": [{ "source": "s", "id": "R", "path": [] }],
				"reads": [],
				"same": false
			}
		},
		{
			"op": "items",
			"open": "none",
			"expect": {
				"items": [{ "source": "s", "id": "R", "path": [] }],
				"reads": [],
				"same": true
			}
		},
		{ "op": "open", "address": ["/"], "as": "slash", "expect": {} },
		{
			"op": "items",
			"open": "slash",
			"expect": {
				"items": [{ "source": "s", "id": "R", "path": [] }],
				"reads": [],
				"same": false
			}
		},
		{ "op": "open", "address": ["a", ".", "b"], "as": "dot", "expect": {} },
		{
			"op": "items",
			"open": "dot",
			"expect": {
				"items": [{ "source": "s", "id": "B", "name": "b", "at": 0, "path": ["a", "b"] }],
				"reads": [
					{ "source": "s", "id": "R", "path": ["a"] },
					{ "source": "s", "id": "A", "path": ["b"] }
				],
				"same": false
			}
		},
		{ "op": "open", "address": ["a", "..", "z"], "as": "back", "expect": {} },
		{
			"op": "items",
			"open": "back",
			"expect": {
				"items": [{ "source": "s", "id": "Z", "name": "z", "at": 0, "path": ["z"] }],
				"reads": [{ "source": "s", "id": "R", "path": ["z"] }],
				"same": false
			}
		},
		{
			"op": "items",
			"open": "back",
			"expect": {
				"items": [{ "source": "s", "id": "Z", "name": "z", "at": 0, "path": ["z"] }],
				"reads": [{ "source": "s", "id": "R", "path": ["z"] }],
				"same": true
			}
		},
		{ "op": "open", "address": ["a", "b", "..", "..", "a", "b"], "as": "round", "expect": {} },
		{
			"op": "items",
			"open": "round",
			"expect": {
				"items": [{ "source": "s", "id": "B", "name": "b", "at": 0, "path": ["a", "b"] }],
				"reads": [
					{ "source": "s", "id": "R", "path": ["a"] },
					{ "source": "s", "id": "A", "path": ["b"] }
				],
				"same": false
			}
		},
		{ "op": "open", "address": ["a", "/", "z"], "as": "slashed", "expect": {} },
		{
			"op": "items",
			"open": "slashed",
			"expect": {
				"items": [{ "source": "s", "id": "Z", "name": "z", "at": 0, "path": ["z"] }],
				"reads": [{ "source": "s", "id": "R", "path": ["z"] }],
				"same": false
			}
		},
		{ "op": "open", "address": [".."], "as": "above", "expect": {} },
		{ "op": "items", "open": "above", "skip": ["same"], "expect": { "items": [], "reads": [] } },
		{ "op": "items", "open": "above", "skip": ["same"], "expect": { "items": [], "reads": [] } },
		{ "op": "open", "address": ["a", "..", ".."], "as": "above2", "expect": {} },
		{ "op": "items", "open": "above2", "skip": ["same"], "expect": { "items": [], "reads": [] } },
		{ "op": "open", "address": ["a", "nope", "x", "y"], "as": "lost", "expect": {} },
		{
			"op": "items",
			"open": "lost",
			"expect": {
				"items": [],
				"reads": [
					{ "source": "s", "id": "R", "path": ["a"] },
					{ "source": "s", "id": "A", "path": ["nope"] }
				],
				"same": false
			}
		},
		{
			"op": "items",
			"open": "lost",
			"expect": {
				"items": [],
				"reads": [
					{ "source": "s", "id": "R", "path": ["a"] },
					{ "source": "s", "id": "A", "path": ["nope"] }
				],
				"same": true
			}
		},
		{ "op": "open", "address": ["nope"], "as": "lost1", "expect": {} },
		{
			"op": "items",
			"open": "lost1",
			"expect": {
				"items": [],
				"reads": [{ "source": "s", "id": "R", "path": ["nope"] }],
				"same": false
			}
		},
		{
			"op": "children",
			"source": "s",
			"id": "R",
			"value": { "a": [["s", "A"], ["s", "A2"], ["s", "A"]] },
			"expect": {}
		},
		{
			"op": "children",
			"source": "s",
			"id": "A2",
			"value": { "b": [["s", "B2"]] },
			"expect": {}
		},
		{
			"op": "items",
			"open": "dot",
			"expect": {
				"items": [
					{ "source": "s", "id": "B", "name": "b", "at": 0, "path": ["a", "b"] },
					{ "source": "s", "id": "B2", "name": "b", "at": 0, "path": ["a", "b"] },
					{ "source": "s", "id": "B", "name": "b", "at": 0, "path": ["a", "b"] }
				],
				"reads": [
					{ "source": "s", "id": "R", "path": ["a"] },
					{ "source": "s", "id": "A", "path": ["b"] },
					{ "source": "s", "id": "A2", "path": ["b"] },
					{ "source": "s", "id": "A", "path": ["b"] }
				],
				"same": false
			}
		},
		{
			"op": "items",
			"open": "dot",
			"expect": {
				"items": [
					{ "source": "s", "id": "B", "name": "b", "at": 0, "path": ["a", "b"] },
					{ "source": "s", "id": "B2", "name": "b", "at": 0, "path": ["a", "b"] },
					{ "source": "s", "id": "B", "name": "b", "at": 0, "path": ["a", "b"] }
				],
				"reads": [
					{ "source": "s", "id": "R", "path": ["a"] },
					{ "source": "s", "id": "A", "path": ["b"] },
					{ "source": "s", "id": "A2", "path": ["b"] },
					{ "source": "s", "id": "A", "path": ["b"] }
				],
				"same": true
			}
		},
		{ "op": "open", "address": ["a", "b"], "as": "many", "expect": {} },
		{
			"op": "items",
			"open": "many",
			"save": "m",
			"expect": {
				"items": [
					{ "source": "s", "id": "B", "name": "b", "at": 0, "path": ["a", "b"] },
					{ "source": "s", "id": "B2", "name": "b", "at": 0, "path": ["a", "b"] },
					{ "source": "s", "id": "B", "name": "b", "at": 0, "path": ["a", "b"] }
				],
				"reads": [
					{ "source": "s", "id": "R", "path": ["a"] },
					{ "source": "s", "id": "A", "path": ["b"] },
					{ "source": "s", "id": "A2", "path": ["b"] },
					{ "source": "s", "id": "A", "path": ["b"] }
				],
				"same": false
			}
		},
		{
			"op": "items",
			"open": "many",
			"expect": {
				"items": [
					{ "source": "s", "id": "B", "name": "b", "at": 0, "path": ["a", "b"] },
					{ "source": "s", "id": "B2", "name": "b", "at": 0, "path": ["a", "b"] },
					{ "source": "s", "id": "B", "name": "b", "at": 0, "path": ["a", "b"] }
				],
				"reads": [
					{ "source": "s", "id": "R", "path": ["a"] },
					{ "source": "s", "id": "A", "path": ["b"] },
					{ "source": "s", "id": "A2", "path": ["b"] },
					{ "source": "s", "id": "A", "path": ["b"] }
				],
				"same": true
			}
		},
		{ "op": "open", "address": ["a", "b"], "as": "dup", "expect": {} },
		{
			"op": "items",
			"open": "dup",
			"save": "d",
			"expect": {
				"items": [
					{ "source": "s", "id": "B", "name": "b", "at": 0, "path": ["a", "b"] },
					{ "source": "s", "id": "B2", "name": "b", "at": 0, "path": ["a", "b"] },
					{ "source": "s", "id": "B", "name": "b", "at": 0, "path": ["a", "b"] }
				],
				"reads": [
					{ "source": "s", "id": "R", "path": ["a"] },
					{ "source": "s", "id": "A", "path": ["b"] },
					{ "source": "s", "id": "A2", "path": ["b"] },
					{ "source": "s", "id": "A", "path": ["b"] }
				],
				"same": false
			}
		},
		{ "op": "path", "item": "d", "expect": { "path": ["a", "b"] } },
		{
			"op": "get",
			"address": [".."],
			"from": { "item": "d" },
			"expect": {
				"items": [{ "source": "s", "id": "A", "name": "a", "at": 0, "path": ["a"] }],
				"reads": []
			}
		}
	]
