{
	"title": "every read is told, in order, including reads that found nothing; reads are fine",
	"steps": [
		{ "op": "make", "root": ["s", "R"], "expect": {} },
		{
			"op": "get",
			"address": ["a"],
			"expect": { "items": [], "reads": [{ "source": "s", "id": "R", "path": ["a"] }] }
		},
		{ "op": "children", "source": "s", "id": "R", "expect": {} },
		{
			"op": "get",
			"address": ["a"],
			"expect": { "items": [], "reads": [{ "source": "s", "id": "R", "path": ["a"] }] }
		},
		{ "op": "children", "source": "s", "id": "R", "value": [1, 2], "expect": {} },
		{
			"op": "get",
			"address": ["a"],
			"expect": { "items": [], "reads": [{ "source": "s", "id": "R", "path": ["a"] }] }
		},
		{ "op": "children", "source": "s", "id": "R", "value": "text", "expect": {} },
		{
			"op": "get",
			"address": ["a"],
			"expect": { "items": [], "reads": [{ "source": "s", "id": "R", "path": ["a"] }] }
		},
		{ "op": "children", "source": "s", "id": "R", "value": null, "expect": {} },
		{
			"op": "get",
			"address": ["a"],
			"expect": { "items": [], "reads": [{ "source": "s", "id": "R", "path": ["a"] }] }
		},
		{
			"op": "children",
			"source": "s",
			"id": "R",
			"value": { "a": 5, "b": "x", "c": null, "d": {}, "e": [] },
			"expect": {}
		},
		{
			"op": "get",
			"address": ["a"],
			"expect": { "items": [], "reads": [{ "source": "s", "id": "R", "path": ["a"] }] }
		},
		{
			"op": "get",
			"address": ["b"],
			"expect": { "items": [], "reads": [{ "source": "s", "id": "R", "path": ["b"] }] }
		},
		{
			"op": "get",
			"address": ["c"],
			"expect": { "items": [], "reads": [{ "source": "s", "id": "R", "path": ["c"] }] }
		},
		{
			"op": "get",
			"address": ["d"],
			"expect": { "items": [], "reads": [{ "source": "s", "id": "R", "path": ["d"] }] }
		},
		{
			"op": "get",
			"address": ["e"],
			"expect": { "items": [], "reads": [{ "source": "s", "id": "R", "path": ["e"] }] }
		},
		{
			"op": "get",
			"address": ["f"],
			"expect": { "items": [], "reads": [{ "source": "s", "id": "R", "path": ["f"] }] }
		},
		{ "op": "children", "source": "s", "id": "R", "value": { "a": [["s", "A"]] }, "expect": {} },
		{
			"op": "get",
			"address": ["a", "b", "c"],
			"expect": {
				"items": [],
				"reads": [
					{ "source": "s", "id": "R", "path": ["a"] },
					{ "source": "s", "id": "A", "path": ["b"] }
				]
			}
		},
		{
			"op": "children",
			"source": "s",
			"id": "A",
			"value": { "b": [["s", "B"]], "c": [["s", "C"]] },
			"expect": {}
		},
		{
			"op": "get",
			"address": ["a", "b"],
			"expect": {
				"items": [{ "source": "s", "id": "B", "name": "b", "at": 0, "path": ["a", "b"] }],
				"reads": [
					{ "source": "s", "id": "R", "path": ["a"] },
					{ "source": "s", "id": "A", "path": ["b"] }
				]
			}
		},
		{
			"op": "get",
			"address": ["a", "c"],
			"expect": {
				"items": [{ "source": "s", "id": "C", "name": "c", "at": 0, "path": ["a", "c"] }],
				"reads": [
					{ "source": "s", "id": "R", "path": ["a"] },
					{ "source": "s", "id": "A", "path": ["c"] }
				]
			}
		},
		{
			"op": "get",
			"address": [],
			"expect": { "items": [{ "source": "s", "id": "R", "path": [] }], "reads": [] }
		},
		{
			"op": "children",
			"source": "s",
			"id": "R",
			"value": { "a": [["s", "A"], ["o", "A"], ["s", "A2"]] },
			"expect": {}
		},
		{ "op": "children", "source": "s", "id": "A", "value": { "b": [["s", "B"]] }, "expect": {} },
		{ "op": "children", "source": "o", "id": "A", "value": { "b": [["s", "B2"]] }, "expect": {} },
		{
			"op": "get",
			"address": ["a", "b"],
			"expect": {
				"items": [
					{ "source": "s", "id": "B", "name": "b", "at": 0, "path": ["a", "b"] },
					{ "source": "s", "id": "B2", "name": "b", "at": 0, "path": ["a", "b"] }
				],
				"reads": [
					{ "source": "s", "id": "R", "path": ["a"] },
					{ "source": "s", "id": "A", "path": ["b"] },
					{ "source": "o", "id": "A", "path": ["b"] },
					{ "source": "s", "id": "A2", "path": ["b"] }
				]
			}
		},
		{
			"op": "get",
			"address": ["a", "nope", "x"],
			"expect": {
				"items": [],
				"reads": [
					{ "source": "s", "id": "R", "path": ["a"] },
					{ "source": "s", "id": "A", "path": ["nope"] },
					{ "source": "o", "id": "A", "path": ["nope"] },
					{ "source": "s", "id": "A2", "path": ["nope"] }
				]
			}
		},
		{
			"op": "get",
			"address": ["a", "b", "x"],
			"expect": {
				"items": [],
				"reads": [
					{ "source": "s", "id": "R", "path": ["a"] },
					{ "source": "s", "id": "A", "path": ["b"] },
					{ "source": "o", "id": "A", "path": ["b"] },
					{ "source": "s", "id": "A2", "path": ["b"] },
					{ "source": "s", "id": "B", "path": ["x"] },
					{ "source": "s", "id": "B2", "path": ["x"] }
				]
			}
		},
		{
			"op": "lookup",
			"address": ["a"],
			"from": ["s", "R"],
			"expect": {
				"items": [
					{ "source": "s", "id": "A", "name": "a", "at": 0, "path": ["a"] },
					{ "source": "o", "id": "A", "name": "a", "at": 1, "path": ["a"] },
					{ "source": "s", "id": "A2", "name": "a", "at": 2, "path": ["a"] }
				],
				"reads": [{ "source": "s", "id": "R", "path": ["a"] }]
			}
		},
		{
			"op": "names",
			"from": ["s", "R"],
			"expect": {
				"names": ["a"],
				"reads": [{ "source": "s", "id": "R", "path": [], "keys": true }]
			}
		},
		{
			"op": "names",
			"from": ["s", "nobody"],
			"expect": {
				"names": [],
				"reads": [{ "source": "s", "id": "nobody", "path": [], "keys": true }]
			}
		}
	]
}
