{
	"title": "a delete that meets what was typed",
	"steps": [
		{
			"op": "squish",
			"patches": [
				{ "path": ["t"], "range": [0, 0], "value": "ab" },
				{ "path": ["t"], "range": [2, 5] }
			],
			"expect": { "patches": [{ "path": ["t"], "range": [0, 3], "value": "ab" }] }
		},
		{
			"op": "squish",
			"patches": [
				{ "path": ["t"], "range": [0, 0], "value": "ab" },
				{ "path": ["t"], "range": [2, 5] },
				{ "path": ["t"], "range": [2, 3] }
			],
			"expect": { "patches": [{ "path": ["t"], "range": [0, 4], "value": "ab" }] }
		},
		{
			"op": "squish",
			"patches": [
				{ "path": ["t"], "range": [0, 0], "value": "ab" },
				{ "path": ["t"], "range": [1, 5] }
			],
			"expect": {
				"patches": [
					{ "path": ["t"], "range": [0, 0], "value": "ab" },
					{ "path": ["t"], "range": [1, 5] }
				]
			}
		}
	]
}
