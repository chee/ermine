{
	"title": "a fouled place moved, as part of what is above it, is fouled where it lands: typing there never joins",
	"steps": [
		{
			"op": "squish",
			"patches": [
				{ "path": ["t", "x"], "range": [0, 0], "value": "\ud83d" },
