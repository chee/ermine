				{ "path": ["u", "x"], "range": [1, 1], "value": "b" }
			],
			"expect": {
				"patches": [
					{ "path": ["t", "x"], "range": [0, 0], "value": "\ud83d" },
					{ "path": ["u"], "move": { "path": ["t"] } },
					{ "path": ["u", "x"], "range": [0, 0], "value": "a" },
					{ "path": ["u", "x"], "range": [1, 1], "value": "b" }
				]
			}
		}
	]
}
